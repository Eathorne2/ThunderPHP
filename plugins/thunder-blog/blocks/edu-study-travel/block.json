{
  "slug": "edu-study-travel",
  "name": "Study & Travel Program",
  "category": "Education",
  "description": "Study-abroad and educational tour cards with destinations and dates",
  "keywords": [
    "education",
    "study abroad",
    "travel",
    "tours"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-travel\"><div class=\"tb-edu-travel__media\">{{elements:image}}</div><div class=\"tb-edu-travel__content\"><div class=\"tb-edu-travel__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-travel__list\">{{elements:trips}}</div></div></div>",
  "css": ".tb-edu-travel{display:grid;grid-template-columns:.9fr 1.1fr;background:var(--tb-color-background)}.tb-edu-travel__media{min-height:650px}.tb-edu-travel__image{width:100%;height:100%;min-height:650px;object-fit:cover}.tb-edu-travel__content{padding:clamp(34px,6vw,72px)}.tb-edu-travel__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-travel__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,60px)}.tb-edu-travel__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-travel__trip{padding:20px 0;border-top:1px solid var(--tb-color-border)}.tb-edu-travel__place{margin:0;color:var(--tb-color-secondary);font-size:25px}.tb-edu-travel__meta{display:block;margin:4px 0;color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase}.tb-edu-travel__trip-text{margin:0;color:var(--tb-color-muted);line-height:1.6}@media(max-width:760px){.tb-edu-travel{grid-template-columns:1fr}.tb-edu-travel__media,.tb-edu-travel__image{min-height:380px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Travel image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1400&q=82",
        "alt": "Students outdoors"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-edu-travel__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-edu-travel__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Learn beyond campus"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-travel__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Study and travel programs"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-edu-travel__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Combine study, culture, fieldwork and new places in one program overview."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-edu-travel__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "trips",
      "label": "Trip",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "place": "Cape Town",
        "meta": "2 weeks · July",
        "text": "Language immersion, cultural visits and project work."
      },
      "schema": [
        {
          "key": "place",
          "label": "Destination",
          "type": "text",
          "selector": ".tb-edu-travel__place"
        },
        {
          "key": "meta",
          "label": "Dates / duration",
          "type": "text",
          "selector": ".tb-edu-travel__meta"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-edu-travel__trip-text",
          "rows": 2
        }
      ],
      "template": "<article class=\"tb-edu-travel__trip\"><h3 class=\"tb-edu-travel__place\">{{place}}</h3><span class=\"tb-edu-travel__meta\">{{meta}}</span><p class=\"tb-edu-travel__trip-text\">{{text}}</p></article>",
      "min": 1,
      "max": 10,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "place": "Cape Town",
          "meta": "2 weeks · July",
          "text": "Language immersion, cultural visits and project work."
        },
        {
          "place": "Nairobi",
          "meta": "10 days · August",
          "text": "Entrepreneurship visits, workshops and regional networking."
        },
        {
          "place": "Livingstone",
          "meta": "5 days · September",
          "text": "Environmental field study and community research."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
