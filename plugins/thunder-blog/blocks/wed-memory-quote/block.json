{
  "slug": "wed-memory-quote",
  "name": "Wedding Memory Quote",
  "category": "Wedding",
  "description": "Full image romantic quote block for vows, memories or couple statements",
  "keywords": [
    "wedding",
    "quote",
    "vows",
    "memory"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-memory-quote\"><div class=\"tb-wed-memory-quote__shade\"></div><div class=\"tb-wed-memory-quote__content\">{{elements:eyebrow}}{{elements:quote}}{{elements:name}}</div></div>",
  "css": ".tb-wed-memory-quote{position:relative;min-height:620px;display:grid;place-items:center;padding:36px;background:url(\"https://images.unsplash.com/photo-1522673607200-164d1b6ce486?auto=format&fit=crop&w=1400&q=82\") center/cover no-repeat;text-align:center;color:#fff}.tb-wed-memory-quote__shade{position:absolute;inset:0;background:rgba(25,20,18,.42)}.tb-wed-memory-quote__content{position:relative;z-index:1;max-width:900px}.tb-wed-memory-quote__eyebrow{font-size:11px;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.tb-wed-memory-quote__quote{margin:18px 0;font-family:Georgia,serif;font-size:clamp(40px,6vw,72px);font-weight:400;line-height:1.12}.tb-wed-memory-quote__name{font-size:13px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A little promise"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-memory-quote__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "quote",
      "label": "Quote",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "“Whatever comes next, I choose you.”"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<blockquote class=\"tb-wed-memory-quote__quote\">{{text}}</blockquote>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "name",
      "label": "Attribution",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Amelia & Noah"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-memory-quote__name\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
