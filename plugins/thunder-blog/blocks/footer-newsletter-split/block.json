{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand statement",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "text": "{{app_description}}",
        "logo": "{{app_logo}}"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-f-newsletter-split__brand-name"
        },
        {
          "key": "text",
          "label": "Brand text",
          "type": "textarea",
          "selector": ".tb-f-newsletter-split__brand-text"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-f-newsletter-split__logo"
        }
      ],
      "template": "<div class=\"tb-f-newsletter-split__brand\"><img class=\"tb-f-newsletter-split__logo\" src=\"{{logo}}\" alt=\"\"><strong class=\"tb-f-newsletter-split__brand-name\">{{name}}</strong><p class=\"tb-f-newsletter-split__brand-text\">{{text}}</p></div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "text"
        }
      }
    },
    {
      "key": "copyright",
      "label": "Copyright",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "© {{year}} {{app_name}}. All rights reserved."
      },
      "schema": [
        {
          "key": "text",
          "label": "Copyright text",
          "type": "text",
          "selector": ".tb-f-newsletter-split__copyright"
        }
      ],
      "template": "<div class=\"tb-f-newsletter-split__copyright\">{{text}}</div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    },
    {
      "key": "newsletter",
      "label": "Newsletter",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "heading": "Join the newsletter",
        "text": "Get new stories and updates delivered to your inbox.",
        "button": "Subscribe"
      },
      "schema": [
        {
          "key": "heading",
          "label": "Heading",
          "type": "text",
          "selector": ".tb-f-newsletter-split__newsletter-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-f-newsletter-split__newsletter-text"
        },
        {
          "key": "button",
          "label": "Button text",
          "type": "text",
          "selector": ".tb-f-newsletter-split__newsletter-button"
        }
      ],
      "template": "<div class=\"tb-f-newsletter-split__newsletter\"><strong class=\"tb-f-newsletter-split__newsletter-title\">{{heading}}</strong><p class=\"tb-f-newsletter-split__newsletter-text\">{{text}}</p><div class=\"tb-f-newsletter-split__newsletter-form\"><span class=\"tb-f-newsletter-split__newsletter-input\">email@example.com</span><button class=\"tb-f-newsletter-split__newsletter-button\" type=\"button\">{{button}}</button></div></div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "text",
          "background_color": "background"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-f-newsletter-split__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-f-newsletter-split__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-f-newsletter-split__parent\"><a class=\"tb-f-newsletter-split__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-f-newsletter-split__chevron\">⌄</span></a><div class=\"tb-f-newsletter-split__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-f-newsletter-split__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<footer class=\"tb-block tb-f-newsletter-split\"><div class=\"tb-f-newsletter-split__inner\" style=\"--tb-f-newsletter-split-width:{{width}}px\"><div class=\"tb-f-newsletter-split__top\">{{elements:newsletter}}{{menu:primary}}</div><div class=\"tb-f-newsletter-split__bottom\">{{elements:brand}}{{elements:copyright}}</div></div></footer>",
  "css": ".tb-f-newsletter-split{background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-f-newsletter-split__inner{max-width:var(--tb-f-newsletter-split-width);margin:auto;padding:52px 24px 24px}.tb-f-newsletter-split__brand{display:grid;gap:10px;align-content:start}.tb-f-newsletter-split__logo{width:42px;height:42px;object-fit:contain}.tb-f-newsletter-split__brand-name{font-size:20px}.tb-f-newsletter-split__brand-text{max-width:360px;margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-f-newsletter-split__copyright{color:var(--tb-color-muted);font-size:12px}.tb-f-newsletter-split__nav{display:grid;gap:10px}.tb-f-newsletter-split__link{color:inherit;text-decoration:none;opacity:.78}.tb-f-newsletter-split__link:hover{opacity:1;color:var(--tb-color-primary)}.tb-f-newsletter-split__parent{display:grid;gap:8px}.tb-f-newsletter-split__parent>.tb-f-newsletter-split__link{font-weight:850;opacity:1}.tb-f-newsletter-split__submenu{display:grid;gap:7px;padding-left:0}.tb-f-newsletter-split__chevron{display:none}.tb-f-newsletter-split__top{display:grid;grid-template-columns:minmax(280px,1fr) minmax(0,1.1fr);gap:54px}.tb-f-newsletter-split__newsletter{padding:24px;border-radius:18px}.tb-f-newsletter-split__newsletter-title{font-size:24px}.tb-f-newsletter-split__newsletter-text{color:var(--tb-color-muted);line-height:1.6}.tb-f-newsletter-split__newsletter-form{height:44px;border:1px solid var(--tb-color-border);border-radius:9px;display:flex;overflow:hidden}.tb-f-newsletter-split__newsletter-input{padding:12px;flex:1;color:var(--tb-color-muted)}.tb-f-newsletter-split__newsletter-button{padding:0 15px;border:0;background:var(--tb-color-primary);color:var(--tb-color-background);font-weight:850}.tb-f-newsletter-split__nav{grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.tb-f-newsletter-split__bottom{margin-top:40px;padding-top:22px;border-top:1px solid var(--tb-color-border);display:flex;align-items:end;justify-content:space-between;gap:24px}.tb-f-newsletter-split__bottom .tb-f-newsletter-split__brand-text,.tb-f-newsletter-split__bottom .tb-f-newsletter-split__logo{display:none}@media(max-width:820px){.tb-f-newsletter-split__grid,.tb-f-newsletter-split__top,.tb-f-newsletter-split__row,.tb-f-newsletter-split__bottom{grid-template-columns:1fr;flex-wrap:wrap}.tb-f-newsletter-split__nav{grid-template-columns:repeat(2,minmax(0,1fr))}.tb-f-newsletter-split__contacts{grid-template-columns:1fr}}@media(max-width:520px){.tb-f-newsletter-split__inner{padding-left:16px;padding-right:16px}.tb-f-newsletter-split__nav{grid-template-columns:1fr}.tb-f-newsletter-split__search{width:100%!important}}",
  "js": "",
  "slug": "footer-newsletter-split",
  "name": "Newsletter Split Footer",
  "category": "Footers",
  "description": "A split newsletter and navigation footer with a quiet legal row.",
  "keywords": [
    "footer",
    "navigation",
    "menu",
    "newssplit"
  ],
  "contexts": [
    "footer"
  ],
  "version": "1.0.0"
}
