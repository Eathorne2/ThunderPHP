{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1280",
      "message": "New stories every week"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Navigation menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1100": "Compact",
          "1280": "Standard",
          "1440": "Wide"
        },
        "default": "1280"
      },
      {
        "key": "message",
        "label": "Top bar message",
        "type": "text",
        "default": "New stories every week"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "{{app_name}}"
      },
      "schema": [
        {
          "key": "text",
          "label": "Brand name",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<a class=\"tb-search-header__brand\" href=\"{{root}}/\">{{text}}</a>",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "secondary"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-search-header__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-search-header__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-search-header__parent\"><a class=\"tb-search-header__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}} ⌄</a><div class=\"tb-search-header__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-search-header__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<header class=\"tb-block tb-search-header\"><div class=\"tb-search-header__top\">{{message}}</div><div class=\"tb-search-header__inner\" style=\"--tb-search-header-width:{{width}}px\">{{elements:brand}}{{menu:primary}}<form class=\"tb-search-header__form\" method=\"get\" action=\"{{root}}/blog/search\"><label class=\"tb-search-header__label\"><span class=\"tb-search-header__sr\">Search the blog</span><input class=\"tb-search-header__input\" type=\"search\" name=\"q\" placeholder=\"Search articles\"><button class=\"tb-search-header__submit\" type=\"submit\" aria-label=\"Search\">⌕</button></label></form></div></header>",
  "css": ".tb-search-header{border-bottom:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-search-header__top{padding:7px 18px;background:var(--tb-color-secondary);color:var(--tb-color-background);font-size:12px;font-weight:750;text-align:center}.tb-search-header__inner{max-width:var(--tb-search-header-width);min-height:74px;margin:auto;padding:0 24px;display:grid;grid-template-columns:auto 1fr minmax(190px,260px);align-items:center;gap:24px}.tb-search-header__brand{color:var(--tb-color-secondary);font-size:22px;font-weight:900;text-decoration:none}.tb-search-header__nav{display:flex;justify-content:center;gap:5px}.tb-search-header__link{display:block;padding:9px 11px;color:var(--tb-color-text);text-decoration:none;font-weight:700}.tb-search-header__link:hover{color:var(--tb-color-primary)}.tb-search-header__label{display:flex;border:1px solid var(--tb-color-border);border-radius:999px;background:var(--tb-color-background);overflow:hidden}.tb-search-header__input{min-width:0;width:100%;padding:10px 2px 10px 14px;border:0;outline:0;background:transparent;color:var(--tb-color-text)}.tb-search-header__submit{width:42px;border:0;background:transparent;color:var(--tb-color-primary);cursor:pointer;font-size:20px}.tb-search-header__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.tb-search-header__parent{position:relative}.tb-search-header__submenu{position:absolute;z-index:20;top:100%;left:0;min-width:180px;padding:7px;border:1px solid var(--tb-color-border);border-radius:11px;background:var(--tb-color-surface);display:none}.tb-search-header__parent:hover>.tb-search-header__submenu,.tb-search-header__parent:focus-within>.tb-search-header__submenu{display:grid}.tb-menu-empty{color:var(--tb-color-muted);font-size:13px}@media(max-width:880px){.tb-search-header__inner{grid-template-columns:1fr;padding-top:16px;padding-bottom:16px}.tb-search-header__nav{justify-content:flex-start;flex-wrap:wrap}.tb-search-header__form{max-width:420px}}",
  "js": "",
  "slug": "header-topbar-search",
  "name": "Top Bar, Menu and Search Header",
  "category": "Headers",
  "description": "A publication header with a saved menu and blog search form.",
  "keywords": [
    "header",
    "topbar",
    "menu",
    "search",
    "publication"
  ],
  "contexts": [
    "header"
  ],
  "version": "1.0.0"
}
