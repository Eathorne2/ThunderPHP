{
  "slug": "edu-quality-education",
  "name": "Quality Education Statement",
  "category": "Education",
  "description": "Large education mission statement with supporting metrics",
  "keywords": [
    "education",
    "quality",
    "mission",
    "statistics"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-quality\"><div class=\"tb-edu-quality__statement\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-quality__metrics\">{{elements:metrics}}</div></div>",
  "css": ".tb-edu-quality{padding:clamp(38px,7vw,90px);background:var(--tb-color-secondary);color:var(--tb-color-background)}.tb-edu-quality__statement{max-width:980px}.tb-edu-quality__eyebrow{color:var(--tb-color-accent);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-edu-quality__title{margin:14px 0;color:inherit;font-size:clamp(48px,7vw,86px);line-height:1}.tb-edu-quality__text{max-width:720px;color:inherit;opacity:.78;font-size:18px;line-height:1.75}.tb-edu-quality__metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:42px;background:color-mix(in srgb,var(--tb-color-background) 25%,transparent)}.tb-edu-quality__metric{padding:24px;background:var(--tb-color-secondary)}.tb-edu-quality__value{display:block;font-size:42px;font-weight:950;color:var(--tb-color-accent)}.tb-edu-quality__label{display:block;margin-top:4px;color:inherit;opacity:.8}@media(max-width:650px){.tb-edu-quality__metrics{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Why choose us"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-quality__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A good education changes what feels possible"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-edu-quality__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Use this section for your educational philosophy, outcomes and headline proof points."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-edu-quality__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "metrics",
      "label": "Metric",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "value": "96%",
        "label": "Learner satisfaction"
      },
      "schema": [
        {
          "key": "value",
          "label": "Value",
          "type": "text",
          "selector": ".tb-edu-quality__value"
        },
        {
          "key": "label",
          "label": "Label",
          "type": "text",
          "selector": ".tb-edu-quality__label"
        }
      ],
      "template": "<div class=\"tb-edu-quality__metric\"><strong class=\"tb-edu-quality__value\">{{value}}</strong><span class=\"tb-edu-quality__label\">{{label}}</span></div>",
      "min": 1,
      "max": 8,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "value": "96%",
          "label": "Learner satisfaction"
        },
        {
          "value": "42",
          "label": "Expert instructors"
        },
        {
          "value": "18",
          "label": "Study programs"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
