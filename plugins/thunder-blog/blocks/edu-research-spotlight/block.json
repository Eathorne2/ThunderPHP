{
  "slug": "edu-research-spotlight",
  "name": "Learning & Research Spotlight",
  "category": "Education",
  "description": "Research spotlight with two editorial research summaries",
  "keywords": [
    "education",
    "research",
    "university",
    "learning"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-research\"><div class=\"tb-edu-research__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-research__body\"><div class=\"tb-edu-research__media\">{{elements:image}}</div><div class=\"tb-edu-research__list\">{{elements:items}}</div></div></div>",
  "css": ".tb-edu-research{padding:clamp(34px,6vw,78px);background:var(--tb-color-surface)}.tb-edu-research__head{max-width:790px;margin-bottom:28px}.tb-edu-research__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-research__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,60px)}.tb-edu-research__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-research__body{display:grid;grid-template-columns:1fr 1fr;gap:20px}.tb-edu-research__image{width:100%;height:100%;min-height:520px;object-fit:cover}.tb-edu-research__item{padding:26px 0;border-top:1px solid var(--tb-color-border)}.tb-edu-research__label{color:var(--tb-color-primary);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.tb-edu-research__item-title{margin:8px 0;color:var(--tb-color-secondary);font-size:28px}.tb-edu-research__item-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:760px){.tb-edu-research__body{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Knowledge in motion"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-research__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Learning and research"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-edu-research__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Highlight research themes, labs, field projects, academic initiatives or community partnerships."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-edu-research__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "image",
      "label": "Research image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=1400&q=82",
        "alt": "Research activity"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-edu-research__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-edu-research__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Research item",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "label": "Research area",
        "title": "Learning analytics",
        "text": "Using evidence to understand how students progress and where support matters most."
      },
      "schema": [
        {
          "key": "label",
          "label": "Label",
          "type": "text",
          "selector": ".tb-edu-research__label"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-edu-research__item-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-edu-research__item-text",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-edu-research__item\"><span class=\"tb-edu-research__label\">{{label}}</span><h3 class=\"tb-edu-research__item-title\">{{title}}</h3><p class=\"tb-edu-research__item-text\">{{text}}</p></article>",
      "min": 1,
      "max": 8,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "label": "Research area",
          "title": "Learning analytics",
          "text": "Using evidence to understand how students progress and where support matters most."
        },
        {
          "label": "Community project",
          "title": "Local language literacy",
          "text": "Working with teachers to develop reading resources rooted in local context."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
