{
  "slug": "food-customer-reviews",
  "name": "Customer Reviews",
  "category": "Food & Restaurant",
  "description": "Restaurant testimonial cards with guest attribution and visit context",
  "keywords": [
    "food",
    "restaurant",
    "reviews",
    "testimonials",
    "guests"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-reviews\"><header class=\"tb-food-reviews__head\">{{elements:eyebrow}}{{elements:title}}</header><div class=\"tb-food-reviews__grid\">{{elements:reviews}}</div></div>",
  "css": ".tb-food-reviews{padding:clamp(36px,6vw,82px);background:color-mix(in srgb,var(--tb-color-primary) 8%,var(--tb-color-surface))}.tb-food-reviews__head{max-width:720px;margin-bottom:30px}.tb-food-reviews__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;text-transform:uppercase;letter-spacing:.16em}.tb-food-reviews__title{margin:8px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(42px,6vw,68px)}.tb-food-reviews__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.tb-food-reviews__card{padding:26px;background:var(--tb-color-background);border:1px solid var(--tb-color-border)}.tb-food-reviews__quote{margin:0 0 24px;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:20px;line-height:1.55}.tb-food-reviews__name{display:block;color:var(--tb-color-primary);font-weight:900}.tb-food-reviews__meta{display:block;margin-top:3px;color:var(--tb-color-muted);font-size:13px}@media(max-width:760px){.tb-food-reviews__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Guest notes"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-reviews__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "What people remember"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h2 class=\"tb-food-reviews__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "reviews",
      "label": "Review",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "quote": "The kind of place you start recommending before dessert arrives.",
        "name": "M. Banda",
        "meta": "Dinner guest"
      },
      "schema": [
        {
          "key": "quote",
          "label": "Quote",
          "type": "textarea",
          "selector": ".tb-food-reviews__quote",
          "rows": 3
        },
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "selector": ".tb-food-reviews__name"
        },
        {
          "key": "meta",
          "label": "Visit note",
          "type": "text",
          "selector": ".tb-food-reviews__meta"
        }
      ],
      "template": "<blockquote class=\"tb-food-reviews__card\"><p class=\"tb-food-reviews__quote\">“{{quote}}”</p><strong class=\"tb-food-reviews__name\">{{name}}</strong><span class=\"tb-food-reviews__meta\">{{meta}}</span></blockquote>",
      "min": 1,
      "max": 12,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "quote": "The kind of place you start recommending before dessert arrives.",
          "name": "M. Banda",
          "meta": "Dinner guest"
        },
        {
          "quote": "Beautiful room, thoughtful service and food that feels confident without trying too hard.",
          "name": "T. Mwale",
          "meta": "Weekend lunch"
        },
        {
          "quote": "Our celebration felt effortless from the first welcome to the final coffee.",
          "name": "K. Phiri",
          "meta": "Private event"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
