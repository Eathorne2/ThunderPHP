{
  "slug": "edu-learning-center-hero",
  "name": "Teaching & Learning Center Hero",
  "category": "Education",
  "description": "Modern split education hero for schools, academies and learning centers",
  "keywords": [
    "education",
    "hero",
    "school",
    "academy"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-learning-center\"><div class=\"tb-edu-learning-center__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-edu-learning-center__actions\">{{elements:primary}}{{elements:secondary}}</div></div><div class=\"tb-edu-learning-center__media\">{{elements:image}}<div class=\"tb-edu-learning-center__badge\">{{elements:badge}}</div></div></div>",
  "css": ".tb-edu-learning-center{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);background:var(--tb-color-background);border:1px solid var(--tb-color-border)}.tb-edu-learning-center__copy{padding:clamp(38px,7vw,92px);align-self:center}.tb-edu-learning-center__eyebrow{color:var(--tb-color-primary);font-weight:900;letter-spacing:.16em;text-transform:uppercase;font-size:12px}.tb-edu-learning-center__title{margin:14px 0;color:var(--tb-color-secondary);font-size:clamp(46px,6vw,78px);line-height:.98;letter-spacing:-.045em}.tb-edu-learning-center__text{color:var(--tb-color-muted);font-size:17px;line-height:1.75}.tb-edu-learning-center__actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}.tb-edu-learning-center__primary,.tb-edu-learning-center__secondary{padding:13px 19px;text-decoration:none;font-weight:900}.tb-edu-learning-center__primary{background:var(--tb-color-primary);color:var(--tb-color-background)}.tb-edu-learning-center__secondary{border:1px solid var(--tb-color-border);color:var(--tb-color-text)}.tb-edu-learning-center__media{position:relative;min-height:620px}.tb-edu-learning-center__image{width:100%;height:100%;min-height:620px;object-fit:cover;display:block}.tb-edu-learning-center__badge{position:absolute;left:24px;bottom:24px;max-width:230px;padding:18px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-edu-learning-center__badge-text{font-weight:900;color:var(--tb-color-secondary)}@media(max-width:760px){.tb-edu-learning-center{grid-template-columns:1fr}.tb-edu-learning-center__media,.tb-edu-learning-center__image{min-height:420px}}",
  "js": "",
