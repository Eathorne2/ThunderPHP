{
  "slug": "medicine-science-discovery-feature",
  "name": "Science Discovery Feature",
  "category": "Medicine & Science",
  "description": "Editorial scientific discovery feature",
  "keywords": [
    "science",
    "discovery",
    "research"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-science-discovery-feature\"><div class=\"tb-med-science-discovery-feature__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-med-science-discovery-feature__visual\">{{elements:image}}<span class=\"tb-med-science-discovery-feature__caption\">Discovery / 2026</span></div></section>",
  "css": ".tb-med-science-discovery-feature{display:grid;grid-template-columns:1fr 1fr;gap:clamp(26px,6vw,72px);align-items:center;padding:clamp(42px,7vw,90px);background:var(--tb-color-surface)}.tb-med-science-discovery-feature__eyebrow{font-family:monospace;color:var(--tb-color-primary);font-size:12px;text-transform:uppercase;letter-spacing:.14em}.tb-med-science-discovery-feature__title{font-size:clamp(40px,5vw,68px);line-height:1;margin:12px 0 18px;color:var(--tb-color-secondary)}.tb-med-science-discovery-feature__text{font-size:17px;line-height:1.8;color:var(--tb-color-muted)}.tb-med-science-discovery-feature__cta{display:inline-block;margin-top:20px;color:var(--tb-color-primary);font-weight:900;text-underline-offset:5px}.tb-med-science-discovery-feature__visual{position:relative}.tb-med-science-discovery-feature__image{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:50%}.tb-med-science-discovery-feature__caption{position:absolute;right:0;bottom:10%;padding:9px 12px;background:var(--tb-color-secondary);color:var(--tb-color-surface);font-family:monospace}@media(max-width:760px){.tb-med-science-discovery-feature{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Featured discovery"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-med-science-discovery-feature__eyebrow\">{{text}}</span>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    },
    {
