          "type": "text"
        }
      ],
      "template": "<img class=\"tb-med-science-discovery-feature__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "",
