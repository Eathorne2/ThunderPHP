      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-med-science-discovery-feature__cta\" href=\"{{url}}\">{{text}}</a>",
      "appearance": {
