{
  "slug": "food-seasonal-produce",
  "name": "Seasonal Produce Grid",
  "category": "Food & Restaurant",
  "description": "Produce-led seasonal grid for farm-to-table restaurants and healthy food brands",
  "keywords": [
    "food",
    "restaurant",
    "seasonal",
    "produce",
    "ingredients"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-produce\"><div class=\"tb-food-produce__intro\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-food-produce__grid\">{{elements:items}}</div></div>",
  "css": ".tb-food-produce{padding:clamp(34px,6vw,80px);background:color-mix(in srgb,var(--tb-color-primary) 6%,var(--tb-color-background))}.tb-food-produce__intro{display:grid;grid-template-columns:.8fr 1.2fr;gap:40px;margin-bottom:30px}.tb-food-produce__eyebrow{color:var(--tb-color-primary);font-weight:950;text-transform:uppercase;letter-spacing:.16em;font-size:12px}.tb-food-produce__title{grid-column:1;margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,62px)}.tb-food-produce__text{grid-column:2;grid-row:1/3;margin:0;color:var(--tb-color-muted);line-height:1.75;align-self:end}.tb-food-produce__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.tb-food-produce__item{min-height:240px;padding:24px;display:flex;flex-direction:column;justify-content:end;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-food-produce__item h3{margin:0 0 8px;color:var(--tb-color-secondary);font-size:24px}.tb-food-produce__item p{margin:0;color:var(--tb-color-muted);line-height:1.55}@media(max-width:800px){.tb-food-produce__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.tb-food-produce__intro{grid-template-columns:1fr}.tb-food-produce__text{grid-column:1;grid-row:auto}.tb-food-produce__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "In season now"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-produce__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Ingredients we are excited about"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h2 class=\"tb-food-produce__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Use this section to highlight the produce driving your current menu and tell guests what changes through the year."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-food-produce__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Produce item",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "title": "Tomatoes",
        "text": "Peak-season, deeply flavored and used across salads and sauces."
      },
      "schema": [
        {
          "key": "title",
          "label": "Ingredient",
          "type": "text",
          "selector": ".tb-food-produce__item h3"
        },
        {
          "key": "text",
          "label": "Description",
          "type": "textarea",
          "selector": ".tb-food-produce__item p",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-food-produce__item\"><h3>{{title}}</h3><p>{{text}}</p></article>",
      "min": 1,
      "max": 12,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "title": "Tomatoes",
          "text": "Peak-season, deeply flavored and used across salads and sauces."
        },
        {
          "title": "Leafy greens",
          "text": "Tender local greens for warm plates and crisp sides."
        },
        {
          "title": "Citrus",
          "text": "Bright acidity for dressings, desserts and drinks."
        },
        {
          "title": "Herbs",
          "text": "Fresh-picked herbs to finish plates with fragrance and color."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
