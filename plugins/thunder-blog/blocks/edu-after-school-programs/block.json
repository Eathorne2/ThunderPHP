  "html": "<div class=\"tb-block tb-edu-after-school\"><div class=\"tb-edu-after-school__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-after-school__grid\">{{elements:programs}}</div></div>",
  "css": ".tb-edu-after-school{padding:clamp(34px,6vw,78px);background:var(--tb-color-background)}.tb-edu-after-school__head{max-width:720px;margin-bottom:28px}.tb-edu-after-school__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-after-school__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,60px)}.tb-edu-after-school__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-after-school__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tb-edu-after-school__card{padding:26px;border:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-edu-after-school__day{display:inline-block;padding:6px 9px;background:color-mix(in srgb,var(--tb-color-primary) 10%,var(--tb-color-surface));color:var(--tb-color-primary);font-size:11px;font-weight:900;text-transform:uppercase}.tb-edu-after-school__card-title{margin:32px 0 8px;color:var(--tb-color-secondary);font-size:25px}.tb-edu-after-school__card-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:760px){.tb-edu-after-school__grid{grid-template-columns:1fr}}",
