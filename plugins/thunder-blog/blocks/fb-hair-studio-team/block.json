{
  "slug": "fb-hair-studio-team",
  "name": "Hair Studio Team",
  "category": "Fashion & Beauty",
  "description": "Editorial team cards for salons, stylists and beauty studios.",
  "keywords": [
    "hair",
    "salon",
    "team",
    "stylists"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-team\"><div class=\"tb-fb-team__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-fb-team__grid\">{{elements:members}}</div></div>",
  "css": ".tb-fb-team{padding:clamp(28px,6vw,76px);background:var(--tb-color-background)}.tb-fb-team__head{max-width:720px;margin-bottom:30px}.tb-fb-team__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-team__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,5vw,62px);font-weight:500}.tb-fb-team__text{color:var(--tb-color-muted);line-height:1.7}.tb-fb-team__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tb-fb-team__member{background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-fb-team__image{width:100%;aspect-ratio:4/5;object-fit:cover;display:block}.tb-fb-team__copy{padding:18px}.tb-fb-team__name{margin:0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:26px}.tb-fb-team__role{margin:5px 0 0;color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}@media(max-width:760px){.tb-fb-team__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Meet the studio"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-team__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
