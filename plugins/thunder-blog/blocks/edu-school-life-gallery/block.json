{
  "slug": "edu-school-life-gallery",
  "name": "Our School Life Gallery",
  "category": "Education",
  "description": "Editorial school-life photo mosaic with captions",
  "keywords": [
    "education",
    "school",
    "gallery",
    "students"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-school-life\"><div class=\"tb-edu-school-life__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-school-life__grid\">{{elements:photos}}</div></div>",
  "css": ".tb-edu-school-life{padding:clamp(34px,6vw,76px);background:var(--tb-color-surface)}.tb-edu-school-life__head{max-width:780px;margin-bottom:28px}.tb-edu-school-life__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.tb-edu-school-life__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,60px)}.tb-edu-school-life__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-school-life__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.tb-edu-school-life__item{position:relative;min-height:300px;overflow:hidden}.tb-edu-school-life__photo{width:100%;height:100%;min-height:300px;object-fit:cover;transition:transform .3s ease}.tb-edu-school-life__item:hover .tb-edu-school-life__photo{transform:scale(1.03)}.tb-edu-school-life__caption{position:absolute;left:16px;bottom:16px;padding:8px 11px;background:var(--tb-color-surface);color:var(--tb-color-text);font-weight:900}@media(max-width:650px){.tb-edu-school-life__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
