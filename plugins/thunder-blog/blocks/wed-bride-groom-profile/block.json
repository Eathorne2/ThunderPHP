{
  "slug": "wed-bride-groom-profile",
  "name": "Bride & Groom Profiles",
  "category": "Wedding",
  "description": "Two large profile panels for the couple",
  "keywords": [
    "wedding",
    "bride",
    "groom",
    "profiles"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-profiles\">{{elements:profiles}}</div>",
  "css": ".tb-wed-profiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));background:var(--tb-color-surface)}.tb-wed-profiles__profile{display:grid;grid-template-columns:1fr 1fr;min-height:440px;border:1px solid var(--tb-color-border)}.tb-wed-profiles__image{width:100%;height:100%;min-height:440px;object-fit:cover}.tb-wed-profiles__copy{padding:32px;display:flex;flex-direction:column;justify-content:center}.tb-wed-profiles__label{color:var(--tb-color-primary);font-size:11px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-profiles__name{margin:9px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:42px;font-weight:400}.tb-wed-profiles__text{margin:0;color:var(--tb-color-muted);line-height:1.7}@media(max-width:900px){.tb-wed-profiles{grid-template-columns:1fr}}@media(max-width:540px){.tb-wed-profiles__profile{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "profiles",
      "label": "Profile",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "image": "https://images.unsplash.com/photo-1591604466107-ec97de577aff?auto=format&fit=crop&w=1400&q=82",
        "alt": "Bride portrait",
        "name": "Amelia",
        "label": "The bride",
        "text": "Lover of old films, fresh flowers and Sunday breakfasts."
      },
      "schema": [
        {
          "key": "image",
          "label": "Photo",
          "type": "image",
          "selector": ".tb-wed-profiles__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        },
        {
          "key": "label",
          "label": "Label",
          "type": "text",
          "selector": ".tb-wed-profiles__label"
        },
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "selector": ".tb-wed-profiles__name"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-wed-profiles__text",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-wed-profiles__profile\"><img class=\"tb-wed-profiles__image\" src=\"{{image}}\" alt=\"{{alt}}\"><div class=\"tb-wed-profiles__copy\"><span class=\"tb-wed-profiles__label\">{{label}}</span><h3 class=\"tb-wed-profiles__name\">{{name}}</h3><p class=\"tb-wed-profiles__text\">{{text}}</p></div></article>",
      "min": 1,
      "max": 4,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "image": "https://images.unsplash.com/photo-1591604466107-ec97de577aff?auto=format&fit=crop&w=1400&q=82",
          "alt": "Bride portrait",
          "name": "Amelia",
          "label": "The bride",
          "text": "Lover of old films, fresh flowers and Sunday breakfasts."
        },
        {
          "image": "https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=1400&q=82",
          "alt": "Groom portrait",
          "name": "Noah",
          "label": "The groom",
          "text": "Collector of records, road trips and very strong coffee."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
