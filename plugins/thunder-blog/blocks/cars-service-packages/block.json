{
  "slug": "cars-service-packages",
  "name": "Vehicle Service Packages",
  "category": "Cars & Transportation",
  "description": "Maintenance package cards for scheduled servicing",
  "keywords": [
    "cars",
    "transportation",
    "pricing",
    "services"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-auto-service-packages\"><header class=\"tb-auto-service-packages__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</header><div class=\"tb-auto-service-packages__list\">{{elements:items}}</div></section>",
  "css": ".tb-auto-service-packages{padding:clamp(34px,6vw,84px);background:var(--tb-color-secondary)}.tb-auto-service-packages__head{max-width:760px;margin-bottom:28px}.tb-auto-service-packages__eyebrow{color:var(--tb-color-primary);font-size:11px;font-weight:950;letter-spacing:.15em;text-transform:uppercase}.tb-auto-service-packages__title{margin:9px 0;color:var(--tb-color-surface);font-size:clamp(40px,5vw,66px)}.tb-auto-service-packages__text{color:color-mix(in srgb,var(--tb-color-surface) 75%,transparent);line-height:1.7}.tb-auto-service-packages__list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tb-auto-service-packages__item{padding:25px;border:1px solid color-mix(in srgb,var(--tb-color-surface) 20%,transparent);background:color-mix(in srgb,var(--tb-color-surface) 7%,transparent)}.tb-auto-service-packages__row{display:flex;justify-content:space-between;gap:14px;align-items:baseline}.tb-auto-service-packages__name{margin:0;color:var(--tb-color-surface);font-size:22px}.tb-auto-service-packages__price{color:var(--tb-color-primary);font-size:22px;font-weight:950}.tb-auto-service-packages__item-text{margin:14px 0 0;color:color-mix(in srgb,var(--tb-color-surface) 70%,transparent);line-height:1.6}@media(max-width:760px){.tb-auto-service-packages__list{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Maintenance plans"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-auto-service-packages__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Service before problems start"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-auto-service-packages__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Compare maintenance packages for different mileage and service requirements."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-auto-service-packages__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Price item",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "name": "Essential",
        "price": "From K350",
        "text": "Clear service package description."
      },
      "schema": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "selector": ".tb-auto-service-packages__name"
        },
        {
          "key": "price",
          "label": "Price",
          "type": "text",
          "selector": ".tb-auto-service-packages__price"
        },
        {
          "key": "text",
          "label": "Description",
          "type": "textarea",
          "selector": ".tb-auto-service-packages__item-text",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-auto-service-packages__item\"><div class=\"tb-auto-service-packages__row\"><h3 class=\"tb-auto-service-packages__name\">{{name}}</h3><span class=\"tb-auto-service-packages__price\">{{price}}</span></div><p class=\"tb-auto-service-packages__item-text\">{{text}}</p></article>",
      "min": 1,
      "max": 12,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "name": "Essential",
          "price": "From K900",
          "text": "Oil, filter, fluid and safety checks."
        },
        {
          "name": "Comprehensive",
          "price": "From K1,650",
          "text": "Essential service plus deeper inspection and diagnostics."
        },
        {
          "name": "Major",
          "price": "From K2,700",
          "text": "Extended maintenance with replacement service items."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
