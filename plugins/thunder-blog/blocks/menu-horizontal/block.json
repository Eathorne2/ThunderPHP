{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "alignment": "center",
      "style": "plain"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "alignment",
        "label": "Alignment",
        "type": "select",
        "options": {
          "left": "Left",
          "center": "Center",
          "right": "Right"
        },
        "default": "center"
      },
      {
        "key": "style",
        "label": "Item style",
        "type": "select",
        "options": {
          "plain": "Plain",
          "boxed": "Boxed",
          "underline": "Underline"
        },
        "default": "plain"
      }
    ]
  },
  "elements": [],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "main",
      "empty": "",
      "container": "<nav class=\"tb-horizontal-menu__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-horizontal-menu__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-horizontal-menu__parent\"><a class=\"tb-horizontal-menu__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}} <span>⌄</span></a><div class=\"tb-horizontal-menu__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-horizontal-menu__nav tb-menu-empty\">Select a menu in block settings</nav>"
    }
  ],
  "html": "<section class=\"tb-block tb-horizontal-menu tb-horizontal-menu--{{alignment}} tb-horizontal-menu--{{style}}\">{{menu:main}}</section>",
  "css": ".tb-horizontal-menu{padding:16px 22px;border:1px solid var(--tb-color-border);border-radius:14px;background:var(--tb-color-surface)}.tb-horizontal-menu__nav{display:flex;gap:7px;flex-wrap:wrap}.tb-horizontal-menu--left .tb-horizontal-menu__nav{justify-content:flex-start}.tb-horizontal-menu--center .tb-horizontal-menu__nav{justify-content:center}.tb-horizontal-menu--right .tb-horizontal-menu__nav{justify-content:flex-end}.tb-horizontal-menu__link{display:block;padding:9px 12px;border-radius:9px;color:var(--tb-color-text);text-decoration:none;font-weight:700}.tb-horizontal-menu--boxed .tb-horizontal-menu__link{background:var(--tb-color-background)}.tb-horizontal-menu--underline .tb-horizontal-menu__link{border-radius:0;border-bottom:2px solid transparent}.tb-horizontal-menu--underline .tb-horizontal-menu__link:hover{border-color:var(--tb-color-primary)}.tb-horizontal-menu__link:hover{color:var(--tb-color-primary)}.tb-horizontal-menu__parent{position:relative}.tb-horizontal-menu__submenu{position:absolute;z-index:15;top:100%;left:0;min-width:190px;padding:7px;border:1px solid var(--tb-color-border);border-radius:11px;background:var(--tb-color-surface);box-shadow:0 16px 40px color-mix(in srgb,var(--tb-color-secondary) 15%,transparent);display:none}.tb-horizontal-menu__parent:hover>.tb-horizontal-menu__submenu,.tb-horizontal-menu__parent:focus-within>.tb-horizontal-menu__submenu{display:grid}.tb-menu-empty{color:var(--tb-color-muted);font-size:13px}",
  "js": "",
  "slug": "menu-horizontal",
  "name": "Horizontal Menu",
  "category": "Menus",
  "description": "A reusable horizontal navigation block sourced from a saved menu.",
  "keywords": [
    "menu",
    "navigation",
    "horizontal",
    "links"
  ],
  "contexts": [
    "post",
    "page",
    "header",
    "footer"
  ],
  "version": "1.0.0"
}
