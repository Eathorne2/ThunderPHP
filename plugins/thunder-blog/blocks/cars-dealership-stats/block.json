{
  "slug": "cars-dealership-stats",
  "name": "Dealership Trust Numbers",
  "category": "Cars & Transportation",
  "description": "Automotive dealership confidence statistics",
  "keywords": [
    "cars",
    "transportation",
    "statistics",
    "numbers"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-auto-dealership-stats\"><header class=\"tb-auto-dealership-stats__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</header><div class=\"tb-auto-dealership-stats__grid\">{{elements:items}}</div></section>",
  "css": ".tb-auto-dealership-stats{padding:clamp(34px,6vw,76px);background:var(--tb-color-background)}.tb-auto-dealership-stats__head{text-align:center;max-width:800px;margin:0 auto 28px}.tb-auto-dealership-stats__eyebrow{color:var(--tb-color-primary);font-size:11px;font-weight:950;letter-spacing:.15em;text-transform:uppercase}.tb-auto-dealership-stats__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(38px,5vw,62px)}.tb-auto-dealership-stats__text{color:var(--tb-color-muted);line-height:1.7}.tb-auto-dealership-stats__grid{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-auto-dealership-stats__stat{padding:28px;text-align:center;border-right:1px solid var(--tb-color-border)}.tb-auto-dealership-stats__value{display:block;color:var(--tb-color-primary);font-size:clamp(34px,5vw,56px);font-weight:950}.tb-auto-dealership-stats__label{display:block;margin-top:8px;color:var(--tb-color-secondary);font-weight:800}@media(max-width:700px){.tb-auto-dealership-stats__grid{grid-template-columns:1fr 1fr}}",
  "js": "",
