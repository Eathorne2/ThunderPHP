  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-pediatric-care\"><div class=\"tb-med-pediatric-care__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-med-pediatric-care__split\">{{elements:image}}<div class=\"tb-med-pediatric-care__grid\">{{elements:items}}</div></div></section>",
  "css": ".tb-med-pediatric-care{padding:clamp(42px,7vw,88px);background:var(--tb-color-background)}.tb-med-pediatric-care__head{max-width:780px;margin-bottom:34px}.tb-med-pediatric-care__eyebrow{display:block;color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.tb-med-pediatric-care__title{font-size:clamp(36px,5vw,60px);line-height:1.05;margin:10px 0 14px;color:var(--tb-color-secondary)}.tb-med-pediatric-care__text{color:var(--tb-color-muted);font-size:17px;line-height:1.7}.tb-med-pediatric-care__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tb-med-pediatric-care__card{padding:26px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border);border-radius:16px}.tb-med-pediatric-care__card__icon{font-size:24px;color:var(--tb-color-primary)}.tb-med-pediatric-care__card__title{font-size:20px;margin:14px 0 8px;color:var(--tb-color-secondary)}.tb-med-pediatric-care__card__text{margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-med-pediatric-care__split{display:grid;grid-template-columns:.85fr 1.15fr;gap:24px;align-items:stretch}.tb-med-pediatric-care__image{width:100%;height:100%;min-height:420px;object-fit:cover;border-radius:18px}@media(max-width:900px){.tb-med-pediatric-care__grid{grid-template-columns:repeat(2,1fr)}.tb-med-pediatric-care__split{grid-template-columns:1fr}}@media(max-width:560px){.tb-med-pediatric-care__grid{grid-template-columns:1fr}}",
