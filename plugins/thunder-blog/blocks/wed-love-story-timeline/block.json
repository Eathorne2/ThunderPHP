{
  "slug": "wed-love-story-timeline",
  "name": "Love Story Timeline",
  "category": "Wedding",
  "description": "Vertical romantic timeline for milestones from first meeting to engagement",
  "keywords": [
    "wedding",
    "timeline",
    "story",
    "engagement"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-timeline\"><div class=\"tb-wed-timeline__head\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-wed-timeline__timeline\">{{elements:events}}</div></div>",
  "css": ".tb-wed-timeline{padding:clamp(32px,6vw,80px);background:var(--tb-color-surface)}.tb-wed-timeline__head{text-align:center;margin-bottom:34px}.tb-wed-timeline__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-timeline__title{margin:9px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,5vw,60px);font-weight:400}.tb-wed-timeline__timeline{max-width:780px;margin:auto;position:relative}.tb-wed-timeline__timeline:before{content:\"\";position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--tb-color-border)}.tb-wed-timeline__event{width:50%;padding:10px 42px 32px 0;text-align:right;box-sizing:border-box;position:relative}.tb-wed-timeline__event:nth-child(even){margin-left:50%;padding:10px 0 32px 42px;text-align:left}.tb-wed-timeline__event:after{content:\"\";position:absolute;right:-5px;top:18px;width:9px;height:9px;border-radius:50%;background:var(--tb-color-primary)}.tb-wed-timeline__event:nth-child(even):after{right:auto;left:-4px}.tb-wed-timeline__date{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.tb-wed-timeline__event-title{margin:7px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:28px;font-weight:400}.tb-wed-timeline__event-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:640px){.tb-wed-timeline__timeline:before{left:5px}.tb-wed-timeline__event,.tb-wed-timeline__event:nth-child(even){width:auto;margin-left:0;padding:8px 0 28px 28px;text-align:left}.tb-wed-timeline__event:after,.tb-wed-timeline__event:nth-child(even):after{left:1px;right:auto}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "How it happened"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-timeline__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "From hello to forever"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-timeline__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "events",
      "label": "Timeline event",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "date": "May 2019",
        "title": "We met",
        "text": "A shared table, a long conversation and no desire to leave."
      },
      "schema": [
        {
          "key": "date",
          "label": "Date",
          "type": "text",
          "selector": ".tb-wed-timeline__date"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-wed-timeline__event-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-wed-timeline__event-text",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-wed-timeline__event\"><span class=\"tb-wed-timeline__date\">{{date}}</span><h3 class=\"tb-wed-timeline__event-title\">{{title}}</h3><p class=\"tb-wed-timeline__event-text\">{{text}}</p></article>",
      "min": 1,
      "max": 10,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "date": "May 2019",
          "title": "We met",
          "text": "A shared table, a long conversation and no desire to leave."
        },
        {
          "date": "August 2022",
          "title": "We moved in",
          "text": "Boxes everywhere, music on, and our first place together."
        },
        {
          "date": "December 2025",
          "title": "We got engaged",
          "text": "A quiet evening became our favorite memory."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
