{
  "slug": "fb-model-portfolio-grid",
  "name": "Model Portfolio Grid",
  "category": "Fashion & Beauty",
  "description": "Clean six-image portfolio grid with an editorial introduction.",
  "keywords": [
    "fashion",
    "model",
    "portfolio",
    "gallery"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-portfolio\"><div class=\"tb-fb-portfolio__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-fb-portfolio__grid\">{{elements:images}}</div></div>",
  "css": ".tb-fb-portfolio{padding:clamp(26px,5vw,64px);background:var(--tb-color-surface)}.tb-fb-portfolio__head{display:grid;grid-template-columns:.7fr 1.3fr;gap:30px;align-items:end;margin-bottom:26px}.tb-fb-portfolio__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-portfolio__title{margin:6px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,6vw,68px);font-weight:500}.tb-fb-portfolio__text{margin:0;color:var(--tb-color-muted);line-height:1.7}.tb-fb-portfolio__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.tb-fb-portfolio__item{margin:0;overflow:hidden}.tb-fb-portfolio__image{width:100%;aspect-ratio:3/4;object-fit:cover;display:block}@media(max-width:760px){.tb-fb-portfolio__head{grid-template-columns:1fr}.tb-fb-portfolio__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:480px){.tb-fb-portfolio__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Selected work"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-portfolio__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
