{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "density": "comfortable",
      "width": "320"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "density",
        "label": "Density",
        "type": "select",
        "options": {
          "compact": "Compact",
          "comfortable": "Comfortable",
          "spacious": "Spacious"
        },
        "default": "comfortable"
      },
      {
        "key": "width",
        "label": "Maximum width",
        "type": "select",
        "options": {
          "260": "260px",
          "320": "320px",
          "420": "420px",
          "full": "Full width"
        },
        "default": "320"
      }
    ]
  },
  "elements": [],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "main",
      "empty": "",
      "container": "<nav class=\"tb-vertical-menu__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-vertical-menu__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\"><span>{{title}}</span><span>→</span></a>",
      "parent": "<div class=\"tb-vertical-menu__group\"><a class=\"tb-vertical-menu__link tb-vertical-menu__link--parent\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\"><span>{{title}}</span><span>⌄</span></a><div class=\"tb-vertical-menu__children\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-vertical-menu__nav tb-menu-empty\">Select a menu in block settings</nav>"
    }
  ],
  "html": "<section class=\"tb-block tb-vertical-menu tb-vertical-menu--{{density}} tb-vertical-menu--width-{{width}}\">{{menu:main}}</section>",
  "css": ".tb-vertical-menu{max-width:320px;padding:12px;border:1px solid var(--tb-color-border);border-radius:16px;background:var(--tb-color-surface)}.tb-vertical-menu--width-260{max-width:260px}.tb-vertical-menu--width-420{max-width:420px}.tb-vertical-menu--width-full{max-width:none}.tb-vertical-menu__nav,.tb-vertical-menu__children{display:grid;gap:5px}.tb-vertical-menu__link{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:11px 13px;border-radius:9px;color:var(--tb-color-text);text-decoration:none;font-weight:700}.tb-vertical-menu--compact .tb-vertical-menu__link{padding:7px 10px;font-size:14px}.tb-vertical-menu--spacious .tb-vertical-menu__link{padding:15px 16px}.tb-vertical-menu__link:hover{background:var(--tb-color-background);color:var(--tb-color-primary)}.tb-vertical-menu__children{margin:4px 0 8px 16px;padding-left:10px;border-left:2px solid var(--tb-color-border)}.tb-vertical-menu__children .tb-vertical-menu__link{font-size:14px;font-weight:600}.tb-menu-empty{color:var(--tb-color-muted);font-size:13px}",
  "js": "",
  "slug": "menu-vertical",
  "name": "Vertical Menu",
  "category": "Menus",
  "description": "A sidebar-friendly vertical menu with visible nested hierarchy.",
  "keywords": [
    "menu",
    "sidebar",
    "vertical",
    "navigation"
  ],
  "contexts": [
    "post",
    "page",
    "header",
    "footer"
  ],
  "version": "1.0.0"
}
