{
  "slug": "edu-certificate-courses",
  "name": "Certificate Courses",
  "category": "Education",
  "description": "Certificate program cards with duration and concise outcomes",
  "keywords": [
    "education",
    "certificate",
    "courses",
    "online"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-certificates\"><div class=\"tb-edu-certificates__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-certificates__grid\">{{elements:cards}}</div></div>",
  "css": ".tb-edu-certificates{padding:clamp(34px,6vw,78px);background:var(--tb-color-background)}.tb-edu-certificates__head{max-width:720px;margin:0 auto 30px;text-align:center}.tb-edu-certificates__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.tb-edu-certificates__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(38px,5vw,58px)}.tb-edu-certificates__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-certificates__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.tb-edu-certificates__card{padding:28px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-edu-certificates__icon{width:48px;height:48px;display:grid;place-items:center;border-radius:12px;background:color-mix(in srgb,var(--tb-color-primary) 12%,var(--tb-color-surface));color:var(--tb-color-primary);font-size:24px;font-weight:900}.tb-edu-certificates__card-title{margin:22px 0 5px;color:var(--tb-color-secondary);font-size:24px}.tb-edu-certificates__meta{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase}.tb-edu-certificates__card-text{color:var(--tb-color-muted);line-height:1.65}@media(max-width:760px){.tb-edu-certificates__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Career credentials"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-certificates__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
