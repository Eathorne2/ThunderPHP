          "selector": ".tb-edu-certificates__card-text",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-edu-certificates__card\"><span class=\"tb-edu-certificates__icon\">{{icon}}</span><h3 class=\"tb-edu-certificates__card-title\">{{title}}</h3><span class=\"tb-edu-certificates__meta\">{{meta}}</span><p class=\"tb-edu-certificates__card-text\">{{text}}</p></article>",
      "min": 1,
      "max": 8,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
