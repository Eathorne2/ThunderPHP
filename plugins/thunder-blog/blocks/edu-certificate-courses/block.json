      "label": "Certificate course",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "icon": "✓",
        "title": "Project Management",
        "meta": "8 weeks",
        "text": "Plan, lead and deliver practical projects with confidence."
      },
      "schema": [
        {
          "key": "icon",
          "label": "Icon text",
          "type": "text",
          "selector": ".tb-edu-certificates__icon"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
