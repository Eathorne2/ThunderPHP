          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<div class=\"tb-arch-sustainable-design-feature__point\">{{text}}</div>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
