{
  "slug": "arch-sustainable-design-feature",
  "name": "Sustainable Architecture Feature",
  "category": "Architecture & Building",
  "description": "Split image and content architecture section",
  "keywords": [
    "sustainable",
    "architecture",
    "feature",
    "split"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-arch-sustainable-design-feature\"><div class=\"tb-arch-sustainable-design-feature__image-wrap\">{{elements:image}}</div><div class=\"tb-arch-sustainable-design-feature__content\">{{elements:kicker}}{{elements:title}}{{elements:text}}<div class=\"tb-arch-sustainable-design-feature__points\">{{elements:points}}</div></div></section>",
  "css": ".tb-arch-sustainable-design-feature{display:grid;grid-template-columns:1fr 1fr;background:var(--tb-color-background);min-height:520px}.tb-arch-sustainable-design-feature__image-wrap{min-height:520px}.tb-arch-sustainable-design-feature__image{width:100%;height:100%;object-fit:cover}.tb-arch-sustainable-design-feature__content{padding:clamp(36px,6vw,78px);display:flex;flex-direction:column;justify-content:center}.tb-arch-sustainable-design-feature__kicker{font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:var(--tb-color-primary)}.tb-arch-sustainable-design-feature__title{margin:12px 0 18px;font-size:clamp(36px,5vw,62px);line-height:1;color:var(--tb-color-secondary)}.tb-arch-sustainable-design-feature__text{font-size:17px;line-height:1.75;color:var(--tb-color-muted)}.tb-arch-sustainable-design-feature__points{display:grid;gap:0;margin-top:24px;border-top:1px solid var(--tb-color-border)}.tb-arch-sustainable-design-feature__point{padding:14px 0;border-bottom:1px solid var(--tb-color-border);font-weight:800;color:var(--tb-color-text)}@media(max-width:780px){.tb-arch-sustainable-design-feature{grid-template-columns:1fr}.tb-arch-sustainable-design-feature__image-wrap{min-height:360px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Feature image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1511818966892-d7d671e672a2?auto=format&fit=crop&w=1600&q=82",
        "alt": "Sustainable Architecture Feature"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-arch-sustainable-design-feature__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-arch-sustainable-design-feature__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "appearance": {
        "color": false,
        "background_color": false,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "kicker",
      "label": "Kicker",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
