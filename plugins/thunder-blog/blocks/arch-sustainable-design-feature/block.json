      "defaults": {
        "text": "Responsible design"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-arch-sustainable-design-feature__kicker\">{{text}}</span>",
