{
  "slug": "cars-rental-fleet",
  "name": "Rental Fleet Cards",
  "category": "Cars & Transportation",
  "description": "Image cards for car rental categories",
  "keywords": [
    "cars",
    "transportation",
    "cards",
    "services"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-auto-rental-fleet\"><header class=\"tb-auto-rental-fleet__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</header><div class=\"tb-auto-rental-fleet__grid\">{{elements:items}}</div></section>",
  "css": ".tb-auto-rental-fleet{padding:clamp(34px,6vw,82px);background:var(--tb-color-background)}.tb-auto-rental-fleet__head{max-width:780px;margin-bottom:30px}.tb-auto-rental-fleet__eyebrow{color:var(--tb-color-primary);font-size:11px;font-weight:950;letter-spacing:.15em;text-transform:uppercase}.tb-auto-rental-fleet__title{margin:9px 0 12px;color:var(--tb-color-secondary);font-size:clamp(38px,5vw,64px);line-height:1.02}.tb-auto-rental-fleet__text{margin:0;color:var(--tb-color-muted);font-size:16px;line-height:1.7}.tb-auto-rental-fleet__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.tb-auto-rental-fleet__card{overflow:hidden;border:1px solid var(--tb-color-border);border-radius:18px;background:var(--tb-color-surface)}.tb-auto-rental-fleet__card-body{padding:22px}.tb-auto-rental-fleet__card-title{margin:0 0 8px;color:var(--tb-color-secondary);font-size:23px}.tb-auto-rental-fleet__card-text{margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-auto-rental-fleet__meta{display:block;margin-top:13px;color:var(--tb-color-primary);font-weight:900}.tb-auto-rental-fleet__image{width:100%;height:230px;object-fit:cover;display:block}@media(max-width:760px){.tb-auto-rental-fleet__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Choose your ride"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-auto-rental-fleet__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A fleet for every kind of trip"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-auto-rental-fleet__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Show rental categories with clear positioning and pricing or capacity notes."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-auto-rental-fleet__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Card",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "title": "Performance model",
        "text": "Designed for confident everyday driving.",
        "meta": "Explore vehicle",
        "url": "https://images.unsplash.com/photo-1515569067071-ec3b51335dd0?auto=format&fit=crop&w=1600&q=82",
        "alt": "Vehicle"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-auto-rental-fleet__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-auto-rental-fleet__card-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-auto-rental-fleet__card-text",
          "rows": 3
        },
        {
          "key": "meta",
          "label": "Meta",
          "type": "text",
          "selector": ".tb-auto-rental-fleet__meta"
        }
      ],
      "template": "<article class=\"tb-auto-rental-fleet__card\"><img class=\"tb-auto-rental-fleet__image\" src=\"{{url}}\" alt=\"{{alt}}\"><div class=\"tb-auto-rental-fleet__card-body\"><h3 class=\"tb-auto-rental-fleet__card-title\">{{title}}</h3><p class=\"tb-auto-rental-fleet__card-text\">{{text}}</p><span class=\"tb-auto-rental-fleet__meta\">{{meta}}</span></div></article>",
      "min": 1,
      "max": 18,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "title": "Economy",
          "text": "Easy on fuel and perfect for city movement.",
          "meta": "From K650/day",
          "url": "https://images.unsplash.com/photo-1515569067071-ec3b51335dd0?auto=format&fit=crop&w=1600&q=82",
          "alt": "Vehicle"
        },
        {
          "title": "SUV",
          "text": "Extra space for families, luggage and longer trips.",
          "meta": "From K1,250/day",
          "url": "https://images.unsplash.com/photo-1515569067071-ec3b51335dd0?auto=format&fit=crop&w=1600&q=82",
          "alt": "Vehicle"
        },
        {
          "title": "Executive",
          "text": "Premium comfort for business and special occasions.",
          "meta": "From K1,800/day",
          "url": "https://images.unsplash.com/photo-1515569067071-ec3b51335dd0?auto=format&fit=crop&w=1600&q=82",
          "alt": "Vehicle"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
