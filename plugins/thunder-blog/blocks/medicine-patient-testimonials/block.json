{
  "slug": "medicine-patient-testimonials",
  "name": "Patient Testimonials",
  "category": "Medicine & Science",
  "description": "Patient experience testimonial cards",
  "keywords": [
    "patients",
    "testimonials",
    "healthcare"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-patient-testimonials\"><div class=\"tb-med-patient-testimonials__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-med-patient-testimonials__grid\">{{elements:items}}</div></section>",
  "css": ".tb-med-patient-testimonials{padding:clamp(42px,7vw,88px);background:var(--tb-color-background)}.tb-med-patient-testimonials__head{max-width:780px;margin-bottom:34px}.tb-med-patient-testimonials__eyebrow{display:block;color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.tb-med-patient-testimonials__title{font-size:clamp(36px,5vw,60px);line-height:1.05;margin:10px 0 14px;color:var(--tb-color-secondary)}.tb-med-patient-testimonials__text{color:var(--tb-color-muted);font-size:17px;line-height:1.7}.tb-med-patient-testimonials__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tb-med-patient-testimonials__card{padding:26px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border);border-radius:16px}.tb-med-patient-testimonials__card__icon{font-size:24px;color:var(--tb-color-primary)}.tb-med-patient-testimonials__card__title{font-size:20px;margin:14px 0 8px;color:var(--tb-color-secondary)}.tb-med-patient-testimonials__card__text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:900px){.tb-med-patient-testimonials__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.tb-med-patient-testimonials__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
