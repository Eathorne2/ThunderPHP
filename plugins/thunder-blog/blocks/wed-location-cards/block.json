{
  "slug": "wed-location-cards",
  "name": "Ceremony & Reception Locations",
  "category": "Wedding",
  "description": "Two visual venue cards for ceremony and reception locations",
  "keywords": [
    "wedding",
    "venue",
    "ceremony",
    "reception"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-locations\"><div class=\"tb-wed-locations__head\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-wed-locations__grid\">{{elements:locations}}</div></div>",
  "css": ".tb-wed-locations{padding:clamp(30px,6vw,76px);background:var(--tb-color-surface)}.tb-wed-locations__head{margin-bottom:24px}.tb-wed-locations__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-locations__title{margin:8px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(40px,5vw,60px);font-weight:400}.tb-wed-locations__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.tb-wed-locations__card{position:relative;min-height:520px;overflow:hidden;text-decoration:none}.tb-wed-locations__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.tb-wed-locations__overlay{position:absolute;inset:0;background:linear-gradient(180deg,transparent 38%,rgba(0,0,0,.72))}.tb-wed-locations__copy{position:absolute;left:24px;right:24px;bottom:24px;color:#fff}.tb-wed-locations__label{font-size:11px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.tb-wed-locations__card-title{margin:6px 0;font-family:Georgia,serif;font-size:34px;font-weight:400}.tb-wed-locations__text{margin:0;opacity:.82}@media(max-width:700px){.tb-wed-locations__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Where to be"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-locations__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Ceremony & reception"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-locations__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "locations",
      "label": "Location",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "image": "https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=1400&q=82",
        "alt": "Ceremony venue",
        "label": "Ceremony",
        "title": "Garden Chapel",
        "text": "2:00 PM · Main lawn",
        "url": "#"
      },
      "schema": [
        {
          "key": "image",
          "label": "Image",
          "type": "image",
          "selector": ".tb-wed-locations__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        },
        {
          "key": "label",
          "label": "Label",
          "type": "text",
          "selector": ".tb-wed-locations__label"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-wed-locations__card-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ".tb-wed-locations__text"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-wed-locations__card\" href=\"{{url}}\"><img class=\"tb-wed-locations__image\" src=\"{{image}}\" alt=\"{{alt}}\"><span class=\"tb-wed-locations__overlay\"></span><div class=\"tb-wed-locations__copy\"><span class=\"tb-wed-locations__label\">{{label}}</span><h3 class=\"tb-wed-locations__card-title\">{{title}}</h3><p class=\"tb-wed-locations__text\">{{text}}</p></div></a>",
      "min": 1,
      "max": 6,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "image": "https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=1400&q=82",
          "alt": "Ceremony venue",
          "label": "Ceremony",
          "title": "Garden Chapel",
          "text": "2:00 PM · Main lawn",
          "url": "#"
        },
        {
          "image": "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=1400&q=82",
          "alt": "Reception venue",
          "label": "Reception",
          "title": "The Grand Hall",
          "text": "6:00 PM · Dinner & dancing",
          "url": "#"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
