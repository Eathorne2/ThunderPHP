{
  "slug": "sports-athlete-profile",
  "name": "Athlete Profile",
  "category": "Sports",
  "description": "Editorial athlete spotlight",
  "keywords": [
    "athlete",
    "profile",
    "bio"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-sport-athlete-profile\"><div class=\"tb-sport-athlete-profile__media\">{{elements:image}}</div><div class=\"tb-sport-athlete-profile__copy\">{{elements:kicker}}{{elements:name}}{{elements:bio}}<div class=\"tb-sport-athlete-profile__facts\">{{elements:facts}}</div></div></section>",
  "css": ".tb-sport-athlete-profile{display:grid;grid-template-columns:.9fr 1.1fr;background:var(--tb-color-surface)}.tb-sport-athlete-profile__media{min-height:620px}.tb-sport-athlete-profile__image{width:100%;height:100%;min-height:620px;object-fit:cover}.tb-sport-athlete-profile__copy{padding:clamp(38px,7vw,88px);display:flex;flex-direction:column;justify-content:center}.tb-sport-athlete-profile__kicker{font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:900;color:var(--tb-color-primary)}.tb-sport-athlete-profile__name{font-size:clamp(48px,7vw,84px);line-height:.95;margin:12px 0 24px}.tb-sport-athlete-profile__bio{font-size:18px;line-height:1.75;color:var(--tb-color-muted)}.tb-sport-athlete-profile__facts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:26px}.tb-sport-athlete-profile__fact{padding:16px;border-top:2px solid var(--tb-color-primary)}.tb-sport-athlete-profile__fact strong{display:block;font-size:24px}.tb-sport-athlete-profile__fact span{font-size:12px;color:var(--tb-color-muted)}@media(max-width:760px){.tb-sport-athlete-profile{grid-template-columns:1fr}.tb-sport-athlete-profile__media,.tb-sport-athlete-profile__image{min-height:420px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Athlete image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1552674605-db6ffd4facb5?auto=format&fit=crop&w=1600&q=82",
        "alt": "Athlete training"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-sport-athlete-profile__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-sport-athlete-profile__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "kicker",
      "label": "Kicker",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Athlete spotlight"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-sport-athlete-profile__kicker\">{{text}}</span>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "name",
      "label": "Athlete name",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Amara Cole"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-sport-athlete-profile__name\">{{text}}</h2>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "bio",
      "label": "Biography",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "A focused competitor whose training balances speed, endurance and patience. Use this profile to tell the story behind performance."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-sport-athlete-profile__bio\">{{text}}</p>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "facts",
      "label": "Facts",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "value": "10K",
        "label": "Best event"
      },
      "schema": [
        {
          "key": "value",
          "label": "Value",
          "type": "text",
          "selector": "strong"
        },
        {
          "key": "label",
          "label": "Label",
          "type": "text",
          "selector": "span"
        }
      ],
      "template": "<div class=\"tb-sport-athlete-profile__fact\"><strong>{{value}}</strong><span>{{label}}</span></div>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 6,
      "default_items": [
        {
          "value": "10K",
          "label": "Best event"
        },
        {
          "value": "34:18",
          "label": "Personal best"
        },
        {
          "value": "6 yrs",
          "label": "Competing"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
