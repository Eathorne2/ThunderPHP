{
  "slug": "fb-beauty-welcome-grid",
  "name": "Beauty Welcome Grid",
  "category": "Fashion & Beauty",
  "description": "A welcoming beauty image with a checkerboard of treatment cards.",
  "keywords": [
    "beauty",
    "salon",
    "spa",
    "services",
    "grid"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-welcome\"><div class=\"tb-fb-welcome__hero\">{{elements:hero}}<div class=\"tb-fb-welcome__intro\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div></div><div class=\"tb-fb-welcome__grid\">{{elements:cards}}</div></div>",
  "css": ".tb-fb-welcome{background:var(--tb-color-background);padding:clamp(24px,5vw,60px)}.tb-fb-welcome__hero{position:relative;min-height:430px;overflow:hidden}.tb-fb-welcome__hero-image{width:100%;height:430px;object-fit:cover;display:block}.tb-fb-welcome__intro{position:absolute;left:clamp(20px,5vw,70px);bottom:clamp(20px,5vw,58px);max-width:440px;padding:24px;background:color-mix(in srgb,var(--tb-color-surface) 92%,transparent);backdrop-filter:blur(7px)}.tb-fb-welcome__eyebrow{display:block;color:var(--tb-color-primary);font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.tb-fb-welcome__title{margin:8px 0 10px;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(34px,5vw,58px);font-weight:500}.tb-fb-welcome__text{margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-fb-welcome__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}.tb-fb-welcome__card{min-width:0;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-fb-welcome__card-image{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}.tb-fb-welcome__card-copy{padding:20px}.tb-fb-welcome__card-title{margin:0 0 8px;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:22px}.tb-fb-welcome__card-text{margin:0;color:var(--tb-color-muted);font-size:14px;line-height:1.6}@media(max-width:850px){.tb-fb-welcome__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.tb-fb-welcome__grid{grid-template-columns:1fr}.tb-fb-welcome__intro{position:relative;left:auto;bottom:auto;max-width:none}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "hero",
      "label": "Hero image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=1400&q=82",
        "alt": "Beauty studio portrait"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-fb-welcome__hero-image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-fb-welcome__hero-image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Welcome to the studio"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-welcome__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
