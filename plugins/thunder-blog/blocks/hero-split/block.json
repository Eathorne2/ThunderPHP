{
  "slug": "hero-split",
  "name": "Split Hero",
  "category": "Hero",
  "description": "A bold two-column opening with heading, copy, action and image.",
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-block--hero-split tb-hero-split--{{image_position}}\">\n  <div class=\"tb-hero-split__content\">{{elements:eyebrow}}{{elements:heading}}{{elements:text}}{{elements:button}}</div>\n  {{elements:image}}\n</div>",
  "css": ".tb-block--hero-split{padding:clamp(24px,5vw,64px);border:1px solid var(--tb-color-border);border-radius:24px;background:linear-gradient(135deg,color-mix(in srgb,var(--tb-color-primary) 10%,var(--tb-color-surface)),var(--tb-color-surface));display:grid;grid-template-columns:minmax(0,1.1fr) minmax(240px,.9fr);align-items:center;gap:clamp(24px,5vw,54px)}.tb-hero-split__content{min-width:0}.tb-hero-split__eyebrow{display:inline-flex;margin-bottom:14px;padding:6px 10px;border-radius:999px;background:color-mix(in srgb,var(--tb-color-primary) 13%,var(--tb-color-surface));color:var(--tb-color-primary);font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.tb-hero-split__title{margin:0;color:var(--tb-color-secondary);font-size:clamp(34px,6vw,66px);line-height:1;letter-spacing:-.045em}.tb-hero-split__text{max-width:640px;margin:18px 0 24px;color:var(--tb-color-muted);font-size:18px;line-height:1.7}.tb-hero-split__button{display:inline-flex;padding:12px 18px;border-radius:10px;background:var(--tb-color-primary);color:#fff;font-weight:800;text-decoration:none}.tb-hero-split__button:hover{background:var(--tb-color-primary-hover)}.tb-hero-split__media{overflow:hidden;border-radius:18px;min-height:320px;background:var(--tb-color-background)}.tb-hero-split__image{width:100%;height:100%;min-height:320px;object-fit:cover}@media(max-width:760px){.tb-block--hero-split{grid-template-columns:1fr}.tb-hero-split__media{min-height:240px}.tb-hero-split__image{min-height:240px}}.tb-hero-split--left .tb-hero-split__content{order:2}.tb-hero-split--left .tb-hero-split__media{order:1}@media(max-width:760px){.tb-hero-split--left .tb-hero-split__content,.tb-hero-split--left .tb-hero-split__media{order:initial}}",
  "js": "",
  "settings": {
    "defaults": {
      "image_position": "right"
    },
    "schema": [
      {
        "key": "image_position",
        "label": "Image position",
        "type": "select",
        "options": {
          "right": "Right",
          "left": "Left"
        },
        "default": "right"
      }
    ]
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Featured story"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-hero-split__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "heading",
      "label": "Heading",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A strong opening for your next story"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-hero-split__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Use this block to introduce the central idea and guide readers into the article."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 4
        }
      ],
      "template": "<p class=\"tb-hero-split__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "button",
      "label": "Button",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Learn more",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Button text",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "Button URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-hero-split__button\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "image",
      "label": "Image",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1400&q=80",
        "alt": "Creative team collaborating around laptops at a table"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-hero-split__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<div class=\"tb-hero-split__media\"><img class=\"tb-hero-split__image\" src=\"{{url}}\" alt=\"{{alt}}\"></div>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
