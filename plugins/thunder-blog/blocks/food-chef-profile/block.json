{
  "slug": "food-chef-profile",
  "name": "Executive Chef Profile",
  "category": "Food & Restaurant",
  "description": "Chef biography layout with portrait, philosophy and signature",
  "keywords": [
    "food",
    "restaurant",
    "chef",
    "profile",
    "team"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-chef-profile\"><div class=\"tb-food-chef-profile__portrait\">{{elements:image}}</div><div class=\"tb-food-chef-profile__copy\">{{elements:eyebrow}}{{elements:name}}{{elements:role}}{{elements:text}}{{elements:signature}}</div></div>",
  "css": ".tb-food-chef-profile{display:grid;grid-template-columns:minmax(300px,.9fr) 1.1fr;gap:clamp(30px,7vw,92px);padding:clamp(34px,6vw,82px);background:var(--tb-color-surface);align-items:center}.tb-food-chef-profile__image{width:100%;aspect-ratio:4/5;object-fit:cover;display:block}.tb-food-chef-profile__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;text-transform:uppercase;letter-spacing:.16em}.tb-food-chef-profile__name{margin:10px 0 4px;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(44px,6vw,72px)}.tb-food-chef-profile__role{color:var(--tb-color-primary);font-weight:850}.tb-food-chef-profile__text{margin-top:22px;color:var(--tb-color-muted);line-height:1.8;max-width:650px}.tb-food-chef-profile__signature{display:block;margin-top:28px;color:var(--tb-color-secondary);font-family:cursive;font-size:28px}@media(max-width:700px){.tb-food-chef-profile{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Chef portrait",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1577219491135-ce391730fb2c?auto=format&fit=crop&w=1400&q=82",
        "alt": "Executive chef portrait"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-food-chef-profile__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-food-chef-profile__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Meet the chef"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-chef-profile__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "name",
      "label": "Chef name",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Chef Maya Ndlovu"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h2 class=\"tb-food-chef-profile__name\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "role",
      "label": "Role",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Executive Chef"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-chef-profile__role\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Biography",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A seasonal approach, strong local sourcing and years spent learning from kitchens across the region shape every menu."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-food-chef-profile__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "signature",
      "label": "Signature line",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Maya"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-chef-profile__signature\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
