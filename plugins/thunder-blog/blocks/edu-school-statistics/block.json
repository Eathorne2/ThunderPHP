{
  "slug": "edu-school-statistics",
  "name": "Education Statistics",
  "category": "Education",
  "description": "Bold statistic strip for school, university or training outcomes",
  "keywords": [
    "education",
    "statistics",
    "numbers",
    "school"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-stats\"><div class=\"tb-edu-stats__intro\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-edu-stats__grid\">{{elements:stats}}</div></div>",
  "css": ".tb-edu-stats{padding:clamp(28px,5vw,60px);background:var(--tb-color-primary);color:#fff}.tb-edu-stats__intro{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:26px}.tb-edu-stats__eyebrow{font-size:12px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.tb-edu-stats__title{max-width:650px;margin:0;color:inherit;font-size:clamp(34px,5vw,56px)}.tb-edu-stats__grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.35)}.tb-edu-stats__stat{padding:24px 20px;border-right:1px solid rgba(255,255,255,.35)}.tb-edu-stats__stat:last-child{border-right:0}.tb-edu-stats__value{display:block;font-size:clamp(34px,5vw,58px);font-weight:950}.tb-edu-stats__label{display:block;margin-top:6px;opacity:.82}@media(max-width:760px){.tb-edu-stats__intro{align-items:flex-start;flex-direction:column}.tb-edu-stats__grid{grid-template-columns:repeat(2,1fr)}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "In numbers"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-stats__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A learning community with measurable momentum"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-edu-stats__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "stats",
      "label": "Statistic",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "value": "2,400+",
        "label": "Active learners"
      },
      "schema": [
        {
          "key": "value",
          "label": "Value",
          "type": "text",
          "selector": ".tb-edu-stats__value"
        },
        {
          "key": "label",
          "label": "Label",
          "type": "text",
          "selector": ".tb-edu-stats__label"
        }
      ],
      "template": "<div class=\"tb-edu-stats__stat\"><strong class=\"tb-edu-stats__value\">{{value}}</strong><span class=\"tb-edu-stats__label\">{{label}}</span></div>",
      "min": 1,
      "max": 8,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "value": "2,400+",
          "label": "Active learners"
        },
        {
          "value": "35",
          "label": "Programs"
        },
        {
          "value": "18",
          "label": "Countries represented"
        },
        {
          "value": "92%",
          "label": "Completion rate"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
