{
  "settings": {
    "defaults": {
      "width": "1200",
      "gap": "20"
    },
    "schema": [
      {
        "key": "width",
        "label": "Maximum width",
        "type": "select",
        "options": {
          "1000": "Compact",
          "1200": "Standard",
          "1440": "Wide"
        },
        "default": "1200"
      },
      {
        "key": "gap",
        "label": "Gap",
        "type": "range",
        "min": 0,
        "max": 64,
        "default": 20
      }
    ]
  },
  "elements": [
    {
      "key": "columns",
      "label": "Dynamic column",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "heading": "Column",
        "shortcode": "[thunder-blog.posts layout=\"small\" order=\"latest\" limit=\"4\"]"
      },
      "default_items": [
        {
          "heading": "Latest",
          "shortcode": "[thunder-blog.posts layout=\"small\" order=\"latest\" limit=\"4\"]"
        },
        {
          "heading": "Popular",
          "shortcode": "[thunder-blog.posts layout=\"small\" order=\"popular\" limit=\"4\"]"
        },
        {
          "heading": "Featured",
          "shortcode": "[thunder-blog.posts layout=\"small\" order=\"featured\" limit=\"4\"]"
        }
      ],
      "schema": [
        {
          "key": "heading",
          "label": "Heading",
          "type": "text",
          "selector": ".tb-page-columns__heading"
        },
        {
          "key": "shortcode",
          "label": "Shortcode",
          "type": "shortcode",
          "rows": 4
        }
      ],
      "template": "<section class=\"tb-page-columns__column\"><h2 class=\"tb-page-columns__heading\">{{heading}}</h2><div class=\"tb-page-columns__dynamic\">{{shortcode}}</div></section>",
      "min": 1,
      "max": 6,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "background_color": "surface"
        }
      }
    }
  ],
  "html": "<div class=\"tb-block tb-page-columns\" style=\"--tb-page-width:{{width}}px;--tb-page-gap:{{gap}}px\">{{elements:columns}}</div>",
  "css": ".tb-page-columns{max-width:var(--tb-page-width);margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--tb-page-gap)}.tb-page-columns__column{padding:20px;border:1px solid var(--tb-color-border);border-radius:16px;background:var(--tb-color-surface)}.tb-page-columns__heading{margin:0 0 16px;color:var(--tb-color-secondary);font-size:20px}@media(max-width:900px){.tb-page-columns{grid-template-columns:1fr}}",
  "js": "",
  "slug": "page-three-column-layout",
  "name": "Page: Three Dynamic Columns",
  "category": "Page Layouts",
  "description": "Three responsive repeatable columns intended for shortcodes and plugin output.",
  "keywords": [
    "page",
    "layout",
    "columns",
    "shortcode"
  ],
  "contexts": [
    "page"
  ],
  "version": "1.0.0"
}
