{
  "slug": "food-pizza-menu",
  "name": "Pizza Menu Cards",
  "category": "Food & Restaurant",
  "description": "Bold pizzeria section with large pizza image and menu cards",
  "keywords": [
    "food",
    "restaurant",
    "pizza",
    "pizzeria",
    "menu"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-pizza\"><div class=\"tb-food-pizza__visual\">{{elements:image}}</div><div class=\"tb-food-pizza__body\">{{elements:eyebrow}}{{elements:title}}<div class=\"tb-food-pizza__items\">{{elements:items}}</div>{{elements:cta}}</div></div>",
  "css": ".tb-food-pizza{display:grid;grid-template-columns:minmax(320px,.9fr) 1.1fr;background:var(--tb-color-secondary);color:var(--tb-color-surface)}.tb-food-pizza__visual{min-height:620px}.tb-food-pizza__image{width:100%;height:100%;object-fit:cover;display:block}.tb-food-pizza__body{padding:clamp(34px,6vw,80px)}.tb-food-pizza__eyebrow{color:var(--tb-color-primary);font-weight:950;text-transform:uppercase;letter-spacing:.16em;font-size:12px}.tb-food-pizza__title{margin:8px 0 26px;color:inherit;font-size:clamp(46px,7vw,82px);line-height:.9}.tb-food-pizza__items{display:grid;gap:12px}.tb-food-pizza__item{padding:18px;border:1px solid color-mix(in srgb,var(--tb-color-surface) 35%,transparent);display:grid;grid-template-columns:1fr auto;gap:6px 15px}.tb-food-pizza__item h3{margin:0;color:inherit;font-size:22px}.tb-food-pizza__item p{margin:0;color:color-mix(in srgb,var(--tb-color-surface) 70%,transparent)}.tb-food-pizza__price{grid-row:1/3;grid-column:2;font-weight:950;color:var(--tb-color-primary)}.tb-food-pizza__cta{display:inline-flex;margin-top:24px;padding:13px 20px;background:var(--tb-color-primary);color:var(--tb-color-surface);text-decoration:none;font-weight:900}@media(max-width:760px){.tb-food-pizza{grid-template-columns:1fr}.tb-food-pizza__visual{min-height:360px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Pizza image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1579751626657-72bc17010498?auto=format&fit=crop&w=1400&q=82",
        "alt": "Fresh wood-fired pizza"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-food-pizza__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-food-pizza__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Wood-fired daily"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-pizza__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Pizza, done right"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-food-pizza__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Pizza",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "name": "Margherita",
        "text": "Tomato · mozzarella · basil",
        "price": "K140"
      },
      "schema": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "selector": ".tb-food-pizza__item h3"
        },
        {
          "key": "text",
          "label": "Toppings",
          "type": "text",
          "selector": ".tb-food-pizza__item p"
        },
        {
          "key": "price",
          "label": "Price",
          "type": "text",
          "selector": ".tb-food-pizza__price"
        }
      ],
      "template": "<article class=\"tb-food-pizza__item\"><h3>{{name}}</h3><p>{{text}}</p><strong class=\"tb-food-pizza__price\">{{price}}</strong></article>",
      "min": 1,
      "max": 12,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "name": "Margherita",
          "text": "Tomato · mozzarella · basil",
          "price": "K140"
        },
        {
          "name": "Garden Verde",
          "text": "Zucchini · peppers · olives",
          "price": "K165"
        },
        {
          "name": "Hot Honey",
          "text": "Pepperoni · chilli · honey",
          "price": "K185"
        }
      ]
    },
    {
      "key": "cta",
      "label": "Order button",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Order pizza",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-food-pizza__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
