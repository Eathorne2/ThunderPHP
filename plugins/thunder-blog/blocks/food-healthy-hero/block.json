{
  "slug": "food-healthy-hero",
  "name": "Healthy Food Hero",
  "category": "Food & Restaurant",
  "description": "Fresh health-focused food hero with image, benefits and action",
  "keywords": [
    "food",
    "restaurant",
    "healthy",
    "nutrition",
    "organic"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-healthy\"><div class=\"tb-food-healthy__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:benefits}}{{elements:cta}}</div><div class=\"tb-food-healthy__visual\">{{elements:image}}</div></div>",
  "css": ".tb-food-healthy{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,6vw,76px);align-items:center;padding:clamp(34px,6vw,78px);background:color-mix(in srgb,var(--tb-color-primary) 7%,var(--tb-color-surface))}.tb-food-healthy__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.tb-food-healthy__title{margin:10px 0;color:var(--tb-color-secondary);font-size:clamp(48px,7vw,82px);line-height:.95}.tb-food-healthy__text{color:var(--tb-color-muted);font-size:17px;line-height:1.75}.tb-food-healthy__benefit{display:inline-flex;margin:8px 8px 0 0;padding:8px 11px;border:1px solid var(--tb-color-border);background:var(--tb-color-background);color:var(--tb-color-secondary);font-weight:800;font-size:13px}.tb-food-healthy__cta{display:inline-flex;margin-top:24px;padding:13px 20px;background:var(--tb-color-primary);color:var(--tb-color-surface);font-weight:900;text-decoration:none}.tb-food-healthy__image{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:50% 50% 8% 50%;display:block}@media(max-width:720px){.tb-food-healthy{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
