{
  "slug": "divider-space",
  "name": "Divider and Space",
  "category": "Layout",
  "description": "A configurable divider for separating article sections.",
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-block--divider-space\"><span class=\"tb-divider-space__line\"></span></div>",
  "css": ".tb-block--divider-space{padding:{{space}}px 0}.tb-divider-space__line{height:{{thickness}}px;display:block;background:var(--tb-color-border)}",
  "js": "",
  "settings": {
    "defaults": {
      "space": 34,
      "thickness": 1
    },
    "schema": [
      {
        "key": "space",
        "label": "Vertical space",
        "type": "range",
        "min": 8,
        "max": 100,
        "step": 2,
        "default": 34
      },
      {
        "key": "thickness",
        "label": "Line thickness",
        "type": "range",
        "min": 1,
        "max": 8,
        "step": 1,
        "default": 1
      }
    ]
  },
  "elements": [],
  "contexts": [
    "post",
    "page"
  ]
}
