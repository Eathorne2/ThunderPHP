{
  "slug": "fb-style-tips",
  "name": "Numbered Style Tips",
  "category": "Fashion & Beauty",
  "description": "Editorial numbered style advice with a clean magazine rhythm.",
  "keywords": [
    "fashion",
    "tips",
    "stylist",
    "numbered"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-style-tips\"><div class=\"tb-fb-style-tips__intro\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-fb-style-tips__list\">{{elements:tips}}</div></div>",
  "css": ".tb-fb-style-tips{display:grid;grid-template-columns:minmax(260px,.7fr) minmax(0,1.3fr);gap:clamp(30px,7vw,100px);padding:clamp(30px,6vw,80px);background:var(--tb-color-surface)}.tb-fb-style-tips__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-style-tips__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,5vw,62px);font-weight:500}.tb-fb-style-tips__text{color:var(--tb-color-muted);line-height:1.7}.tb-fb-style-tips__list{counter-reset:tips}.tb-fb-style-tips__tip{counter-increment:tips;display:grid;grid-template-columns:72px 1fr;gap:18px;padding:22px 0;border-top:1px solid var(--tb-color-border)}.tb-fb-style-tips__tip:before{content:counter(tips,decimal-leading-zero);color:var(--tb-color-primary);font-family:Georgia,serif;font-size:28px}.tb-fb-style-tips__tip-title{margin:0;color:var(--tb-color-secondary);font-size:20px}.tb-fb-style-tips__tip-text{margin:6px 0 0;color:var(--tb-color-muted);line-height:1.6}@media(max-width:760px){.tb-fb-style-tips{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
