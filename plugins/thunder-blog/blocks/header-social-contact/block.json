{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "logo": "{{app_logo}}",
        "url": "{{root}}/"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-h-social-contact__brand-name"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-h-social-contact__logo"
        },
        {
          "key": "url",
          "label": "Home URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-social-contact__brand\" href=\"{{url}}\"><img class=\"tb-h-social-contact__logo\" src=\"{{logo}}\" alt=\"\"><span class=\"tb-h-social-contact__brand-name\">{{name}}</span></a>",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "secondary"
        }
      }
    },
    {
      "key": "contact",
      "label": "Contact link",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "hello@example.com",
        "url": "mailto:hello@example.com"
      },
      "schema": [
        {
          "key": "text",
          "label": "Contact text",
          "type": "text",
          "selector": ".tb-h-social-contact__contact"
        },
        {
          "key": "url",
          "label": "Contact URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-social-contact__contact\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "text"
        }
      }
    },
    {
      "key": "social",
      "label": "Social links",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Instagram",
        "url": "#"
      },
      "default_items": [
        {
          "text": "Instagram",
          "url": "#"
        },
        {
          "text": "LinkedIn",
          "url": "#"
        },
        {
          "text": "YouTube",
          "url": "#"
        }
      ],
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ".tb-h-social-contact__social-link"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-social-contact__social-link\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 8,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-h-social-contact__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-h-social-contact__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-h-social-contact__parent\"><a class=\"tb-h-social-contact__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-h-social-contact__chevron\">⌄</span></a><div class=\"tb-h-social-contact__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-h-social-contact__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<header class=\"tb-block tb-h-social-contact\"><div class=\"tb-h-social-contact__top\"><div class=\"tb-h-social-contact__inner\" style=\"--tb-h-social-contact-width:{{width}}px\"><div class=\"tb-h-social-contact__socials\">{{elements:social}}</div>{{elements:contact}}</div></div><div class=\"tb-h-social-contact__inner\" style=\"--tb-h-social-contact-width:{{width}}px\"><div class=\"tb-h-social-contact__row\">{{elements:brand}}{{menu:primary}}</div></div></header>",
  "css": ".tb-h-social-contact{position:relative;background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-h-social-contact__inner{max-width:var(--tb-h-social-contact-width);margin:auto;padding:0 24px}.tb-h-social-contact__brand{display:flex;align-items:center;gap:10px;color:var(--tb-color-secondary);text-decoration:none;font-weight:900}.tb-h-social-contact__logo{width:38px;height:38px;object-fit:contain}.tb-h-social-contact__brand-name{letter-spacing:-.025em}.tb-h-social-contact__nav{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.tb-h-social-contact__link{display:inline-flex;align-items:center;gap:5px;padding:9px 11px;color:inherit;text-decoration:none;font-weight:750}.tb-h-social-contact__link:hover{color:var(--tb-color-primary)}.tb-h-social-contact__parent{position:relative}.tb-h-social-contact__submenu{position:absolute;z-index:20;top:100%;left:0;min-width:190px;padding:8px;border:1px solid var(--tb-color-border);border-radius:12px;background:var(--tb-color-surface);display:none;box-shadow:0 16px 38px color-mix(in srgb,var(--tb-color-secondary) 14%,transparent)}.tb-h-social-contact__submenu .tb-h-social-contact__link{display:flex}.tb-h-social-contact__parent:hover>.tb-h-social-contact__submenu,.tb-h-social-contact__parent:focus-within>.tb-h-social-contact__submenu{display:grid}.tb-h-social-contact__chevron{font-size:10px;opacity:.65}.tb-h-social-contact__top{background:var(--tb-color-background);border-bottom:1px solid var(--tb-color-border)}.tb-h-social-contact__top .tb-h-social-contact__inner{min-height:36px;display:flex;align-items:center;justify-content:space-between;gap:18px}.tb-h-social-contact__socials{display:flex;gap:13px}.tb-h-social-contact__social-link,.tb-h-social-contact__contact{color:var(--tb-color-muted);text-decoration:none;font-size:11px;font-weight:750}.tb-h-social-contact__row{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:22px}@media(max-width:820px){.tb-h-social-contact__row,.tb-h-social-contact__top,.tb-h-social-contact__glass,.tb-h-social-contact__frame,.tb-h-social-contact__pill{flex-wrap:wrap;height:auto;padding-top:14px;padding-bottom:14px}.tb-h-social-contact__nav{width:100%;order:5}.tb-h-social-contact__submenu{position:static;box-shadow:none}}@media(max-width:560px){.tb-h-social-contact__inner{padding-left:16px;padding-right:16px}.tb-h-social-contact__row{grid-template-columns:1fr!important}.tb-h-social-contact__search{width:100%!important}}",
  "js": "",
  "slug": "header-social-contact",
  "name": "Social Contact Header",
  "category": "Headers",
  "description": "A social/contact utility row above a classic brand and navigation row.",
  "keywords": [
    "header",
    "navigation",
    "menu",
    "social"
  ],
  "contexts": [
    "header"
  ],
  "version": "1.0.0"
}
