{
  "slug": "edu-creative-crafts",
  "name": "Creative Learning Activities",
  "category": "Education",
  "description": "Playful creative-learning image cards for children and workshops",
  "keywords": [
    "education",
    "creative",
    "kids",
    "activities"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-crafts\"><div class=\"tb-edu-crafts__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-crafts__grid\">{{elements:items}}</div></div>",
  "css": ".tb-edu-crafts{padding:clamp(34px,6vw,78px);background:var(--tb-color-surface)}.tb-edu-crafts__head{max-width:760px;margin-bottom:28px}.tb-edu-crafts__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-crafts__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,60px)}.tb-edu-crafts__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-crafts__grid{display:grid;grid-template-columns:1.2fr .9fr .9fr;gap:12px}.tb-edu-crafts__item{position:relative;min-height:390px;overflow:hidden;border-radius:24px}.tb-edu-crafts__image{width:100%;height:100%;min-height:390px;object-fit:cover}.tb-edu-crafts__title-card{position:absolute;left:16px;bottom:16px;margin:0;padding:10px 13px;border-radius:999px;background:var(--tb-color-surface);color:var(--tb-color-text);font-size:16px}@media(max-width:760px){.tb-edu-crafts__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
