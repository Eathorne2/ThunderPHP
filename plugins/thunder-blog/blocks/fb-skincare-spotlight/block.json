{
  "slug": "fb-skincare-spotlight",
  "name": "Skincare Spotlight",
  "category": "Fashion & Beauty",
  "description": "Soft skincare feature with product/lifestyle image and benefit list.",
  "keywords": [
    "beauty",
    "skincare",
    "product",
    "benefits"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-skincare\"><div class=\"tb-fb-skincare__visual\">{{elements:image}}<div class=\"tb-fb-skincare__badge\">Daily ritual</div></div><div class=\"tb-fb-skincare__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-fb-skincare__benefits\">{{elements:benefits}}</div>{{elements:cta}}</div></div>",
  "css": ".tb-fb-skincare{display:grid;grid-template-columns:minmax(300px,1fr) minmax(0,1fr);gap:clamp(30px,6vw,82px);align-items:center;padding:clamp(30px,6vw,76px);background:color-mix(in srgb,var(--tb-color-primary) 7%,var(--tb-color-surface))}.tb-fb-skincare__visual{position:relative}.tb-fb-skincare__image{width:100%;aspect-ratio:4/5;object-fit:cover;display:block}.tb-fb-skincare__badge{position:absolute;right:-14px;bottom:26px;padding:10px 14px;background:var(--tb-color-secondary);color:var(--tb-color-surface);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.12em}.tb-fb-skincare__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-skincare__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(40px,6vw,68px);font-weight:500;line-height:1}.tb-fb-skincare__text{color:var(--tb-color-muted);line-height:1.75}.tb-fb-skincare__benefits{display:grid;gap:10px;margin:24px 0}.tb-fb-skincare__benefit{padding:13px 0;border-bottom:1px solid var(--tb-color-border);color:var(--tb-color-text);font-weight:700}.tb-fb-skincare__cta{display:inline-flex;padding:12px 18px;background:var(--tb-color-primary);color:#fff;text-decoration:none;font-weight:800}@media(max-width:760px){.tb-fb-skincare{grid-template-columns:1fr}.tb-fb-skincare__badge{right:10px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Skincare image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1612817288484-6f916006741a?auto=format&fit=crop&w=1400&q=82",
        "alt": "Skincare ritual and product"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-fb-skincare__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-fb-skincare__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Skincare spotlight"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-skincare__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Quiet luxury for your skin"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-fb-skincare__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Pair a hero product or treatment with clear benefits and a gentle editorial tone."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-fb-skincare__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "benefits",
      "label": "Benefit",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Hydration that lasts"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
