{
  "slug": "sports-training-program-cards",
  "name": "Training Programs",
  "category": "Sports",
  "description": "Service cards for sports and fitness programs",
  "keywords": [
    "training",
    "programs",
    "cards"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-sport-training-program-cards\"><div class=\"tb-sport-training-program-cards__head\">{{elements:kicker}}{{elements:heading}}</div><div class=\"tb-sport-training-program-cards__grid\">{{elements:cards}}</div></section>",
  "css": ".tb-sport-training-program-cards{padding:clamp(40px,7vw,86px);background:var(--tb-color-background)}.tb-sport-training-program-cards__head{max-width:760px;margin-bottom:34px}.tb-sport-training-program-cards__kicker{font-size:12px;font-weight:900;letter-spacing:.15em;text-transform:uppercase;color:var(--tb-color-primary)}.tb-sport-training-program-cards__heading{font-size:clamp(34px,5vw,58px);line-height:1.05;margin:10px 0;color:var(--tb-color-secondary)}.tb-sport-training-program-cards__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tb-sport-training-program-cards__card{background:var(--tb-color-surface);border:1px solid var(--tb-color-border);overflow:hidden;border-radius:18px}.tb-sport-training-program-cards__card-image{width:100%;height:220px;object-fit:cover}.tb-sport-training-program-cards__card-body{padding:22px}.tb-sport-training-program-cards__card-title{font-size:22px;margin:0 0 10px;color:var(--tb-color-secondary)}.tb-sport-training-program-cards__card-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:860px){.tb-sport-training-program-cards__grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.tb-sport-training-program-cards__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "kicker",
      "label": "Kicker",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Programs"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-sport-training-program-cards__kicker\">{{text}}</span>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "heading",
      "label": "Heading",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Choose your training track"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-sport-training-program-cards__heading\">{{text}}</h2>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "cards",
      "label": "Cards",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "title": "Strength & Power",
        "text": "Progressive sessions for strength, speed and athletic output."
      },
      "schema": [
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-sport-training-program-cards__card-title"
        },
        {
          "key": "text",
          "label": "Description",
          "type": "textarea",
          "selector": ".tb-sport-training-program-cards__card-text",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-sport-training-program-cards__card\"><div class=\"tb-sport-training-program-cards__card-body\"><h3 class=\"tb-sport-training-program-cards__card-title\">{{title}}</h3><p class=\"tb-sport-training-program-cards__card-text\">{{text}}</p></div></article>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 12,
      "default_items": [
        {
          "title": "Strength & Power",
          "text": "Progressive sessions for strength, speed and athletic output."
        },
        {
          "title": "Endurance",
          "text": "Structured aerobic work for races, seasons and long-term fitness."
        },
        {
          "title": "Mobility",
          "text": "Restore range, control and confidence in movement."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
