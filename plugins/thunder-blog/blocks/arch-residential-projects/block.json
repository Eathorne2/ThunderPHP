{
  "slug": "arch-residential-projects",
  "name": "Residential Projects",
  "category": "Architecture & Building",
  "description": "Responsive architecture/building card section",
  "keywords": [
    "residential",
    "projects",
    "cards"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-arch-residential-projects\"><div class=\"tb-arch-residential-projects__head\">{{elements:kicker}}{{elements:title}}{{elements:intro}}</div><div class=\"tb-arch-residential-projects__grid\">{{elements:cards}}</div></section>",
  "css": ".tb-arch-residential-projects{padding:clamp(40px,7vw,86px);background:var(--tb-color-background)}.tb-arch-residential-projects__head{max-width:760px;margin-bottom:36px}.tb-arch-residential-projects__kicker{font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:var(--tb-color-primary)}.tb-arch-residential-projects__title{font-size:clamp(38px,5vw,64px);line-height:1;margin:12px 0;color:var(--tb-color-secondary)}.tb-arch-residential-projects__intro{font-size:17px;line-height:1.7;color:var(--tb-color-muted)}.tb-arch-residential-projects__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tb-arch-residential-projects__card{border:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-arch-residential-projects__card-image{width:100%;height:240px;object-fit:cover}.tb-arch-residential-projects__card-body{padding:22px}.tb-arch-residential-projects__card-title{font-size:23px;margin:0 0 10px;color:var(--tb-color-secondary)}.tb-arch-residential-projects__card-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:860px){.tb-arch-residential-projects__grid{grid-template-columns:1fr 1fr}}@media(max-width:580px){.tb-arch-residential-projects__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "kicker",
      "label": "Kicker",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Selected homes"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-arch-residential-projects__kicker\">{{text}}</span>",
