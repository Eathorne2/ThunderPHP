{
  "slug": "fb-fashion-category-trio",
  "name": "Fashion Category Trio",
  "category": "Fashion & Beauty",
  "description": "Three tall visual category cards for a boutique or fashion landing page.",
  "keywords": [
    "fashion",
    "categories",
    "shop",
    "boutique"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-category-trio\"><div class=\"tb-fb-category-trio__head\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-fb-category-trio__grid\">{{elements:categories}}</div></div>",
  "css": ".tb-fb-category-trio{padding:clamp(28px,5vw,68px);background:var(--tb-color-surface)}.tb-fb-category-trio__head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:28px}.tb-fb-category-trio__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.tb-fb-category-trio__title{margin:6px 0 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(34px,5vw,58px);font-weight:500}.tb-fb-category-trio__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tb-fb-category-trio__card{position:relative;min-height:480px;overflow:hidden;text-decoration:none;background:var(--tb-color-background)}.tb-fb-category-trio__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.tb-fb-category-trio__shade{position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(0,0,0,.7))}.tb-fb-category-trio__label{position:absolute;left:22px;bottom:22px;color:#fff;font-family:Georgia,serif;font-size:30px}.tb-fb-category-trio__card:hover .tb-fb-category-trio__image{transform:scale(1.035)}@media(max-width:760px){.tb-fb-category-trio__grid{grid-template-columns:1fr}.tb-fb-category-trio__card{min-height:400px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Shop by mood"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-category-trio__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Build your own edit"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-fb-category-trio__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "categories",
      "label": "Category",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "image": "https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1400&q=82",
        "alt": "Editorial dress",
        "title": "Dresses",
        "url": "#"
      },
      "schema": [
        {
          "key": "image",
          "label": "Image",
          "type": "image",
          "selector": ".tb-fb-category-trio__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-fb-category-trio__label"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-fb-category-trio__card\" href=\"{{url}}\"><img class=\"tb-fb-category-trio__image\" src=\"{{image}}\" alt=\"{{alt}}\"><span class=\"tb-fb-category-trio__shade\"></span><span class=\"tb-fb-category-trio__label\">{{title}}</span></a>",
      "min": 1,
      "max": 6,
      "default_items": [
        {
          "image": "https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1400&q=82",
          "alt": "Editorial dress",
          "title": "Dresses",
          "url": "#"
        },
        {
          "image": "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=1400&q=82",
          "alt": "Jewelry accessory",
          "title": "Accessories",
          "url": "#"
        },
        {
          "image": "https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1400&q=82",
          "alt": "Clothing collection",
          "title": "Essentials",
          "url": "#"
        }
      ],
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
