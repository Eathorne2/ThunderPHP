{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "logo": "{{app_logo}}",
        "url": "{{root}}/"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-h-menu-logo-cta__brand-name"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-h-menu-logo-cta__logo"
        },
        {
          "key": "url",
          "label": "Home URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-menu-logo-cta__brand\" href=\"{{url}}\"><img class=\"tb-h-menu-logo-cta__logo\" src=\"{{logo}}\" alt=\"\"><span class=\"tb-h-menu-logo-cta__brand-name\">{{name}}</span></a>",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "secondary"
        }
      }
    },
    {
      "key": "cta",
      "label": "Call to action",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Get started",
        "url": "{{root}}/contact"
      },
      "schema": [
        {
          "key": "text",
          "label": "Button text",
          "type": "text",
          "selector": ".tb-h-menu-logo-cta__cta"
        },
        {
          "key": "url",
          "label": "Button URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-menu-logo-cta__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "background",
          "background_color": "primary"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-h-menu-logo-cta__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-h-menu-logo-cta__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-h-menu-logo-cta__parent\"><a class=\"tb-h-menu-logo-cta__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-h-menu-logo-cta__chevron\">⌄</span></a><div class=\"tb-h-menu-logo-cta__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-h-menu-logo-cta__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<header class=\"tb-block tb-h-menu-logo-cta\"><div class=\"tb-h-menu-logo-cta__inner\" style=\"--tb-h-menu-logo-cta-width:{{width}}px\"><div class=\"tb-h-menu-logo-cta__row\"><div class=\"tb-h-menu-logo-cta__left\">{{menu:primary}}</div><div class=\"tb-h-menu-logo-cta__center\">{{elements:brand}}</div><div class=\"tb-h-menu-logo-cta__right\">{{elements:cta}}</div></div></div></header>",
  "css": ".tb-h-menu-logo-cta{position:relative;background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-h-menu-logo-cta__inner{max-width:var(--tb-h-menu-logo-cta-width);margin:auto;padding:0 24px}.tb-h-menu-logo-cta__brand{display:flex;align-items:center;gap:10px;color:var(--tb-color-secondary);text-decoration:none;font-weight:900}.tb-h-menu-logo-cta__logo{width:38px;height:38px;object-fit:contain}.tb-h-menu-logo-cta__brand-name{letter-spacing:-.025em}.tb-h-menu-logo-cta__nav{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.tb-h-menu-logo-cta__link{display:inline-flex;align-items:center;gap:5px;padding:9px 11px;color:inherit;text-decoration:none;font-weight:750}.tb-h-menu-logo-cta__link:hover{color:var(--tb-color-primary)}.tb-h-menu-logo-cta__parent{position:relative}.tb-h-menu-logo-cta__submenu{position:absolute;z-index:20;top:100%;left:0;min-width:190px;padding:8px;border:1px solid var(--tb-color-border);border-radius:12px;background:var(--tb-color-surface);display:none;box-shadow:0 16px 38px color-mix(in srgb,var(--tb-color-secondary) 14%,transparent)}.tb-h-menu-logo-cta__submenu .tb-h-menu-logo-cta__link{display:flex}.tb-h-menu-logo-cta__parent:hover>.tb-h-menu-logo-cta__submenu,.tb-h-menu-logo-cta__parent:focus-within>.tb-h-menu-logo-cta__submenu{display:grid}.tb-h-menu-logo-cta__chevron{font-size:10px;opacity:.65}.tb-h-menu-logo-cta__row{min-height:84px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px}.tb-h-menu-logo-cta__left{display:flex;justify-content:flex-start}.tb-h-menu-logo-cta__center{display:flex;justify-content:center}.tb-h-menu-logo-cta__right{display:flex;justify-content:flex-end}.tb-h-menu-logo-cta__cta{padding:11px 16px;border-radius:999px;text-decoration:none;font-weight:850}@media(max-width:820px){.tb-h-menu-logo-cta__row,.tb-h-menu-logo-cta__top,.tb-h-menu-logo-cta__glass,.tb-h-menu-logo-cta__frame,.tb-h-menu-logo-cta__pill{flex-wrap:wrap;height:auto;padding-top:14px;padding-bottom:14px}.tb-h-menu-logo-cta__nav{width:100%;order:5}.tb-h-menu-logo-cta__submenu{position:static;box-shadow:none}}@media(max-width:560px){.tb-h-menu-logo-cta__inner{padding-left:16px;padding-right:16px}.tb-h-menu-logo-cta__row{grid-template-columns:1fr!important}.tb-h-menu-logo-cta__search{width:100%!important}}",
  "js": "",
  "slug": "header-menu-logo-cta",
  "name": "Menu Logo CTA Header",
  "category": "Headers",
  "description": "Menu on the left, centered brand, and call-to-action on the right.",
  "keywords": [
    "header",
    "navigation",
    "menu",
    "menulogoc"
  ],
  "contexts": [
    "header"
  ],
  "version": "1.0.0"
}
