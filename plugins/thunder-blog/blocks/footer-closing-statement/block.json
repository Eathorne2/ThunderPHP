{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand statement",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "text": "{{app_description}}",
        "logo": "{{app_logo}}"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-f-closing-statement__brand-name"
        },
        {
          "key": "text",
          "label": "Brand text",
          "type": "textarea",
          "selector": ".tb-f-closing-statement__brand-text"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-f-closing-statement__logo"
        }
      ],
      "template": "<div class=\"tb-f-closing-statement__brand\"><img class=\"tb-f-closing-statement__logo\" src=\"{{logo}}\" alt=\"\"><strong class=\"tb-f-closing-statement__brand-name\">{{name}}</strong><p class=\"tb-f-closing-statement__brand-text\">{{text}}</p></div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "text"
        }
      }
    },
    {
      "key": "copyright",
      "label": "Copyright",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "© {{year}} {{app_name}}. All rights reserved."
      },
      "schema": [
        {
          "key": "text",
          "label": "Copyright text",
          "type": "text",
          "selector": ".tb-f-closing-statement__copyright"
        }
      ],
      "template": "<div class=\"tb-f-closing-statement__copyright\">{{text}}</div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    },
    {
      "key": "statement",
      "label": "Statement",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Have a story worth sharing? Let’s make it memorable."
      },
      "schema": [
        {
          "key": "text",
          "label": "Statement",
          "type": "text",
          "selector": ".tb-f-closing-statement__statement"
        }
      ],
      "template": "<div class=\"tb-f-closing-statement__statement\">{{text}}</div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-f-closing-statement__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-f-closing-statement__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-f-closing-statement__parent\"><a class=\"tb-f-closing-statement__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-f-closing-statement__chevron\">⌄</span></a><div class=\"tb-f-closing-statement__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-f-closing-statement__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<footer class=\"tb-block tb-f-closing-statement\"><div class=\"tb-f-closing-statement__inner\" style=\"--tb-f-closing-statement-width:{{width}}px\"><div class=\"tb-f-closing-statement__closing\">{{elements:statement}}</div><div class=\"tb-f-closing-statement__bottom\">{{elements:brand}}{{menu:primary}}</div><div class=\"tb-f-closing-statement__legal\">{{elements:copyright}}</div></div></footer>",
  "css": ".tb-f-closing-statement{background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-f-closing-statement__inner{max-width:var(--tb-f-closing-statement-width);margin:auto;padding:52px 24px 24px}.tb-f-closing-statement__brand{display:grid;gap:10px;align-content:start}.tb-f-closing-statement__logo{width:42px;height:42px;object-fit:contain}.tb-f-closing-statement__brand-name{font-size:20px}.tb-f-closing-statement__brand-text{max-width:360px;margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-f-closing-statement__copyright{color:var(--tb-color-muted);font-size:12px}.tb-f-closing-statement__nav{display:grid;gap:10px}.tb-f-closing-statement__link{color:inherit;text-decoration:none;opacity:.78}.tb-f-closing-statement__link:hover{opacity:1;color:var(--tb-color-primary)}.tb-f-closing-statement__parent{display:grid;gap:8px}.tb-f-closing-statement__parent>.tb-f-closing-statement__link{font-weight:850;opacity:1}.tb-f-closing-statement__submenu{display:grid;gap:7px;padding-left:0}.tb-f-closing-statement__chevron{display:none}.tb-f-closing-statement__closing{max-width:900px;padding-bottom:42px}.tb-f-closing-statement__statement{font-size:clamp(36px,6vw,70px);line-height:1;letter-spacing:-.055em;font-weight:900}.tb-f-closing-statement__bottom{padding-top:28px;border-top:1px solid var(--tb-color-border);display:grid;grid-template-columns:1fr 1.4fr;gap:46px}.tb-f-closing-statement__nav{grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tb-f-closing-statement__legal{margin-top:28px}@media(max-width:820px){.tb-f-closing-statement__grid,.tb-f-closing-statement__top,.tb-f-closing-statement__row,.tb-f-closing-statement__bottom{grid-template-columns:1fr;flex-wrap:wrap}.tb-f-closing-statement__nav{grid-template-columns:repeat(2,minmax(0,1fr))}.tb-f-closing-statement__contacts{grid-template-columns:1fr}}@media(max-width:520px){.tb-f-closing-statement__inner{padding-left:16px;padding-right:16px}.tb-f-closing-statement__nav{grid-template-columns:1fr}.tb-f-closing-statement__search{width:100%!important}}",
  "js": "",
  "slug": "footer-closing-statement",
  "name": "Closing Statement Footer",
  "category": "Footers",
  "description": "A large closing statement followed by navigation and legal details.",
  "keywords": [
    "footer",
    "navigation",
    "menu",
    "closing"
  ],
  "contexts": [
    "footer"
  ],
  "version": "1.0.0"
}
