      ],
      "template": "<a class=\"tb-fb-shop-grid__card\" href=\"{{url}}\"><img class=\"tb-fb-shop-grid__image\" src=\"{{image}}\" alt=\"{{alt}}\"><span class=\"tb-fb-shop-grid__shade\"></span><span class=\"tb-fb-shop-grid__title-text\">{{title}}</span></a>",
      "min": 1,
