{
  "slug": "medicine-medical-center-hero",
  "name": "Medical Center Hero",
  "category": "Medicine & Science",
  "description": "Modern healthcare hero with appointment action",
  "keywords": [
    "hospital",
    "clinic",
    "doctor",
    "hero"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-medical-center-hero\"><div class=\"tb-med-medical-center-hero__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-med-medical-center-hero__actions\">{{elements:cta}}</div></div><div class=\"tb-med-medical-center-hero__media\">{{elements:image}}<div class=\"tb-med-medical-center-hero__badge\">24/7 care</div></div></section>",
  "css": ".tb-med-medical-center-hero{display:grid;grid-template-columns:1fr 1fr;min-height:610px;background:var(--tb-color-surface);overflow:hidden}.tb-med-medical-center-hero__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(38px,7vw,92px)}.tb-med-medical-center-hero__eyebrow{color:var(--tb-color-primary);font-weight:900;letter-spacing:.14em;text-transform:uppercase;font-size:12px}.tb-med-medical-center-hero__title{font-size:clamp(44px,6vw,76px);line-height:1;margin:14px 0 20px;color:var(--tb-color-secondary)}.tb-med-medical-center-hero__text{font-size:18px;line-height:1.75;color:var(--tb-color-muted);max-width:620px}.tb-med-medical-center-hero__cta{display:inline-block;margin-top:24px;padding:14px 20px;background:var(--tb-color-primary);color:var(--tb-color-surface);text-decoration:none;font-weight:900;border-radius:999px}.tb-med-medical-center-hero__media{position:relative}.tb-med-medical-center-hero__image{width:100%;height:100%;min-height:610px;object-fit:cover}.tb-med-medical-center-hero__badge{position:absolute;left:24px;bottom:24px;background:var(--tb-color-surface);color:var(--tb-color-secondary);padding:12px 18px;border-radius:999px;font-weight:900}@media(max-width:780px){.tb-med-medical-center-hero{grid-template-columns:1fr}.tb-med-medical-center-hero__image{min-height:390px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
