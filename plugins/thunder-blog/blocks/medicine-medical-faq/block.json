{
  "slug": "medicine-medical-faq",
  "name": "Medical FAQ",
  "category": "Medicine & Science",
  "description": "Patient frequently asked questions section",
  "keywords": [
    "faq",
    "patients",
    "medical"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-medical-faq\"><div class=\"tb-med-medical-faq__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-med-medical-faq__list\">{{elements:items}}</div></section>",
  "css": ".tb-med-medical-faq{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(28px,6vw,70px);padding:clamp(42px,7vw,88px);background:var(--tb-color-surface)}.tb-med-medical-faq__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.14em}.tb-med-medical-faq__title{font-size:clamp(38px,5vw,60px);margin:10px 0 14px;color:var(--tb-color-secondary)}.tb-med-medical-faq__text{color:var(--tb-color-muted);line-height:1.7}.tb-med-medical-faq__list{display:grid}.tb-med-medical-faq__item{display:grid;grid-template-columns:46px 1fr;gap:14px;padding:20px 0;border-bottom:1px solid var(--tb-color-border)}.tb-med-medical-faq__item__icon{font-family:monospace;color:var(--tb-color-primary);font-weight:900}.tb-med-medical-faq__item__title{margin:0 0 7px;color:var(--tb-color-secondary);font-size:19px}.tb-med-medical-faq__item__text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:760px){.tb-med-medical-faq{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Patient information"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-med-medical-faq__eyebrow\">{{text}}</span>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Questions, answered clearly"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-med-medical-faq__title\">{{text}}</h2>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Reduce uncertainty before a visit with concise answers to common patient questions."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-med-medical-faq__text\">{{text}}</p>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    },
    {
      "key": "items",
      "label": "Questions",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "title": "",
        "text": "",
        "icon": "✦"
      },
      "schema": [
        {
          "key": "icon",
          "label": "Icon",
          "type": "text",
          "selector": ".tb-med-medical-faq__item__icon"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-med-medical-faq__item__title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-med-medical-faq__item__text",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-med-medical-faq__item\"><span class=\"tb-med-medical-faq__item__icon\">{{icon}}</span><h3 class=\"tb-med-medical-faq__item__title\">{{title}}</h3><p class=\"tb-med-medical-faq__item__text\">{{text}}</p></article>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "icon": "01",
          "title": "Do I need an appointment?",
          "text": "Use this answer area to explain walk-ins, booking rules and urgent-care options."
        },
        {
          "icon": "02",
          "title": "What should I bring?",
          "text": "List identification, referral, medication or insurance information patients may need."
        },
        {
          "icon": "03",
          "title": "When will results be ready?",
          "text": "Explain expected turnaround times and how results are shared."
        },
        {
          "icon": "04",
          "title": "Can I book online?",
          "text": "Describe your digital booking or virtual-care process."
        }
      ],
      "min": 1,
      "max": 12
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
