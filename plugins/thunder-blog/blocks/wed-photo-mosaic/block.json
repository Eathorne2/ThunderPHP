{
  "slug": "wed-photo-mosaic",
  "name": "Wedding Photo Mosaic",
  "category": "Wedding",
  "description": "Asymmetric editable wedding gallery for memories and photography portfolios",
  "keywords": [
    "wedding",
    "gallery",
    "photos",
    "memories"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-photo-mosaic\"><div class=\"tb-wed-photo-mosaic__head\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-wed-photo-mosaic__grid\">{{elements:photos}}</div></div>",
  "css": ".tb-wed-photo-mosaic{padding:clamp(28px,5vw,68px);background:var(--tb-color-background)}.tb-wed-photo-mosaic__head{max-width:700px;margin-bottom:28px}.tb-wed-photo-mosaic__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-photo-mosaic__title{margin:8px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,5vw,62px);font-weight:400}.tb-wed-photo-mosaic__grid{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:180px;gap:12px}.tb-wed-photo-mosaic__photo{width:100%;height:100%;object-fit:cover;display:block}.tb-wed-photo-mosaic__item:nth-child(1){grid-column:span 2;grid-row:span 2}.tb-wed-photo-mosaic__item:nth-child(4){grid-column:span 2}@media(max-width:700px){.tb-wed-photo-mosaic__grid{grid-template-columns:repeat(2,1fr)}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Moments"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-photo-mosaic__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A gallery of happy memories"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-photo-mosaic__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "photos",
      "label": "Photo",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "image": "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1400&q=82",
        "alt": "Wedding couple"
      },
      "schema": [
        {
          "key": "image",
          "label": "Image",
          "type": "image",
          "selector": ".tb-wed-photo-mosaic__photo"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<figure class=\"tb-wed-photo-mosaic__item\"><img class=\"tb-wed-photo-mosaic__photo\" src=\"{{image}}\" alt=\"{{alt}}\"></figure>",
      "min": 1,
      "max": 12,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "image": "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1400&q=82",
          "alt": "Wedding couple"
        },
        {
          "image": "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1400&q=82",
          "alt": "Wedding rings"
        },
        {
          "image": "https://images.unsplash.com/photo-1523438885200-e635ba2c371e?auto=format&fit=crop&w=1400&q=82",
          "alt": "Wedding flowers"
        },
        {
          "image": "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=1400&q=82",
          "alt": "Reception details"
        },
        {
          "image": "https://images.unsplash.com/photo-1591604466107-ec97de577aff?auto=format&fit=crop&w=1400&q=82",
          "alt": "Bride portrait"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
