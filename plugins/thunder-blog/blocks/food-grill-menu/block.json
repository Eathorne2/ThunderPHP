          "type": "text",
          "selector": ".tb-food-grill__price"
        }
      ],
      "template": "<article class=\"tb-food-grill__item\"><h3 class=\"tb-food-grill__name\">{{name}}</h3><p class=\"tb-food-grill__detail\">{{detail}}</p><strong class=\"tb-food-grill__price\">{{price}}</strong></article>",
      "min": 1,
