{
  "slug": "food-grill-menu",
  "name": "Grill House Menu",
  "category": "Food & Restaurant",
  "description": "Dark grill-house menu with smoky image backdrop and price list",
  "keywords": [
    "food",
    "restaurant",
    "grill",
    "meat",
    "menu"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-grill\"><div class=\"tb-food-grill__overlay\"></div><div class=\"tb-food-grill__inner\"><header class=\"tb-food-grill__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</header><div class=\"tb-food-grill__menu\">{{elements:items}}</div></div></div>",
  "css": ".tb-food-grill{position:relative;padding:clamp(40px,7vw,90px);background:linear-gradient(rgba(12,12,12,.78),rgba(12,12,12,.88)),url(\"https://images.unsplash.com/photo-1529692236671-f1f6cf9683ba?auto=format&fit=crop&w=1400&q=82\") center/cover no-repeat;color:#fff}.tb-food-grill__inner{position:relative;z-index:1;max-width:1100px;margin:auto}.tb-food-grill__head{max-width:720px;margin-bottom:32px}.tb-food-grill__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;letter-spacing:.17em;text-transform:uppercase}.tb-food-grill__title{margin:9px 0;color:#fff;font-size:clamp(48px,7vw,82px);text-transform:uppercase;line-height:.92}.tb-food-grill__text{color:rgba(255,255,255,.72);line-height:1.7}.tb-food-grill__menu{display:grid;grid-template-columns:1fr 1fr;gap:0 40px}.tb-food-grill__item{display:grid;grid-template-columns:1fr auto;gap:6px 14px;padding:18px 0;border-top:1px solid rgba(255,255,255,.25)}.tb-food-grill__name{margin:0;color:#fff;font-size:20px}.tb-food-grill__detail{margin:0;color:rgba(255,255,255,.65)}.tb-food-grill__price{grid-column:2;grid-row:1/3;color:var(--tb-color-primary);font-weight:950}@media(max-width:660px){.tb-food-grill__menu{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Over live fire"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-grill__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "From the grill"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h2 class=\"tb-food-grill__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Smoke, char and bold sauces—the grill menu is built for generous plates and sharing."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
