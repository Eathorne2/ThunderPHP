{
  "slug": "sports-upcoming-fixtures",
  "name": "Upcoming Fixtures",
  "category": "Sports",
  "description": "Sports schedule or fixtures listing",
  "keywords": [
    "upcoming",
    "fixtures",
    "schedule"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-sport-upcoming-fixtures\"><div class=\"tb-sport-upcoming-fixtures__intro\">{{elements:kicker}}{{elements:heading}}</div><div class=\"tb-sport-upcoming-fixtures__schedule\">{{elements:sessions}}</div></section>",
  "css": ".tb-sport-upcoming-fixtures{display:grid;grid-template-columns:.8fr 1.2fr;gap:48px;padding:clamp(40px,7vw,86px);background:var(--tb-color-background)}.tb-sport-upcoming-fixtures__kicker{font-weight:900;color:var(--tb-color-primary);text-transform:uppercase;letter-spacing:.13em;font-size:12px}.tb-sport-upcoming-fixtures__heading{font-size:clamp(36px,5vw,58px);line-height:1.05;margin:12px 0;color:var(--tb-color-secondary)}.tb-sport-upcoming-fixtures__schedule{border-top:2px solid var(--tb-color-secondary)}.tb-sport-upcoming-fixtures__row{display:grid;grid-template-columns:100px 1fr auto;gap:18px;align-items:center;padding:20px 0;border-bottom:1px solid var(--tb-color-border)}.tb-sport-upcoming-fixtures__day{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--tb-color-muted)}.tb-sport-upcoming-fixtures__name{font-size:20px}.tb-sport-upcoming-fixtures__time{font-weight:800;color:var(--tb-color-primary)}@media(max-width:760px){.tb-sport-upcoming-fixtures{grid-template-columns:1fr}.tb-sport-upcoming-fixtures__row{grid-template-columns:80px 1fr}.tb-sport-upcoming-fixtures__time{grid-column:2}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "kicker",
      "label": "Kicker",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Weekly schedule"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-sport-upcoming-fixtures__kicker\">{{text}}</span>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "heading",
      "label": "Heading",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Next matches"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-sport-upcoming-fixtures__heading\">{{text}}</h2>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "sessions",
      "label": "Schedule rows",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "day": "AUG 14",
        "name": "City United vs Riverside",
        "time": "18:30"
      },
      "schema": [
        {
          "key": "day",
          "label": "Day",
          "type": "text",
          "selector": ".tb-sport-upcoming-fixtures__day"
        },
        {
          "key": "name",
          "label": "Session",
          "type": "text",
          "selector": ".tb-sport-upcoming-fixtures__name"
        },
        {
          "key": "time",
          "label": "Time",
          "type": "text",
          "selector": ".tb-sport-upcoming-fixtures__time"
        }
      ],
      "template": "<div class=\"tb-sport-upcoming-fixtures__row\"><span class=\"tb-sport-upcoming-fixtures__day\">{{day}}</span><strong class=\"tb-sport-upcoming-fixtures__name\">{{name}}</strong><span class=\"tb-sport-upcoming-fixtures__time\">{{time}}</span></div>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 12,
      "default_items": [
        {
          "day": "AUG 14",
          "name": "City United vs Riverside",
          "time": "18:30"
        },
        {
          "day": "AUG 21",
          "name": "Riverside vs North Stars",
          "time": "15:00"
        },
        {
          "day": "AUG 28",
          "name": "Lakeside vs Riverside",
          "time": "17:00"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
