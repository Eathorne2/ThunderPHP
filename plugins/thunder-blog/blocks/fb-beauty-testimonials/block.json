{
  "slug": "fb-beauty-testimonials",
  "name": "Beauty Testimonials",
  "category": "Fashion & Beauty",
  "description": "Soft testimonial cards for salons, stylists and beauty brands.",
  "keywords": [
    "beauty",
    "testimonials",
    "reviews",
    "salon"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-testimonials\"><div class=\"tb-fb-testimonials__head\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-fb-testimonials__grid\">{{elements:quotes}}</div></div>",
  "css": ".tb-fb-testimonials{padding:clamp(30px,6vw,78px);background:color-mix(in srgb,var(--tb-color-primary) 6%,var(--tb-color-surface))}.tb-fb-testimonials__head{text-align:center;max-width:720px;margin:0 auto 30px}.tb-fb-testimonials__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-testimonials__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,5vw,62px);font-weight:500}.tb-fb-testimonials__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.tb-fb-testimonials__card{padding:28px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-fb-testimonials__quote{margin:0 0 24px;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:24px;line-height:1.35}.tb-fb-testimonials__name{color:var(--tb-color-primary);font-weight:900}.tb-fb-testimonials__meta{margin-top:4px;color:var(--tb-color-muted);font-size:12px}@media(max-width:760px){.tb-fb-testimonials__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Client notes"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-testimonials__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "How the experience feels"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-fb-testimonials__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "quotes",
      "label": "Testimonial",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "quote": "The consultation felt personal, calm and completely unhurried.",
        "name": "Sofia M.",
        "meta": "Skin ritual client"
      },
      "schema": [
        {
          "key": "quote",
          "label": "Quote",
          "type": "textarea",
          "selector": ".tb-fb-testimonials__quote",
          "rows": 4
        },
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "selector": ".tb-fb-testimonials__name"
        },
        {
          "key": "meta",
          "label": "Meta",
          "type": "text",
          "selector": ".tb-fb-testimonials__meta"
        }
      ],
      "template": "<article class=\"tb-fb-testimonials__card\"><blockquote class=\"tb-fb-testimonials__quote\">“{{quote}}”</blockquote><div class=\"tb-fb-testimonials__name\">{{name}}</div><div class=\"tb-fb-testimonials__meta\">{{meta}}</div></article>",
      "min": 1,
      "max": 12,
      "default_items": [
        {
          "quote": "The consultation felt personal, calm and completely unhurried.",
          "name": "Sofia M.",
          "meta": "Skin ritual client"
        },
        {
          "quote": "I left with a cut that works just as well on ordinary days.",
          "name": "Tariq K.",
          "meta": "Hair studio client"
        },
        {
          "quote": "The styling direction was clear, practical and still felt like me.",
          "name": "Nadia R.",
          "meta": "Personal styling client"
        }
      ],
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
