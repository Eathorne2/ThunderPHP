  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-enroll\"><div class=\"tb-edu-enroll__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-edu-enroll__actions\">{{elements:primary}}{{elements:secondary}}</div></div><div class=\"tb-edu-enroll__media\">{{elements:image}}</div></div>",
  "css": ".tb-edu-enroll{display:grid;grid-template-columns:1fr 1fr;background:var(--tb-color-primary);color:#fff}.tb-edu-enroll__copy{padding:clamp(36px,7vw,88px);align-self:center}.tb-edu-enroll__eyebrow{font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.16em}.tb-edu-enroll__title{margin:10px 0;color:inherit;font-size:clamp(44px,6vw,72px);line-height:1}.tb-edu-enroll__text{color:inherit;opacity:.82;line-height:1.7}.tb-edu-enroll__actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.tb-edu-enroll__primary,.tb-edu-enroll__secondary{padding:13px 18px;text-decoration:none;font-weight:900}.tb-edu-enroll__primary{background:#fff;color:var(--tb-color-primary)}.tb-edu-enroll__secondary{border:1px solid rgba(255,255,255,.6);color:#fff}.tb-edu-enroll__media{min-height:540px}.tb-edu-enroll__image{width:100%;height:100%;min-height:540px;object-fit:cover}@media(max-width:760px){.tb-edu-enroll{grid-template-columns:1fr}.tb-edu-enroll__media,.tb-edu-enroll__image{min-height:360px}}",
  "js": "",
