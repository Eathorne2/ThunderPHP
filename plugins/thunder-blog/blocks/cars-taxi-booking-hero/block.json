{
  "slug": "cars-taxi-booking-hero",
  "name": "Taxi Booking Hero",
  "category": "Cars & Transportation",
  "description": "Taxi service hero with prominent booking action",
  "keywords": [
    "cars",
    "transportation",
    "hero",
    "image",
    "cta"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-auto-taxi-booking-hero\"><div class=\"tb-auto-taxi-booking-hero__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-auto-taxi-booking-hero__visual\">{{elements:image}}</div></section>",
  "css": ".tb-auto-taxi-booking-hero{display:grid;grid-template-columns:minmax(0,.92fr) minmax(360px,1.08fr);min-height:600px;background:var(--tb-color-surface);overflow:hidden}.tb-auto-taxi-booking-hero__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(36px,7vw,90px)}.tb-auto-taxi-booking-hero__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.tb-auto-taxi-booking-hero__title{margin:12px 0 18px;color:var(--tb-color-secondary);font-size:clamp(46px,6.5vw,82px);line-height:.98}.tb-auto-taxi-booking-hero__text{max-width:580px;color:var(--tb-color-muted);font-size:17px;line-height:1.75}.tb-auto-taxi-booking-hero__cta{align-self:flex-start;margin-top:24px;padding:13px 19px;background:var(--tb-color-primary);color:var(--tb-color-surface);font-weight:900;text-decoration:none}.tb-auto-taxi-booking-hero__image{width:100%;height:100%;min-height:600px;object-fit:cover;display:block}@media(max-width:780px){.tb-auto-taxi-booking-hero{grid-template-columns:1fr}.tb-auto-taxi-booking-hero__image{min-height:400px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Available day and night"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-auto-taxi-booking-hero__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Your ride is already close"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-auto-taxi-booking-hero__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Introduce a taxi or transfer service with simple messaging and a clear booking destination."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-auto-taxi-booking-hero__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cta",
      "label": "Action",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Book a taxi",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-auto-taxi-booking-hero__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "image",
      "label": "Image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1555215695-3004980ad54e?auto=format&fit=crop&w=1600&q=82",
        "alt": "Taxi Booking Hero"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-auto-taxi-booking-hero__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-auto-taxi-booking-hero__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
