{
  "slug": "sports-match-scoreboard",
  "name": "Match Scoreboard",
  "category": "Sports",
  "description": "Prominent latest-result scoreboard",
  "keywords": [
    "score",
    "match",
    "team",
    "result"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-sport-match-scoreboard\"><div class=\"tb-sport-match-scoreboard__meta\">{{elements:competition}}</div><div class=\"tb-sport-match-scoreboard__board\"><div class=\"tb-sport-match-scoreboard__team\">{{elements:home}}</div><div class=\"tb-sport-match-scoreboard__score\">{{elements:score}}</div><div class=\"tb-sport-match-scoreboard__team tb-sport-match-scoreboard__team--away\">{{elements:away}}</div></div>{{elements:note}}</section>",
  "css": ".tb-sport-match-scoreboard{padding:clamp(44px,8vw,96px);background:var(--tb-color-secondary);color:var(--tb-color-surface);text-align:center}.tb-sport-match-scoreboard__competition{text-transform:uppercase;font-weight:900;letter-spacing:.14em;font-size:12px;color:var(--tb-color-primary)}.tb-sport-match-scoreboard__board{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:30px;max-width:1000px;margin:30px auto}.tb-sport-match-scoreboard__team-name{font-size:clamp(28px,4vw,48px);font-weight:900}.tb-sport-match-scoreboard__score-value{font-size:clamp(64px,10vw,124px);font-weight:950;letter-spacing:-.08em;color:var(--tb-color-primary)}.tb-sport-match-scoreboard__note{color:color-mix(in srgb,var(--tb-color-surface) 70%,transparent);margin:0}@media(max-width:620px){.tb-sport-match-scoreboard__board{grid-template-columns:1fr}}",
  "js": "",
