      "template": "<article class=\"tb-auto-car-wash-pricing__item\"><div class=\"tb-auto-car-wash-pricing__row\"><h3 class=\"tb-auto-car-wash-pricing__name\">{{name}}</h3><span class=\"tb-auto-car-wash-pricing__price\">{{price}}</span></div><p class=\"tb-auto-car-wash-pricing__item-text\">{{text}}</p></article>",
