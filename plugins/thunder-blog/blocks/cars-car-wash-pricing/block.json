{
  "slug": "cars-car-wash-pricing",
  "name": "Car Wash Pricing",
  "category": "Cars & Transportation",
  "description": "Pricing cards for wash and detailing packages",
  "keywords": [
    "cars",
    "transportation",
    "pricing",
    "services"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-auto-car-wash-pricing\"><header class=\"tb-auto-car-wash-pricing__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</header><div class=\"tb-auto-car-wash-pricing__list\">{{elements:items}}</div></section>",
  "css": ".tb-auto-car-wash-pricing{padding:clamp(34px,6vw,84px);background:var(--tb-color-secondary)}.tb-auto-car-wash-pricing__head{max-width:760px;margin-bottom:28px}.tb-auto-car-wash-pricing__eyebrow{color:var(--tb-color-primary);font-size:11px;font-weight:950;letter-spacing:.15em;text-transform:uppercase}.tb-auto-car-wash-pricing__title{margin:9px 0;color:var(--tb-color-surface);font-size:clamp(40px,5vw,66px)}.tb-auto-car-wash-pricing__text{color:color-mix(in srgb,var(--tb-color-surface) 75%,transparent);line-height:1.7}.tb-auto-car-wash-pricing__list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tb-auto-car-wash-pricing__item{padding:25px;border:1px solid color-mix(in srgb,var(--tb-color-surface) 20%,transparent);background:color-mix(in srgb,var(--tb-color-surface) 7%,transparent)}.tb-auto-car-wash-pricing__row{display:flex;justify-content:space-between;gap:14px;align-items:baseline}.tb-auto-car-wash-pricing__name{margin:0;color:var(--tb-color-surface);font-size:22px}.tb-auto-car-wash-pricing__price{color:var(--tb-color-primary);font-size:22px;font-weight:950}.tb-auto-car-wash-pricing__item-text{margin:14px 0 0;color:color-mix(in srgb,var(--tb-color-surface) 70%,transparent);line-height:1.6}@media(max-width:760px){.tb-auto-car-wash-pricing__list{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
