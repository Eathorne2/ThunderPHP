{
  "slug": "wed-pricing-packages",
  "name": "Wedding Planning Packages",
  "category": "Wedding",
  "description": "Three editable pricing packages for planners and coordinators",
  "keywords": [
    "wedding",
    "pricing",
    "planner",
    "packages"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-packages\"><div class=\"tb-wed-packages__head\">{{elements:eyebrow}}{{elements:title}}{{elements:intro}}</div><div class=\"tb-wed-packages__grid\">{{elements:packages}}</div></div>",
  "css": ".tb-wed-packages{padding:clamp(34px,6vw,80px);background:var(--tb-color-background)}.tb-wed-packages__head{max-width:720px;margin-bottom:28px}.tb-wed-packages__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-packages__title{margin:8px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(40px,5vw,60px);font-weight:400}.tb-wed-packages__intro{color:var(--tb-color-muted);line-height:1.7}.tb-wed-packages__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tb-wed-packages__package{padding:28px;border:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-wed-packages__name{margin:0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:30px;font-weight:400}.tb-wed-packages__price{display:block;margin:20px 0;color:var(--tb-color-primary);font-size:28px;font-weight:900}.tb-wed-packages__text,.tb-wed-packages__features{color:var(--tb-color-muted);line-height:1.65}.tb-wed-packages__features{padding-top:18px;border-top:1px solid var(--tb-color-border);font-size:13px}@media(max-width:760px){.tb-wed-packages__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
