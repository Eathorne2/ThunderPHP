{
  "slug": "food-online-ordering",
  "name": "Online Ordering CTA",
  "category": "Food & Restaurant",
  "description": "Food-ordering section with three-step explanation and strong action",
  "keywords": [
    "food",
    "restaurant",
    "ordering",
    "delivery",
    "takeaway"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-order\"><div class=\"tb-food-order__top\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-food-order__steps\">{{elements:items}}</div></div>",
  "css": ".tb-food-order{padding:clamp(38px,7vw,90px);background:var(--tb-color-primary)}.tb-food-order__top{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:end;max-width:1100px;margin:auto}.tb-food-order__eyebrow{grid-column:1/-1;color:var(--tb-color-surface);font-size:12px;font-weight:950;letter-spacing:.18em;text-transform:uppercase}.tb-food-order__title{margin:8px 0;color:var(--tb-color-surface);font-size:clamp(46px,7vw,80px);line-height:.95}.tb-food-order__text{grid-column:1;max-width:660px;color:color-mix(in srgb,var(--tb-color-surface) 80%,transparent);line-height:1.7}.tb-food-order__cta{grid-column:2;grid-row:2/4;padding:14px 22px;background:var(--tb-color-secondary);color:var(--tb-color-surface);text-decoration:none;font-weight:950;align-self:center}.tb-food-order__steps{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:1100px;margin:34px auto 0}.tb-food-order__item{padding:24px;background:var(--tb-color-background)}.tb-food-order__item h3{margin:0 0 8px;color:var(--tb-color-secondary);font-size:24px}.tb-food-order__item p{margin:0;color:var(--tb-color-muted);line-height:1.6}@media(max-width:720px){.tb-food-order__top{grid-template-columns:1fr}.tb-food-order__cta{grid-column:1;grid-row:auto;justify-self:start}.tb-food-order__steps{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Dinner, simplified"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-order__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Order your favorites online"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-food-order__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Connect this section to your own ordering route or third-party ordering system."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-food-order__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cta",
      "label": "Order button",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Start an order",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-food-order__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Ordering step",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "title": "Choose",
        "text": "Pick dishes, sizes and extras from the current menu."
      },
      "schema": [
        {
          "key": "title",
          "label": "Step",
          "type": "text",
          "selector": ".tb-food-order__item h3"
        },
        {
          "key": "text",
          "label": "Description",
          "type": "textarea",
          "selector": ".tb-food-order__item p",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-food-order__item\"><h3>{{title}}</h3><p>{{text}}</p></article>",
      "min": 1,
      "max": 12,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "title": "Choose",
          "text": "Pick dishes, sizes and extras from the current menu."
        },
        {
          "title": "Confirm",
          "text": "Review your order and preferred collection or delivery time."
        },
        {
          "title": "Enjoy",
          "text": "Collect fresh or have the meal delivered ready to eat."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
