          "swatch": "#87937C"
        },
        {
          "name": "Rose",
          "note": "Soft floral note",
          "swatch": "#C9959A"
        },
        {
          "name": "Ink",
          "note": "Type & evening detail",
          "swatch": "#2E2B29"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
