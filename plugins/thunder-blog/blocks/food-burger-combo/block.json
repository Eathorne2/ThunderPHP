{
  "slug": "food-burger-combo",
  "name": "Burger Combo Banner",
  "category": "Food & Restaurant",
  "description": "High-impact fast-food combo promotion with price, image and CTA",
  "keywords": [
    "food",
    "restaurant",
    "burger",
    "fast food",
    "promotion"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-burger\"><div class=\"tb-food-burger__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-food-burger__bottom\">{{elements:price}}{{elements:cta}}</div></div><div class=\"tb-food-burger__visual\">{{elements:image}}</div></div>",
  "css": ".tb-food-burger{display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:clamp(28px,5vw,64px);background:var(--tb-color-primary);overflow:hidden}.tb-food-burger__copy{padding:clamp(12px,4vw,50px)}.tb-food-burger__eyebrow{display:inline-flex;padding:7px 10px;background:var(--tb-color-secondary);color:var(--tb-color-surface);font-weight:950;text-transform:uppercase;font-size:11px;letter-spacing:.12em}.tb-food-burger__title{margin:18px 0 10px;color:var(--tb-color-surface);font-size:clamp(52px,8vw,94px);line-height:.86;text-transform:uppercase}.tb-food-burger__text{max-width:520px;color:color-mix(in srgb,var(--tb-color-surface) 82%,transparent);font-size:18px;line-height:1.65}.tb-food-burger__bottom{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:24px}.tb-food-burger__price{font-size:34px;font-weight:950;color:var(--tb-color-secondary)}.tb-food-burger__cta{padding:13px 20px;background:var(--tb-color-secondary);color:var(--tb-color-surface);font-weight:900;text-decoration:none}.tb-food-burger__image{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:50%;display:block;transform:rotate(3deg)}@media(max-width:720px){.tb-food-burger{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Badge",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Combo of the week"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-burger__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
