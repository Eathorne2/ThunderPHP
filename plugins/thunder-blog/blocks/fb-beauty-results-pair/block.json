{
  "slug": "fb-beauty-results-pair",
  "name": "Beauty Results Pair",
  "category": "Fashion & Beauty",
  "description": "Two-image beauty story with a central results statement.",
  "keywords": [
    "beauty",
    "results",
    "before after",
    "treatment"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-results\"><div class=\"tb-fb-results__image-wrap\">{{elements:image_one}}</div><div class=\"tb-fb-results__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-fb-results__image-wrap\">{{elements:image_two}}</div></div>",
  "css": ".tb-fb-results{display:grid;grid-template-columns:minmax(220px,.8fr) minmax(260px,1fr) minmax(220px,.8fr);align-items:center;gap:18px;padding:clamp(28px,5vw,68px);background:var(--tb-color-background)}.tb-fb-results__image-wrap{overflow:hidden}.tb-fb-results__image{width:100%;aspect-ratio:3/4;object-fit:cover;display:block}.tb-fb-results__copy{text-align:center;padding:clamp(20px,4vw,48px);background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-fb-results__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.17em;text-transform:uppercase}.tb-fb-results__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(34px,5vw,56px);font-weight:500}.tb-fb-results__text{color:var(--tb-color-muted);line-height:1.7}.tb-fb-results__cta{display:inline-flex;margin-top:14px;padding:11px 18px;border:1px solid var(--tb-color-secondary);color:var(--tb-color-secondary);text-decoration:none;font-weight:800}@media(max-width:760px){.tb-fb-results{grid-template-columns:1fr}.tb-fb-results__image{aspect-ratio:16/10}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image_one",
      "label": "Image one",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=1400&q=82",
        "alt": "Beauty treatment portrait"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-fb-results__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-fb-results__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
