  "html": "<section class=\"tb-block tb-med-clinical-trials-steps\"><header>{{elements:eyebrow}}{{elements:title}}{{elements:text}}</header><div class=\"tb-med-clinical-trials-steps__grid\">{{elements:steps}}</div></section>",
  "css": ".tb-med-clinical-trials-steps{padding:clamp(42px,7vw,88px);background:var(--tb-color-secondary);color:var(--tb-color-surface)}.tb-med-clinical-trials-steps header{max-width:780px;margin-bottom:34px}.tb-med-clinical-trials-steps__eyebrow{color:var(--tb-color-accent);font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:900}.tb-med-clinical-trials-steps__title{font-size:clamp(38px,5vw,62px);margin:10px 0 14px}.tb-med-clinical-trials-steps__text{line-height:1.7;opacity:.82}.tb-med-clinical-trials-steps__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:color-mix(in srgb,var(--tb-color-surface) 25%,transparent)}.tb-med-clinical-trials-steps__step{padding:26px;background:var(--tb-color-secondary)}.tb-med-clinical-trials-steps__step__number{font-size:34px;color:var(--tb-color-accent)}.tb-med-clinical-trials-steps__step__title{font-size:20px;margin:16px 0 8px}.tb-med-clinical-trials-steps__step__text{opacity:.76;line-height:1.65}@media(max-width:800px){.tb-med-clinical-trials-steps__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.tb-med-clinical-trials-steps__grid{grid-template-columns:1fr}}",
