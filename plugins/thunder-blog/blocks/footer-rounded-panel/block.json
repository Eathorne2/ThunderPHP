{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand statement",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "text": "{{app_description}}",
        "logo": "{{app_logo}}"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-f-rounded-panel__brand-name"
        },
        {
          "key": "text",
          "label": "Brand text",
          "type": "textarea",
          "selector": ".tb-f-rounded-panel__brand-text"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-f-rounded-panel__logo"
        }
      ],
      "template": "<div class=\"tb-f-rounded-panel__brand\"><img class=\"tb-f-rounded-panel__logo\" src=\"{{logo}}\" alt=\"\"><strong class=\"tb-f-rounded-panel__brand-name\">{{name}}</strong><p class=\"tb-f-rounded-panel__brand-text\">{{text}}</p></div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "text"
        }
      }
    },
    {
      "key": "copyright",
      "label": "Copyright",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "© {{year}} {{app_name}}. All rights reserved."
      },
      "schema": [
        {
          "key": "text",
          "label": "Copyright text",
          "type": "text",
          "selector": ".tb-f-rounded-panel__copyright"
        }
      ],
      "template": "<div class=\"tb-f-rounded-panel__copyright\">{{text}}</div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-f-rounded-panel__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-f-rounded-panel__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-f-rounded-panel__parent\"><a class=\"tb-f-rounded-panel__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-f-rounded-panel__chevron\">⌄</span></a><div class=\"tb-f-rounded-panel__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-f-rounded-panel__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<footer class=\"tb-block tb-f-rounded-panel\"><div class=\"tb-f-rounded-panel__inner\" style=\"--tb-f-rounded-panel-width:{{width}}px\"><div class=\"tb-f-rounded-panel__panel\"><div class=\"tb-f-rounded-panel__grid\">{{elements:brand}}{{menu:primary}}</div><div class=\"tb-f-rounded-panel__legal\">{{elements:copyright}}</div></div></div></footer>",
  "css": ".tb-f-rounded-panel{background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-f-rounded-panel__inner{max-width:var(--tb-f-rounded-panel-width);margin:auto;padding:52px 24px 24px}.tb-f-rounded-panel__brand{display:grid;gap:10px;align-content:start}.tb-f-rounded-panel__logo{width:42px;height:42px;object-fit:contain}.tb-f-rounded-panel__brand-name{font-size:20px}.tb-f-rounded-panel__brand-text{max-width:360px;margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-f-rounded-panel__copyright{color:var(--tb-color-muted);font-size:12px}.tb-f-rounded-panel__nav{display:grid;gap:10px}.tb-f-rounded-panel__link{color:inherit;text-decoration:none;opacity:.78}.tb-f-rounded-panel__link:hover{opacity:1;color:var(--tb-color-primary)}.tb-f-rounded-panel__parent{display:grid;gap:8px}.tb-f-rounded-panel__parent>.tb-f-rounded-panel__link{font-weight:850;opacity:1}.tb-f-rounded-panel__submenu{display:grid;gap:7px;padding-left:0}.tb-f-rounded-panel__chevron{display:none}.tb-f-rounded-panel{padding:24px 0;background:var(--tb-color-background)}.tb-f-rounded-panel__inner{padding-top:0;padding-bottom:0}.tb-f-rounded-panel__panel{padding:38px;border:1px solid var(--tb-color-border);border-radius:28px;background:var(--tb-color-surface);box-shadow:0 18px 44px color-mix(in srgb,var(--tb-color-secondary) 8%,transparent)}.tb-f-rounded-panel__grid{display:grid;grid-template-columns:1fr 1.4fr;gap:48px}.tb-f-rounded-panel__nav{grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tb-f-rounded-panel__legal{margin-top:28px;padding-top:16px;border-top:1px solid var(--tb-color-border)}@media(max-width:820px){.tb-f-rounded-panel__grid,.tb-f-rounded-panel__top,.tb-f-rounded-panel__row,.tb-f-rounded-panel__bottom{grid-template-columns:1fr;flex-wrap:wrap}.tb-f-rounded-panel__nav{grid-template-columns:repeat(2,minmax(0,1fr))}.tb-f-rounded-panel__contacts{grid-template-columns:1fr}}@media(max-width:520px){.tb-f-rounded-panel__inner{padding-left:16px;padding-right:16px}.tb-f-rounded-panel__nav{grid-template-columns:1fr}.tb-f-rounded-panel__search{width:100%!important}}",
  "js": "",
  "slug": "footer-rounded-panel",
  "name": "Rounded Panel Footer",
  "category": "Footers",
  "description": "A floating rounded footer panel on a contrasting page background.",
  "keywords": [
    "footer",
    "navigation",
    "menu",
    "rounded"
  ],
  "contexts": [
    "footer"
  ],
  "version": "1.0.0"
}
