  "html": "<section class=\"tb-block tb-sport-golf-club-feature\"><div class=\"tb-sport-golf-club-feature__copy\">{{elements:kicker}}{{elements:heading}}{{elements:text}}<ul class=\"tb-sport-golf-club-feature__points\">{{elements:points}}</ul></div><div class=\"tb-sport-golf-club-feature__media\">{{elements:image}}</div></section>",
  "css": ".tb-sport-golf-club-feature{display:grid;grid-template-columns:1fr 1fr;gap:0;background:var(--tb-color-surface)}.tb-sport-golf-club-feature__copy{padding:clamp(40px,7vw,86px)}.tb-sport-golf-club-feature__kicker{font-size:12px;font-weight:900;color:var(--tb-color-primary);letter-spacing:.14em;text-transform:uppercase}.tb-sport-golf-club-feature__heading{font-size:clamp(38px,5vw,62px);line-height:1.05;margin:12px 0 20px}.tb-sport-golf-club-feature__text{font-size:18px;line-height:1.7;color:var(--tb-color-muted)}.tb-sport-golf-club-feature__points{list-style:none;padding:0;margin:24px 0 0;display:grid;gap:10px}.tb-sport-golf-club-feature__point{padding:12px 0;border-bottom:1px solid var(--tb-color-border);font-weight:800}.tb-sport-golf-club-feature__media{min-height:560px}.tb-sport-golf-club-feature__image{width:100%;height:100%;min-height:560px;object-fit:cover}@media(max-width:760px){.tb-sport-golf-club-feature{grid-template-columns:1fr}.tb-sport-golf-club-feature__media,.tb-sport-golf-club-feature__image{min-height:390px}}",
