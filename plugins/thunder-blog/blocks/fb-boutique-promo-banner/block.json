{
  "slug": "fb-boutique-promo-banner",
  "name": "Boutique Promo Banner",
  "category": "Fashion & Beauty",
  "description": "High-impact boutique promotion with discount badge and fashion image.",
  "keywords": [
    "fashion",
    "boutique",
    "promo",
    "sale",
    "banner"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-promo\"><div class=\"tb-fb-promo__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-fb-promo__media\">{{elements:image}}<div class=\"tb-fb-promo__badge\">{{elements:badge}}</div></div></div>",
  "css": ".tb-fb-promo{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,1fr);background:var(--tb-color-primary);color:#fff;overflow:hidden}.tb-fb-promo__copy{padding:clamp(32px,7vw,88px);display:flex;flex-direction:column;justify-content:center}.tb-fb-promo__eyebrow{font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-promo__title{margin:10px 0;font-family:Georgia,serif;font-size:clamp(44px,7vw,80px);font-weight:500;line-height:.98}.tb-fb-promo__text{max-width:540px;line-height:1.7;opacity:.88}.tb-fb-promo__cta{align-self:flex-start;margin-top:18px;padding:12px 18px;background:#fff;color:var(--tb-color-primary);text-decoration:none;font-weight:900}.tb-fb-promo__media{position:relative;min-height:520px}.tb-fb-promo__image{width:100%;height:100%;min-height:520px;object-fit:cover;display:block}.tb-fb-promo__badge{position:absolute;left:22px;top:22px;width:100px;height:100px;border-radius:50%;display:grid;place-items:center;text-align:center;padding:12px;background:var(--tb-color-accent);color:var(--tb-color-secondary);font-weight:900}@media(max-width:760px){.tb-fb-promo{grid-template-columns:1fr}.tb-fb-promo__media,.tb-fb-promo__image{min-height:390px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Boutique edit"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-promo__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
