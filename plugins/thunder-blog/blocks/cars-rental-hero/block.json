{
  "slug": "cars-rental-hero",
  "name": "Car Rental Hero",
  "category": "Cars & Transportation",
  "description": "Rental-focused hero with large vehicle image and reservation action",
  "keywords": [
    "cars",
    "transportation",
    "hero",
    "image",
    "cta"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-auto-rental-hero\"><div class=\"tb-auto-rental-hero__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-auto-rental-hero__visual\">{{elements:image}}</div></section>",
  "css": ".tb-auto-rental-hero{position:relative;min-height:650px;display:flex;align-items:flex-end;padding:clamp(32px,6vw,80px);overflow:hidden;background:var(--tb-color-secondary)}.tb-auto-rental-hero__visual{position:absolute;inset:0}.tb-auto-rental-hero__visual:after{content:\"\";position:absolute;inset:0;background:linear-gradient(90deg,var(--tb-color-secondary),transparent 82%)}.tb-auto-rental-hero__image{width:100%;height:100%;object-fit:cover;display:block;opacity:.72}.tb-auto-rental-hero__copy{position:relative;z-index:2;max-width:670px;padding:28px;background:color-mix(in srgb,var(--tb-color-secondary) 78%,transparent);border-left:5px solid var(--tb-color-primary)}.tb-auto-rental-hero__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;text-transform:uppercase;letter-spacing:.17em}.tb-auto-rental-hero__title{margin:10px 0;color:var(--tb-color-surface);font-size:clamp(44px,7vw,88px);line-height:.95}.tb-auto-rental-hero__text{color:color-mix(in srgb,var(--tb-color-surface) 80%,transparent);font-size:17px;line-height:1.7}.tb-auto-rental-hero__cta{display:inline-flex;margin-top:22px;padding:12px 18px;background:var(--tb-color-primary);color:var(--tb-color-surface);font-weight:900;text-decoration:none}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Drive your way"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-auto-rental-hero__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "The right car for every road"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-auto-rental-hero__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Present a rental service with a simple promise, strong photography and a direct booking action."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-auto-rental-hero__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cta",
      "label": "Action",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Browse the fleet",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-auto-rental-hero__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "image",
      "label": "Image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1600&q=82",
        "alt": "Car Rental Hero"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-auto-rental-hero__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-auto-rental-hero__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
