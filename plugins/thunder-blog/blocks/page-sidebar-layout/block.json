{
  "settings": {
    "defaults": {
      "sidebar": "right",
      "width": "1200",
      "gap": "32"
    },
    "schema": [
      {
        "key": "sidebar",
        "label": "Sidebar position",
        "type": "select",
        "options": {
          "right": "Right",
          "left": "Left"
        },
        "default": "right"
      },
      {
        "key": "width",
        "label": "Maximum width",
        "type": "select",
        "options": {
          "1000": "Compact",
          "1200": "Standard",
          "1440": "Wide"
        },
        "default": "1200"
      },
      {
        "key": "gap",
        "label": "Column gap",
        "type": "range",
        "min": 12,
        "max": 72,
        "default": 32
      }
    ]
  },
  "elements": [
    {
      "key": "main",
      "label": "Main shortcode",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "shortcode": "[thunder-blog.posts layout=\"large\" order=\"latest\" limit=\"6\"]"
      },
      "schema": [
        {
          "key": "shortcode",
          "label": "Shortcode",
          "type": "shortcode",
          "rows": 4
        }
      ],
      "template": "<div class=\"tb-page-sidebar__dynamic\">{{shortcode}}</div>",
      "min": 1,
      "max": 8,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {}
      }
    },
    {
      "key": "sidebar_items",
      "label": "Sidebar shortcode",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "shortcode": "[thunder-blog.posts layout=\"small\" order=\"popular_week\" limit=\"5\"]"
      },
      "schema": [
        {
          "key": "shortcode",
          "label": "Shortcode",
          "type": "shortcode",
          "rows": 4
        }
      ],
      "template": "<div class=\"tb-page-sidebar__dynamic\">{{shortcode}}</div>",
      "min": 0,
      "max": 8,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {}
      }
    }
  ],
  "html": "<div class=\"tb-block tb-page-sidebar tb-page-sidebar--{{sidebar}}\" style=\"--tb-page-width:{{width}}px;--tb-page-gap:{{gap}}px\"><main class=\"tb-page-sidebar__main\">{{elements:main}}</main><aside class=\"tb-page-sidebar__aside\">{{elements:sidebar_items}}</aside></div>",
  "css": ".tb-page-sidebar{max-width:var(--tb-page-width);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,320px);gap:var(--tb-page-gap);align-items:start}.tb-page-sidebar--left .tb-page-sidebar__main{order:2}.tb-page-sidebar--left .tb-page-sidebar__aside{order:1}.tb-page-sidebar__dynamic+.tb-page-sidebar__dynamic{margin-top:24px}.tb-page-sidebar__aside{position:sticky;top:24px}@media(max-width:780px){.tb-page-sidebar{grid-template-columns:1fr}.tb-page-sidebar--left .tb-page-sidebar__main,.tb-page-sidebar--left .tb-page-sidebar__aside{order:initial}.tb-page-sidebar__aside{position:static}}",
  "js": "",
  "slug": "page-sidebar-layout",
  "name": "Page: Main and Sidebar",
  "category": "Page Layouts",
  "description": "A two-column page shell with separate shortcode regions for main content and a sidebar.",
  "keywords": [
    "page",
    "layout",
    "sidebar",
    "shortcode"
  ],
  "contexts": [
    "page"
  ],
  "version": "1.0.0"
}
