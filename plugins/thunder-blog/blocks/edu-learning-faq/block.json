{
  "slug": "edu-learning-faq",
  "name": "Education FAQ",
  "category": "Education",
  "description": "Clean FAQ list for admissions, courses or online learning questions",
  "keywords": [
    "education",
    "faq",
    "admissions",
    "courses"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-faq\"><div class=\"tb-edu-faq__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-faq__list\">{{elements:faqs}}</div></div>",
  "css": ".tb-edu-faq{display:grid;grid-template-columns:.75fr 1.25fr;gap:42px;padding:clamp(34px,6vw,78px);background:var(--tb-color-background)}.tb-edu-faq__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-faq__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,58px)}.tb-edu-faq__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-faq__faq{padding:22px 0;border-top:1px solid var(--tb-color-border)}.tb-edu-faq__q{margin:0;color:var(--tb-color-secondary);font-size:23px}.tb-edu-faq__a{margin:8px 0 0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:760px){.tb-edu-faq{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Questions, answered"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-faq__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Learning FAQ"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-edu-faq__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Use for admissions, enrollment, course delivery, pricing or campus questions."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-edu-faq__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "faqs",
      "label": "FAQ",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "q": "Can I study part-time?",
        "a": "Yes. Many programs can be taken on a flexible schedule."
      },
      "schema": [
        {
          "key": "q",
          "label": "Question",
          "type": "text",
          "selector": ".tb-edu-faq__q"
        },
        {
          "key": "a",
          "label": "Answer",
          "type": "textarea",
          "selector": ".tb-edu-faq__a",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-edu-faq__faq\"><h3 class=\"tb-edu-faq__q\">{{q}}</h3><p class=\"tb-edu-faq__a\">{{a}}</p></article>",
      "min": 1,
      "max": 16,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "q": "Can I study part-time?",
          "a": "Yes. Many programs can be taken on a flexible schedule."
        },
        {
          "q": "Are certificates included?",
          "a": "Certificate availability depends on the program and completion requirements."
        },
        {
          "q": "How do I get help?",
          "a": "Learners can use the support channels and instructor contact options provided by each course."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
