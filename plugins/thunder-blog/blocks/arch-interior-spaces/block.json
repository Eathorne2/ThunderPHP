{
  "slug": "arch-interior-spaces",
  "name": "Interior Spaces Showcase",
  "category": "Architecture & Building",
  "description": "Editorial architecture project gallery",
  "keywords": [
    "interior",
    "spaces",
    "showcase",
    "gallery"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-arch-interior-spaces\"><div class=\"tb-arch-interior-spaces__head\">{{elements:kicker}}{{elements:title}}</div><div class=\"tb-arch-interior-spaces__gallery\">{{elements:images}}</div></section>",
  "css": ".tb-arch-interior-spaces{padding:clamp(36px,6vw,76px);background:var(--tb-color-background)}.tb-arch-interior-spaces__head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:28px}.tb-arch-interior-spaces__kicker{font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:var(--tb-color-primary)}.tb-arch-interior-spaces__title{font-size:clamp(38px,5vw,62px);line-height:1;margin:10px 0 0;color:var(--tb-color-secondary)}.tb-arch-interior-spaces__gallery{display:grid;grid-template-columns:2fr 1fr 1fr;grid-auto-rows:240px;gap:14px}.tb-arch-interior-spaces__item{min-height:0}.tb-arch-interior-spaces__item:first-child{grid-row:span 2}.tb-arch-interior-spaces__image{width:100%;height:100%;object-fit:cover}@media(max-width:760px){.tb-arch-interior-spaces__gallery{grid-template-columns:1fr 1fr;grid-auto-rows:220px}.tb-arch-interior-spaces__item:first-child{grid-column:span 2;grid-row:auto}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "kicker",
      "label": "Kicker",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Inside the project"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-arch-interior-spaces__kicker\">{{text}}</span>",
      "appearance": {
        "color": true,
