{
  "slug": "wed-luxury-planner-hero",
  "name": "Luxury Wedding Planner Hero",
  "category": "Wedding",
  "description": "Dark luxury wedding-planner hero with image, statement and CTA",
  "keywords": [
    "wedding",
    "planner",
    "luxury",
    "hero"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-luxury-planner\"><div class=\"tb-wed-luxury-planner__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-wed-luxury-planner__media\">{{elements:image}}</div></div>",
  "css": ".tb-wed-luxury-planner{display:grid;grid-template-columns:1fr 1fr;background:var(--tb-color-secondary);color:var(--tb-color-background)}.tb-wed-luxury-planner__copy{padding:clamp(42px,8vw,104px);display:flex;flex-direction:column;justify-content:center}.tb-wed-luxury-planner__eyebrow{color:var(--tb-color-accent);font-size:12px;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.tb-wed-luxury-planner__title{margin:14px 0;font-family:Georgia,serif;font-size:clamp(48px,7vw,86px);font-weight:400;line-height:.98}.tb-wed-luxury-planner__text{opacity:.75;line-height:1.8;font-size:17px}.tb-wed-luxury-planner__cta{align-self:flex-start;margin-top:24px;padding:13px 22px;border:1px solid var(--tb-color-accent);color:var(--tb-color-accent);text-decoration:none;font-weight:900}.tb-wed-luxury-planner__media,.tb-wed-luxury-planner__image{min-height:680px}.tb-wed-luxury-planner__image{width:100%;height:100%;object-fit:cover}@media(max-width:760px){.tb-wed-luxury-planner{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Luxury celebrations"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-luxury-planner__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "We create weddings with a point of view"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-luxury-planner__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Text",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "For couples who want a celebration that feels personal, intentional and effortlessly polished."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-wed-luxury-planner__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cta",
      "label": "Button",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Plan with us",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-wed-luxury-planner__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "image",
      "label": "Planner image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=1400&q=82",
        "alt": "Luxury wedding reception"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-wed-luxury-planner__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-wed-luxury-planner__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
