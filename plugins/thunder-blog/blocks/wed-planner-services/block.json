{
  "slug": "wed-planner-services",
  "name": "Wedding Planner Services",
  "category": "Wedding",
  "description": "Numbered services layout for planners and event agencies",
  "keywords": [
    "wedding",
    "planner",
    "services",
    "agency"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-planner-services\"><div class=\"tb-wed-planner-services__head\">{{elements:eyebrow}}{{elements:title}}{{elements:intro}}</div><div class=\"tb-wed-planner-services__grid\">{{elements:services}}</div></div>",
  "css": ".tb-wed-planner-services{padding:clamp(34px,6vw,78px);background:var(--tb-color-background)}.tb-wed-planner-services__head{display:grid;grid-template-columns:.5fr 1fr;gap:24px;align-items:end;margin-bottom:28px}.tb-wed-planner-services__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-planner-services__title{grid-column:2;margin:0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(40px,5vw,62px);font-weight:400}.tb-wed-planner-services__intro{grid-column:2;color:var(--tb-color-muted);line-height:1.7}.tb-wed-planner-services__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tb-wed-planner-services__service{padding:26px;border:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-wed-planner-services__number{color:var(--tb-color-primary);font-size:12px;font-weight:900}.tb-wed-planner-services__service-title{margin:50px 0 10px;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:30px;font-weight:400}.tb-wed-planner-services__service-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:700px){.tb-wed-planner-services__head{grid-template-columns:1fr}.tb-wed-planner-services__title,.tb-wed-planner-services__intro{grid-column:auto}.tb-wed-planner-services__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Wedding planning"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-planner-services__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Thoughtful planning, beautifully done"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-planner-services__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "intro",
      "label": "Intro",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Flexible support for intimate celebrations, destination weekends and large-scale wedding days."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-wed-planner-services__intro\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "services",
      "label": "Service",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "number": "01",
        "title": "Full planning",
        "text": "From first ideas through the final dance."
      },
      "schema": [
        {
          "key": "number",
          "label": "Number",
          "type": "text",
          "selector": ".tb-wed-planner-services__number"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-wed-planner-services__service-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-wed-planner-services__service-text",
          "rows": 2
        }
      ],
      "template": "<article class=\"tb-wed-planner-services__service\"><span class=\"tb-wed-planner-services__number\">{{number}}</span><h3 class=\"tb-wed-planner-services__service-title\">{{title}}</h3><p class=\"tb-wed-planner-services__service-text\">{{text}}</p></article>",
      "min": 1,
      "max": 8,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "number": "01",
          "title": "Full planning",
          "text": "From first ideas through the final dance."
        },
        {
          "number": "02",
          "title": "Design & styling",
          "text": "A cohesive visual direction for every detail."
        },
        {
          "number": "03",
          "title": "Wedding-day coordination",
          "text": "Calm, experienced support when the day arrives."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
