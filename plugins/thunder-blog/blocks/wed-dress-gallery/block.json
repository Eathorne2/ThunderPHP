{
  "slug": "wed-dress-gallery",
  "name": "Bridal Dress Gallery",
  "category": "Wedding",
  "description": "Editorial bridal fashion cards for gowns and bridal boutiques",
  "keywords": [
    "wedding",
    "dress",
    "bridal",
    "fashion"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-dress-gallery\"><div class=\"tb-wed-dress-gallery__head\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-wed-dress-gallery__grid\">{{elements:dresses}}</div></div>",
  "css": ".tb-wed-dress-gallery{padding:clamp(30px,5vw,68px);background:var(--tb-color-background)}.tb-wed-dress-gallery__head{margin-bottom:24px}.tb-wed-dress-gallery__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-dress-gallery__title{margin:8px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(40px,5vw,62px);font-weight:400}.tb-wed-dress-gallery__grid{display:grid;grid-template-columns:1.25fr .75fr .75fr;gap:14px;align-items:end}.tb-wed-dress-gallery__image{width:100%;aspect-ratio:3/4;object-fit:cover;display:block}.tb-wed-dress-gallery__dress:nth-child(2) .tb-wed-dress-gallery__image,.tb-wed-dress-gallery__dress:nth-child(3) .tb-wed-dress-gallery__image{aspect-ratio:3/3.5}.tb-wed-dress-gallery__name{margin:10px 0 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:24px;font-weight:400}@media(max-width:700px){.tb-wed-dress-gallery__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Bridal edit"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-dress-gallery__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Find your bridal style"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-dress-gallery__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "dresses",
      "label": "Dress",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "image": "https://images.unsplash.com/photo-1594552072238-b8a33785b261?auto=format&fit=crop&w=1400&q=82",
        "alt": "Bridal gown",
        "title": "Sculpted satin"
      },
      "schema": [
        {
          "key": "image",
          "label": "Image",
          "type": "image",
          "selector": ".tb-wed-dress-gallery__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-wed-dress-gallery__name"
        }
      ],
      "template": "<article class=\"tb-wed-dress-gallery__dress\"><img class=\"tb-wed-dress-gallery__image\" src=\"{{image}}\" alt=\"{{alt}}\"><h3 class=\"tb-wed-dress-gallery__name\">{{title}}</h3></article>",
      "min": 1,
      "max": 8,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "image": "https://images.unsplash.com/photo-1594552072238-b8a33785b261?auto=format&fit=crop&w=1400&q=82",
          "alt": "Bridal gown",
          "title": "Sculpted satin"
        },
        {
          "image": "https://images.unsplash.com/photo-1591604466107-ec97de577aff?auto=format&fit=crop&w=1400&q=82",
          "alt": "Wedding dress",
          "title": "Soft romance"
        },
        {
          "image": "https://images.unsplash.com/photo-1594552072238-b8a33785b261?auto=format&fit=crop&w=1400&q=82",
          "alt": "Bridal gown detail",
          "title": "Modern lace"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
