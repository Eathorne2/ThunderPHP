{
  "slug": "arch-featured-project",
  "name": "Featured Project Case Study",
  "category": "Architecture & Building",
  "description": "Split image and content architecture section",
  "keywords": [
    "featured",
    "project",
    "case",
    "study",
    "split"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-arch-featured-project\"><div class=\"tb-arch-featured-project__image-wrap\">{{elements:image}}</div><div class=\"tb-arch-featured-project__content\">{{elements:kicker}}{{elements:title}}{{elements:text}}<div class=\"tb-arch-featured-project__points\">{{elements:points}}</div></div></section>",
  "css": ".tb-arch-featured-project{display:grid;grid-template-columns:1fr 1fr;background:var(--tb-color-background);min-height:520px}.tb-arch-featured-project__image-wrap{min-height:520px}.tb-arch-featured-project__image{width:100%;height:100%;object-fit:cover}.tb-arch-featured-project__content{padding:clamp(36px,6vw,78px);display:flex;flex-direction:column;justify-content:center}.tb-arch-featured-project__kicker{font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:var(--tb-color-primary)}.tb-arch-featured-project__title{margin:12px 0 18px;font-size:clamp(36px,5vw,62px);line-height:1;color:var(--tb-color-secondary)}.tb-arch-featured-project__text{font-size:17px;line-height:1.75;color:var(--tb-color-muted)}.tb-arch-featured-project__points{display:grid;gap:0;margin-top:24px;border-top:1px solid var(--tb-color-border)}.tb-arch-featured-project__point{padding:14px 0;border-bottom:1px solid var(--tb-color-border);font-weight:800;color:var(--tb-color-text)}@media(max-width:780px){.tb-arch-featured-project{grid-template-columns:1fr}.tb-arch-featured-project__image-wrap{min-height:360px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Feature image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=1600&q=82",
        "alt": "Featured Project Case Study"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-arch-featured-project__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-arch-featured-project__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "appearance": {
        "color": false,
        "background_color": false,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "kicker",
      "label": "Kicker",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Featured project"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-arch-featured-project__kicker\">{{text}}</span>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "title",
      "label": "Heading",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "A house built around a shaded courtyard"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-arch-featured-project__title\">{{text}}</h2>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Use a project narrative section for concept, site response and construction decisions."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-arch-featured-project__text\">{{text}}</p>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "points",
      "label": "Key points",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Courtyard-centered plan"
      },
      "schema": [
        {
          "key": "text",
          "label": "Point",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<div class=\"tb-arch-featured-project__point\">{{text}}</div>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 12,
      "default_items": [
        {
          "text": "Courtyard-centered plan"
        },
        {
          "text": "Deep shade and cross ventilation"
        },
        {
          "text": "Local masonry and timber"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
