{
  "slug": "fb-color-story",
  "name": "Seasonal Color Story",
  "category": "Fashion & Beauty",
  "description": "Two editorial fashion panels for seasonal colour storytelling.",
  "keywords": [
    "fashion",
    "color",
    "trend",
    "editorial"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-color-story\"><div class=\"tb-fb-color-story__head\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-fb-color-story__grid\">{{elements:stories}}</div></div>",
  "css": ".tb-fb-color-story{padding:clamp(28px,6vw,76px);background:var(--tb-color-background)}.tb-fb-color-story__head{max-width:760px;margin:0 auto 34px;text-align:center}.tb-fb-color-story__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.tb-fb-color-story__title{margin:10px 0 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,6vw,70px);font-weight:500}.tb-fb-color-story__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.tb-fb-color-story__card{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(220px,.8fr);background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-fb-color-story__image{width:100%;height:100%;min-height:430px;object-fit:cover}.tb-fb-color-story__copy{padding:clamp(22px,4vw,46px);display:flex;flex-direction:column;justify-content:center}.tb-fb-color-story__label{color:var(--tb-color-primary);font-weight:900}.tb-fb-color-story__card-title{margin:14px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:30px}.tb-fb-color-story__card-text{margin:0;color:var(--tb-color-muted);line-height:1.7}@media(max-width:1000px){.tb-fb-color-story__grid{grid-template-columns:1fr}}@media(max-width:560px){.tb-fb-color-story__card{grid-template-columns:1fr}.tb-fb-color-story__image{min-height:330px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Palette notes"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-color-story__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Color stories for the new season"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-fb-color-story__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "stories",
      "label": "Color story",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "image": "https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?auto=format&fit=crop&w=1400&q=82",
        "alt": "Soft neutral outfit",
        "label": "01",
        "title": "Powder neutrals",
        "text": "Warm ivory, blush and sand soften winter layers."
      },
      "schema": [
        {
          "key": "image",
          "label": "Image",
          "type": "image",
          "selector": ".tb-fb-color-story__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        },
        {
          "key": "label",
          "label": "Number / label",
          "type": "text",
          "selector": ".tb-fb-color-story__label"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-fb-color-story__card-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-fb-color-story__card-text",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-fb-color-story__card\"><img class=\"tb-fb-color-story__image\" src=\"{{image}}\" alt=\"{{alt}}\"><div class=\"tb-fb-color-story__copy\"><span class=\"tb-fb-color-story__label\">{{label}}</span><h3 class=\"tb-fb-color-story__card-title\">{{title}}</h3><p class=\"tb-fb-color-story__card-text\">{{text}}</p></div></article>",
      "min": 1,
      "max": 6,
      "default_items": [
        {
          "image": "https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?auto=format&fit=crop&w=1400&q=82",
          "alt": "Soft neutral outfit",
          "label": "01",
          "title": "Powder neutrals",
          "text": "Warm ivory, blush and sand soften winter layers."
        },
        {
          "image": "https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1400&q=82",
          "alt": "Bold fashion portrait",
          "label": "02",
          "title": "Deep contrast",
          "text": "Ink, plum and saturated accents sharpen the silhouette."
        }
      ],
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
