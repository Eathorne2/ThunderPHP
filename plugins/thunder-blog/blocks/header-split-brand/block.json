{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "logo": "{{app_logo}}",
        "url": "{{root}}/"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-h-split-brand__brand-name"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-h-split-brand__logo"
        },
        {
          "key": "url",
          "label": "Home URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-split-brand__brand\" href=\"{{url}}\"><img class=\"tb-h-split-brand__logo\" src=\"{{logo}}\" alt=\"\"><span class=\"tb-h-split-brand__brand-name\">{{name}}</span></a>",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "secondary"
        }
      }
    },
    {
      "key": "cta",
      "label": "Call to action",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Get started",
        "url": "{{root}}/contact"
      },
      "schema": [
        {
          "key": "text",
          "label": "Button text",
          "type": "text",
          "selector": ".tb-h-split-brand__cta"
        },
        {
          "key": "url",
          "label": "Button URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-split-brand__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "background",
          "background_color": "primary"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-h-split-brand__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-h-split-brand__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-h-split-brand__parent\"><a class=\"tb-h-split-brand__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-h-split-brand__chevron\">⌄</span></a><div class=\"tb-h-split-brand__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-h-split-brand__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<header class=\"tb-block tb-h-split-brand\"><div class=\"tb-h-split-brand__inner\" style=\"--tb-h-split-brand-width:{{width}}px\"><div class=\"tb-h-split-brand__row\">{{elements:brand}}<div class=\"tb-h-split-brand__right\">{{menu:primary}}{{elements:cta}}</div></div></div></header>",
  "css": ".tb-h-split-brand{position:relative;background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-h-split-brand__inner{max-width:var(--tb-h-split-brand-width);margin:auto;padding:0 24px}.tb-h-split-brand__brand{display:flex;align-items:center;gap:10px;color:var(--tb-color-secondary);text-decoration:none;font-weight:900}.tb-h-split-brand__logo{width:38px;height:38px;object-fit:contain}.tb-h-split-brand__brand-name{letter-spacing:-.025em}.tb-h-split-brand__nav{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.tb-h-split-brand__link{display:inline-flex;align-items:center;gap:5px;padding:9px 11px;color:inherit;text-decoration:none;font-weight:750}.tb-h-split-brand__link:hover{color:var(--tb-color-primary)}.tb-h-split-brand__parent{position:relative}.tb-h-split-brand__submenu{position:absolute;z-index:20;top:100%;left:0;min-width:190px;padding:8px;border:1px solid var(--tb-color-border);border-radius:12px;background:var(--tb-color-surface);display:none;box-shadow:0 16px 38px color-mix(in srgb,var(--tb-color-secondary) 14%,transparent)}.tb-h-split-brand__submenu .tb-h-split-brand__link{display:flex}.tb-h-split-brand__parent:hover>.tb-h-split-brand__submenu,.tb-h-split-brand__parent:focus-within>.tb-h-split-brand__submenu{display:grid}.tb-h-split-brand__chevron{font-size:10px;opacity:.65}.tb-h-split-brand__row{min-height:88px;display:flex;align-items:center;justify-content:space-between;gap:34px}.tb-h-split-brand__right{display:flex;align-items:center;gap:18px}.tb-h-split-brand__cta{padding:12px 18px;border-radius:999px;text-decoration:none;font-weight:850}@media(max-width:820px){.tb-h-split-brand__row,.tb-h-split-brand__top,.tb-h-split-brand__glass,.tb-h-split-brand__frame,.tb-h-split-brand__pill{flex-wrap:wrap;height:auto;padding-top:14px;padding-bottom:14px}.tb-h-split-brand__nav{width:100%;order:5}.tb-h-split-brand__submenu{position:static;box-shadow:none}}@media(max-width:560px){.tb-h-split-brand__inner{padding-left:16px;padding-right:16px}.tb-h-split-brand__row{grid-template-columns:1fr!important}.tb-h-split-brand__search{width:100%!important}}",
  "js": "",
  "slug": "header-split-brand",
  "name": "Split Brand Header",
  "category": "Headers",
  "description": "A balanced split header with brand, menu and a strong action at opposite edges.",
  "keywords": [
    "header",
    "navigation",
    "menu",
    "split"
  ],
  "contexts": [
    "header"
  ],
  "version": "1.0.0"
}
