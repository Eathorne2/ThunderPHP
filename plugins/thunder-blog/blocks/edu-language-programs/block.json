{
  "slug": "edu-language-programs",
  "name": "Language Programs",
  "category": "Education",
  "description": "Language-center layout with course list and learning image",
  "keywords": [
    "education",
    "language",
    "courses",
    "school"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-language\"><div class=\"tb-edu-language__media\">{{elements:image}}</div><div class=\"tb-edu-language__content\"><div class=\"tb-edu-language__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-language__list\">{{elements:programs}}</div></div></div>",
  "css": ".tb-edu-language{display:grid;grid-template-columns:.85fr 1.15fr;gap:0;background:var(--tb-color-background)}.tb-edu-language__media{min-height:600px}.tb-edu-language__image{width:100%;height:100%;min-height:600px;object-fit:cover}.tb-edu-language__content{padding:clamp(32px,6vw,72px)}.tb-edu-language__eyebrow{color:var(--tb-color-primary);font-weight:900;text-transform:uppercase;letter-spacing:.15em;font-size:12px}.tb-edu-language__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(38px,5vw,60px)}.tb-edu-language__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-language__item{display:grid;grid-template-columns:52px 1fr;gap:16px;padding:20px 0;border-top:1px solid var(--tb-color-border)}.tb-edu-language__code{width:48px;height:48px;display:grid;place-items:center;border-radius:50%;background:var(--tb-color-primary);color:#fff;font-weight:900}.tb-edu-language__item-title{margin:0;color:var(--tb-color-secondary);font-size:22px}.tb-edu-language__item-text{margin:5px 0 0;color:var(--tb-color-muted);line-height:1.55}@media(max-width:760px){.tb-edu-language{grid-template-columns:1fr}.tb-edu-language__media,.tb-edu-language__image{min-height:380px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Language image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1400&q=82",
        "alt": "Language class"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-edu-language__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-edu-language__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Language center"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-language__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Speak with confidence"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-edu-language__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Flexible language programs for school, travel, university and work."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-edu-language__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "programs",
      "label": "Language program",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "code": "EN",
        "title": "English",
        "text": "Conversation, academic and professional pathways."
      },
      "schema": [
        {
          "key": "code",
          "label": "Code",
          "type": "text",
          "selector": ".tb-edu-language__code"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-edu-language__item-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-edu-language__item-text",
          "rows": 2
        }
      ],
      "template": "<article class=\"tb-edu-language__item\"><span class=\"tb-edu-language__code\">{{code}}</span><div><h3 class=\"tb-edu-language__item-title\">{{title}}</h3><p class=\"tb-edu-language__item-text\">{{text}}</p></div></article>",
      "min": 1,
      "max": 10,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "code": "EN",
          "title": "English",
          "text": "Conversation, academic and professional pathways."
        },
        {
          "code": "FR",
          "title": "French",
          "text": "Build speaking confidence with immersive practice."
        },
        {
          "code": "PT",
          "title": "Portuguese",
          "text": "Flexible programs for travel, work and culture."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
