{
  "slug": "sports-membership-pricing",
  "name": "Sports Membership Pricing",
  "category": "Sports",
  "description": "Sports membership and package pricing",
  "keywords": [
    "sports",
    "membership",
    "pricing",
    "pricing"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-sport-membership-pricing\"><div class=\"tb-sport-membership-pricing__head\">{{elements:kicker}}{{elements:heading}}</div><div class=\"tb-sport-membership-pricing__grid\">{{elements:plans}}</div></section>",
  "css": ".tb-sport-membership-pricing{padding:clamp(42px,7vw,88px);background:var(--tb-color-background)}.tb-sport-membership-pricing__head{text-align:center;max-width:700px;margin:0 auto 34px}.tb-sport-membership-pricing__kicker{color:var(--tb-color-primary);text-transform:uppercase;font-weight:900;letter-spacing:.13em;font-size:12px}.tb-sport-membership-pricing__heading{font-size:clamp(36px,5vw,56px);margin:10px 0;color:var(--tb-color-secondary)}.tb-sport-membership-pricing__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1050px;margin:auto}.tb-sport-membership-pricing__card{padding:30px;border:1px solid var(--tb-color-border);border-radius:20px;background:var(--tb-color-surface)}.tb-sport-membership-pricing__label{font-weight:900;text-transform:uppercase;letter-spacing:.09em;font-size:12px}.tb-sport-membership-pricing__price{font-size:46px;font-weight:950;margin:18px 0;color:var(--tb-color-primary)}.tb-sport-membership-pricing__text{color:var(--tb-color-muted);line-height:1.65;min-height:80px}.tb-sport-membership-pricing__link{display:block;text-align:center;padding:13px 16px;border-radius:999px;background:var(--tb-color-secondary);color:var(--tb-color-surface);text-decoration:none;font-weight:900}@media(max-width:760px){.tb-sport-membership-pricing__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "kicker",
      "label": "Kicker",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Membership"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-sport-membership-pricing__kicker\">{{text}}</span>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "heading",
      "label": "Heading",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Train your way"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-sport-membership-pricing__heading\">{{text}}</h2>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "plans",
      "label": "Plans",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "label": "Starter",
        "price": "$19/mo",
        "text": "Open-gym access and community sessions.",
        "url": "#"
      },
      "schema": [
        {
          "key": "label",
          "label": "Plan name",
          "type": "text",
          "selector": ".tb-sport-membership-pricing__label"
        },
        {
          "key": "price",
          "label": "Price",
          "type": "text",
          "selector": ".tb-sport-membership-pricing__price"
        },
        {
          "key": "text",
          "label": "Description",
          "type": "textarea",
          "selector": ".tb-sport-membership-pricing__text",
          "rows": 3
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<article class=\"tb-sport-membership-pricing__card\"><span class=\"tb-sport-membership-pricing__label\">{{label}}</span><div class=\"tb-sport-membership-pricing__price\">{{price}}</div><p class=\"tb-sport-membership-pricing__text\">{{text}}</p><a class=\"tb-sport-membership-pricing__link\" href=\"{{url}}\">Choose plan</a></article>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 6,
      "default_items": [
        {
          "label": "Starter",
          "price": "$19/mo",
          "text": "Open-gym access and community sessions.",
          "url": "#"
        },
        {
          "label": "Performance",
          "price": "$49/mo",
          "text": "Full access plus coached group training.",
          "url": "#"
        },
        {
          "label": "Unlimited",
          "price": "$79/mo",
          "text": "Unlimited classes and priority booking.",
          "url": "#"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
