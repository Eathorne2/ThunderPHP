{
  "slug": "wed-gift-registry",
  "name": "Gift Registry Cards",
  "category": "Wedding",
  "description": "Simple registry choices for gifts, honeymoon funds or charities",
  "keywords": [
    "wedding",
    "registry",
    "gifts",
    "honeymoon"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-registry\"><div class=\"tb-wed-registry__head\">{{elements:eyebrow}}{{elements:title}}{{elements:intro}}</div><div class=\"tb-wed-registry__grid\">{{elements:items}}</div></div>",
  "css": ".tb-wed-registry{padding:clamp(30px,6vw,76px);background:var(--tb-color-background)}.tb-wed-registry__head{max-width:700px;margin:0 auto 30px;text-align:center}.tb-wed-registry__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-registry__title{margin:8px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,5vw,60px);font-weight:400}.tb-wed-registry__intro{color:var(--tb-color-muted);line-height:1.7}.tb-wed-registry__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.tb-wed-registry__card{display:block;padding:30px;border:1px solid var(--tb-color-border);background:var(--tb-color-surface);text-decoration:none}.tb-wed-registry__name{margin:0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:30px;font-weight:400}.tb-wed-registry__text{color:var(--tb-color-muted);line-height:1.65}.tb-wed-registry__arrow{color:var(--tb-color-primary);font-weight:900}@media(max-width:700px){.tb-wed-registry__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "With love"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-registry__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Our gift registry"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-registry__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "intro",
      "label": "Intro",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Your presence is the greatest gift. If you would like to give something more, here are a few ideas."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-wed-registry__intro\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Registry",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "name": "Home & Table",
        "text": "A few pieces for our first home together.",
        "url": "#"
      },
      "schema": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "selector": ".tb-wed-registry__name"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-wed-registry__text",
          "rows": 2
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-wed-registry__card\" href=\"{{url}}\"><h3 class=\"tb-wed-registry__name\">{{name}}</h3><p class=\"tb-wed-registry__text\">{{text}}</p><span class=\"tb-wed-registry__arrow\">View registry →</span></a>",
      "min": 1,
      "max": 6,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "name": "Home & Table",
          "text": "A few pieces for our first home together.",
          "url": "#"
        },
        {
          "name": "Honeymoon Fund",
          "text": "Help us make memories on our first adventure.",
          "url": "#"
        },
        {
          "name": "Local Charity",
          "text": "Give to a cause close to our hearts.",
          "url": "#"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
