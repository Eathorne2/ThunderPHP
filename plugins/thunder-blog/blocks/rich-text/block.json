{
  "slug": "rich-text",
  "name": "Rich Text",
  "category": "Article",
  "description": "A readable body-text block for paragraphs, lists and emphasis.",
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-block--rich-text\">{{elements:content}}</div>",
  "css": ".tb-block--rich-text{max-width:760px;margin:0 auto;padding:8px 0}.tb-rich-text__content{color:var(--tb-color-text);font-size:18px;line-height:1.82}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "content",
      "label": "Rich text",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "html": "<p>Write a focused paragraph here. You can use <strong>strong emphasis</strong>, <em>italics</em>, links and simple lists.</p><p>Keep each section purposeful and easy to scan.</p>"
      },
      "schema": [
        {
          "key": "html",
          "label": "Content",
          "type": "richtext",
          "selector": ":scope",
          "rows": 12,
          "help": "Allowed formatting: paragraphs, emphasis, links and lists."
        }
      ],
      "template": "<div class=\"tb-rich-text__content\">{{html}}</div>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
