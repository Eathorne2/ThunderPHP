{
  "slug": "wed-photographer-portfolio",
  "name": "Wedding Photographer Portfolio",
  "category": "Wedding",
  "description": "Editorial image portfolio for wedding photographers and photo stories",
  "keywords": [
    "wedding",
    "photographer",
    "portfolio",
    "gallery"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-photo-portfolio\"><div class=\"tb-wed-photo-portfolio__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-wed-photo-portfolio__grid\">{{elements:photos}}</div></div>",
  "css": ".tb-wed-photo-portfolio{display:grid;grid-template-columns:minmax(240px,.55fr) minmax(0,1.45fr);gap:28px;padding:clamp(30px,5vw,68px);background:var(--tb-color-background)}.tb-wed-photo-portfolio__copy{position:sticky;top:24px;align-self:start}.tb-wed-photo-portfolio__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-photo-portfolio__title{margin:8px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,5vw,58px);font-weight:400}.tb-wed-photo-portfolio__text{color:var(--tb-color-muted);line-height:1.7}.tb-wed-photo-portfolio__cta{display:inline-block;margin-top:16px;color:var(--tb-color-primary);font-weight:900;text-decoration:none}.tb-wed-photo-portfolio__grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.tb-wed-photo-portfolio__photo{width:100%;aspect-ratio:4/5;object-fit:cover}.tb-wed-photo-portfolio__item:nth-child(even){margin-top:64px}@media(max-width:760px){.tb-wed-photo-portfolio{grid-template-columns:1fr}.tb-wed-photo-portfolio__copy{position:static}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Photography"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-photo-portfolio__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
