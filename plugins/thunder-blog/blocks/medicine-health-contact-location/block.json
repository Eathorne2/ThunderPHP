{
  "slug": "medicine-health-contact-location",
  "name": "Clinic Contact & Location",
  "category": "Medicine & Science",
  "description": "Contact details with medical-center image",
  "keywords": [
    "contact",
    "clinic",
    "location"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-health-contact-location\"><div class=\"tb-med-health-contact-location__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-med-health-contact-location__details\">{{elements:details}}</div></div>{{elements:image}}</section>",
  "css": ".tb-med-health-contact-location{display:grid;grid-template-columns:1fr 1fr;background:var(--tb-color-secondary);color:var(--tb-color-surface)}.tb-med-health-contact-location__copy{padding:clamp(42px,7vw,88px)}.tb-med-health-contact-location__eyebrow{color:var(--tb-color-accent);font-size:12px;text-transform:uppercase;font-weight:900;letter-spacing:.14em}.tb-med-health-contact-location__title{font-size:clamp(38px,5vw,62px);line-height:1;margin:10px 0 15px}.tb-med-health-contact-location__text{line-height:1.75;opacity:.82}.tb-med-health-contact-location__details{margin-top:28px;display:grid;gap:14px}.tb-med-health-contact-location__detail{display:grid;grid-template-columns:38px 1fr;gap:12px}.tb-med-health-contact-location__detail__icon{color:var(--tb-color-accent);font-size:20px}.tb-med-health-contact-location__detail__title{font-size:14px;margin:0 0 3px;text-transform:uppercase;letter-spacing:.08em}.tb-med-health-contact-location__detail__text{margin:0;opacity:.78}.tb-med-health-contact-location__image{width:100%;height:100%;min-height:560px;object-fit:cover}@media(max-width:760px){.tb-med-health-contact-location{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Contact us"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-med-health-contact-location__eyebrow\">{{text}}</span>",
      "appearance": {
        "color": true,
