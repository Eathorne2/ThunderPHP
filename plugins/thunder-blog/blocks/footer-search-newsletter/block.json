{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200",
      "search_placeholder": "Search stories"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      },
      {
        "key": "search_placeholder",
        "label": "Search placeholder",
        "type": "text",
        "default": "Search stories"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand statement",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "text": "{{app_description}}",
        "logo": "{{app_logo}}"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-f-search-newsletter__brand-name"
        },
        {
          "key": "text",
          "label": "Brand text",
          "type": "textarea",
          "selector": ".tb-f-search-newsletter__brand-text"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-f-search-newsletter__logo"
        }
      ],
      "template": "<div class=\"tb-f-search-newsletter__brand\"><img class=\"tb-f-search-newsletter__logo\" src=\"{{logo}}\" alt=\"\"><strong class=\"tb-f-search-newsletter__brand-name\">{{name}}</strong><p class=\"tb-f-search-newsletter__brand-text\">{{text}}</p></div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "text"
        }
      }
    },
    {
      "key": "copyright",
      "label": "Copyright",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "© {{year}} {{app_name}}. All rights reserved."
      },
      "schema": [
        {
          "key": "text",
          "label": "Copyright text",
          "type": "text",
          "selector": ".tb-f-search-newsletter__copyright"
        }
      ],
      "template": "<div class=\"tb-f-search-newsletter__copyright\">{{text}}</div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    },
    {
      "key": "newsletter",
      "label": "Newsletter",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "heading": "Join the newsletter",
        "text": "Get new stories and updates delivered to your inbox.",
        "button": "Subscribe"
      },
      "schema": [
        {
          "key": "heading",
          "label": "Heading",
          "type": "text",
          "selector": ".tb-f-search-newsletter__newsletter-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-f-search-newsletter__newsletter-text"
        },
        {
          "key": "button",
          "label": "Button text",
          "type": "text",
          "selector": ".tb-f-search-newsletter__newsletter-button"
        }
      ],
      "template": "<div class=\"tb-f-search-newsletter__newsletter\"><strong class=\"tb-f-search-newsletter__newsletter-title\">{{heading}}</strong><p class=\"tb-f-search-newsletter__newsletter-text\">{{text}}</p><div class=\"tb-f-search-newsletter__newsletter-form\"><span class=\"tb-f-search-newsletter__newsletter-input\">email@example.com</span><button class=\"tb-f-search-newsletter__newsletter-button\" type=\"button\">{{button}}</button></div></div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "text",
          "background_color": "background"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-f-search-newsletter__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-f-search-newsletter__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-f-search-newsletter__parent\"><a class=\"tb-f-search-newsletter__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-f-search-newsletter__chevron\">⌄</span></a><div class=\"tb-f-search-newsletter__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-f-search-newsletter__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<footer class=\"tb-block tb-f-search-newsletter\"><div class=\"tb-f-search-newsletter__inner\" style=\"--tb-f-search-newsletter-width:{{width}}px\"><div class=\"tb-f-search-newsletter__top\">{{elements:brand}}<form class=\"tb-f-search-newsletter__search\" action=\"{{root}}/blog/search\" method=\"get\"><input class=\"tb-f-search-newsletter__search-input\" name=\"q\" placeholder=\"{{search_placeholder}}\"><button class=\"tb-f-search-newsletter__search-button\" type=\"submit\">Search</button></form></div><div class=\"tb-f-search-newsletter__grid\">{{elements:newsletter}}{{menu:primary}}</div><div class=\"tb-f-search-newsletter__legal\">{{elements:copyright}}</div></div></footer>",
  "css": ".tb-f-search-newsletter{background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-f-search-newsletter__inner{max-width:var(--tb-f-search-newsletter-width);margin:auto;padding:52px 24px 24px}.tb-f-search-newsletter__brand{display:grid;gap:10px;align-content:start}.tb-f-search-newsletter__logo{width:42px;height:42px;object-fit:contain}.tb-f-search-newsletter__brand-name{font-size:20px}.tb-f-search-newsletter__brand-text{max-width:360px;margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-f-search-newsletter__copyright{color:var(--tb-color-muted);font-size:12px}.tb-f-search-newsletter__nav{display:grid;gap:10px}.tb-f-search-newsletter__link{color:inherit;text-decoration:none;opacity:.78}.tb-f-search-newsletter__link:hover{opacity:1;color:var(--tb-color-primary)}.tb-f-search-newsletter__parent{display:grid;gap:8px}.tb-f-search-newsletter__parent>.tb-f-search-newsletter__link{font-weight:850;opacity:1}.tb-f-search-newsletter__submenu{display:grid;gap:7px;padding-left:0}.tb-f-search-newsletter__chevron{display:none}.tb-f-search-newsletter__top{display:flex;align-items:center;justify-content:space-between;gap:28px}.tb-f-search-newsletter__search{width:min(420px,50%);height:42px;border:1px solid var(--tb-color-border);display:flex}.tb-f-search-newsletter__search-input{min-width:0;flex:1;padding:0 12px;border:0;background:transparent;color:var(--tb-color-text)}.tb-f-search-newsletter__search-button{padding:0 14px;border:0;background:var(--tb-color-secondary);color:var(--tb-color-background);font-weight:800}.tb-f-search-newsletter__grid{margin-top:34px;display:grid;grid-template-columns:1fr 1.2fr;gap:48px}.tb-f-search-newsletter__newsletter{padding:22px;border-radius:14px}.tb-f-search-newsletter__newsletter-text{color:var(--tb-color-muted)}.tb-f-search-newsletter__newsletter-form{height:42px;border:1px solid var(--tb-color-border);display:flex}.tb-f-search-newsletter__newsletter-input{padding:11px;flex:1;color:var(--tb-color-muted)}.tb-f-search-newsletter__newsletter-button{border:0;background:var(--tb-color-primary);color:var(--tb-color-background)}.tb-f-search-newsletter__nav{grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tb-f-search-newsletter__legal{margin-top:30px;padding-top:16px;border-top:1px solid var(--tb-color-border)}@media(max-width:820px){.tb-f-search-newsletter__grid,.tb-f-search-newsletter__top,.tb-f-search-newsletter__row,.tb-f-search-newsletter__bottom{grid-template-columns:1fr;flex-wrap:wrap}.tb-f-search-newsletter__nav{grid-template-columns:repeat(2,minmax(0,1fr))}.tb-f-search-newsletter__contacts{grid-template-columns:1fr}}@media(max-width:520px){.tb-f-search-newsletter__inner{padding-left:16px;padding-right:16px}.tb-f-search-newsletter__nav{grid-template-columns:1fr}.tb-f-search-newsletter__search{width:100%!important}}",
  "js": "",
  "slug": "footer-search-newsletter",
  "name": "Search Newsletter Footer",
  "category": "Footers",
  "description": "A footer combining blog search, newsletter copy and saved links.",
  "keywords": [
    "footer",
    "navigation",
    "menu",
    "searchnews"
  ],
  "contexts": [
    "footer"
  ],
  "version": "1.0.0"
}
