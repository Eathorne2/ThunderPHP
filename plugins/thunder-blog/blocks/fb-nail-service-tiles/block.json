        }
      ],
      "template": "<article class=\"tb-fb-nails__tile\"><h3 class=\"tb-fb-nails__tile-title\">{{title}}</h3><p class=\"tb-fb-nails__tile-text\">{{text}}</p></article>",
      "min": 1,
      "max": 8,
      "default_items": [
        {
