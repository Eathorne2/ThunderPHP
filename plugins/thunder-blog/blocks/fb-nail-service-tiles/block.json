{
  "slug": "fb-nail-service-tiles",
  "name": "Nail Service Tiles",
  "category": "Fashion & Beauty",
  "description": "Bold four-tile nail service section with a large supporting image.",
  "keywords": [
    "beauty",
    "nails",
    "services",
    "salon"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-nails\"><div class=\"tb-fb-nails__intro\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-fb-nails__layout\">{{elements:image}}<div class=\"tb-fb-nails__tiles\">{{elements:tiles}}</div></div></div>",
  "css": ".tb-fb-nails{padding:clamp(28px,6vw,76px);background:var(--tb-color-surface)}.tb-fb-nails__intro{max-width:720px;margin-bottom:28px}.tb-fb-nails__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-nails__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,5vw,62px);font-weight:500}.tb-fb-nails__text{color:var(--tb-color-muted);line-height:1.7}.tb-fb-nails__layout{display:grid;grid-template-columns:1fr 1fr;gap:14px}.tb-fb-nails__image{width:100%;height:100%;min-height:500px;object-fit:cover}.tb-fb-nails__tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.tb-fb-nails__tile{padding:28px;background:color-mix(in srgb,var(--tb-color-primary) 9%,var(--tb-color-background));display:flex;flex-direction:column;justify-content:end;min-height:240px}.tb-fb-nails__tile-title{margin:0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:27px}.tb-fb-nails__tile-text{margin:8px 0 0;color:var(--tb-color-muted);line-height:1.6}@media(max-width:760px){.tb-fb-nails__layout{grid-template-columns:1fr}.tb-fb-nails__tiles{grid-template-columns:1fr}.tb-fb-nails__image{min-height:380px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Nail studio"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-nails__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "The finishing touch"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-fb-nails__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A visual service section for nail bars and beauty studios."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-fb-nails__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "image",
      "label": "Nail image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1400&q=82",
        "alt": "Modern manicure detail"
      },
      "schema": [
