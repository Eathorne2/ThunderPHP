  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-alumni\"><div class=\"tb-edu-alumni__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-alumni__list\">{{elements:items}}</div></div>",
  "css": ".tb-edu-alumni{padding:clamp(34px,6vw,78px);background:var(--tb-color-secondary);color:#fff}.tb-edu-alumni__head{max-width:800px;margin-bottom:28px}.tb-edu-alumni__eyebrow{color:var(--tb-color-accent);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-alumni__title{margin:8px 0;color:inherit;font-size:clamp(40px,5vw,62px)}.tb-edu-alumni__text{color:inherit;opacity:.75;line-height:1.7}.tb-edu-alumni__item{display:grid;grid-template-columns:100px .8fr 1fr;gap:24px;padding:22px 0;border-top:1px solid rgba(255,255,255,.25)}.tb-edu-alumni__year{color:var(--tb-color-accent);font-weight:950}.tb-edu-alumni__item-title{margin:0;color:inherit;font-size:24px}.tb-edu-alumni__item-text{margin:0;color:inherit;opacity:.75;line-height:1.6}@media(max-width:650px){.tb-edu-alumni__item{grid-template-columns:1fr;gap:6px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
