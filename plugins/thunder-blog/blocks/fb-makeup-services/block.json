{
  "slug": "fb-makeup-services",
  "name": "Makeup Artist Services",
  "category": "Fashion & Beauty",
  "description": "Portrait-led makeup services with a clean numbered list.",
  "keywords": [
    "beauty",
    "makeup",
    "artist",
    "services"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-makeup\"><div class=\"tb-fb-makeup__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-fb-makeup__services\">{{elements:services}}</div></div>{{elements:image}}</div>",
  "css": ".tb-fb-makeup{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.85fr);gap:clamp(28px,6vw,80px);padding:clamp(30px,6vw,78px);background:var(--tb-color-background);align-items:center}.tb-fb-makeup__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.tb-fb-makeup__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(40px,6vw,68px);font-weight:500}.tb-fb-makeup__text{max-width:620px;color:var(--tb-color-muted);line-height:1.75}.tb-fb-makeup__services{counter-reset:services;display:grid;gap:0;margin-top:24px}.tb-fb-makeup__service{counter-increment:services;display:grid;grid-template-columns:46px 1fr;gap:14px;padding:18px 0;border-top:1px solid var(--tb-color-border)}.tb-fb-makeup__service:before{content:counter(services,decimal-leading-zero);color:var(--tb-color-primary);font-weight:900}.tb-fb-makeup__service-title{margin:0;color:var(--tb-color-secondary);font-size:19px}.tb-fb-makeup__service-text{margin:6px 0 0;color:var(--tb-color-muted);line-height:1.6}.tb-fb-makeup__image{width:100%;aspect-ratio:4/5;object-fit:cover;display:block}@media(max-width:760px){.tb-fb-makeup{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Artist services"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-makeup__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Makeup with a point of view"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-fb-makeup__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Introduce your approach, then let clients scan the services that fit their moment."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-fb-makeup__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "services",
      "label": "Service",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "title": "Editorial Makeup",
        "text": "Camera-ready finish for campaigns and shoots."
      },
      "schema": [
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-fb-makeup__service-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-fb-makeup__service-text",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-fb-makeup__service\"><div><h3 class=\"tb-fb-makeup__service-title\">{{title}}</h3><p class=\"tb-fb-makeup__service-text\">{{text}}</p></div></article>",
      "min": 1,
      "max": 8,
      "default_items": [
        {
          "title": "Editorial Makeup",
          "text": "Camera-ready finish for campaigns and shoots."
        },
        {
          "title": "Occasion Beauty",
          "text": "Refined makeup tailored to your event and style."
        },
        {
          "title": "Personal Lesson",
          "text": "Build a routine that feels effortless and repeatable."
        }
      ],
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "image",
      "label": "Portrait",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=1400&q=82",
        "alt": "Makeup artist beauty portrait"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-fb-makeup__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-fb-makeup__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
