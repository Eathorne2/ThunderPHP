{
  "slug": "sports-contact-location",
  "name": "Sports Club Contact & Location",
  "category": "Sports",
  "description": "Contact and location panel for sports venues",
  "keywords": [
    "contact",
    "location",
    "club",
    "venue"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-sport-contact-location\"><div class=\"tb-sport-contact-location__info\">{{elements:kicker}}{{elements:heading}}{{elements:text}}<div class=\"tb-sport-contact-location__details\">{{elements:details}}</div></div><div class=\"tb-sport-contact-location__media\">{{elements:image}}</div></section>",
  "css": ".tb-sport-contact-location{display:grid;grid-template-columns:1fr 1fr;background:var(--tb-color-secondary);color:var(--tb-color-surface)}.tb-sport-contact-location__info{padding:clamp(42px,7vw,88px)}.tb-sport-contact-location__kicker{font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:900;color:var(--tb-color-primary)}.tb-sport-contact-location__heading{font-size:clamp(38px,5vw,62px);margin:12px 0 18px}.tb-sport-contact-location__text{line-height:1.7;color:color-mix(in srgb,var(--tb-color-surface) 72%,transparent)}.tb-sport-contact-location__details{display:grid;gap:0;margin-top:28px}.tb-sport-contact-location__detail{padding:16px 0;border-top:1px solid color-mix(in srgb,var(--tb-color-surface) 24%,transparent)}.tb-sport-contact-location__detail strong{display:block;margin-bottom:5px}.tb-sport-contact-location__image{width:100%;height:100%;min-height:560px;object-fit:cover}@media(max-width:760px){.tb-sport-contact-location{grid-template-columns:1fr}.tb-sport-contact-location__image{min-height:360px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "kicker",
      "label": "Kicker",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Visit the club"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-sport-contact-location__kicker\">{{text}}</span>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "heading",
      "label": "Heading",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Come train with us"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-sport-contact-location__heading\">{{text}}</h2>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Use this section for venue details, opening times and the simplest way to get in touch."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-sport-contact-location__text\">{{text}}</p>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "details",
      "label": "Contact details",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "label": "Address",
        "value": "24 Arena Road, City Center"
      },
      "schema": [
        {
          "key": "label",
          "label": "Label",
          "type": "text",
          "selector": "strong"
        },
        {
          "key": "value",
          "label": "Value",
          "type": "text",
          "selector": "span"
        }
      ],
      "template": "<div class=\"tb-sport-contact-location__detail\"><strong>{{label}}</strong><span>{{value}}</span></div>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8,
      "default_items": [
        {
          "label": "Address",
          "value": "24 Arena Road, City Center"
        },
        {
          "label": "Hours",
          "value": "Mon–Sat · 05:30–21:00"
        },
        {
          "label": "Phone",
          "value": "+260 000 000 000"
        }
      ]
    },
    {
      "key": "image",
      "label": "Venue image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=1600&q=82",
        "alt": "Sports venue"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-sport-contact-location__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-sport-contact-location__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
