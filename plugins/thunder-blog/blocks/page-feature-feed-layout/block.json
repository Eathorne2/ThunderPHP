{
  "settings": {
    "defaults": {
      "width": "1200"
    },
    "schema": [
      {
        "key": "width",
        "label": "Maximum width",
        "type": "select",
        "options": {
          "1000": "Compact",
          "1200": "Standard",
          "1440": "Wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "feature",
      "label": "Feature shortcode",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "shortcode": "[thunder-blog.posts layout=\"large\" order=\"featured\" limit=\"1\"]"
      },
      "schema": [
        {
          "key": "shortcode",
          "label": "Shortcode",
          "type": "shortcode",
          "rows": 4
        }
      ],
      "template": "<section class=\"tb-feature-feed__feature\">{{shortcode}}</section>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {}
      }
    },
    {
      "key": "feeds",
      "label": "Feed section",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "heading": "Latest stories",
        "shortcode": "[thunder-blog.posts layout=\"grid\" order=\"latest\" limit=\"6\"]"
      },
      "schema": [
        {
          "key": "heading",
          "label": "Heading",
          "type": "text",
          "selector": ".tb-feature-feed__heading"
        },
        {
          "key": "shortcode",
          "label": "Shortcode",
          "type": "shortcode",
          "rows": 4
        }
      ],
      "template": "<section class=\"tb-feature-feed__section\"><h2 class=\"tb-feature-feed__heading\">{{heading}}</h2>{{shortcode}}</section>",
      "min": 1,
      "max": 8,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {}
      }
    }
  ],
  "html": "<div class=\"tb-block tb-feature-feed\" style=\"--tb-page-width:{{width}}px\">{{elements:feature}}{{elements:feeds}}</div>",
  "css": ".tb-feature-feed{max-width:var(--tb-page-width);margin:0 auto}.tb-feature-feed__feature{margin-bottom:48px}.tb-feature-feed__section+.tb-feature-feed__section{margin-top:52px}.tb-feature-feed__heading{margin:0 0 20px;padding-bottom:12px;border-bottom:1px solid var(--tb-color-border);color:var(--tb-color-secondary);font-size:28px}",
  "js": "",
  "slug": "page-feature-feed-layout",
  "name": "Page: Feature and Feed",
  "category": "Page Layouts",
  "description": "A page layout with a large feature region followed by repeatable dynamic feed sections.",
  "keywords": [
    "page",
    "layout",
    "feature",
    "feed",
    "shortcode"
  ],
  "contexts": [
    "page"
  ],
  "version": "1.0.0"
}
