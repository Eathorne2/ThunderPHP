{
  "slug": "newsletter-banner",
  "name": "Newsletter Banner",
  "category": "Call to Action",
  "description": "An email-style subscription prompt that other plugins can later connect to.",
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-block--newsletter-banner\">\n  <div class=\"tb-newsletter-banner__content\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div>\n  {{elements:form}}\n</div>",
  "css": ".tb-block--newsletter-banner{padding:32px;border:1px solid var(--tb-color-border);border-radius:20px;background:linear-gradient(135deg,color-mix(in srgb,var(--tb-color-primary) 12%,var(--tb-color-surface)),var(--tb-color-surface));display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.8fr);align-items:center;gap:28px}.tb-newsletter-banner__eyebrow{display:block;color:var(--tb-color-primary);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.12em}.tb-newsletter-banner__title{margin:7px 0 0;color:var(--tb-color-secondary);font-size:30px}.tb-newsletter-banner__text{margin:10px 0 0;color:var(--tb-color-muted);line-height:1.6}.tb-newsletter-banner__form{padding:6px;border:1px solid var(--tb-color-border);border-radius:12px;background:var(--tb-color-surface);display:flex;gap:6px}.tb-newsletter-banner__input{min-width:0;flex:1;padding:0 10px;border:0;background:transparent;color:var(--tb-color-text);outline:none}.tb-newsletter-banner__button{padding:11px 15px;border-radius:8px;background:var(--tb-color-primary);color:#fff;font-weight:850;text-decoration:none;white-space:nowrap}@media(max-width:760px){.tb-block--newsletter-banner{grid-template-columns:1fr}.tb-newsletter-banner__form{align-items:stretch;flex-direction:column}.tb-newsletter-banner__input{min-height:42px}.tb-newsletter-banner__button{text-align:center}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Stay informed"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-newsletter-banner__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Get the next story in your inbox"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h3 class=\"tb-newsletter-banner__title\">{{text}}</h3>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Text",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Connect this call to action to a subscription plugin or newsletter page."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 4
        }
      ],
      "template": "<p class=\"tb-newsletter-banner__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "form",
      "label": "Subscription form",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "placeholder": "you@example.com",
        "button_text": "Subscribe",
        "url": "#"
      },
      "schema": [
        {
          "key": "placeholder",
          "label": "Email placeholder",
          "type": "text"
        },
        {
          "key": "button_text",
          "label": "Button text",
          "type": "text",
          "selector": ".tb-newsletter-banner__button"
        },
        {
          "key": "url",
          "label": "Button URL",
          "type": "url"
        }
      ],
      "template": "<div class=\"tb-newsletter-banner__form\"><input class=\"tb-newsletter-banner__input\" type=\"email\" placeholder=\"{{placeholder}}\" disabled><a class=\"tb-newsletter-banner__button\" href=\"{{url}}\">{{button_text}}</a></div>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
