  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-sport-martial-arts-classes\"><div class=\"tb-sport-martial-arts-classes__head\">{{elements:kicker}}{{elements:heading}}</div><div class=\"tb-sport-martial-arts-classes__grid\">{{elements:cards}}</div></section>",
  "css": ".tb-sport-martial-arts-classes{padding:clamp(40px,7vw,86px);background:var(--tb-color-background)}.tb-sport-martial-arts-classes__head{max-width:760px;margin-bottom:34px}.tb-sport-martial-arts-classes__kicker{font-size:12px;font-weight:900;letter-spacing:.15em;text-transform:uppercase;color:var(--tb-color-primary)}.tb-sport-martial-arts-classes__heading{font-size:clamp(34px,5vw,58px);line-height:1.05;margin:10px 0;color:var(--tb-color-secondary)}.tb-sport-martial-arts-classes__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tb-sport-martial-arts-classes__card{background:var(--tb-color-surface);border:1px solid var(--tb-color-border);overflow:hidden;border-radius:18px}.tb-sport-martial-arts-classes__card-image{width:100%;height:220px;object-fit:cover}.tb-sport-martial-arts-classes__card-body{padding:22px}.tb-sport-martial-arts-classes__card-title{font-size:22px;margin:0 0 10px;color:var(--tb-color-secondary)}.tb-sport-martial-arts-classes__card-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:860px){.tb-sport-martial-arts-classes__grid{grid-template-columns:1fr 1fr}}@media(max-width:560px){.tb-sport-martial-arts-classes__grid{grid-template-columns:1fr}}",
  "js": "",
