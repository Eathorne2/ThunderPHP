{
  "slug": "wed-venue-feature",
  "name": "Wedding Venue Feature",
  "category": "Wedding",
  "description": "Large venue image with address, description and directions link",
  "keywords": [
    "wedding",
    "venue",
    "location",
    "directions"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-venue\"><div class=\"tb-wed-venue__image-wrap\">{{elements:image}}</div><div class=\"tb-wed-venue__card\">{{elements:eyebrow}}{{elements:title}}{{elements:address}}{{elements:text}}{{elements:cta}}</div></div>",
  "css": ".tb-wed-venue{position:relative;padding:clamp(24px,5vw,64px);background:var(--tb-color-background)}.tb-wed-venue__image-wrap{min-height:600px}.tb-wed-venue__image{width:100%;height:600px;object-fit:cover;display:block}.tb-wed-venue__card{position:absolute;right:clamp(38px,8vw,110px);bottom:clamp(38px,8vw,110px);width:min(440px,calc(100% - 76px));padding:32px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-wed-venue__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-venue__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:38px;font-weight:400}.tb-wed-venue__address{font-weight:800;color:var(--tb-color-text)}.tb-wed-venue__text{color:var(--tb-color-muted);line-height:1.7}.tb-wed-venue__cta{display:inline-block;margin-top:12px;color:var(--tb-color-primary);font-weight:900;text-decoration:none}@media(max-width:700px){.tb-wed-venue__card{position:relative;right:auto;bottom:auto;width:auto;margin:-60px 18px 0}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Venue image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=1400&q=82",
        "alt": "Wedding venue"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-wed-venue__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-wed-venue__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "The venue"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-venue__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Venue name",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "The Garden Estate"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-venue__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "address",
      "label": "Address",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "12 Willow Lane · Lusaka"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<p class=\"tb-wed-venue__address\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "An intimate garden setting for our ceremony, followed by dinner and dancing under the lights."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-wed-venue__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cta",
      "label": "Directions link",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Get directions",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-wed-venue__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
