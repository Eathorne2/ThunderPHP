  "css": ".tb-med-wellness-programs{padding:clamp(42px,7vw,88px);background:var(--tb-color-background)}.tb-med-wellness-programs__head{max-width:780px;margin-bottom:34px}.tb-med-wellness-programs__eyebrow{display:block;color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.tb-med-wellness-programs__title{font-size:clamp(36px,5vw,60px);line-height:1.05;margin:10px 0 14px;color:var(--tb-color-secondary)}.tb-med-wellness-programs__text{color:var(--tb-color-muted);font-size:17px;line-height:1.7}.tb-med-wellness-programs__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tb-med-wellness-programs__card{padding:26px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border);border-radius:16px}.tb-med-wellness-programs__card__icon{font-size:24px;color:var(--tb-color-primary)}.tb-med-wellness-programs__card__title{font-size:20px;margin:14px 0 8px;color:var(--tb-color-secondary)}.tb-med-wellness-programs__card__text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:900px){.tb-med-wellness-programs__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.tb-med-wellness-programs__grid{grid-template-columns:1fr}}",
