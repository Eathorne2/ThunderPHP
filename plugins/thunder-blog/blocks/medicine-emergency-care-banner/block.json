{
  "slug": "medicine-emergency-care-banner",
  "name": "Emergency Care Banner",
  "category": "Medicine & Science",
  "description": "High-visibility urgent care information banner",
  "keywords": [
    "emergency",
    "urgent care",
    "banner"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-emergency-care-banner\"><div class=\"tb-med-emergency-care-banner__icon\">+</div><div>{{elements:title}}{{elements:text}}</div>{{elements:cta}}</section>",
  "css": ".tb-med-emergency-care-banner{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:22px;padding:28px 32px;background:var(--tb-color-secondary);color:var(--tb-color-surface);border-left:8px solid var(--tb-color-accent)}.tb-med-emergency-care-banner__icon{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;background:var(--tb-color-accent);color:var(--tb-color-secondary);font-size:30px;font-weight:900}.tb-med-emergency-care-banner__title{font-size:28px;margin:0 0 6px}.tb-med-emergency-care-banner__text{margin:0;opacity:.82;line-height:1.6}.tb-med-emergency-care-banner__cta{padding:12px 16px;border:1px solid currentColor;color:inherit;text-decoration:none;font-weight:900}@media(max-width:700px){.tb-med-emergency-care-banner{grid-template-columns:auto 1fr}.tb-med-emergency-care-banner__cta{grid-column:1/-1;justify-self:start}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "title",
      "label": "Title",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Urgent care when every minute matters"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-med-emergency-care-banner__title\">{{text}}</h2>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Use this banner for urgent-care hours, emergency contact guidance or rapid assistance."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-med-emergency-care-banner__text\">{{text}}</p>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    },
    {
      "key": "cta",
      "label": "Action",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Get help",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-med-emergency-care-banner__cta\" href=\"{{url}}\">{{text}}</a>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
