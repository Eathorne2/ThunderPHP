{
  "slug": "medicine-telemedicine-feature",
  "name": "Virtual Care Feature",
  "category": "Medicine & Science",
  "description": "Telemedicine and online consultation section",
  "keywords": [
    "telemedicine",
    "virtual care",
    "doctor"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-telemedicine-feature\"><div class=\"tb-med-telemedicine-feature__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-med-telemedicine-feature__device\">{{elements:image}}<div class=\"tb-med-telemedicine-feature__status\">● Doctor online</div></div></section>",
  "css": ".tb-med-telemedicine-feature{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center;padding:clamp(42px,7vw,88px);background:linear-gradient(135deg,var(--tb-color-background),var(--tb-color-surface))}.tb-med-telemedicine-feature__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.tb-med-telemedicine-feature__title{font-size:clamp(40px,5vw,66px);margin:10px 0 16px;color:var(--tb-color-secondary);line-height:1}.tb-med-telemedicine-feature__text{color:var(--tb-color-muted);font-size:17px;line-height:1.75}.tb-med-telemedicine-feature__cta{display:inline-block;margin-top:22px;padding:14px 19px;background:var(--tb-color-primary);color:var(--tb-color-surface);text-decoration:none;border-radius:12px;font-weight:900}.tb-med-telemedicine-feature__device{position:relative;padding:18px;background:var(--tb-color-secondary);border-radius:30px;box-shadow:0 24px 70px rgba(0,0,0,.16)}.tb-med-telemedicine-feature__image{display:block;width:100%;height:430px;object-fit:cover;border-radius:18px}.tb-med-telemedicine-feature__status{position:absolute;left:36px;bottom:34px;padding:9px 13px;border-radius:999px;background:var(--tb-color-surface);color:var(--tb-color-secondary);font-weight:800}@media(max-width:760px){.tb-med-telemedicine-feature{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
