{
  "slug": "food-organic-farm-story",
  "name": "Organic Farm Story",
  "category": "Food & Restaurant",
  "description": "Farm-to-table storytelling section with sourcing highlights",
  "keywords": [
    "food",
    "restaurant",
    "organic",
    "farm",
    "sourcing"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-farm\"><div class=\"tb-food-farm__visual\">{{elements:image}}</div><div class=\"tb-food-farm__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-food-farm__facts\">{{elements:facts}}</div></div></div>",
  "css": ".tb-food-farm{display:grid;grid-template-columns:1.1fr .9fr;gap:0;background:var(--tb-color-background)}.tb-food-farm__visual{min-height:620px}.tb-food-farm__image{width:100%;height:100%;object-fit:cover;display:block}.tb-food-farm__copy{padding:clamp(38px,7vw,92px);align-self:center}.tb-food-farm__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.tb-food-farm__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(44px,6vw,72px)}.tb-food-farm__text{color:var(--tb-color-muted);line-height:1.8}.tb-food-farm__facts{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:24px}.tb-food-farm__fact{padding:16px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border);font-weight:850;color:var(--tb-color-secondary)}@media(max-width:760px){.tb-food-farm{grid-template-columns:1fr}.tb-food-farm__visual{min-height:380px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Farm image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1471193945509-9ad0617afabf?auto=format&fit=crop&w=1400&q=82",
        "alt": "Fresh produce at a farm"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-food-farm__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-food-farm__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Closer to the source"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-farm__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Food starts in the field"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h2 class=\"tb-food-farm__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Story",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Introduce the growers, producers and local relationships behind your ingredients and explain why sourcing matters to the kitchen."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-food-farm__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "facts",
      "label": "Sourcing fact",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Seasonal produce"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ".tb-food-farm__fact"
        }
      ],
      "template": "<div class=\"tb-food-farm__fact\">{{text}}</div>",
      "min": 1,
      "max": 10,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "text": "Seasonal produce"
        },
        {
          "text": "Local partners"
        },
        {
          "text": "Small-batch supply"
        },
        {
          "text": "Low-waste kitchen"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
