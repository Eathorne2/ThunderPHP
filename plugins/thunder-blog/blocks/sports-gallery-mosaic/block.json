{
  "slug": "sports-gallery-mosaic",
  "name": "Sports Gallery Mosaic",
  "category": "Sports",
  "description": "Image-forward sports gallery",
  "keywords": [
    "gallery",
    "photos",
    "sports"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-sport-gallery-mosaic\"><div class=\"tb-sport-gallery-mosaic__head\">{{elements:kicker}}{{elements:heading}}</div><div class=\"tb-sport-gallery-mosaic__grid\">{{elements:images}}</div></section>",
  "css": ".tb-sport-gallery-mosaic{padding:clamp(38px,6vw,78px);background:var(--tb-color-background)}.tb-sport-gallery-mosaic__head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.tb-sport-gallery-mosaic__kicker{font-size:12px;font-weight:900;color:var(--tb-color-primary);text-transform:uppercase;letter-spacing:.13em}.tb-sport-gallery-mosaic__heading{font-size:clamp(34px,5vw,58px);margin:8px 0 0}.tb-sport-gallery-mosaic__grid{display:grid;grid-template-columns:2fr 1fr 1fr;grid-auto-rows:220px;gap:12px}.tb-sport-gallery-mosaic__image{width:100%;height:100%;object-fit:cover;border-radius:14px}.tb-sport-gallery-mosaic__grid>[data-tb-element-id]:first-child{grid-row:span 2}@media(max-width:700px){.tb-sport-gallery-mosaic__grid{grid-template-columns:1fr 1fr}.tb-sport-gallery-mosaic__grid>[data-tb-element-id]:first-child{grid-column:span 2;grid-row:auto}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "kicker",
      "label": "Kicker",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Inside the action"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-sport-gallery-mosaic__kicker\">{{text}}</span>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "heading",
      "label": "Heading",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Moments that move us"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-sport-gallery-mosaic__heading\">{{text}}</h2>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "images",
      "label": "Gallery images",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=1600&q=82",
        "alt": "Football action"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-sport-gallery-mosaic__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-sport-gallery-mosaic__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 10,
      "default_items": [
        {
          "url": "https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=1600&q=82",
