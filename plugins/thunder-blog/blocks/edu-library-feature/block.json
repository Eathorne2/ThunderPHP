{
  "slug": "edu-library-feature",
  "name": "College Library Feature",
  "category": "Education",
  "description": "Large library image with reading, research and resource copy",
  "keywords": [
    "education",
    "library",
    "books",
    "research"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-library\"><div class=\"tb-edu-library__media\">{{elements:image}}</div><div class=\"tb-edu-library__card\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div></div>",
  "css": ".tb-edu-library{position:relative;padding:clamp(28px,5vw,60px);background:var(--tb-color-background)}.tb-edu-library__media{min-height:620px}.tb-edu-library__image{width:100%;height:620px;object-fit:cover;display:block}.tb-edu-library__card{position:absolute;left:clamp(44px,9vw,120px);bottom:clamp(44px,9vw,120px);width:min(450px,calc(100% - 88px));padding:32px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-edu-library__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-library__title{margin:8px 0;color:var(--tb-color-secondary);font-size:40px}.tb-edu-library__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-library__cta{display:inline-block;margin-top:12px;color:var(--tb-color-primary);font-weight:900;text-decoration:none}@media(max-width:700px){.tb-edu-library__card{position:relative;left:auto;bottom:auto;width:auto;margin:-50px 16px 0}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Library image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1497633762265-9d179a990aa6?auto=format&fit=crop&w=1400&q=82",
        "alt": "Books in a library"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-edu-library__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-edu-library__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Library & research"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-library__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A quieter place for bigger questions"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-edu-library__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Highlight physical and digital resources, study spaces, research support or reading programs."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-edu-library__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cta",
      "label": "Library link",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Explore the library",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-edu-library__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
