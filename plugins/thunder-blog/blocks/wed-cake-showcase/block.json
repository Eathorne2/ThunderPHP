{
  "slug": "wed-cake-showcase",
  "name": "Wedding Cake Showcase",
  "category": "Wedding",
  "description": "Wedding cake image with editable cake or dessert packages",
  "keywords": [
    "wedding",
    "cake",
    "dessert",
    "bakery"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-cake\"><div class=\"tb-wed-cake__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:intro}}<div class=\"tb-wed-cake__offers\">{{elements:offers}}</div></div><div class=\"tb-wed-cake__media\">{{elements:image}}</div></div>",
  "css": ".tb-wed-cake{display:grid;grid-template-columns:1fr 1fr;background:var(--tb-color-surface)}.tb-wed-cake__copy{padding:clamp(34px,6vw,80px)}.tb-wed-cake__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-cake__title{margin:8px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(40px,5vw,62px);font-weight:400}.tb-wed-cake__intro{color:var(--tb-color-muted);line-height:1.7}.tb-wed-cake__offer{display:grid;grid-template-columns:1fr auto;gap:14px;padding:20px 0;border-top:1px solid var(--tb-color-border)}.tb-wed-cake__offer-title{margin:0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:26px;font-weight:400}.tb-wed-cake__offer-text{margin:6px 0 0;color:var(--tb-color-muted)}.tb-wed-cake__price{color:var(--tb-color-primary);font-weight:900;white-space:nowrap}.tb-wed-cake__media,.tb-wed-cake__image{min-height:610px}.tb-wed-cake__image{width:100%;height:100%;object-fit:cover}@media(max-width:760px){.tb-wed-cake{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Sweet details"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-cake__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Cake worth celebrating"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-cake__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "intro",
      "label": "Intro",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A refined showcase for wedding cakes, dessert tables and custom tasting packages."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-wed-cake__intro\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "offers",
      "label": "Offer",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "title": "Signature tiered cake",
        "text": "Classic proportions with soft floral detailing.",
        "price": "From K3,200"
      },
      "schema": [
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-wed-cake__offer-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-wed-cake__offer-text",
          "rows": 2
        },
        {
          "key": "price",
          "label": "Price",
          "type": "text",
          "selector": ".tb-wed-cake__price"
        }
      ],
      "template": "<article class=\"tb-wed-cake__offer\"><div><h3 class=\"tb-wed-cake__offer-title\">{{title}}</h3><p class=\"tb-wed-cake__offer-text\">{{text}}</p></div><span class=\"tb-wed-cake__price\">{{price}}</span></article>",
      "min": 1,
      "max": 6,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "title": "Signature tiered cake",
          "text": "Classic proportions with soft floral detailing.",
          "price": "From K3,200"
        },
        {
          "title": "Dessert table",
          "text": "Mini cakes, pastries and seasonal sweet bites.",
          "price": "From K2,400"
        }
      ]
    },
    {
      "key": "image",
      "label": "Cake image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1535254973040-607b474cb50d?auto=format&fit=crop&w=1400&q=82",
        "alt": "Wedding cake"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-wed-cake__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-wed-cake__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
