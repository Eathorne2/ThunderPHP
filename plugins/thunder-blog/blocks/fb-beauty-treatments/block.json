          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<article class=\"tb-fb-treatments__card\"><img class=\"tb-fb-treatments__image\" src=\"{{image}}\" alt=\"{{alt}}\"><h3 class=\"tb-fb-treatments__card-title\">{{title}}</h3><p class=\"tb-fb-treatments__card-text\">{{text}}</p><a class=\"tb-fb-treatments__link\" href=\"{{url}}\">Discover →</a></article>",
      "min": 1,
      "max": 8,
      "default_items": [
        {
