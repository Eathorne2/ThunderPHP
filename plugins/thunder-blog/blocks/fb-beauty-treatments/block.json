{
  "slug": "fb-beauty-treatments",
  "name": "Beauty Treatment Cards",
  "category": "Fashion & Beauty",
  "description": "Elegant treatment cards with circular imagery and service descriptions.",
  "keywords": [
    "beauty",
    "treatments",
    "spa",
    "salon",
    "services"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-treatments\"><div class=\"tb-fb-treatments__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-fb-treatments__grid\">{{elements:cards}}</div></div>",
  "css": ".tb-fb-treatments{padding:clamp(30px,6vw,78px);background:var(--tb-color-surface)}.tb-fb-treatments__head{text-align:center;max-width:700px;margin:0 auto 34px}.tb-fb-treatments__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-treatments__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,5vw,60px);font-weight:500}.tb-fb-treatments__text{margin:0;color:var(--tb-color-muted);line-height:1.7}.tb-fb-treatments__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tb-fb-treatments__card{text-align:center;padding:28px 22px;background:color-mix(in srgb,var(--tb-color-primary) 7%,var(--tb-color-background));border:1px solid var(--tb-color-border)}.tb-fb-treatments__image{width:150px;height:150px;border-radius:50%;object-fit:cover}.tb-fb-treatments__card-title{margin:18px 0 8px;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:27px}.tb-fb-treatments__card-text{margin:0 auto 16px;max-width:300px;color:var(--tb-color-muted);line-height:1.65}.tb-fb-treatments__link{color:var(--tb-color-primary);font-weight:800;text-decoration:none}@media(max-width:760px){.tb-fb-treatments__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Treatment menu"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-treatments__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Find your treatment"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-fb-treatments__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A refined service overview for beauty salons, spas and wellness studios."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-fb-treatments__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
