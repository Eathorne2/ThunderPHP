{
  "slug": "wed-invitation-card",
  "name": "Formal Wedding Invitation",
  "category": "Wedding",
  "description": "Classic centered invitation card with names, venue and date",
  "keywords": [
    "wedding",
    "invitation",
    "formal",
    "save the date"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-invitation\"><div class=\"tb-wed-invitation__card\">{{elements:eyebrow}}{{elements:names}}{{elements:message}}<div class=\"tb-wed-invitation__rule\"></div>{{elements:date}}{{elements:venue}}{{elements:cta}}</div></div>",
  "css": ".tb-wed-invitation{padding:clamp(34px,7vw,90px);background:var(--tb-color-background)}.tb-wed-invitation__card{max-width:760px;margin:auto;padding:clamp(34px,7vw,80px);text-align:center;background:var(--tb-color-surface);border:1px solid var(--tb-color-border);outline:1px solid var(--tb-color-border);outline-offset:-12px}.tb-wed-invitation__eyebrow{color:var(--tb-color-primary);font-size:11px;font-weight:900;letter-spacing:.22em;text-transform:uppercase}.tb-wed-invitation__names{margin:20px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(52px,8vw,86px);font-weight:400;line-height:.95}.tb-wed-invitation__message{max-width:520px;margin:0 auto;color:var(--tb-color-muted);line-height:1.75}.tb-wed-invitation__rule{width:70px;height:1px;margin:28px auto;background:var(--tb-color-primary)}.tb-wed-invitation__date{font-size:16px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:var(--tb-color-text)}.tb-wed-invitation__venue{margin:10px 0;color:var(--tb-color-muted)}.tb-wed-invitation__cta{display:inline-block;margin-top:20px;color:var(--tb-color-primary);font-weight:900;text-decoration:none}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Together with their families"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-invitation__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
