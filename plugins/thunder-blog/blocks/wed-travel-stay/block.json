{
  "slug": "wed-travel-stay",
  "name": "Travel & Stay",
  "category": "Wedding",
  "description": "Travel notes and hotel cards for destination wedding guests",
  "keywords": [
    "wedding",
    "travel",
    "hotel",
    "guests"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-travel\"><div class=\"tb-wed-travel__intro\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-wed-travel__hotels\">{{elements:hotels}}</div></div>",
  "css": ".tb-wed-travel{display:grid;grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr);gap:36px;padding:clamp(30px,6vw,76px);background:var(--tb-color-surface)}.tb-wed-travel__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-travel__title{margin:8px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,5vw,58px);font-weight:400}.tb-wed-travel__text{color:var(--tb-color-muted);line-height:1.75}.tb-wed-travel__hotels{display:grid;gap:14px}.tb-wed-travel__hotel{padding:26px;border:1px solid var(--tb-color-border);background:var(--tb-color-background)}.tb-wed-travel__hotel-title{margin:0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:28px;font-weight:400}.tb-wed-travel__meta{display:block;margin:8px 0;color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.tb-wed-travel__hotel-text{margin:0;color:var(--tb-color-muted);line-height:1.6}.tb-wed-travel__link{display:inline-block;margin-top:12px;color:var(--tb-color-primary);font-weight:900;text-decoration:none}@media(max-width:760px){.tb-wed-travel{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "For our guests"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-travel__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Travel & stay"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-travel__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Intro",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A few helpful options for guests travelling in for the celebration."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-wed-travel__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "hotels",
      "label": "Hotel",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "title": "The Willow Hotel",
        "meta": "8 min from venue · $$$",
        "text": "Boutique rooms and breakfast included.",
        "url": "#"
      },
      "schema": [
        {
          "key": "title",
          "label": "Hotel name",
          "type": "text",
          "selector": ".tb-wed-travel__hotel-title"
        },
        {
          "key": "meta",
          "label": "Meta",
          "type": "text",
          "selector": ".tb-wed-travel__meta"
        },
        {
          "key": "text",
          "label": "Description",
          "type": "textarea",
          "selector": ".tb-wed-travel__hotel-text",
          "rows": 2
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<article class=\"tb-wed-travel__hotel\"><h3 class=\"tb-wed-travel__hotel-title\">{{title}}</h3><span class=\"tb-wed-travel__meta\">{{meta}}</span><p class=\"tb-wed-travel__hotel-text\">{{text}}</p><a class=\"tb-wed-travel__link\" href=\"{{url}}\">View details →</a></article>",
      "min": 1,
      "max": 6,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "title": "The Willow Hotel",
          "meta": "8 min from venue · $$$",
          "text": "Boutique rooms and breakfast included.",
          "url": "#"
        },
        {
          "title": "Garden Suites",
          "meta": "12 min from venue · $$",
          "text": "Family-friendly apartments with airport shuttle.",
          "url": "#"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
