{
  "slug": "fb-new-collection-split",
  "name": "New Collection Split",
  "category": "Fashion & Beauty",
  "description": "Minimal collection announcement with layered image framing.",
  "keywords": [
    "fashion",
    "collection",
    "split",
    "editorial"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-collection\"><div class=\"tb-fb-collection__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-fb-collection__visual\"><span class=\"tb-fb-collection__shape\"></span>{{elements:image}}</div></div>",
  "css": ".tb-fb-collection{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,1fr);align-items:center;gap:clamp(28px,6vw,80px);padding:clamp(30px,6vw,80px);background:var(--tb-color-surface)}.tb-fb-collection__copy{padding-left:clamp(0px,4vw,56px)}.tb-fb-collection__eyebrow{display:block;margin-bottom:16px;color:var(--tb-color-primary);font-size:12px;font-weight:800;letter-spacing:.2em;text-transform:uppercase}.tb-fb-collection__title{margin:0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(44px,7vw,80px);font-weight:500;line-height:1}.tb-fb-collection__text{margin:22px 0;max-width:500px;color:var(--tb-color-muted);line-height:1.75}.tb-fb-collection__cta{display:inline-flex;padding:12px 18px;background:var(--tb-color-secondary);color:var(--tb-color-surface);text-decoration:none;font-weight:800}.tb-fb-collection__visual{position:relative;padding:28px 28px 0 0}.tb-fb-collection__shape{position:absolute;right:0;top:0;width:72%;height:74%;background:color-mix(in srgb,var(--tb-color-primary) 18%,var(--tb-color-surface))}.tb-fb-collection__image{position:relative;width:100%;aspect-ratio:4/5;object-fit:cover;display:block}@media(max-width:760px){.tb-fb-collection{grid-template-columns:1fr}.tb-fb-collection__copy{padding-left:0}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
