{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "alignment": "center"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "alignment",
        "label": "Alignment",
        "type": "select",
        "options": {
          "left": "Left",
          "center": "Center",
          "right": "Right"
        },
        "default": "center"
      }
    ]
  },
  "elements": [],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "main",
      "empty": "",
      "container": "<nav class=\"tb-pill-menu__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-pill-menu__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-pill-menu__group\"><a class=\"tb-pill-menu__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a><div class=\"tb-pill-menu__children\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-pill-menu__nav tb-menu-empty\">Select a menu in block settings</nav>"
    }
  ],
  "html": "<section class=\"tb-block tb-pill-menu tb-pill-menu--{{alignment}}\">{{menu:main}}</section>",
  "css": ".tb-pill-menu__nav{display:flex;gap:9px;flex-wrap:wrap}.tb-pill-menu--left .tb-pill-menu__nav{justify-content:flex-start}.tb-pill-menu--center .tb-pill-menu__nav{justify-content:center}.tb-pill-menu--right .tb-pill-menu__nav{justify-content:flex-end}.tb-pill-menu__link{display:block;padding:10px 16px;border:1px solid var(--tb-color-border);border-radius:999px;background:var(--tb-color-surface);color:var(--tb-color-text);text-decoration:none;font-weight:750}.tb-pill-menu__link:hover{border-color:var(--tb-color-primary);background:var(--tb-color-primary);color:#fff}.tb-pill-menu__group{display:flex;gap:7px;flex-wrap:wrap}.tb-pill-menu__children{display:flex;gap:7px;flex-wrap:wrap}.tb-pill-menu__children .tb-pill-menu__link{font-size:13px}.tb-menu-empty{color:var(--tb-color-muted);font-size:13px}",
  "js": "",
  "slug": "menu-pills",
  "name": "Pill Menu",
  "category": "Menus",
  "description": "A compact rounded menu for landing pages, category links and footers.",
  "keywords": [
    "menu",
    "pills",
    "tags",
    "navigation"
  ],
  "contexts": [
    "post",
    "page",
    "header",
    "footer"
  ],
  "version": "1.0.0"
}
