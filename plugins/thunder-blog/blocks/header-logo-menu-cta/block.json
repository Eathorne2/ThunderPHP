{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1280",
      "sticky": "yes"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Navigation menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1100": "Compact",
          "1280": "Standard",
          "1440": "Wide"
        },
        "default": "1280"
      },
      {
        "key": "sticky",
        "label": "Sticky",
        "type": "select",
        "options": {
          "yes": "Yes",
          "no": "No"
        },
        "default": "yes"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "logo": "{{app_logo}}",
        "url": "{{root}}/"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-cta-header__brand-name"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-cta-header__logo"
        },
        {
          "key": "url",
          "label": "Home URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-cta-header__brand\" href=\"{{url}}\"><img class=\"tb-cta-header__logo\" src=\"{{logo}}\" alt=\"\"><span class=\"tb-cta-header__brand-name\">{{name}}</span></a>",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "secondary"
        }
      }
    },
    {
      "key": "cta",
      "label": "Call to action",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Get started",
        "url": "{{root}}/contact"
      },
      "schema": [
        {
          "key": "text",
          "label": "Button text",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "Button URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-cta-header__button\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "background",
          "background_color": "primary"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-cta-header__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-cta-header__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-cta-header__parent\"><a class=\"tb-cta-header__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}} ⌄</a><div class=\"tb-cta-header__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-cta-header__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<header class=\"tb-block tb-cta-header tb-cta-header--sticky-{{sticky}}\"><div class=\"tb-cta-header__inner\" style=\"--tb-cta-header-width:{{width}}px\">{{elements:brand}}<div class=\"tb-cta-header__right\">{{menu:primary}}{{elements:cta}}</div></div></header>",
  "css": ".tb-cta-header{z-index:60;border-bottom:1px solid var(--tb-color-border);background:color-mix(in srgb,var(--tb-color-surface) 94%,transparent);backdrop-filter:blur(14px)}.tb-cta-header--sticky-yes{position:sticky;top:0}.tb-cta-header__inner{max-width:var(--tb-cta-header-width);min-height:78px;margin:auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:28px}.tb-cta-header__brand{display:flex;align-items:center;gap:11px;color:var(--tb-color-secondary);text-decoration:none;font-weight:900}.tb-cta-header__logo{width:40px;height:40px;border-radius:11px;object-fit:contain}.tb-cta-header__right,.tb-cta-header__nav{display:flex;align-items:center;gap:7px}.tb-cta-header__link{padding:9px 11px;border-radius:8px;color:var(--tb-color-text);text-decoration:none;font-weight:700}.tb-cta-header__link:hover{background:var(--tb-color-background);color:var(--tb-color-primary)}.tb-cta-header__button{padding:11px 17px;border-radius:10px;text-decoration:none;font-weight:800}.tb-cta-header__parent{position:relative}.tb-cta-header__submenu{position:absolute;top:100%;left:0;min-width:190px;padding:7px;border:1px solid var(--tb-color-border);border-radius:12px;background:var(--tb-color-surface);display:none;box-shadow:0 18px 42px color-mix(in srgb,var(--tb-color-secondary) 15%,transparent)}.tb-cta-header__parent:hover>.tb-cta-header__submenu,.tb-cta-header__parent:focus-within>.tb-cta-header__submenu{display:grid}.tb-menu-empty{color:var(--tb-color-muted);font-size:13px}@media(max-width:850px){.tb-cta-header__inner{align-items:flex-start;flex-direction:column;padding-top:16px;padding-bottom:16px}.tb-cta-header__right,.tb-cta-header__nav{align-items:flex-start;flex-wrap:wrap}}",
  "js": "",
  "slug": "header-logo-menu-cta",
  "name": "Logo, Menu and CTA Header",
  "category": "Headers",
  "description": "A polished sticky header with a saved menu and editable call-to-action button.",
  "keywords": [
    "header",
    "logo",
    "menu",
    "cta",
    "sticky"
  ],
  "contexts": [
    "header"
  ],
  "version": "1.0.0"
}
