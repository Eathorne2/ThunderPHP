{
  "slug": "wed-event-details",
  "name": "Wedding Day Details",
  "category": "Wedding",
  "description": "Schedule cards for ceremony, reception and wedding-day logistics",
  "keywords": [
    "wedding",
    "schedule",
    "ceremony",
    "reception"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-event-details\"><div class=\"tb-wed-event-details__head\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-wed-event-details__list\">{{elements:events}}</div></div>",
  "css": ".tb-wed-event-details{padding:clamp(30px,5vw,68px);background:var(--tb-color-surface)}.tb-wed-event-details__head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.tb-wed-event-details__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-event-details__title{margin:5px 0 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(36px,5vw,58px);font-weight:400}.tb-wed-event-details__list{border-top:1px solid var(--tb-color-border)}.tb-wed-event-details__event{display:grid;grid-template-columns:120px minmax(180px,.7fr) minmax(0,1fr);gap:22px;padding:24px 0;border-bottom:1px solid var(--tb-color-border);align-items:center}.tb-wed-event-details__time{color:var(--tb-color-primary);font-size:13px;font-weight:900;letter-spacing:.12em}.tb-wed-event-details__event-title{margin:0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:28px;font-weight:400}.tb-wed-event-details__event-text{margin:0;color:var(--tb-color-muted)}@media(max-width:640px){.tb-wed-event-details__event{grid-template-columns:1fr;gap:7px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "The celebration"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-event-details__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Wedding day schedule"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-event-details__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "events",
      "label": "Schedule item",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "time": "14:00",
        "title": "Ceremony",
        "text": "Garden Chapel · Main lawn"
      },
      "schema": [
        {
          "key": "time",
          "label": "Time",
          "type": "text",
          "selector": ".tb-wed-event-details__time"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-wed-event-details__event-title"
        },
        {
          "key": "text",
          "label": "Details",
          "type": "textarea",
          "selector": ".tb-wed-event-details__event-text",
          "rows": 2
        }
      ],
      "template": "<article class=\"tb-wed-event-details__event\"><span class=\"tb-wed-event-details__time\">{{time}}</span><h3 class=\"tb-wed-event-details__event-title\">{{title}}</h3><p class=\"tb-wed-event-details__event-text\">{{text}}</p></article>",
      "min": 1,
      "max": 10,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "time": "14:00",
          "title": "Ceremony",
          "text": "Garden Chapel · Main lawn"
        },
        {
          "time": "16:30",
          "title": "Cocktail hour",
          "text": "Orchard terrace · Welcome drinks"
        },
        {
          "time": "18:00",
          "title": "Dinner & dancing",
          "text": "Grand hall · Reception"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
