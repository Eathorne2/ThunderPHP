{
  "slug": "edu-quiz-challenge",
  "name": "Quiz Challenge",
  "category": "Education",
  "description": "Interactive-looking quiz topic cards and challenge CTA",
  "keywords": [
    "education",
    "quiz",
    "knowledge",
    "test"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-quiz\"><div class=\"tb-edu-quiz__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-edu-quiz__topics\">{{elements:topics}}</div></div>",
  "css": ".tb-edu-quiz{display:grid;grid-template-columns:.8fr 1.2fr;gap:32px;padding:clamp(34px,6vw,78px);background:color-mix(in srgb,var(--tb-color-accent) 16%,var(--tb-color-background))}.tb-edu-quiz__copy{align-self:center}.tb-edu-quiz__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-quiz__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(42px,6vw,68px);line-height:1}.tb-edu-quiz__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-quiz__cta{display:inline-flex;margin-top:20px;padding:12px 18px;background:var(--tb-color-secondary);color:var(--tb-color-background);font-weight:900;text-decoration:none}.tb-edu-quiz__topic{display:grid;grid-template-columns:54px 1fr auto;gap:14px;align-items:center;padding:20px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-edu-quiz__number{font-weight:950;color:var(--tb-color-primary)}.tb-edu-quiz__topic-title{margin:0;color:var(--tb-color-secondary);font-size:22px}.tb-edu-quiz__meta{color:var(--tb-color-muted);font-size:12px;font-weight:900}@media(max-width:760px){.tb-edu-quiz{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Test yourself"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-quiz__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Ready for a quick challenge?"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-edu-quiz__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Use this for quizzes, knowledge checks, placement tests or interactive learning links."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-edu-quiz__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cta",
      "label": "Quiz CTA",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Start a quiz",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-edu-quiz__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "topics",
      "label": "Quiz topic",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "number": "01",
        "title": "General knowledge",
        "meta": "20 questions"
      },
      "schema": [
        {
          "key": "number",
          "label": "Number",
          "type": "text",
          "selector": ".tb-edu-quiz__number"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-edu-quiz__topic-title"
        },
        {
          "key": "meta",
          "label": "Meta",
          "type": "text",
          "selector": ".tb-edu-quiz__meta"
        }
      ],
      "template": "<article class=\"tb-edu-quiz__topic\"><span class=\"tb-edu-quiz__number\">{{number}}</span><h3 class=\"tb-edu-quiz__topic-title\">{{title}}</h3><span class=\"tb-edu-quiz__meta\">{{meta}}</span></article>",
      "min": 1,
      "max": 10,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "number": "01",
          "title": "General knowledge",
          "meta": "20 questions"
        },
        {
          "number": "02",
          "title": "Science challenge",
          "meta": "15 questions"
        },
        {
          "number": "03",
          "title": "Language skills",
          "meta": "25 questions"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
