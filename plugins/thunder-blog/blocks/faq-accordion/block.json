{
  "slug": "faq-accordion",
  "name": "FAQ Accordion",
  "category": "Interactive",
  "description": "An accessible three-question accordion with editable answers.",
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-block--faq\">\n  <div class=\"tb-faq__intro\">{{elements:eyebrow}}{{elements:title}}</div>\n  <div class=\"tb-faq__items\">{{elements:items}}</div>\n</div>",
  "css": ".tb-block--faq{padding:30px;border:1px solid var(--tb-color-border);border-radius:20px;background:var(--tb-color-surface)}.tb-faq__intro{margin-bottom:20px}.tb-faq__eyebrow{display:block;color:var(--tb-color-primary);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.12em}.tb-faq__title{margin:7px 0 0;color:var(--tb-color-secondary);font-size:31px}.tb-faq__items{display:grid}.tb-faq__item{border-top:1px solid var(--tb-color-border)}.tb-faq__button{width:100%;padding:17px 0;border:0;background:transparent;color:var(--tb-color-text);display:flex;align-items:center;justify-content:space-between;gap:18px;text-align:left;cursor:pointer}.tb-faq__question{font-size:16px;font-weight:800}.tb-faq__icon{width:28px;height:28px;border-radius:50%;background:color-mix(in srgb,var(--tb-color-primary) 10%,var(--tb-color-surface));color:var(--tb-color-primary);display:flex;align-items:center;justify-content:center;font-size:20px;transition:transform .2s ease}.tb-faq__button[aria-expanded=\"true\"] .tb-faq__icon{transform:rotate(45deg)}.tb-faq__answer{display:grid;grid-template-rows:0fr;transition:grid-template-rows .25s ease}.tb-faq__answer--open{grid-template-rows:1fr}.tb-faq__answer-inner{overflow:hidden;color:var(--tb-color-muted);font-size:15px;line-height:1.7}.tb-faq__answer--open .tb-faq__answer-inner{padding:0 0 18px}",
  "js": "document.querySelectorAll('.tb-block--faq .tb-faq__button').forEach((button)=>{if(button.dataset.tbBound)return;button.dataset.tbBound='1';button.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));const answer=button.nextElementSibling;if(answer)answer.classList.toggle('tb-faq__answer--open',!open);});});",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Questions"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-faq__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Frequently asked questions"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h3 class=\"tb-faq__title\">{{text}}</h3>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "FAQ item",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "question": "How does this work?",
        "answer": "Give readers a direct answer, then add only the context needed to make it useful."
      },
      "schema": [
        {
          "key": "question",
          "label": "Question",
          "type": "text",
          "selector": ".tb-faq__question"
        },
        {
          "key": "answer",
          "label": "Answer",
          "type": "textarea",
          "selector": ".tb-faq__answer-inner",
          "rows": 5
        }
      ],
      "template": "<div class=\"tb-faq__item\"><button class=\"tb-faq__button\" type=\"button\" aria-expanded=\"false\"><span class=\"tb-faq__question\">{{question}}</span><span class=\"tb-faq__icon\">+</span></button><div class=\"tb-faq__answer\"><div class=\"tb-faq__answer-inner\">{{answer}}</div></div></div>",
      "min": 1,
      "max": 20,
      "default_items": [
        {
          "question": "How does this work?",
          "answer": "Give readers a direct answer, then add only the context needed to make it useful."
        },
        {
          "question": "What should I prepare?",
          "answer": "List the information or materials a reader needs before taking the next step."
        },
        {
          "question": "Where can I learn more?",
          "answer": "Point readers to the most relevant follow-up resource or contact method."
        }
      ],
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
