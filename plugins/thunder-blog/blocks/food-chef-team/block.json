{
  "slug": "food-chef-team",
  "name": "Meet the Chefs",
  "category": "Food & Restaurant",
  "description": "Portrait grid introducing the kitchen team and roles",
  "keywords": [
    "food",
    "restaurant",
    "chef",
    "team",
    "staff"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-team\"><header class=\"tb-food-team__head\">{{elements:eyebrow}}{{elements:title}}</header><div class=\"tb-food-team__grid\">{{elements:people}}</div></div>",
  "css": ".tb-food-team{padding:clamp(34px,6vw,80px);background:var(--tb-color-background)}.tb-food-team__head{text-align:center;margin-bottom:28px}.tb-food-team__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-food-team__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,62px)}.tb-food-team__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.tb-food-team__card{position:relative;overflow:hidden;background:var(--tb-color-surface)}.tb-food-team__photo{width:100%;aspect-ratio:3/4;object-fit:cover;display:block}.tb-food-team__meta{padding:18px}.tb-food-team__name{margin:0;color:var(--tb-color-secondary);font-size:21px}.tb-food-team__role{display:block;margin-top:4px;color:var(--tb-color-muted)}@media(max-width:680px){.tb-food-team__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "The kitchen team"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-team__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Meet the people behind the plates"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h2 class=\"tb-food-team__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "people",
      "label": "Team member",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "image": "https://images.unsplash.com/photo-1577219491135-ce391730fb2c?auto=format&fit=crop&w=1400&q=82",
        "alt": "Chef",
        "name": "Maya Ndlovu",
        "role": "Executive Chef"
      },
      "schema": [
        {
          "key": "image",
          "label": "Photo",
          "type": "image",
          "selector": ".tb-food-team__photo"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        },
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "selector": ".tb-food-team__name"
        },
        {
          "key": "role",
          "label": "Role",
          "type": "text",
          "selector": ".tb-food-team__role"
        }
      ],
      "template": "<article class=\"tb-food-team__card\"><img class=\"tb-food-team__photo\" src=\"{{image}}\" alt=\"{{alt}}\"><div class=\"tb-food-team__meta\"><h3 class=\"tb-food-team__name\">{{name}}</h3><span class=\"tb-food-team__role\">{{role}}</span></div></article>",
      "min": 1,
      "max": 12,
      "appearance": {
        "color": false,
