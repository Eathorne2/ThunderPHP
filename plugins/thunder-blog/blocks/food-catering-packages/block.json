{
  "slug": "food-catering-packages",
  "name": "Catering Packages",
  "category": "Food & Restaurant",
  "description": "Three pricing cards for catering tiers, inclusions and custom quotes",
  "keywords": [
    "food",
    "restaurant",
    "catering",
    "pricing",
    "packages"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-packages\"><header class=\"tb-food-packages__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</header><div class=\"tb-food-packages__grid\">{{elements:packages}}</div></div>",
  "css": ".tb-food-packages{padding:clamp(36px,6vw,82px);background:var(--tb-color-background)}.tb-food-packages__head{max-width:760px;margin:0 auto 30px;text-align:center}.tb-food-packages__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.tb-food-packages__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,64px)}.tb-food-packages__text{color:var(--tb-color-muted);line-height:1.65}.tb-food-packages__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.tb-food-packages__card{padding:28px;border:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-food-packages__badge{display:inline-flex;padding:5px 8px;background:color-mix(in srgb,var(--tb-color-primary) 13%,transparent);color:var(--tb-color-primary);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.tb-food-packages__name{margin:18px 0 6px;color:var(--tb-color-secondary);font-size:28px}.tb-food-packages__price{display:block;color:var(--tb-color-primary);font-weight:950}.tb-food-packages__details{margin:18px 0 0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:740px){.tb-food-packages__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Catering packages"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-packages__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Choose the level of service"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h2 class=\"tb-food-packages__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Start with a package and adapt the menu, staffing and presentation to suit your event."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-food-packages__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "packages",
      "label": "Package",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "name": "Gather",
        "price": "From K120 / person",
        "text": "Shared platters · two mains · dessert",
        "badge": "Casual"
      },
      "schema": [
        {
          "key": "badge",
          "label": "Badge",
          "type": "text",
          "selector": ".tb-food-packages__badge"
        },
        {
          "key": "name",
          "label": "Package name",
          "type": "text",
          "selector": ".tb-food-packages__name"
        },
        {
          "key": "price",
          "label": "Price",
          "type": "text",
          "selector": ".tb-food-packages__price"
        },
        {
          "key": "text",
          "label": "Includes",
          "type": "textarea",
          "selector": ".tb-food-packages__details",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-food-packages__card\"><span class=\"tb-food-packages__badge\">{{badge}}</span><h3 class=\"tb-food-packages__name\">{{name}}</h3><strong class=\"tb-food-packages__price\">{{price}}</strong><p class=\"tb-food-packages__details\">{{text}}</p></article>",
      "min": 1,
      "max": 12,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "name": "Gather",
          "price": "From K120 / person",
          "text": "Shared platters · two mains · dessert",
          "badge": "Casual"
        },
        {
          "name": "Celebrate",
          "price": "From K220 / person",
          "text": "Canapés · plated mains · dessert table",
          "badge": "Popular"
        },
        {
          "name": "Host",
          "price": "Custom quote",
          "text": "Full menu planning · service team · styling",
          "badge": "Full service"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
