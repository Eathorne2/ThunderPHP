{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand statement",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "text": "{{app_description}}",
        "logo": "{{app_logo}}"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-f-accent__brand-name"
        },
        {
          "key": "text",
          "label": "Brand text",
          "type": "textarea",
          "selector": ".tb-f-accent__brand-text"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-f-accent__logo"
        }
      ],
      "template": "<div class=\"tb-f-accent__brand\"><img class=\"tb-f-accent__logo\" src=\"{{logo}}\" alt=\"\"><strong class=\"tb-f-accent__brand-name\">{{name}}</strong><p class=\"tb-f-accent__brand-text\">{{text}}</p></div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "text"
        }
      }
    },
    {
      "key": "copyright",
      "label": "Copyright",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "© {{year}} {{app_name}}. All rights reserved."
      },
      "schema": [
        {
          "key": "text",
          "label": "Copyright text",
          "type": "text",
          "selector": ".tb-f-accent__copyright"
        }
      ],
      "template": "<div class=\"tb-f-accent__copyright\">{{text}}</div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-f-accent__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-f-accent__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-f-accent__parent\"><a class=\"tb-f-accent__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-f-accent__chevron\">⌄</span></a><div class=\"tb-f-accent__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-f-accent__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<footer class=\"tb-block tb-f-accent\"><div class=\"tb-f-accent__accent\"></div><div class=\"tb-f-accent__inner\" style=\"--tb-f-accent-width:{{width}}px\"><div class=\"tb-f-accent__row\">{{elements:brand}}{{menu:primary}}</div><div class=\"tb-f-accent__legal\">{{elements:copyright}}</div></div></footer>",
  "css": ".tb-f-accent{background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-f-accent__inner{max-width:var(--tb-f-accent-width);margin:auto;padding:52px 24px 24px}.tb-f-accent__brand{display:grid;gap:10px;align-content:start}.tb-f-accent__logo{width:42px;height:42px;object-fit:contain}.tb-f-accent__brand-name{font-size:20px}.tb-f-accent__brand-text{max-width:360px;margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-f-accent__copyright{color:var(--tb-color-muted);font-size:12px}.tb-f-accent__nav{display:grid;gap:10px}.tb-f-accent__link{color:inherit;text-decoration:none;opacity:.78}.tb-f-accent__link:hover{opacity:1;color:var(--tb-color-primary)}.tb-f-accent__parent{display:grid;gap:8px}.tb-f-accent__parent>.tb-f-accent__link{font-weight:850;opacity:1}.tb-f-accent__submenu{display:grid;gap:7px;padding-left:0}.tb-f-accent__chevron{display:none}.tb-f-accent__accent{height:8px;background:var(--tb-color-primary)}.tb-f-accent__row{display:grid;grid-template-columns:1fr 1.4fr;gap:46px}.tb-f-accent__nav{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tb-f-accent__legal{margin-top:34px;padding-top:16px;border-top:1px solid var(--tb-color-border)}@media(max-width:820px){.tb-f-accent__grid,.tb-f-accent__top,.tb-f-accent__row,.tb-f-accent__bottom{grid-template-columns:1fr;flex-wrap:wrap}.tb-f-accent__nav{grid-template-columns:repeat(2,minmax(0,1fr))}.tb-f-accent__contacts{grid-template-columns:1fr}}@media(max-width:520px){.tb-f-accent__inner{padding-left:16px;padding-right:16px}.tb-f-accent__nav{grid-template-columns:1fr}.tb-f-accent__search{width:100%!important}}",
  "js": "",
  "slug": "footer-accent",
  "name": "Accent Footer",
  "category": "Footers",
  "description": "A strong accent band introduces a clean navigation footer.",
  "keywords": [
    "footer",
    "navigation",
    "menu",
    "accent"
  ],
  "contexts": [
    "footer"
  ],
  "version": "1.0.0"
}
