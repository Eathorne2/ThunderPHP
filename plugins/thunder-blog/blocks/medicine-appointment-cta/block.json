  "html": "<section class=\"tb-block tb-med-appointment-cta\"><div>{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-med-appointment-cta__action\">{{elements:cta}}{{elements:phone}}</div></section>",
  "css": ".tb-med-appointment-cta{display:flex;justify-content:space-between;align-items:center;gap:30px;padding:clamp(36px,6vw,72px);background:var(--tb-color-primary);color:var(--tb-color-surface);border-radius:24px}.tb-med-appointment-cta__eyebrow{font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.13em;opacity:.78}.tb-med-appointment-cta__title{font-size:clamp(34px,5vw,58px);margin:8px 0 10px;line-height:1.04}.tb-med-appointment-cta__text{max-width:650px;line-height:1.7;opacity:.88}.tb-med-appointment-cta__action{display:flex;flex-direction:column;align-items:flex-start;gap:10px;min-width:210px}.tb-med-appointment-cta__cta{background:var(--tb-color-surface);color:var(--tb-color-primary);padding:14px 18px;border-radius:999px;text-decoration:none;font-weight:900}.tb-med-appointment-cta__phone{font-weight:800}@media(max-width:760px){.tb-med-appointment-cta{flex-direction:column;align-items:flex-start}}",
