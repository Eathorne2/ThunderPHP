{
  "slug": "wed-bouquet-feature",
  "name": "Bridal Bouquet Feature",
  "category": "Wedding",
  "description": "Large floral image with bouquet story and florist CTA",
  "keywords": [
    "wedding",
    "bouquet",
    "flowers",
    "florist"
