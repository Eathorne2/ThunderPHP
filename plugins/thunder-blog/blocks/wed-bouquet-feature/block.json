  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-bouquet\"><div class=\"tb-wed-bouquet__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-wed-bouquet__media\">{{elements:image}}</div></div>",
  "css": ".tb-wed-bouquet{display:grid;grid-template-columns:.8fr 1.2fr;gap:0;background:var(--tb-color-surface)}.tb-wed-bouquet__copy{padding:clamp(36px,7vw,90px);display:flex;flex-direction:column;justify-content:center}.tb-wed-bouquet__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-bouquet__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(40px,6vw,68px);font-weight:400}.tb-wed-bouquet__text{color:var(--tb-color-muted);line-height:1.8}.tb-wed-bouquet__cta{align-self:flex-start;margin-top:18px;color:var(--tb-color-primary);font-weight:900;text-decoration:none}.tb-wed-bouquet__media,.tb-wed-bouquet__image{min-height:560px}.tb-wed-bouquet__image{width:100%;height:100%;object-fit:cover;display:block}@media(max-width:760px){.tb-wed-bouquet{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
