{
  "slug": "medicine-prescription-delivery",
  "name": "Prescription Delivery",
  "category": "Medicine & Science",
  "description": "Pharmacy delivery feature with simple steps",
  "keywords": [
    "pharmacy",
    "delivery",
    "prescription"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-prescription-delivery\"><div class=\"tb-med-prescription-delivery__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-med-prescription-delivery__steps\">{{elements:steps}}</div>{{elements:cta}}</div>{{elements:image}}</section>",
  "css": ".tb-med-prescription-delivery{display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center;padding:clamp(42px,7vw,88px);background:var(--tb-color-background)}.tb-med-prescription-delivery__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.14em}.tb-med-prescription-delivery__title{font-size:clamp(38px,5vw,62px);margin:10px 0 15px;color:var(--tb-color-secondary)}.tb-med-prescription-delivery__text{color:var(--tb-color-muted);font-size:17px;line-height:1.7}.tb-med-prescription-delivery__steps{display:grid;gap:10px;margin:22px 0}.tb-med-prescription-delivery__step{display:grid;grid-template-columns:38px 1fr;gap:12px;align-items:center;padding:12px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border);border-radius:12px}.tb-med-prescription-delivery__step__icon{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--tb-color-primary);color:var(--tb-color-surface);font-weight:900}.tb-med-prescription-delivery__step__title{margin:0;font-size:16px;color:var(--tb-color-secondary)}.tb-med-prescription-delivery__step__text{display:none}.tb-med-prescription-delivery__cta{display:inline-block;padding:13px 18px;background:var(--tb-color-secondary);color:var(--tb-color-surface);text-decoration:none;border-radius:8px;font-weight:900}.tb-med-prescription-delivery__image{width:100%;height:520px;object-fit:cover;border-radius:24px}@media(max-width:760px){.tb-med-prescription-delivery{grid-template-columns:1fr}}",
  "js": "",
