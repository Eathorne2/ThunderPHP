{
  "slug": "medicine-healthcare-stats",
  "name": "Healthcare Statistics",
  "category": "Medicine & Science",
  "description": "Healthcare trust and outcomes statistics",
  "keywords": [
    "statistics",
    "hospital",
    "healthcare"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-healthcare-stats\"><div class=\"tb-med-healthcare-stats__head\">{{elements:title}}{{elements:text}}</div><div class=\"tb-med-healthcare-stats__grid\">{{elements:stats}}</div></section>",
  "css": ".tb-med-healthcare-stats{padding:clamp(40px,6vw,76px);background:var(--tb-color-surface);border-block:1px solid var(--tb-color-border)}.tb-med-healthcare-stats__head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:30px}.tb-med-healthcare-stats__title{font-size:clamp(34px,4vw,54px);margin:0;color:var(--tb-color-secondary)}.tb-med-healthcare-stats__text{max-width:520px;color:var(--tb-color-muted);line-height:1.7}.tb-med-healthcare-stats__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.tb-med-healthcare-stats__stat{padding:24px;border-left:3px solid var(--tb-color-primary)}.tb-med-healthcare-stats__stat__number{display:block;font-size:42px;color:var(--tb-color-primary)}.tb-med-healthcare-stats__stat__title{font-size:18px;margin:6px 0;color:var(--tb-color-secondary)}.tb-med-healthcare-stats__stat__text{margin:0;color:var(--tb-color-muted);line-height:1.55}@media(max-width:760px){.tb-med-healthcare-stats__head{display:block}.tb-med-healthcare-stats__grid{grid-template-columns:repeat(2,1fr)}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "title",
      "label": "Title",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Care measured by trust and outcomes"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-med-healthcare-stats__title\">{{text}}</h2>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Use real numbers to communicate experience, reach, availability or clinical capacity."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-med-healthcare-stats__text\">{{text}}</p>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    },
    {
      "key": "stats",
      "label": "Statistics",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "number": "",
        "title": "",
        "text": ""
      },
      "schema": [
        {
          "key": "number",
          "label": "Number",
          "type": "text",
          "selector": ".tb-med-healthcare-stats__stat__number"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-med-healthcare-stats__stat__title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-med-healthcare-stats__stat__text",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-med-healthcare-stats__stat\"><strong class=\"tb-med-healthcare-stats__stat__number\">{{number}}</strong><h3 class=\"tb-med-healthcare-stats__stat__title\">{{title}}</h3><p class=\"tb-med-healthcare-stats__stat__text\">{{text}}</p></article>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "number": "25+",
          "title": "Specialists",
          "text": "Connected clinical expertise."
        },
        {
          "number": "18k",
          "title": "Patients",
          "text": "People supported each year."
        },
        {
          "number": "12",
          "title": "Departments",
          "text": "Coordinated service lines."
        },
        {
          "number": "24/7",
          "title": "Support",
          "text": "Always-on care guidance."
        }
      ],
      "min": 1,
      "max": 12
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
