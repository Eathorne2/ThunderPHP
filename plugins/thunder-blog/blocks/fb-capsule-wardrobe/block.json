  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-capsule\"><div class=\"tb-fb-capsule__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-fb-capsule__steps\">{{elements:steps}}</div></div>",
  "css": ".tb-fb-capsule{padding:clamp(30px,6vw,78px);background:var(--tb-color-background)}.tb-fb-capsule__head{max-width:760px;margin-bottom:32px}.tb-fb-capsule__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-capsule__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,6vw,66px);font-weight:500}.tb-fb-capsule__text{color:var(--tb-color-muted);line-height:1.7}.tb-fb-capsule__steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.tb-fb-capsule__step{min-height:270px;padding:24px;border:1px solid var(--tb-color-border);background:var(--tb-color-surface);display:flex;flex-direction:column}.tb-fb-capsule__number{color:var(--tb-color-primary);font-family:Georgia,serif;font-size:38px}.tb-fb-capsule__step-title{margin:auto 0 8px;color:var(--tb-color-secondary);font-size:20px}.tb-fb-capsule__step-text{margin:0;color:var(--tb-color-muted);line-height:1.6}@media(max-width:900px){.tb-fb-capsule__steps{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.tb-fb-capsule__steps{grid-template-columns:1fr}}",
