{
  "slug": "cars-vehicle-gallery",
  "name": "Vehicle Gallery Mosaic",
  "category": "Cars & Transportation",
  "description": "Large automotive image mosaic for models, events or dealership stock",
  "keywords": [
    "cars",
    "transportation",
    "gallery",
    "images"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-auto-vehicle-gallery\"><header class=\"tb-auto-vehicle-gallery__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</header><div class=\"tb-auto-vehicle-gallery__grid\">{{elements:items}}</div></section>",
  "css": ".tb-auto-vehicle-gallery{padding:clamp(34px,6vw,82px);background:var(--tb-color-surface)}.tb-auto-vehicle-gallery__head{max-width:760px;margin-bottom:24px}.tb-auto-vehicle-gallery__eyebrow{color:var(--tb-color-primary);font-size:11px;font-weight:950;letter-spacing:.15em;text-transform:uppercase}.tb-auto-vehicle-gallery__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(38px,5vw,62px)}.tb-auto-vehicle-gallery__text{color:var(--tb-color-muted);line-height:1.7}.tb-auto-vehicle-gallery__grid{display:grid;grid-template-columns:2fr 1fr 1fr;grid-auto-rows:260px;gap:10px}.tb-auto-vehicle-gallery__item{overflow:hidden;position:relative;background:var(--tb-color-background)}.tb-auto-vehicle-gallery__item:first-child{grid-row:span 2}.tb-auto-vehicle-gallery__image{width:100%;height:100%;object-fit:cover;display:block;transition:transform .25s ease}.tb-auto-vehicle-gallery__item:hover .tb-auto-vehicle-gallery__image{transform:scale(1.035)}.tb-auto-vehicle-gallery__caption{position:absolute;left:14px;bottom:14px;padding:7px 10px;background:var(--tb-color-secondary);color:var(--tb-color-surface);font-weight:850}@media(max-width:720px){.tb-auto-vehicle-gallery__grid{grid-template-columns:1fr;grid-auto-rows:260px}.tb-auto-vehicle-gallery__item:first-child{grid-row:auto}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "In the showroom"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-auto-vehicle-gallery__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Machines worth a closer look"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-auto-vehicle-gallery__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Use a responsive image mosaic for featured vehicles, launches or automotive photography."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-auto-vehicle-gallery__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Gallery image",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1600&q=82",
        "alt": "Vehicle",
        "caption": "Featured vehicle"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-auto-vehicle-gallery__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        },
        {
          "key": "caption",
          "label": "Caption",
          "type": "text",
          "selector": ".tb-auto-vehicle-gallery__caption"
        }
      ],
      "template": "<figure class=\"tb-auto-vehicle-gallery__item\"><img class=\"tb-auto-vehicle-gallery__image\" src=\"{{url}}\" alt=\"{{alt}}\"><figcaption class=\"tb-auto-vehicle-gallery__caption\">{{caption}}</figcaption></figure>",
      "min": 1,
      "max": 18,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
