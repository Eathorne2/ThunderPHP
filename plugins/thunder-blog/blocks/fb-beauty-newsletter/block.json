{
  "slug": "fb-beauty-newsletter",
  "name": "Beauty Editorial Newsletter",
  "category": "Fashion & Beauty",
  "description": "Image-led newsletter signup block for fashion and beauty audiences.",
  "keywords": [
    "fashion",
    "beauty",
    "newsletter",
    "signup"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-newsletter\"><div class=\"tb-fb-newsletter__media\">{{elements:image}}</div><div class=\"tb-fb-newsletter__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<form class=\"tb-fb-newsletter__form\" action=\"#\" method=\"post\"><label class=\"tb-fb-newsletter__label\"><span class=\"tb-fb-newsletter__label-text\">Email address</span><input class=\"tb-fb-newsletter__input\" type=\"email\" name=\"email\" placeholder=\"you@example.com\"></label><button class=\"tb-fb-newsletter__button\" type=\"submit\">Subscribe</button></form>{{elements:note}}</div></div>",
  "css": ".tb-fb-newsletter{display:grid;grid-template-columns:minmax(280px,.9fr) minmax(0,1.1fr);background:var(--tb-color-secondary);color:var(--tb-color-surface)}.tb-fb-newsletter__media{min-height:480px}.tb-fb-newsletter__image{width:100%;height:100%;min-height:480px;object-fit:cover}.tb-fb-newsletter__copy{padding:clamp(34px,7vw,86px);display:flex;flex-direction:column;justify-content:center}.tb-fb-newsletter__eyebrow{color:var(--tb-color-accent);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-newsletter__title{margin:10px 0;color:var(--tb-color-surface);font-family:Georgia,serif;font-size:clamp(40px,6vw,66px);font-weight:500}.tb-fb-newsletter__text{color:color-mix(in srgb,var(--tb-color-surface) 72%,transparent);line-height:1.7}.tb-fb-newsletter__form{display:grid;grid-template-columns:1fr auto;gap:10px;margin-top:20px}.tb-fb-newsletter__label{display:block;min-width:0}.tb-fb-newsletter__label-text{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.tb-fb-newsletter__input{width:100%;min-height:48px;padding:0 14px;border:1px solid color-mix(in srgb,var(--tb-color-surface) 35%,transparent);background:transparent;color:var(--tb-color-surface);box-sizing:border-box}.tb-fb-newsletter__button{min-height:48px;padding:0 18px;border:0;background:var(--tb-color-accent);color:var(--tb-color-secondary);font-weight:900}.tb-fb-newsletter__note{margin-top:12px;color:color-mix(in srgb,var(--tb-color-surface) 55%,transparent);font-size:12px}@media(max-width:760px){.tb-fb-newsletter{grid-template-columns:1fr}.tb-fb-newsletter__media,.tb-fb-newsletter__image{min-height:360px}.tb-fb-newsletter__form{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Newsletter image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1571781926291-c477ebfd024b?auto=format&fit=crop&w=1400&q=82",
        "alt": "Beauty editorial product image"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-fb-newsletter__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-fb-newsletter__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Beauty letter"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-newsletter__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "New rituals, honest reviews, good style"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-fb-newsletter__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Use this as a visual signup section; connect the form action in your integration layer if needed."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-fb-newsletter__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "note",
      "label": "Privacy note",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Occasional notes. No noise."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<div class=\"tb-fb-newsletter__note\">{{text}}</div>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
