{
  "slug": "edu-campus-experience",
  "name": "Campus Experience",
  "category": "Education",
  "description": "Three large image cards for campus spaces, clubs and student support",
  "keywords": [
    "education",
    "campus",
    "student life",
    "college"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-campus\"><div class=\"tb-edu-campus__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-campus__grid\">{{elements:cards}}</div></div>",
  "css": ".tb-edu-campus{padding:clamp(34px,6vw,78px);background:var(--tb-color-surface)}.tb-edu-campus__head{max-width:760px;margin:0 auto 30px;text-align:center}.tb-edu-campus__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-campus__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,60px)}.tb-edu-campus__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-campus__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tb-edu-campus__card{position:relative;min-height:430px;overflow:hidden}.tb-edu-campus__image{width:100%;height:100%;min-height:430px;object-fit:cover}.tb-edu-campus__title-card{position:absolute;left:18px;right:18px;bottom:18px;margin:0;padding:14px;background:var(--tb-color-surface);color:var(--tb-color-secondary);font-size:22px}@media(max-width:760px){.tb-edu-campus__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Beyond the classroom"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-campus__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A campus built around people"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-edu-campus__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Use image-led cards to show the experience surrounding your academic programs."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-edu-campus__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cards",
      "label": "Campus card",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "image": "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1400&q=82",
        "alt": "Campus",
        "title": "Campus spaces"
      },
      "schema": [
        {
          "key": "image",
          "label": "Image",
          "type": "image",
          "selector": ".tb-edu-campus__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-edu-campus__title-card"
        }
      ],
      "template": "<article class=\"tb-edu-campus__card\"><img class=\"tb-edu-campus__image\" src=\"{{image}}\" alt=\"{{alt}}\"><h3 class=\"tb-edu-campus__title-card\">{{title}}</h3></article>",
      "min": 1,
      "max": 8,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "image": "https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1400&q=82",
          "alt": "Campus",
          "title": "Campus spaces"
        },
        {
          "image": "https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1400&q=82",
          "alt": "Student club",
          "title": "Clubs & community"
        },
        {
          "image": "https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1400&q=82",
