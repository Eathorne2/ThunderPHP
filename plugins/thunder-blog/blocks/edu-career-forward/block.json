  "html": "<div class=\"tb-block tb-edu-career\"><div class=\"tb-edu-career__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-edu-career__points\">{{elements:points}}</div>{{elements:cta}}</div><div class=\"tb-edu-career__media\">{{elements:image}}</div></div>",
  "css": ".tb-edu-career{display:grid;grid-template-columns:1fr .9fr;background:var(--tb-color-surface)}.tb-edu-career__copy{padding:clamp(36px,7vw,86px)}.tb-edu-career__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-career__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(42px,6vw,68px);line-height:1}.tb-edu-career__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-career__point{padding:12px 0;border-top:1px solid var(--tb-color-border);color:var(--tb-color-text);font-weight:800}.tb-edu-career__cta{display:inline-flex;margin-top:20px;padding:12px 18px;background:var(--tb-color-primary);color:#fff;text-decoration:none;font-weight:900}.tb-edu-career__media{min-height:600px}.tb-edu-career__image{width:100%;height:100%;min-height:600px;object-fit:cover}@media(max-width:760px){.tb-edu-career{grid-template-columns:1fr}.tb-edu-career__media,.tb-edu-career__image{min-height:380px}}",
