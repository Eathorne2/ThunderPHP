{
  "slug": "arch-client-testimonial",
  "name": "Architecture Client Testimonial",
  "category": "Architecture & Building",
  "description": "Large quote or testimonial with architecture image",
  "keywords": [
    "architecture",
    "client",
    "testimonial",
    "testimonial"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-arch-client-testimonial\"><div class=\"tb-arch-client-testimonial__media\">{{elements:image}}</div><blockquote class=\"tb-arch-client-testimonial__quote\">{{elements:kicker}}{{elements:quote}}{{elements:author}}</blockquote></section>",
  "css": ".tb-arch-client-testimonial{display:grid;grid-template-columns:.85fr 1.15fr;background:var(--tb-color-secondary);color:var(--tb-color-surface)}.tb-arch-client-testimonial__media{min-height:470px}.tb-arch-client-testimonial__image{width:100%;height:100%;object-fit:cover}.tb-arch-client-testimonial__quote{margin:0;padding:clamp(38px,7vw,82px);display:flex;flex-direction:column;justify-content:center}.tb-arch-client-testimonial__kicker{font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:var(--tb-color-accent)}.tb-arch-client-testimonial__text{font-size:clamp(30px,4vw,52px);line-height:1.12;margin:18px 0 26px;color:var(--tb-color-surface)}.tb-arch-client-testimonial__author{font-size:14px;color:color-mix(in srgb,var(--tb-color-surface) 72%,transparent)}@media(max-width:760px){.tb-arch-client-testimonial{grid-template-columns:1fr}.tb-arch-client-testimonial__media{min-height:330px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=1600&q=82",
        "alt": "Architecture Client Testimonial"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-arch-client-testimonial__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-arch-client-testimonial__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "appearance": {
        "color": false,
        "background_color": false,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "kicker",
      "label": "Kicker",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Client perspective"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-arch-client-testimonial__kicker\">{{text}}</span>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "quote",
      "label": "Quote",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "They translated a difficult site into a home that feels effortless, calm and completely ours."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-arch-client-testimonial__text\">{{text}}</p>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    },
    {
      "key": "author",
      "label": "Attribution",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "— Residential client"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<cite class=\"tb-arch-client-testimonial__author\">{{text}}</cite>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 8
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
