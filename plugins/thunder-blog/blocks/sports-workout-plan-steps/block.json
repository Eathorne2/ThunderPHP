  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-sport-workout-plan-steps\">{{elements:heading}}<div class=\"tb-sport-workout-plan-steps__grid\">{{elements:steps}}</div></section>",
  "css": ".tb-sport-workout-plan-steps{padding:clamp(42px,7vw,88px);background:var(--tb-color-surface)}.tb-sport-workout-plan-steps__heading{font-size:clamp(34px,5vw,58px);max-width:760px;margin:0 0 34px;color:var(--tb-color-secondary)}.tb-sport-workout-plan-steps__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.tb-sport-workout-plan-steps__step{padding:26px;border:1px solid var(--tb-color-border);border-radius:18px;background:var(--tb-color-background)}.tb-sport-workout-plan-steps__number{display:inline-grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--tb-color-primary);color:var(--tb-color-surface);font-weight:900}.tb-sport-workout-plan-steps__title{font-size:22px;margin:20px 0 8px}.tb-sport-workout-plan-steps__text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:850px){.tb-sport-workout-plan-steps__grid{grid-template-columns:1fr 1fr}}@media(max-width:540px){.tb-sport-workout-plan-steps__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
