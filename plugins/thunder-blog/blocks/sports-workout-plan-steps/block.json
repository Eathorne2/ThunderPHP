        }
      ],
      "template": "<article class=\"tb-sport-workout-plan-steps__step\"><span class=\"tb-sport-workout-plan-steps__number\">{{number}}</span><h3 class=\"tb-sport-workout-plan-steps__title\">{{title}}</h3><p class=\"tb-sport-workout-plan-steps__text\">{{text}}</p></article>",
      "appearance": {
        "color": true,
