{
  "slug": "arch-consultation-cta",
  "name": "Architecture Consultation CTA",
  "category": "Architecture & Building",
  "description": "Architecture/building call-to-action section",
  "keywords": [
    "architecture",
    "consultation",
    "cta",
    "cta"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-arch-consultation-cta\"><div class=\"tb-arch-consultation-cta__media\">{{elements:image}}</div><div class=\"tb-arch-consultation-cta__copy\">{{elements:kicker}}{{elements:title}}{{elements:text}}{{elements:cta}}</div></section>",
  "css": ".tb-arch-consultation-cta{display:grid;grid-template-columns:.95fr 1.05fr;background:var(--tb-color-primary);color:var(--tb-color-surface)}.tb-arch-consultation-cta__media{min-height:430px}.tb-arch-consultation-cta__image{width:100%;height:100%;object-fit:cover}.tb-arch-consultation-cta__copy{padding:clamp(38px,7vw,82px);display:flex;flex-direction:column;justify-content:center}.tb-arch-consultation-cta__kicker{font-size:12px;font-weight:900;letter-spacing:.15em;text-transform:uppercase;color:var(--tb-color-accent)}.tb-arch-consultation-cta__title{font-size:clamp(40px,6vw,72px);line-height:1;margin:13px 0 18px;color:var(--tb-color-surface)}.tb-arch-consultation-cta__text{font-size:18px;line-height:1.7;color:color-mix(in srgb,var(--tb-color-surface) 80%,transparent)}.tb-arch-consultation-cta__cta{display:inline-block;margin-top:26px;padding:14px 22px;background:var(--tb-color-surface);color:var(--tb-color-secondary);font-weight:900;text-decoration:none}@media(max-width:760px){.tb-arch-consultation-cta{grid-template-columns:1fr}.tb-arch-consultation-cta__media{min-height:320px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1600&q=82",
        "alt": "Architecture Consultation CTA"
      },
      "schema": [
        {
          "key": "url",
