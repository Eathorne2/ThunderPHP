{
  "slug": "food-restaurant-locations",
  "name": "Restaurant Locations",
  "category": "Food & Restaurant",
  "description": "Multi-location restaurant cards with address, hours and directions links",
  "keywords": [
    "food",
    "restaurant",
    "locations",
    "contact",
    "restaurant"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-locations\"><header class=\"tb-food-locations__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</header><div class=\"tb-food-locations__grid\">{{elements:items}}</div></div>",
  "css": ".tb-food-locations{padding:clamp(36px,6vw,84px);background:var(--tb-color-background)}.tb-food-locations__head{display:grid;grid-template-columns:.9fr 1.1fr;gap:30px;margin-bottom:30px}.tb-food-locations__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.tb-food-locations__title{grid-column:1;margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(42px,6vw,68px)}.tb-food-locations__text{grid-column:2;grid-row:1/3;margin:0;color:var(--tb-color-muted);line-height:1.75;align-self:end}.tb-food-locations__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tb-food-locations__card{padding:26px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-food-locations__name{margin:0 0 16px;color:var(--tb-color-secondary);font-size:26px}.tb-food-locations__address,.tb-food-locations__hours{display:block;margin:7px 0;color:var(--tb-color-muted);line-height:1.5}.tb-food-locations__link{display:inline-flex;margin-top:18px;color:var(--tb-color-primary);font-weight:900;text-decoration:none}@media(max-width:760px){.tb-food-locations__head{grid-template-columns:1fr}.tb-food-locations__text{grid-column:1;grid-row:auto}.tb-food-locations__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Visit us"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-locations__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Three places, one kitchen philosophy"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-food-locations__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "List restaurant branches, cafés or pickup points with the practical details guests need."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-food-locations__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Location",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "name": "City Kitchen",
        "address": "42 Market Lane, Lusaka",
        "hours": "Tue–Sun · 12:00–22:00",
        "url": "#"
      },
      "schema": [
        {
          "key": "name",
          "label": "Location name",
          "type": "text",
          "selector": ".tb-food-locations__name"
        },
        {
          "key": "address",
          "label": "Address",
          "type": "text",
          "selector": ".tb-food-locations__address"
        },
        {
          "key": "hours",
          "label": "Hours",
          "type": "text",
          "selector": ".tb-food-locations__hours"
        },
        {
          "key": "url",
          "label": "Directions URL",
          "type": "url"
        }
      ],
      "template": "<article class=\"tb-food-locations__card\"><h3 class=\"tb-food-locations__name\">{{name}}</h3><span class=\"tb-food-locations__address\">{{address}}</span><span class=\"tb-food-locations__hours\">{{hours}}</span><a class=\"tb-food-locations__link\" href=\"{{url}}\">Directions →</a></article>",
      "min": 1,
      "max": 12,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "name": "City Kitchen",
          "address": "42 Market Lane, Lusaka",
          "hours": "Tue–Sun · 12:00–22:00",
          "url": "#"
        },
        {
          "name": "Garden Café",
          "address": "8 Green Road, Lusaka",
          "hours": "Daily · 07:00–18:00",
          "url": "#"
        },
        {
          "name": "Riverside Grill",
          "address": "15 River Walk, Livingstone",
          "hours": "Wed–Sun · 12:00–23:00",
          "url": "#"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
