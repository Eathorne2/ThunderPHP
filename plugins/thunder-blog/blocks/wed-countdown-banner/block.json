{
  "slug": "wed-countdown-banner",
  "name": "Wedding Countdown Banner",
  "category": "Wedding",
  "description": "Elegant countdown-style number row for a wedding date",
  "keywords": [
    "wedding",
    "countdown",
    "date",
    "numbers"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-countdown\"><div class=\"tb-wed-countdown__copy\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-wed-countdown__grid\">{{elements:items}}</div></div>",
  "css": ".tb-wed-countdown{display:grid;grid-template-columns:minmax(240px,.8fr) minmax(0,1.2fr);gap:36px;align-items:center;padding:clamp(28px,5vw,64px);background:var(--tb-color-secondary);color:var(--tb-color-background)}.tb-wed-countdown__eyebrow{display:block;color:var(--tb-color-accent);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-countdown__title{margin:10px 0 0;font-family:Georgia,serif;font-size:clamp(34px,5vw,56px);font-weight:400}.tb-wed-countdown__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:color-mix(in srgb,var(--tb-color-background) 25%,transparent)}.tb-wed-countdown__item{padding:22px 10px;text-align:center;background:var(--tb-color-secondary)}.tb-wed-countdown__number{display:block;font-family:Georgia,serif;font-size:clamp(36px,5vw,58px)}.tb-wed-countdown__label{display:block;margin-top:5px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.75}@media(max-width:760px){.tb-wed-countdown{grid-template-columns:1fr}.tb-wed-countdown__grid{grid-template-columns:repeat(2,1fr)}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Counting down"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-countdown__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Until we say “I do”"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-countdown__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Countdown item",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "number": "128",
        "label": "Days"
      },
      "schema": [
        {
          "key": "number",
          "label": "Number",
          "type": "text",
          "selector": ".tb-wed-countdown__number"
        },
        {
          "key": "label",
          "label": "Label",
          "type": "text",
          "selector": ".tb-wed-countdown__label"
        }
      ],
      "template": "<div class=\"tb-wed-countdown__item\"><span class=\"tb-wed-countdown__number\">{{number}}</span><span class=\"tb-wed-countdown__label\">{{label}}</span></div>",
      "min": 1,
      "max": 6,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "number": "128",
          "label": "Days"
        },
        {
          "number": "07",
          "label": "Hours"
        },
        {
          "number": "42",
          "label": "Minutes"
        },
        {
          "number": "18",
          "label": "Seconds"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
