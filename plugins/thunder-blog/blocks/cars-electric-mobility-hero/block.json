{
  "slug": "cars-electric-mobility-hero",
  "name": "Electric Mobility Hero",
  "category": "Cars & Transportation",
  "description": "EV-focused hero for clean modern transportation brands",
  "keywords": [
    "cars",
    "transportation",
    "hero",
    "image",
    "cta"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-auto-electric-mobility-hero\"><div class=\"tb-auto-electric-mobility-hero__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-auto-electric-mobility-hero__visual\">{{elements:image}}</div></section>",
  "css": ".tb-auto-electric-mobility-hero{display:grid;grid-template-columns:1.15fr .85fr;gap:0;background:var(--tb-color-background);padding:clamp(28px,5vw,72px)}.tb-auto-electric-mobility-hero__visual{padding:18px;background:var(--tb-color-primary);transform:rotate(-2deg)}.tb-auto-electric-mobility-hero__image{width:100%;height:560px;object-fit:cover;display:block;transform:rotate(2deg)}.tb-auto-electric-mobility-hero__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(26px,5vw,70px);border:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-auto-electric-mobility-hero__eyebrow{color:var(--tb-color-primary);font-weight:950;letter-spacing:.16em;text-transform:uppercase;font-size:11px}.tb-auto-electric-mobility-hero__title{margin:12px 0;color:var(--tb-color-secondary);font-size:clamp(42px,6vw,74px);line-height:1}.tb-auto-electric-mobility-hero__text{color:var(--tb-color-muted);line-height:1.75;font-size:17px}.tb-auto-electric-mobility-hero__cta{align-self:flex-start;margin-top:22px;color:var(--tb-color-primary);font-weight:950;text-decoration:none;border-bottom:2px solid currentColor;padding-bottom:5px}@media(max-width:780px){.tb-auto-electric-mobility-hero{grid-template-columns:1fr}.tb-auto-electric-mobility-hero__image{height:400px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
