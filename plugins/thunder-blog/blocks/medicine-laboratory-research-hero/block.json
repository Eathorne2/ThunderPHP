{
  "slug": "medicine-laboratory-research-hero",
  "name": "Laboratory Research Hero",
  "category": "Medicine & Science",
  "description": "Science laboratory hero with research metrics",
  "keywords": [
    "laboratory",
    "research",
    "science",
    "hero"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-laboratory-research-hero\">{{elements:image}}<div class=\"tb-med-laboratory-research-hero__overlay\"><div>{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-med-laboratory-research-hero__metrics\">{{elements:metrics}}</div></div></section>",
  "css": ".tb-med-laboratory-research-hero{position:relative;min-height:650px;overflow:hidden;background:var(--tb-color-secondary)}.tb-med-laboratory-research-hero__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.5}.tb-med-laboratory-research-hero__overlay{position:relative;z-index:1;min-height:650px;padding:clamp(44px,8vw,100px);display:flex;flex-direction:column;justify-content:space-between;color:var(--tb-color-surface);background:linear-gradient(90deg,color-mix(in srgb,var(--tb-color-secondary) 88%,transparent),transparent)}.tb-med-laboratory-research-hero__eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.16em;font-weight:900;color:var(--tb-color-accent)}.tb-med-laboratory-research-hero__title{max-width:800px;font-size:clamp(46px,7vw,84px);line-height:.98;margin:12px 0 18px}.tb-med-laboratory-research-hero__text{max-width:640px;line-height:1.75;font-size:18px;opacity:.88}.tb-med-laboratory-research-hero__metrics{display:grid;grid-template-columns:repeat(3,minmax(0,190px));gap:14px}.tb-med-laboratory-research-hero__metric{padding:16px;border-top:2px solid var(--tb-color-accent)}.tb-med-laboratory-research-hero__metric__number{display:block;font-size:30px}.tb-med-laboratory-research-hero__metric__title{font-size:14px;margin:4px 0 0}.tb-med-laboratory-research-hero__metric__text{display:none}@media(max-width:640px){.tb-med-laboratory-research-hero__metrics{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Laboratory image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&fit=crop&w=1600&q=82",
        "alt": "Scientific laboratory"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-med-laboratory-research-hero__image"
