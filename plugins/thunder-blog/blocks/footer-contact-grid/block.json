{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand statement",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "text": "{{app_description}}",
        "logo": "{{app_logo}}"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-f-contact-grid__brand-name"
        },
        {
          "key": "text",
          "label": "Brand text",
          "type": "textarea",
          "selector": ".tb-f-contact-grid__brand-text"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-f-contact-grid__logo"
        }
      ],
      "template": "<div class=\"tb-f-contact-grid__brand\"><img class=\"tb-f-contact-grid__logo\" src=\"{{logo}}\" alt=\"\"><strong class=\"tb-f-contact-grid__brand-name\">{{name}}</strong><p class=\"tb-f-contact-grid__brand-text\">{{text}}</p></div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "text"
        }
      }
    },
    {
      "key": "copyright",
      "label": "Copyright",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "© {{year}} {{app_name}}. All rights reserved."
      },
      "schema": [
        {
          "key": "text",
          "label": "Copyright text",
          "type": "text",
          "selector": ".tb-f-contact-grid__copyright"
        }
      ],
      "template": "<div class=\"tb-f-contact-grid__copyright\">{{text}}</div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    },
    {
      "key": "contact",
      "label": "Contact details",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "label": "Email",
        "value": "hello@example.com",
        "url": "mailto:hello@example.com"
      },
      "default_items": [
        {
          "label": "Email",
          "value": "hello@example.com",
          "url": "mailto:hello@example.com"
        },
        {
          "label": "Phone",
          "value": "+260 000 000000",
          "url": "tel:+260000000000"
        },
        {
          "label": "Location",
          "value": "Lusaka, Zambia",
          "url": "#"
        }
      ],
      "schema": [
        {
          "key": "label",
          "label": "Label",
          "type": "text",
          "selector": ".tb-f-contact-grid__contact-label"
        },
        {
          "key": "value",
          "label": "Value",
          "type": "text",
          "selector": ".tb-f-contact-grid__contact-value"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-f-contact-grid__contact-item\" href=\"{{url}}\"><span class=\"tb-f-contact-grid__contact-label\">{{label}}</span><span class=\"tb-f-contact-grid__contact-value\">{{value}}</span></a>",
      "min": 0,
      "max": 8,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "text"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-f-contact-grid__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-f-contact-grid__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-f-contact-grid__parent\"><a class=\"tb-f-contact-grid__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-f-contact-grid__chevron\">⌄</span></a><div class=\"tb-f-contact-grid__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-f-contact-grid__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<footer class=\"tb-block tb-f-contact-grid\"><div class=\"tb-f-contact-grid__inner\" style=\"--tb-f-contact-grid-width:{{width}}px\">{{elements:brand}}<div class=\"tb-f-contact-grid__contacts\">{{elements:contact}}</div><div class=\"tb-f-contact-grid__menu\">{{menu:primary}}</div><div class=\"tb-f-contact-grid__legal\">{{elements:copyright}}</div></div></footer>",
  "css": ".tb-f-contact-grid{background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-f-contact-grid__inner{max-width:var(--tb-f-contact-grid-width);margin:auto;padding:52px 24px 24px}.tb-f-contact-grid__brand{display:grid;gap:10px;align-content:start}.tb-f-contact-grid__logo{width:42px;height:42px;object-fit:contain}.tb-f-contact-grid__brand-name{font-size:20px}.tb-f-contact-grid__brand-text{max-width:360px;margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-f-contact-grid__copyright{color:var(--tb-color-muted);font-size:12px}.tb-f-contact-grid__nav{display:grid;gap:10px}.tb-f-contact-grid__link{color:inherit;text-decoration:none;opacity:.78}.tb-f-contact-grid__link:hover{opacity:1;color:var(--tb-color-primary)}.tb-f-contact-grid__parent{display:grid;gap:8px}.tb-f-contact-grid__parent>.tb-f-contact-grid__link{font-weight:850;opacity:1}.tb-f-contact-grid__submenu{display:grid;gap:7px;padding-left:0}.tb-f-contact-grid__chevron{display:none}.tb-f-contact-grid__brand{max-width:520px}.tb-f-contact-grid__contacts{margin:34px 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.tb-f-contact-grid__contact-item{padding:18px;border:1px solid var(--tb-color-border);border-radius:12px;display:grid;gap:4px;color:inherit;text-decoration:none}.tb-f-contact-grid__contact-label{color:var(--tb-color-muted);font-size:10px;text-transform:uppercase}.tb-f-contact-grid__contact-value{font-weight:850}.tb-f-contact-grid__menu{padding-top:20px;border-top:1px solid var(--tb-color-border)}.tb-f-contact-grid__nav{display:flex;flex-wrap:wrap;gap:18px}.tb-f-contact-grid__legal{margin-top:18px}@media(max-width:820px){.tb-f-contact-grid__grid,.tb-f-contact-grid__top,.tb-f-contact-grid__row,.tb-f-contact-grid__bottom{grid-template-columns:1fr;flex-wrap:wrap}.tb-f-contact-grid__nav{grid-template-columns:repeat(2,minmax(0,1fr))}.tb-f-contact-grid__contacts{grid-template-columns:1fr}}@media(max-width:520px){.tb-f-contact-grid__inner{padding-left:16px;padding-right:16px}.tb-f-contact-grid__nav{grid-template-columns:1fr}.tb-f-contact-grid__search{width:100%!important}}",
  "js": "",
  "slug": "footer-contact-grid",
  "name": "Contact Grid Footer",
  "category": "Footers",
  "description": "A contact-focused footer with repeatable contact cards and menu.",
  "keywords": [
    "footer",
    "navigation",
    "menu",
    "contactgrid"
  ],
  "contexts": [
    "footer"
  ],
  "version": "1.0.0"
}
