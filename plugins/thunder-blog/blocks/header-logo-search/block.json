{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200",
      "search_placeholder": "Search the blog"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      },
      {
        "key": "search_placeholder",
        "label": "Search placeholder",
        "type": "text",
        "default": "Search the blog"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "logo": "{{app_logo}}",
        "url": "{{root}}/"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-h-logo-search__brand-name"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-h-logo-search__logo"
        },
        {
          "key": "url",
          "label": "Home URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-logo-search__brand\" href=\"{{url}}\"><img class=\"tb-h-logo-search__logo\" src=\"{{logo}}\" alt=\"\"><span class=\"tb-h-logo-search__brand-name\">{{name}}</span></a>",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "secondary"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-h-logo-search__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-h-logo-search__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-h-logo-search__parent\"><a class=\"tb-h-logo-search__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-h-logo-search__chevron\">⌄</span></a><div class=\"tb-h-logo-search__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-h-logo-search__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<header class=\"tb-block tb-h-logo-search\"><div class=\"tb-h-logo-search__inner\" style=\"--tb-h-logo-search-width:{{width}}px\"><div class=\"tb-h-logo-search__top\">{{elements:brand}}<form class=\"tb-h-logo-search__search\" action=\"{{root}}/blog/search\" method=\"get\"><input class=\"tb-h-logo-search__search-input\" name=\"q\" placeholder=\"{{search_placeholder}}\"><button class=\"tb-h-logo-search__search-button\" type=\"submit\">Go</button></form></div><div class=\"tb-h-logo-search__menu-row\">{{menu:primary}}</div></div></header>",
  "css": ".tb-h-logo-search{position:relative;background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-h-logo-search__inner{max-width:var(--tb-h-logo-search-width);margin:auto;padding:0 24px}.tb-h-logo-search__brand{display:flex;align-items:center;gap:10px;color:var(--tb-color-secondary);text-decoration:none;font-weight:900}.tb-h-logo-search__logo{width:38px;height:38px;object-fit:contain}.tb-h-logo-search__brand-name{letter-spacing:-.025em}.tb-h-logo-search__nav{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.tb-h-logo-search__link{display:inline-flex;align-items:center;gap:5px;padding:9px 11px;color:inherit;text-decoration:none;font-weight:750}.tb-h-logo-search__link:hover{color:var(--tb-color-primary)}.tb-h-logo-search__parent{position:relative}.tb-h-logo-search__submenu{position:absolute;z-index:20;top:100%;left:0;min-width:190px;padding:8px;border:1px solid var(--tb-color-border);border-radius:12px;background:var(--tb-color-surface);display:none;box-shadow:0 16px 38px color-mix(in srgb,var(--tb-color-secondary) 14%,transparent)}.tb-h-logo-search__submenu .tb-h-logo-search__link{display:flex}.tb-h-logo-search__parent:hover>.tb-h-logo-search__submenu,.tb-h-logo-search__parent:focus-within>.tb-h-logo-search__submenu{display:grid}.tb-h-logo-search__chevron{font-size:10px;opacity:.65}.tb-h-logo-search__top{padding:18px 0;display:flex;align-items:center;gap:32px}.tb-h-logo-search__search{margin-left:auto;width:min(520px,55%);height:44px;border-bottom:2px solid var(--tb-color-secondary);display:flex}.tb-h-logo-search__search-input{min-width:0;flex:1;border:0;background:transparent;color:var(--tb-color-text);outline:none}.tb-h-logo-search__search-button{padding:0 10px;border:0;background:transparent;color:var(--tb-color-primary);font-weight:900}.tb-h-logo-search__menu-row{padding:8px 0;border-top:1px solid var(--tb-color-border)}@media(max-width:820px){.tb-h-logo-search__row,.tb-h-logo-search__top,.tb-h-logo-search__glass,.tb-h-logo-search__frame,.tb-h-logo-search__pill{flex-wrap:wrap;height:auto;padding-top:14px;padding-bottom:14px}.tb-h-logo-search__nav{width:100%;order:5}.tb-h-logo-search__submenu{position:static;box-shadow:none}}@media(max-width:560px){.tb-h-logo-search__inner{padding-left:16px;padding-right:16px}.tb-h-logo-search__row{grid-template-columns:1fr!important}.tb-h-logo-search__search{width:100%!important}}",
  "js": "",
  "slug": "header-logo-search",
  "name": "Logo and Search Header",
  "category": "Headers",
  "description": "A logo-led header with a wide blog search field and menu below.",
  "keywords": [
    "header",
    "navigation",
    "menu",
    "logosearch"
  ],
  "contexts": [
    "header"
  ],
  "version": "1.0.0"
}
