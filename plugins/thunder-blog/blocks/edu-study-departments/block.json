{
  "slug": "edu-study-departments",
  "name": "Study Departments",
  "category": "Education",
  "description": "Numbered academic departments grid for colleges and universities",
  "keywords": [
    "education",
    "departments",
    "university",
    "faculties"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-departments\"><div class=\"tb-edu-departments__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-departments__grid\">{{elements:departments}}</div></div>",
  "css": ".tb-edu-departments{padding:clamp(34px,6vw,78px);background:var(--tb-color-background)}.tb-edu-departments__head{max-width:750px;margin-bottom:30px}.tb-edu-departments__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-departments__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,60px)}.tb-edu-departments__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-departments__grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--tb-color-border);border-left:1px solid var(--tb-color-border)}.tb-edu-departments__card{padding:28px;border-right:1px solid var(--tb-color-border);border-bottom:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-edu-departments__number{color:var(--tb-color-primary);font-size:12px;font-weight:950}.tb-edu-departments__card-title{margin:34px 0 8px;color:var(--tb-color-secondary);font-size:28px}.tb-edu-departments__card-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:650px){.tb-edu-departments__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Academic areas"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-departments__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
