{
  "slug": "medicine-science-publications",
  "name": "Science Publications",
  "category": "Medicine & Science",
  "description": "Research publication and journal listing",
  "keywords": [
    "science",
    "publications",
    "research"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-science-publications\"><div class=\"tb-med-science-publications__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-med-science-publications__list\">{{elements:papers}}</div></section>",
  "css": ".tb-med-science-publications{padding:clamp(42px,7vw,88px);background:var(--tb-color-background)}.tb-med-science-publications__head{max-width:760px;margin-bottom:32px}.tb-med-science-publications__eyebrow{font-family:monospace;color:var(--tb-color-primary);font-size:12px;text-transform:uppercase;letter-spacing:.14em}.tb-med-science-publications__title{font-size:clamp(38px,5vw,62px);margin:10px 0 14px;color:var(--tb-color-secondary)}.tb-med-science-publications__text{color:var(--tb-color-muted);line-height:1.7}.tb-med-science-publications__list{border-top:1px solid var(--tb-color-border)}.tb-med-science-publications__paper{display:grid;grid-template-columns:100px 1fr;gap:24px;padding:22px 0;border-bottom:1px solid var(--tb-color-border)}.tb-med-science-publications__paper__number{font-family:monospace;color:var(--tb-color-primary);font-size:15px}.tb-med-science-publications__paper__title{font-size:22px;margin:0 0 7px;color:var(--tb-color-secondary)}.tb-med-science-publications__paper__text{margin:0;color:var(--tb-color-muted)}@media(max-width:560px){.tb-med-science-publications__paper{grid-template-columns:1fr;gap:8px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Selected publications"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<span class=\"tb-med-science-publications__eyebrow\">{{text}}</span>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Research in print"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-med-science-publications__title\">{{text}}</h2>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "A clean publication list for laboratories, universities, researchers and scientific organizations."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-med-science-publications__text\">{{text}}</p>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    },
    {
      "key": "papers",
      "label": "Publications",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "number": "",
        "title": "",
        "text": ""
      },
      "schema": [
        {
          "key": "number",
          "label": "Number",
          "type": "text",
          "selector": ".tb-med-science-publications__paper__number"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-med-science-publications__paper__title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-med-science-publications__paper__text",
          "rows": 3
        }
      ],
      "template": "<article class=\"tb-med-science-publications__paper\"><strong class=\"tb-med-science-publications__paper__number\">{{number}}</strong><h3 class=\"tb-med-science-publications__paper__title\">{{title}}</h3><p class=\"tb-med-science-publications__paper__text\">{{text}}</p></article>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "number": "2026",
          "title": "Precision biomarkers in early diagnostics",
          "text": "Journal of Translational Research · Vol. 18"
        },
        {
          "number": "2026",
          "title": "New approaches to cellular imaging",
          "text": "Applied Bioscience Review · Vol. 42"
        },
        {
          "number": "2025",
          "title": "Population-level predictors of recovery",
          "text": "Clinical Data Science · Vol. 11"
        }
      ],
      "min": 1,
      "max": 12
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
