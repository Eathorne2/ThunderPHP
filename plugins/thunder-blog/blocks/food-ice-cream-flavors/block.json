{
  "slug": "food-ice-cream-flavors",
  "name": "Ice Cream Flavors",
  "category": "Food & Restaurant",
  "description": "Colorful ice-cream flavor board with image and editable flavor chips",
  "keywords": [
    "food",
    "restaurant",
    "ice cream",
    "dessert",
    "flavors"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-icecream\"><div class=\"tb-food-icecream__visual\">{{elements:image}}</div><div class=\"tb-food-icecream__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-food-icecream__flavors\">{{elements:items}}</div></div></div>",
  "css": ".tb-food-icecream{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;background:color-mix(in srgb,var(--tb-color-primary) 12%,var(--tb-color-surface));overflow:hidden}.tb-food-icecream__visual{padding:clamp(25px,5vw,60px)}.tb-food-icecream__image{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:50%;display:block}.tb-food-icecream__copy{padding:clamp(36px,7vw,90px)}.tb-food-icecream__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;text-transform:uppercase;letter-spacing:.16em}.tb-food-icecream__title{margin:10px 0;color:var(--tb-color-secondary);font-size:clamp(46px,7vw,80px);line-height:.95}.tb-food-icecream__text{color:var(--tb-color-muted);line-height:1.7}.tb-food-icecream__flavors{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.tb-food-icecream__item{padding:11px 13px;background:var(--tb-color-background);border:1px solid var(--tb-color-border)}.tb-food-icecream__name{display:block;color:var(--tb-color-secondary);font-weight:900}.tb-food-icecream__note{display:block;margin-top:2px;color:var(--tb-color-muted);font-size:12px}@media(max-width:700px){.tb-food-icecream{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Ice cream image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1560008581-09826d1de69e?auto=format&fit=crop&w=1400&q=82",
        "alt": "Ice cream scoops"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-food-icecream__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-food-icecream__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Scooped daily"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-icecream__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Pick your flavor"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h2 class=\"tb-food-icecream__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Small-batch ice cream and bright seasonal sorbets made in-house."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-food-icecream__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Flavor",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "name": "Vanilla Bean",
        "note": "Classic & creamy"
      },
      "schema": [
        {
          "key": "name",
          "label": "Flavor",
          "type": "text",
          "selector": ".tb-food-icecream__name"
        },
        {
          "key": "note",
          "label": "Note",
          "type": "text",
          "selector": ".tb-food-icecream__note"
        }
      ],
      "template": "<div class=\"tb-food-icecream__item\"><strong class=\"tb-food-icecream__name\">{{name}}</strong><span class=\"tb-food-icecream__note\">{{note}}</span></div>",
      "min": 1,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "name": "Vanilla Bean",
          "note": "Classic & creamy"
        },
        {
          "name": "Salted Caramel",
          "note": "Sweet · salty · rich"
        },
        {
          "name": "Mango Sorbet",
          "note": "Bright & dairy-free"
        },
        {
          "name": "Dark Chocolate",
          "note": "Deep cocoa"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
