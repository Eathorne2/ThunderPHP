{
  "slug": "edu-tuition-pricing",
  "name": "Tuition & Course Pricing",
  "category": "Education",
  "description": "Three pricing plans for language centers, tutoring and online programs",
  "keywords": [
    "education",
    "pricing",
    "tuition",
    "courses"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-pricing\"><div class=\"tb-edu-pricing__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-pricing__grid\">{{elements:plans}}</div></div>",
  "css": ".tb-edu-pricing{padding:clamp(34px,6vw,78px);background:var(--tb-color-background)}.tb-edu-pricing__head{max-width:720px;margin:0 auto 30px;text-align:center}.tb-edu-pricing__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-pricing__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,60px)}.tb-edu-pricing__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-pricing__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tb-edu-pricing__plan{padding:28px;border:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-edu-pricing__name{margin:0;color:var(--tb-color-secondary);font-size:26px}.tb-edu-pricing__price{display:inline-block;margin-top:24px;color:var(--tb-color-primary);font-size:38px;font-weight:950}.tb-edu-pricing__period{color:var(--tb-color-muted)}.tb-edu-pricing__plan-text,.tb-edu-pricing__features{color:var(--tb-color-muted);line-height:1.65}.tb-edu-pricing__features{padding-top:18px;border-top:1px solid var(--tb-color-border);font-size:13px}@media(max-width:760px){.tb-edu-pricing__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
