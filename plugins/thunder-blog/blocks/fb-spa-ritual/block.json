{
  "slug": "fb-spa-ritual",
  "name": "Spa Ritual Feature",
  "category": "Fashion & Beauty",
  "description": "Large spa imagery with a calm three-step restorative ritual.",
  "keywords": [
    "spa",
    "wellness",
    "beauty",
    "ritual"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-spa\"><div class=\"tb-fb-spa__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-fb-spa__layout\">{{elements:image}}<div class=\"tb-fb-spa__steps\">{{elements:steps}}</div></div></div>",
  "css": ".tb-fb-spa{padding:clamp(30px,6vw,78px);background:color-mix(in srgb,var(--tb-color-primary) 5%,var(--tb-color-background))}.tb-fb-spa__head{max-width:760px;margin-bottom:32px}.tb-fb-spa__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.17em;text-transform:uppercase}.tb-fb-spa__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(40px,6vw,68px);font-weight:500}.tb-fb-spa__text{max-width:620px;color:var(--tb-color-muted);line-height:1.7}.tb-fb-spa__layout{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr);gap:24px}.tb-fb-spa__image{width:100%;height:100%;min-height:520px;object-fit:cover}.tb-fb-spa__steps{display:grid}.tb-fb-spa__step{padding:26px;border-bottom:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-fb-spa__step-title{margin:0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:28px}.tb-fb-spa__step-text{margin:8px 0 0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:760px){.tb-fb-spa__layout{grid-template-columns:1fr}.tb-fb-spa__image{min-height:380px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
