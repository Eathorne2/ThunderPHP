{
  "slug": "edu-free-course-cta",
  "name": "Start Learning Free CTA",
  "category": "Education",
  "description": "Simple high-impact enrollment CTA for a free course or trial lesson",
  "keywords": [
    "education",
    "free course",
    "cta",
    "enrollment"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-free-cta\"><div class=\"tb-edu-free-cta__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-free-cta__action\">{{elements:cta}}{{elements:note}}</div></div>",
  "css": ".tb-edu-free-cta{display:grid;grid-template-columns:1fr auto;align-items:end;gap:30px;padding:clamp(36px,7vw,84px);background:var(--tb-color-primary);color:#fff}.tb-edu-free-cta__eyebrow{font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.16em}.tb-edu-free-cta__title{max-width:850px;margin:10px 0;color:inherit;font-size:clamp(44px,6vw,76px);line-height:1}.tb-edu-free-cta__text{max-width:660px;color:inherit;opacity:.82;line-height:1.7}.tb-edu-free-cta__action{display:grid;gap:9px;justify-items:start}.tb-edu-free-cta__cta{padding:14px 20px;background:#fff;color:var(--tb-color-primary);font-weight:950;text-decoration:none}.tb-edu-free-cta__note{color:inherit;opacity:.75;font-size:12px}@media(max-width:760px){.tb-edu-free-cta{grid-template-columns:1fr;align-items:start}}",
  "js": "",
