{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "logo": "{{app_logo}}",
        "url": "{{root}}/"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-h-cta-banner__brand-name"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-h-cta-banner__logo"
        },
        {
          "key": "url",
          "label": "Home URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-cta-banner__brand\" href=\"{{url}}\"><img class=\"tb-h-cta-banner__logo\" src=\"{{logo}}\" alt=\"\"><span class=\"tb-h-cta-banner__brand-name\">{{name}}</span></a>",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "secondary"
        }
      }
    },
    {
      "key": "note",
      "label": "Message",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Fresh stories, useful ideas, thoughtful updates"
      },
      "schema": [
        {
          "key": "text",
          "label": "Message",
          "type": "text",
          "selector": ".tb-h-cta-banner__note"
        }
      ],
      "template": "<div class=\"tb-h-cta-banner__note\">{{text}}</div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-h-cta-banner__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-h-cta-banner__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-h-cta-banner__parent\"><a class=\"tb-h-cta-banner__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-h-cta-banner__chevron\">⌄</span></a><div class=\"tb-h-cta-banner__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-h-cta-banner__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<header class=\"tb-block tb-h-cta-banner\"><div class=\"tb-h-cta-banner__inner\" style=\"--tb-h-cta-banner-width:{{width}}px\"><div class=\"tb-h-cta-banner__row\">{{elements:brand}}{{menu:primary}}</div><div class=\"tb-h-cta-banner__banner\">{{elements:note}}</div></div></header>",
  "css": ".tb-h-cta-banner{position:relative;background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-h-cta-banner__inner{max-width:var(--tb-h-cta-banner-width);margin:auto;padding:0 24px}.tb-h-cta-banner__brand{display:flex;align-items:center;gap:10px;color:var(--tb-color-secondary);text-decoration:none;font-weight:900}.tb-h-cta-banner__logo{width:38px;height:38px;object-fit:contain}.tb-h-cta-banner__brand-name{letter-spacing:-.025em}.tb-h-cta-banner__nav{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.tb-h-cta-banner__link{display:inline-flex;align-items:center;gap:5px;padding:9px 11px;color:inherit;text-decoration:none;font-weight:750}.tb-h-cta-banner__link:hover{color:var(--tb-color-primary)}.tb-h-cta-banner__parent{position:relative}.tb-h-cta-banner__submenu{position:absolute;z-index:20;top:100%;left:0;min-width:190px;padding:8px;border:1px solid var(--tb-color-border);border-radius:12px;background:var(--tb-color-surface);display:none;box-shadow:0 16px 38px color-mix(in srgb,var(--tb-color-secondary) 14%,transparent)}.tb-h-cta-banner__submenu .tb-h-cta-banner__link{display:flex}.tb-h-cta-banner__parent:hover>.tb-h-cta-banner__submenu,.tb-h-cta-banner__parent:focus-within>.tb-h-cta-banner__submenu{display:grid}.tb-h-cta-banner__chevron{font-size:10px;opacity:.65}.tb-h-cta-banner__row{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:22px}.tb-h-cta-banner__banner{padding:13px 18px;border-radius:12px 12px 0 0;background:var(--tb-color-primary);color:var(--tb-color-background);text-align:center}.tb-h-cta-banner__note{font-weight:800}@media(max-width:820px){.tb-h-cta-banner__row,.tb-h-cta-banner__top,.tb-h-cta-banner__glass,.tb-h-cta-banner__frame,.tb-h-cta-banner__pill{flex-wrap:wrap;height:auto;padding-top:14px;padding-bottom:14px}.tb-h-cta-banner__nav{width:100%;order:5}.tb-h-cta-banner__submenu{position:static;box-shadow:none}}@media(max-width:560px){.tb-h-cta-banner__inner{padding-left:16px;padding-right:16px}.tb-h-cta-banner__row{grid-template-columns:1fr!important}.tb-h-cta-banner__search{width:100%!important}}",
  "js": "",
  "slug": "header-cta-banner",
  "name": "CTA Banner Header",
  "category": "Headers",
  "description": "A prominent action message sits beside the brand and saved navigation.",
  "keywords": [
    "header",
    "navigation",
    "menu",
    "ctabanner"
  ],
  "contexts": [
    "header"
  ],
  "version": "1.0.0"
}
