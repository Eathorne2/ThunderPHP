  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-online-features\"><div class=\"tb-edu-online-features__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-online-features__grid\">{{elements:features}}</div></div>",
  "css": ".tb-edu-online-features{padding:clamp(34px,6vw,78px);background:var(--tb-color-background)}.tb-edu-online-features__head{max-width:760px;margin-bottom:30px}.tb-edu-online-features__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-online-features__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,60px)}.tb-edu-online-features__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-online-features__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.tb-edu-online-features__feature{padding:24px;border:1px solid var(--tb-color-border);background:var(--tb-color-surface)}.tb-edu-online-features__icon{display:block;color:var(--tb-color-primary);font-size:24px;font-weight:950}.tb-edu-online-features__feature-title{margin:36px 0 8px;color:var(--tb-color-secondary);font-size:22px}.tb-edu-online-features__feature-text{margin:0;color:var(--tb-color-muted);line-height:1.6}@media(max-width:800px){.tb-edu-online-features__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.tb-edu-online-features__grid{grid-template-columns:1fr}}",
  "js": "",
