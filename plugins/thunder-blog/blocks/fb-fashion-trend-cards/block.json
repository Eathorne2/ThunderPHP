{
  "slug": "fb-fashion-trend-cards",
  "name": "Fashion Trend Cards",
  "category": "Fashion & Beauty",
  "description": "Three magazine-style trend stories with imagery and links.",
  "keywords": [
    "fashion",
    "trends",
    "cards",
    "magazine"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-trends\"><div class=\"tb-fb-trends__head\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-fb-trends__grid\">{{elements:cards}}</div></div>",
  "css": ".tb-fb-trends{padding:clamp(30px,6vw,76px);background:var(--tb-color-background)}.tb-fb-trends__head{max-width:760px;margin-bottom:30px}.tb-fb-trends__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-trends__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(38px,6vw,66px);font-weight:500}.tb-fb-trends__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tb-fb-trends__card{background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-fb-trends__image{width:100%;aspect-ratio:4/5;object-fit:cover}.tb-fb-trends__copy{padding:22px}.tb-fb-trends__tag{color:var(--tb-color-primary);font-size:11px;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.tb-fb-trends__card-title{margin:9px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:28px}.tb-fb-trends__card-text{margin:0 0 14px;color:var(--tb-color-muted);line-height:1.65}.tb-fb-trends__link{color:var(--tb-color-secondary);font-weight:800;text-decoration:none;border-bottom:1px solid var(--tb-color-border)}@media(max-width:760px){.tb-fb-trends__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Trend report"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-trends__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "What we are wearing now"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-fb-trends__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cards",
      "label": "Trend card",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "image": "https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1400&q=82",
        "alt": "Fashion trend portrait",
        "tag": "Trend 01",
        "title": "Soft tailoring",
        "text": "Relaxed structure and clean lines for everyday dressing.",
        "url": "#"
      },
      "schema": [
        {
          "key": "image",
          "label": "Image",
          "type": "image",
          "selector": ".tb-fb-trends__image"
        },
        {
          "key": "alt",
          "label": "Alt",
          "type": "text"
        },
        {
          "key": "tag",
          "label": "Tag",
          "type": "text",
          "selector": ".tb-fb-trends__tag"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-fb-trends__card-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-fb-trends__card-text",
          "rows": 3
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<article class=\"tb-fb-trends__card\"><img class=\"tb-fb-trends__image\" src=\"{{image}}\" alt=\"{{alt}}\"><div class=\"tb-fb-trends__copy\"><span class=\"tb-fb-trends__tag\">{{tag}}</span><h3 class=\"tb-fb-trends__card-title\">{{title}}</h3><p class=\"tb-fb-trends__card-text\">{{text}}</p><a class=\"tb-fb-trends__link\" href=\"{{url}}\">Read more</a></div></article>",
      "min": 1,
      "max": 8,
      "default_items": [
        {
          "image": "https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1400&q=82",
          "alt": "Fashion trend portrait",
          "tag": "Trend 01",
          "title": "Soft tailoring",
          "text": "Relaxed structure and clean lines for everyday dressing.",
          "url": "#"
        },
        {
          "image": "https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=1400&q=82",
          "alt": "Clothing rack trend",
          "tag": "Trend 02",
          "title": "Tactile layers",
          "text": "Texture replaces excess with depth and movement.",
          "url": "#"
        },
        {
          "image": "https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1400&q=82",
          "alt": "Modern fashion portrait",
          "tag": "Trend 03",
          "title": "Bold restraint",
          "text": "One strong idea, repeated with confidence.",
          "url": "#"
        }
      ],
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
