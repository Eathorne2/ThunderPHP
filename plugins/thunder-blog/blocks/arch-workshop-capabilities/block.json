  "html": "<section class=\"tb-block tb-arch-workshop-capabilities\"><div class=\"tb-arch-workshop-capabilities__head\">{{elements:kicker}}{{elements:title}}{{elements:intro}}</div><div class=\"tb-arch-workshop-capabilities__grid\">{{elements:cards}}</div></section>",
  "css": ".tb-arch-workshop-capabilities{padding:clamp(40px,7vw,86px);background:var(--tb-color-background)}.tb-arch-workshop-capabilities__head{max-width:760px;margin-bottom:36px}.tb-arch-workshop-capabilities__kicker{font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:var(--tb-color-primary)}.tb-arch-workshop-capabilities__title{font-size:clamp(38px,5vw,64px);line-height:1;margin:12px 0;color:var(--tb-color-secondary)}.tb-arch-workshop-capabilities__intro{font-size:17px;line-height:1.7;color:var(--tb-color-muted)}.tb-arch-workshop-capabilities__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tb-arch-workshop-capabilities__card{padding:28px;border-top:3px solid var(--tb-color-primary);background:var(--tb-color-surface)}.tb-arch-workshop-capabilities__index{display:block;color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.12em;margin-bottom:32px}.tb-arch-workshop-capabilities__card-title{font-size:23px;margin:0 0 10px;color:var(--tb-color-secondary)}.tb-arch-workshop-capabilities__card-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:860px){.tb-arch-workshop-capabilities__grid{grid-template-columns:1fr 1fr}}@media(max-width:580px){.tb-arch-workshop-capabilities__grid{grid-template-columns:1fr}}",
