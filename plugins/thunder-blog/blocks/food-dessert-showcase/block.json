{
  "slug": "food-dessert-showcase",
  "name": "Dessert Showcase",
  "category": "Food & Restaurant",
  "description": "Playful dessert feature with large image and sweet menu list",
  "keywords": [
    "food",
    "restaurant",
    "dessert",
    "cake",
    "sweets"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-dessert\"><div class=\"tb-food-dessert__copy\">{{elements:eyebrow}}{{elements:title}}<div class=\"tb-food-dessert__items\">{{elements:items}}</div></div><div class=\"tb-food-dessert__visual\">{{elements:image}}</div></div>",
  "css": ".tb-food-dessert{display:grid;grid-template-columns:1fr 1fr;gap:clamp(26px,6vw,76px);padding:clamp(34px,6vw,80px);align-items:center;background:var(--tb-color-surface)}.tb-food-dessert__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;text-transform:uppercase;letter-spacing:.18em}.tb-food-dessert__title{margin:10px 0 28px;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(48px,7vw,82px)}.tb-food-dessert__item{display:grid;grid-template-columns:1fr auto;gap:6px 16px;padding:16px 0;border-top:1px solid var(--tb-color-border)}.tb-food-dessert__item h3{margin:0;color:var(--tb-color-secondary)}.tb-food-dessert__item p{margin:0;color:var(--tb-color-muted)}.tb-food-dessert__price{grid-column:2;grid-row:1/3;color:var(--tb-color-primary);font-weight:950}.tb-food-dessert__image{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:50%;display:block;box-shadow:24px 24px 0 color-mix(in srgb,var(--tb-color-primary) 17%,transparent)}@media(max-width:720px){.tb-food-dessert{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Save room"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-dessert__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A sweet finish"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h2 class=\"tb-food-dessert__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Dessert",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "name": "Citrus tart",
        "text": "Lemon curd · crisp shell · cream",
        "price": "K95"
      },
      "schema": [
        {
          "key": "name",
          "label": "Dessert",
          "type": "text",
          "selector": ".tb-food-dessert__item h3"
        },
        {
          "key": "text",
          "label": "Description",
          "type": "text",
          "selector": ".tb-food-dessert__item p"
        },
        {
          "key": "price",
          "label": "Price",
          "type": "text",
          "selector": ".tb-food-dessert__price"
        }
      ],
      "template": "<article class=\"tb-food-dessert__item\"><h3>{{name}}</h3><p>{{text}}</p><strong class=\"tb-food-dessert__price\">{{price}}</strong></article>",
      "min": 1,
      "max": 12,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "name": "Citrus tart",
          "text": "Lemon curd · crisp shell · cream",
          "price": "K95"
        },
        {
          "name": "Chocolate cake",
          "text": "Dark chocolate · cocoa nib · vanilla",
          "price": "K105"
        },
        {
          "name": "Fruit pavlova",
          "text": "Meringue · seasonal fruit · yoghurt",
          "price": "K90"
        }
      ]
    },
    {
      "key": "image",
      "label": "Dessert image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1551024506-0bccd828d307?auto=format&fit=crop&w=1400&q=82",
        "alt": "Fresh dessert"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-food-dessert__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-food-dessert__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
