{
  "slug": "edu-learning-process",
  "name": "How Learning Works",
  "category": "Education",
  "description": "Four-step learning process with strong editorial numbering",
  "keywords": [
    "education",
    "process",
    "steps",
    "learning"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-process\"><div class=\"tb-edu-process__head\">{{elements:eyebrow}}{{elements:title}}</div><div class=\"tb-edu-process__steps\">{{elements:steps}}</div></div>",
  "css": ".tb-edu-process{padding:clamp(34px,6vw,78px);background:var(--tb-color-surface)}.tb-edu-process__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.tb-edu-process__title{margin:8px 0 28px;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,60px)}.tb-edu-process__step{display:grid;grid-template-columns:70px minmax(180px,.7fr) 1fr;gap:22px;padding:22px 0;border-top:1px solid var(--tb-color-border)}.tb-edu-process__number{color:var(--tb-color-primary);font-size:13px;font-weight:950}.tb-edu-process__step-title{margin:0;color:var(--tb-color-secondary);font-size:26px}.tb-edu-process__step-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:640px){.tb-edu-process__step{grid-template-columns:1fr;gap:6px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "How it works"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-process__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Learning built around progress"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-edu-process__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "steps",
      "label": "Learning step",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "number": "01",
        "title": "Choose a path",
        "text": "Find the program that matches your goal."
      },
      "schema": [
        {
          "key": "number",
          "label": "Number",
          "type": "text",
          "selector": ".tb-edu-process__number"
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "selector": ".tb-edu-process__step-title"
        },
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ".tb-edu-process__step-text",
          "rows": 2
        }
      ],
      "template": "<article class=\"tb-edu-process__step\"><span class=\"tb-edu-process__number\">{{number}}</span><h3 class=\"tb-edu-process__step-title\">{{title}}</h3><p class=\"tb-edu-process__step-text\">{{text}}</p></article>",
      "min": 1,
      "max": 10,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
        {
          "number": "01",
          "title": "Choose a path",
          "text": "Find the program that matches your goal."
        },
        {
          "number": "02",
          "title": "Learn by doing",
          "text": "Build knowledge through guided practice."
        },
        {
          "number": "03",
          "title": "Get feedback",
          "text": "Improve with support from instructors and peers."
        },
        {
          "number": "04",
          "title": "Show your progress",
          "text": "Finish with evidence of what you can do."
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
