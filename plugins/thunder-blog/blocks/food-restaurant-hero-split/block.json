      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A warm neighborhood restaurant built around fresh ingredients, generous plates and relaxed evenings."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
