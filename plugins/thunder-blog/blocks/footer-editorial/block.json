{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand statement",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "text": "{{app_description}}",
        "logo": "{{app_logo}}"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-f-editorial__brand-name"
        },
        {
          "key": "text",
          "label": "Brand text",
          "type": "textarea",
          "selector": ".tb-f-editorial__brand-text"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-f-editorial__logo"
        }
      ],
      "template": "<div class=\"tb-f-editorial__brand\"><img class=\"tb-f-editorial__logo\" src=\"{{logo}}\" alt=\"\"><strong class=\"tb-f-editorial__brand-name\">{{name}}</strong><p class=\"tb-f-editorial__brand-text\">{{text}}</p></div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "text"
        }
      }
    },
    {
      "key": "copyright",
      "label": "Copyright",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "© {{year}} {{app_name}}. All rights reserved."
      },
      "schema": [
        {
          "key": "text",
          "label": "Copyright text",
          "type": "text",
          "selector": ".tb-f-editorial__copyright"
        }
      ],
      "template": "<div class=\"tb-f-editorial__copyright\">{{text}}</div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-f-editorial__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-f-editorial__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-f-editorial__parent\"><a class=\"tb-f-editorial__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-f-editorial__chevron\">⌄</span></a><div class=\"tb-f-editorial__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-f-editorial__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<footer class=\"tb-block tb-f-editorial\"><div class=\"tb-f-editorial__inner\" style=\"--tb-f-editorial-width:{{width}}px\"><div class=\"tb-f-editorial__mast\">{{elements:brand}}</div><div class=\"tb-f-editorial__menu\">{{menu:primary}}</div><div class=\"tb-f-editorial__legal\">{{elements:copyright}}</div></div></footer>",
  "css": ".tb-f-editorial{background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-f-editorial__inner{max-width:var(--tb-f-editorial-width);margin:auto;padding:52px 24px 24px}.tb-f-editorial__brand{display:grid;gap:10px;align-content:start}.tb-f-editorial__logo{width:42px;height:42px;object-fit:contain}.tb-f-editorial__brand-name{font-size:20px}.tb-f-editorial__brand-text{max-width:360px;margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-f-editorial__copyright{color:var(--tb-color-muted);font-size:12px}.tb-f-editorial__nav{display:grid;gap:10px}.tb-f-editorial__link{color:inherit;text-decoration:none;opacity:.78}.tb-f-editorial__link:hover{opacity:1;color:var(--tb-color-primary)}.tb-f-editorial__parent{display:grid;gap:8px}.tb-f-editorial__parent>.tb-f-editorial__link{font-weight:850;opacity:1}.tb-f-editorial__submenu{display:grid;gap:7px;padding-left:0}.tb-f-editorial__chevron{display:none}.tb-f-editorial__inner{max-width:980px}.tb-f-editorial__mast{text-align:center}.tb-f-editorial__brand{justify-items:center}.tb-f-editorial__brand-name{font-family:Georgia,serif;font-size:30px}.tb-f-editorial__brand-text{text-align:center;font-family:Georgia,serif;font-style:italic}.tb-f-editorial__menu{margin-top:28px;padding:16px 0;border-top:1px solid var(--tb-color-secondary);border-bottom:1px solid var(--tb-color-secondary)}.tb-f-editorial__nav{display:flex;justify-content:center;flex-wrap:wrap;gap:20px;font-family:Georgia,serif}.tb-f-editorial__legal{padding-top:18px;text-align:center}@media(max-width:820px){.tb-f-editorial__grid,.tb-f-editorial__top,.tb-f-editorial__row,.tb-f-editorial__bottom{grid-template-columns:1fr;flex-wrap:wrap}.tb-f-editorial__nav{grid-template-columns:repeat(2,minmax(0,1fr))}.tb-f-editorial__contacts{grid-template-columns:1fr}}@media(max-width:520px){.tb-f-editorial__inner{padding-left:16px;padding-right:16px}.tb-f-editorial__nav{grid-template-columns:1fr}.tb-f-editorial__search{width:100%!important}}",
  "js": "",
  "slug": "footer-editorial",
  "name": "Editorial Footer",
  "category": "Footers",
  "description": "A refined serif footer for journals and long-form publications.",
  "keywords": [
    "footer",
    "navigation",
    "menu",
    "editorial"
  ],
  "contexts": [
    "footer"
  ],
  "version": "1.0.0"
}
