{
  "slug": "arch-project-team",
  "name": "Architecture Project Team",
  "category": "Architecture & Building",
  "description": "Responsive architecture/building card section",
  "keywords": [
    "architecture",
    "project",
    "team",
    "cards"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-arch-project-team\"><div class=\"tb-arch-project-team__head\">{{elements:kicker}}{{elements:title}}{{elements:intro}}</div><div class=\"tb-arch-project-team__grid\">{{elements:cards}}</div></section>",
  "css": ".tb-arch-project-team{padding:clamp(40px,7vw,86px);background:var(--tb-color-background)}.tb-arch-project-team__head{max-width:760px;margin-bottom:36px}.tb-arch-project-team__kicker{font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:var(--tb-color-primary)}.tb-arch-project-team__title{font-size:clamp(38px,5vw,64px);line-height:1;margin:12px 0;color:var(--tb-color-secondary)}.tb-arch-project-team__intro{font-size:17px;line-height:1.7;color:var(--tb-color-muted)}.tb-arch-project-team__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tb-arch-project-team__card{padding:28px;border-top:3px solid var(--tb-color-primary);background:var(--tb-color-surface)}.tb-arch-project-team__index{display:block;color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.12em;margin-bottom:32px}.tb-arch-project-team__card-title{font-size:23px;margin:0 0 10px;color:var(--tb-color-secondary)}.tb-arch-project-team__card-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:860px){.tb-arch-project-team__grid{grid-template-columns:1fr 1fr}}@media(max-width:580px){.tb-arch-project-team__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
