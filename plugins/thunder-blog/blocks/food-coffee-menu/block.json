{
  "slug": "food-coffee-menu",
  "name": "Coffee Menu Price List",
  "category": "Food & Restaurant",
  "description": "Minimal café price board for coffee, tea and specialty drinks",
  "keywords": [
    "food",
    "restaurant",
    "coffee",
    "menu",
    "prices"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-coffee-menu\"><div class=\"tb-food-coffee-menu__side\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-food-coffee-menu__menu\">{{elements:items}}</div></div>",
  "css": ".tb-food-coffee-menu{display:grid;grid-template-columns:minmax(260px,.7fr) 1.3fr;gap:clamp(30px,7vw,90px);padding:clamp(36px,6vw,82px);background:var(--tb-color-surface)}.tb-food-coffee-menu__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.tb-food-coffee-menu__title{margin:10px 0;color:var(--tb-color-secondary);font-size:clamp(44px,6vw,72px)}.tb-food-coffee-menu__text{color:var(--tb-color-muted);line-height:1.7}.tb-food-coffee-menu__item{display:grid;grid-template-columns:1fr auto;gap:6px 16px;padding:18px 0;border-bottom:1px dashed var(--tb-color-border)}.tb-food-coffee-menu__name{margin:0;color:var(--tb-color-secondary);font-size:20px}.tb-food-coffee-menu__size{margin:0;color:var(--tb-color-muted);font-size:13px}.tb-food-coffee-menu__price{grid-column:2;grid-row:1/3;color:var(--tb-color-primary);font-weight:950}@media(max-width:700px){.tb-food-coffee-menu{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Coffee bar"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-coffee-menu__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Drink well"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<h2 class=\"tb-food-coffee-menu__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Description",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Classic coffee, seasonal drinks and tea prepared all day."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-food-coffee-menu__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "items",
      "label": "Drink",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "name": "Espresso",
        "size": "Single / Double",
        "price": "K28 / K35"
      },
      "schema": [
        {
          "key": "name",
          "label": "Drink",
          "type": "text",
          "selector": ".tb-food-coffee-menu__name"
        },
        {
          "key": "size",
          "label": "Size / note",
          "type": "text",
          "selector": ".tb-food-coffee-menu__size"
        },
        {
          "key": "price",
          "label": "Price",
          "type": "text",
          "selector": ".tb-food-coffee-menu__price"
        }
      ],
      "template": "<article class=\"tb-food-coffee-menu__item\"><h3 class=\"tb-food-coffee-menu__name\">{{name}}</h3><p class=\"tb-food-coffee-menu__size\">{{size}}</p><strong class=\"tb-food-coffee-menu__price\">{{price}}</strong></article>",
      "min": 1,
      "max": 30,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "default_items": [
