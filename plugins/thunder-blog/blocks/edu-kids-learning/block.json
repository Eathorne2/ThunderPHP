{
  "slug": "edu-kids-learning",
  "name": "Fun Learning for Kids",
  "category": "Education",
  "description": "Bright elementary/kindergarten learning cards with playful symbols",
  "keywords": [
    "education",
    "kids",
    "kindergarten",
    "primary school"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-kids\"><div class=\"tb-edu-kids__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}</div><div class=\"tb-edu-kids__cards\">{{elements:cards}}</div></div>",
  "css": ".tb-edu-kids{display:grid;grid-template-columns:.85fr 1.15fr;gap:30px;padding:clamp(34px,6vw,78px);background:color-mix(in srgb,var(--tb-color-primary) 7%,var(--tb-color-background))}.tb-edu-kids__copy{align-self:center}.tb-edu-kids__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.15em}.tb-edu-kids__title{margin:10px 0;color:var(--tb-color-secondary);font-size:clamp(42px,6vw,66px);line-height:1}.tb-edu-kids__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-kids__cta{display:inline-flex;margin-top:20px;padding:12px 18px;border-radius:999px;background:var(--tb-color-primary);color:#fff;text-decoration:none;font-weight:900}.tb-edu-kids__cards{display:grid;gap:12px}.tb-edu-kids__card{display:grid;grid-template-columns:68px 1fr;gap:16px;align-items:center;padding:20px;border-radius:22px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-edu-kids__symbol{width:62px;height:62px;border-radius:18px;display:grid;place-items:center;background:var(--tb-color-accent);color:var(--tb-color-secondary);font-size:28px;font-weight:950}.tb-edu-kids__card-title{margin:0;color:var(--tb-color-secondary);font-size:23px}.tb-edu-kids__card-text{margin:4px 0 0;color:var(--tb-color-muted)}@media(max-width:760px){.tb-edu-kids{grid-template-columns:1fr}}",
  "js": "",
