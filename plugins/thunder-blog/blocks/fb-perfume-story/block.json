{
  "slug": "fb-perfume-story",
  "name": "Perfume Story",
  "category": "Fashion & Beauty",
  "description": "Centered fragrance story with a product image and poetic editorial copy.",
  "keywords": [
    "perfume",
    "fragrance",
    "beauty",
    "product"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-perfume\"><div class=\"tb-fb-perfume__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-fb-perfume__media\">{{elements:image}}<div class=\"tb-fb-perfume__note\">{{elements:note}}</div></div>{{elements:cta}}</div>",
  "css": ".tb-fb-perfume{padding:clamp(34px,7vw,90px);text-align:center;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-fb-perfume__copy{max-width:760px;margin:0 auto}.tb-fb-perfume__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.tb-fb-perfume__title{margin:12px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(46px,7vw,82px);font-weight:500}.tb-fb-perfume__text{max-width:620px;margin:0 auto 28px;color:var(--tb-color-muted);line-height:1.8}.tb-fb-perfume__media{position:relative;max-width:760px;margin:0 auto 24px}.tb-fb-perfume__image{width:100%;max-height:520px;object-fit:cover;display:block}.tb-fb-perfume__note{position:absolute;right:18px;bottom:18px;padding:14px 16px;background:var(--tb-color-surface);color:var(--tb-color-secondary);font-family:Georgia,serif;font-style:italic}.tb-fb-perfume__cta{display:inline-flex;padding:11px 18px;border:1px solid var(--tb-color-secondary);color:var(--tb-color-secondary);text-decoration:none;font-weight:800}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Where scent meets soul"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-perfume__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
