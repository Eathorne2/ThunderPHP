        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A fragrance with memory"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
