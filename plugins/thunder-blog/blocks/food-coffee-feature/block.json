{
  "slug": "food-coffee-feature",
  "name": "Coffee Shop Feature",
  "category": "Food & Restaurant",
  "description": "Dark coffeehouse feature with origin notes and a large lifestyle image",
  "keywords": [
    "food",
    "restaurant",
    "coffee",
    "cafe",
    "roastery"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-coffee\"><div class=\"tb-food-coffee__visual\">{{elements:image}}</div><div class=\"tb-food-coffee__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:origin}}{{elements:cta}}</div></div>",
  "css": ".tb-food-coffee{display:grid;grid-template-columns:1.05fr .95fr;background:var(--tb-color-secondary);color:var(--tb-color-surface)}.tb-food-coffee__visual{padding:30px}.tb-food-coffee__image{width:100%;height:100%;min-height:540px;object-fit:cover;display:block}.tb-food-coffee__copy{padding:clamp(42px,7vw,90px);display:flex;flex-direction:column;justify-content:center}.tb-food-coffee__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;text-transform:uppercase;letter-spacing:.18em}.tb-food-coffee__title{margin:10px 0;color:inherit;font-family:Georgia,serif;font-size:clamp(46px,6vw,76px)}.tb-food-coffee__text{color:color-mix(in srgb,var(--tb-color-surface) 74%,transparent);line-height:1.75}.tb-food-coffee__origin{display:inline-block;margin:18px 0;font-weight:900;color:var(--tb-color-primary)}.tb-food-coffee__cta{align-self:flex-start;padding:12px 18px;border:1px solid color-mix(in srgb,var(--tb-color-surface) 60%,transparent);color:inherit;text-decoration:none;font-weight:850}@media(max-width:760px){.tb-food-coffee{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Coffee image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1400&q=82",
        "alt": "Freshly brewed coffee"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-food-coffee__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-food-coffee__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Roasted with intention"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-coffee__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
