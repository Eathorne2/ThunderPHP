{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand statement",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "text": "{{app_description}}",
        "logo": "{{app_logo}}"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-f-logo-menu__brand-name"
        },
        {
          "key": "text",
          "label": "Brand text",
          "type": "textarea",
          "selector": ".tb-f-logo-menu__brand-text"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-f-logo-menu__logo"
        }
      ],
      "template": "<div class=\"tb-f-logo-menu__brand\"><img class=\"tb-f-logo-menu__logo\" src=\"{{logo}}\" alt=\"\"><strong class=\"tb-f-logo-menu__brand-name\">{{name}}</strong><p class=\"tb-f-logo-menu__brand-text\">{{text}}</p></div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "text"
        }
      }
    },
    {
      "key": "copyright",
      "label": "Copyright",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "© {{year}} {{app_name}}. All rights reserved."
      },
      "schema": [
        {
          "key": "text",
          "label": "Copyright text",
          "type": "text",
          "selector": ".tb-f-logo-menu__copyright"
        }
      ],
      "template": "<div class=\"tb-f-logo-menu__copyright\">{{text}}</div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-f-logo-menu__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-f-logo-menu__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-f-logo-menu__parent\"><a class=\"tb-f-logo-menu__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-f-logo-menu__chevron\">⌄</span></a><div class=\"tb-f-logo-menu__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-f-logo-menu__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<footer class=\"tb-block tb-f-logo-menu\"><div class=\"tb-f-logo-menu__inner\" style=\"--tb-f-logo-menu-width:{{width}}px\"><div class=\"tb-f-logo-menu__row\">{{elements:brand}}{{menu:primary}}</div><div class=\"tb-f-logo-menu__legal\">{{elements:copyright}}</div></div></footer>",
  "css": ".tb-f-logo-menu{background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-f-logo-menu__inner{max-width:var(--tb-f-logo-menu-width);margin:auto;padding:52px 24px 24px}.tb-f-logo-menu__brand{display:grid;gap:10px;align-content:start}.tb-f-logo-menu__logo{width:42px;height:42px;object-fit:contain}.tb-f-logo-menu__brand-name{font-size:20px}.tb-f-logo-menu__brand-text{max-width:360px;margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-f-logo-menu__copyright{color:var(--tb-color-muted);font-size:12px}.tb-f-logo-menu__nav{display:grid;gap:10px}.tb-f-logo-menu__link{color:inherit;text-decoration:none;opacity:.78}.tb-f-logo-menu__link:hover{opacity:1;color:var(--tb-color-primary)}.tb-f-logo-menu__parent{display:grid;gap:8px}.tb-f-logo-menu__parent>.tb-f-logo-menu__link{font-weight:850;opacity:1}.tb-f-logo-menu__submenu{display:grid;gap:7px;padding-left:0}.tb-f-logo-menu__chevron{display:none}.tb-f-logo-menu__row{display:flex;align-items:flex-start;justify-content:space-between;gap:36px}.tb-f-logo-menu__brand-text{max-width:280px}.tb-f-logo-menu__nav{display:flex;flex-wrap:wrap;gap:18px}.tb-f-logo-menu__legal{margin-top:30px;padding-top:16px;border-top:1px solid var(--tb-color-border)}@media(max-width:820px){.tb-f-logo-menu__grid,.tb-f-logo-menu__top,.tb-f-logo-menu__row,.tb-f-logo-menu__bottom{grid-template-columns:1fr;flex-wrap:wrap}.tb-f-logo-menu__nav{grid-template-columns:repeat(2,minmax(0,1fr))}.tb-f-logo-menu__contacts{grid-template-columns:1fr}}@media(max-width:520px){.tb-f-logo-menu__inner{padding-left:16px;padding-right:16px}.tb-f-logo-menu__nav{grid-template-columns:1fr}.tb-f-logo-menu__search{width:100%!important}}",
  "js": "",
  "slug": "footer-logo-menu",
  "name": "Logo Menu Footer",
  "category": "Footers",
  "description": "A clean logo-led footer with horizontal navigation and copyright.",
  "keywords": [
    "footer",
    "navigation",
    "menu",
    "logomenu"
  ],
  "contexts": [
    "footer"
  ],
  "version": "1.0.0"
}
