{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand statement",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "text": "{{app_description}}",
        "logo": "{{app_logo}}"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-f-menu-cards__brand-name"
        },
        {
          "key": "text",
          "label": "Brand text",
          "type": "textarea",
          "selector": ".tb-f-menu-cards__brand-text"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-f-menu-cards__logo"
        }
      ],
      "template": "<div class=\"tb-f-menu-cards__brand\"><img class=\"tb-f-menu-cards__logo\" src=\"{{logo}}\" alt=\"\"><strong class=\"tb-f-menu-cards__brand-name\">{{name}}</strong><p class=\"tb-f-menu-cards__brand-text\">{{text}}</p></div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "text"
        }
      }
    },
    {
      "key": "copyright",
      "label": "Copyright",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "© {{year}} {{app_name}}. All rights reserved."
      },
      "schema": [
        {
          "key": "text",
          "label": "Copyright text",
          "type": "text",
          "selector": ".tb-f-menu-cards__copyright"
        }
      ],
      "template": "<div class=\"tb-f-menu-cards__copyright\">{{text}}</div>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "muted"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-f-menu-cards__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-f-menu-cards__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-f-menu-cards__parent\"><a class=\"tb-f-menu-cards__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-f-menu-cards__chevron\">⌄</span></a><div class=\"tb-f-menu-cards__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-f-menu-cards__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<footer class=\"tb-block tb-f-menu-cards\"><div class=\"tb-f-menu-cards__inner\" style=\"--tb-f-menu-cards-width:{{width}}px\"><div class=\"tb-f-menu-cards__head\">{{elements:brand}}</div><div class=\"tb-f-menu-cards__menu\">{{menu:primary}}</div><div class=\"tb-f-menu-cards__legal\">{{elements:copyright}}</div></div></footer>",
  "css": ".tb-f-menu-cards{background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-f-menu-cards__inner{max-width:var(--tb-f-menu-cards-width);margin:auto;padding:52px 24px 24px}.tb-f-menu-cards__brand{display:grid;gap:10px;align-content:start}.tb-f-menu-cards__logo{width:42px;height:42px;object-fit:contain}.tb-f-menu-cards__brand-name{font-size:20px}.tb-f-menu-cards__brand-text{max-width:360px;margin:0;color:var(--tb-color-muted);line-height:1.65}.tb-f-menu-cards__copyright{color:var(--tb-color-muted);font-size:12px}.tb-f-menu-cards__nav{display:grid;gap:10px}.tb-f-menu-cards__link{color:inherit;text-decoration:none;opacity:.78}.tb-f-menu-cards__link:hover{opacity:1;color:var(--tb-color-primary)}.tb-f-menu-cards__parent{display:grid;gap:8px}.tb-f-menu-cards__parent>.tb-f-menu-cards__link{font-weight:850;opacity:1}.tb-f-menu-cards__submenu{display:grid;gap:7px;padding-left:0}.tb-f-menu-cards__chevron{display:none}.tb-f-menu-cards__head{max-width:480px;margin-bottom:30px}.tb-f-menu-cards__nav{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.tb-f-menu-cards__parent{padding:20px;border:1px solid var(--tb-color-border);border-radius:14px;background:var(--tb-color-background)}.tb-f-menu-cards__link{display:block}.tb-f-menu-cards__legal{margin-top:28px}@media(max-width:820px){.tb-f-menu-cards__grid,.tb-f-menu-cards__top,.tb-f-menu-cards__row,.tb-f-menu-cards__bottom{grid-template-columns:1fr;flex-wrap:wrap}.tb-f-menu-cards__nav{grid-template-columns:repeat(2,minmax(0,1fr))}.tb-f-menu-cards__contacts{grid-template-columns:1fr}}@media(max-width:520px){.tb-f-menu-cards__inner{padding-left:16px;padding-right:16px}.tb-f-menu-cards__nav{grid-template-columns:1fr}.tb-f-menu-cards__search{width:100%!important}}",
  "js": "",
  "slug": "footer-menu-cards",
  "name": "Menu Cards Footer",
  "category": "Footers",
  "description": "A menu rendered as spacious linked groups inside a card-like footer.",
  "keywords": [
    "footer",
    "navigation",
    "menu",
    "menucards"
  ],
  "contexts": [
    "footer"
  ],
  "version": "1.0.0"
}
