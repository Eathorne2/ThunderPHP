{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "logo": "{{app_logo}}",
        "url": "{{root}}/"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-h-dark-contrast__brand-name"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-h-dark-contrast__logo"
        },
        {
          "key": "url",
          "label": "Home URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-dark-contrast__brand\" href=\"{{url}}\"><img class=\"tb-h-dark-contrast__logo\" src=\"{{logo}}\" alt=\"\"><span class=\"tb-h-dark-contrast__brand-name\">{{name}}</span></a>",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "secondary"
        }
      }
    },
    {
      "key": "cta",
      "label": "Call to action",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Get started",
        "url": "{{root}}/contact"
      },
      "schema": [
        {
          "key": "text",
          "label": "Button text",
          "type": "text",
          "selector": ".tb-h-dark-contrast__cta"
        },
        {
          "key": "url",
          "label": "Button URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-dark-contrast__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "background",
          "background_color": "primary"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-h-dark-contrast__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-h-dark-contrast__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-h-dark-contrast__parent\"><a class=\"tb-h-dark-contrast__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-h-dark-contrast__chevron\">⌄</span></a><div class=\"tb-h-dark-contrast__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-h-dark-contrast__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<header class=\"tb-block tb-h-dark-contrast\"><div class=\"tb-h-dark-contrast__inner\" style=\"--tb-h-dark-contrast-width:{{width}}px\"><div class=\"tb-h-dark-contrast__row\">{{elements:brand}}{{menu:primary}}{{elements:cta}}</div></div></header>",
  "css": ".tb-h-dark-contrast{position:relative;background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-h-dark-contrast__inner{max-width:var(--tb-h-dark-contrast-width);margin:auto;padding:0 24px}.tb-h-dark-contrast__brand{display:flex;align-items:center;gap:10px;color:var(--tb-color-secondary);text-decoration:none;font-weight:900}.tb-h-dark-contrast__logo{width:38px;height:38px;object-fit:contain}.tb-h-dark-contrast__brand-name{letter-spacing:-.025em}.tb-h-dark-contrast__nav{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.tb-h-dark-contrast__link{display:inline-flex;align-items:center;gap:5px;padding:9px 11px;color:inherit;text-decoration:none;font-weight:750}.tb-h-dark-contrast__link:hover{color:var(--tb-color-primary)}.tb-h-dark-contrast__parent{position:relative}.tb-h-dark-contrast__submenu{position:absolute;z-index:20;top:100%;left:0;min-width:190px;padding:8px;border:1px solid var(--tb-color-border);border-radius:12px;background:var(--tb-color-surface);display:none;box-shadow:0 16px 38px color-mix(in srgb,var(--tb-color-secondary) 14%,transparent)}.tb-h-dark-contrast__submenu .tb-h-dark-contrast__link{display:flex}.tb-h-dark-contrast__parent:hover>.tb-h-dark-contrast__submenu,.tb-h-dark-contrast__parent:focus-within>.tb-h-dark-contrast__submenu{display:grid}.tb-h-dark-contrast__chevron{font-size:10px;opacity:.65}.tb-h-dark-contrast{background:var(--tb-color-secondary);color:var(--tb-color-background)}.tb-h-dark-contrast__brand{color:inherit}.tb-h-dark-contrast__row{min-height:82px;display:flex;align-items:center;gap:24px}.tb-h-dark-contrast__nav{margin-left:auto}.tb-h-dark-contrast__cta{padding:11px 17px;border-radius:8px;text-decoration:none;font-weight:850}@media(max-width:820px){.tb-h-dark-contrast__row,.tb-h-dark-contrast__top,.tb-h-dark-contrast__glass,.tb-h-dark-contrast__frame,.tb-h-dark-contrast__pill{flex-wrap:wrap;height:auto;padding-top:14px;padding-bottom:14px}.tb-h-dark-contrast__nav{width:100%;order:5}.tb-h-dark-contrast__submenu{position:static;box-shadow:none}}@media(max-width:560px){.tb-h-dark-contrast__inner{padding-left:16px;padding-right:16px}.tb-h-dark-contrast__row{grid-template-columns:1fr!important}.tb-h-dark-contrast__search{width:100%!important}}",
  "js": "",
  "slug": "header-dark-contrast",
  "name": "Dark Contrast Header",
  "category": "Headers",
  "description": "A high-contrast dark header with bright navigation and call-to-action.",
  "keywords": [
    "header",
    "navigation",
    "menu",
    "dark"
  ],
  "contexts": [
    "header"
  ],
  "version": "1.0.0"
}
