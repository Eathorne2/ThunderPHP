{
  "slug": "sports-fitness-training-hero",
  "name": "Performance Training Hero",
  "category": "Sports",
  "description": "High-impact sports hero section",
  "keywords": [
    "performance",
    "training",
    "hero",
    "hero"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-sport-fitness-training-hero\"><div class=\"tb-sport-fitness-training-hero__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}<div class=\"tb-sport-fitness-training-hero__actions\">{{elements:cta}}</div></div><div class=\"tb-sport-fitness-training-hero__media\">{{elements:image}}<span class=\"tb-sport-fitness-training-hero__mark\">MOVE</span></div></section>",
  "css": ".tb-sport-fitness-training-hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:570px;background:var(--tb-color-surface);overflow:hidden}.tb-sport-fitness-training-hero__copy{padding:clamp(38px,7vw,90px);display:flex;flex-direction:column;justify-content:center}.tb-sport-fitness-training-hero__eyebrow{font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;color:var(--tb-color-primary)}.tb-sport-fitness-training-hero__title{font-size:clamp(44px,7vw,84px);line-height:.96;margin:14px 0 22px;color:var(--tb-color-secondary)}.tb-sport-fitness-training-hero__text{font-size:18px;line-height:1.7;color:var(--tb-color-muted);max-width:650px}.tb-sport-fitness-training-hero__cta{display:inline-block;margin-top:26px;padding:14px 22px;background:var(--tb-color-primary);color:var(--tb-color-surface);text-decoration:none;font-weight:900;border-radius:999px}.tb-sport-fitness-training-hero__media{position:relative;min-height:570px}.tb-sport-fitness-training-hero__image{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.tb-sport-fitness-training-hero__mark{position:absolute;right:24px;bottom:22px;font-size:clamp(54px,8vw,120px);font-weight:950;line-height:.8;color:var(--tb-color-surface);opacity:.76;letter-spacing:-.08em}@media(max-width:800px){.tb-sport-fitness-training-hero{grid-template-columns:1fr}.tb-sport-fitness-training-hero__media{min-height:400px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
