{
  "slug": "edu-teacher-profiles",
  "name": "Teacher Profiles",
  "category": "Education",
  "description": "Instructor profile cards with portraits and teaching areas",
  "keywords": [
    "education",
    "teachers",
    "faculty",
    "team"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-edu-teachers\"><div class=\"tb-edu-teachers__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-edu-teachers__grid\">{{elements:teachers}}</div></div>",
  "css": ".tb-edu-teachers{padding:clamp(34px,6vw,78px);background:var(--tb-color-background)}.tb-edu-teachers__head{max-width:720px;margin-bottom:28px}.tb-edu-teachers__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.tb-edu-teachers__title{margin:8px 0;color:var(--tb-color-secondary);font-size:clamp(40px,5vw,60px)}.tb-edu-teachers__text{color:var(--tb-color-muted);line-height:1.7}.tb-edu-teachers__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.tb-edu-teachers__card{background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-edu-teachers__photo{width:100%;aspect-ratio:4/5;object-fit:cover;display:block}.tb-edu-teachers__meta{padding:18px}.tb-edu-teachers__name{margin:0;color:var(--tb-color-secondary);font-size:23px}.tb-edu-teachers__role{display:block;margin-top:5px;color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase}@media(max-width:760px){.tb-edu-teachers__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Meet the faculty"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-edu-teachers__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
