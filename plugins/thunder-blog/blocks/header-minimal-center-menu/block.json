{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "logo": "{{app_logo}}",
        "url": "{{root}}/"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-h-minimal-center-menu__brand-name"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-h-minimal-center-menu__logo"
        },
        {
          "key": "url",
          "label": "Home URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-minimal-center-menu__brand\" href=\"{{url}}\"><img class=\"tb-h-minimal-center-menu__logo\" src=\"{{logo}}\" alt=\"\"><span class=\"tb-h-minimal-center-menu__brand-name\">{{name}}</span></a>",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "secondary"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-h-minimal-center-menu__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-h-minimal-center-menu__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-h-minimal-center-menu__parent\"><a class=\"tb-h-minimal-center-menu__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-h-minimal-center-menu__chevron\">⌄</span></a><div class=\"tb-h-minimal-center-menu__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-h-minimal-center-menu__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<header class=\"tb-block tb-h-minimal-center-menu\"><div class=\"tb-h-minimal-center-menu__inner\" style=\"--tb-h-minimal-center-menu-width:{{width}}px\"><div class=\"tb-h-minimal-center-menu__brand-row\">{{elements:brand}}</div><div class=\"tb-h-minimal-center-menu__menu-row\">{{menu:primary}}</div></div></header>",
  "css": ".tb-h-minimal-center-menu{position:relative;background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-h-minimal-center-menu__inner{max-width:var(--tb-h-minimal-center-menu-width);margin:auto;padding:0 24px}.tb-h-minimal-center-menu__brand{display:flex;align-items:center;gap:10px;color:var(--tb-color-secondary);text-decoration:none;font-weight:900}.tb-h-minimal-center-menu__logo{width:38px;height:38px;object-fit:contain}.tb-h-minimal-center-menu__brand-name{letter-spacing:-.025em}.tb-h-minimal-center-menu__nav{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.tb-h-minimal-center-menu__link{display:inline-flex;align-items:center;gap:5px;padding:9px 11px;color:inherit;text-decoration:none;font-weight:750}.tb-h-minimal-center-menu__link:hover{color:var(--tb-color-primary)}.tb-h-minimal-center-menu__parent{position:relative}.tb-h-minimal-center-menu__submenu{position:absolute;z-index:20;top:100%;left:0;min-width:190px;padding:8px;border:1px solid var(--tb-color-border);border-radius:12px;background:var(--tb-color-surface);display:none;box-shadow:0 16px 38px color-mix(in srgb,var(--tb-color-secondary) 14%,transparent)}.tb-h-minimal-center-menu__submenu .tb-h-minimal-center-menu__link{display:flex}.tb-h-minimal-center-menu__parent:hover>.tb-h-minimal-center-menu__submenu,.tb-h-minimal-center-menu__parent:focus-within>.tb-h-minimal-center-menu__submenu{display:grid}.tb-h-minimal-center-menu__chevron{font-size:10px;opacity:.65}.tb-h-minimal-center-menu__brand-row{padding:18px 0 7px;display:flex;justify-content:center}.tb-h-minimal-center-menu__logo{width:28px;height:28px}.tb-h-minimal-center-menu__brand-name{font-size:14px;letter-spacing:.04em;text-transform:uppercase}.tb-h-minimal-center-menu__menu-row{padding:6px 0 14px;display:flex;justify-content:center}.tb-h-minimal-center-menu__link{font-size:12px;font-weight:700}@media(max-width:820px){.tb-h-minimal-center-menu__row,.tb-h-minimal-center-menu__top,.tb-h-minimal-center-menu__glass,.tb-h-minimal-center-menu__frame,.tb-h-minimal-center-menu__pill{flex-wrap:wrap;height:auto;padding-top:14px;padding-bottom:14px}.tb-h-minimal-center-menu__nav{width:100%;order:5}.tb-h-minimal-center-menu__submenu{position:static;box-shadow:none}}@media(max-width:560px){.tb-h-minimal-center-menu__inner{padding-left:16px;padding-right:16px}.tb-h-minimal-center-menu__row{grid-template-columns:1fr!important}.tb-h-minimal-center-menu__search{width:100%!important}}",
  "js": "",
  "slug": "header-minimal-center-menu",
  "name": "Minimal Center Menu Header",
  "category": "Headers",
  "description": "A quiet centered navigation header with compact branding above.",
  "keywords": [
    "header",
    "navigation",
    "menu",
    "mincenter"
  ],
  "contexts": [
    "header"
  ],
  "version": "1.0.0"
}
