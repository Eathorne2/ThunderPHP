{
  "slug": "food-seafood-feature",
  "name": "Seafood Feature",
  "category": "Food & Restaurant",
  "description": "Coastal seafood story with large photo, catch note and booking action",
  "keywords": [
    "food",
    "restaurant",
    "seafood",
    "fish",
    "coastal"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-seafood\"><div class=\"tb-food-seafood__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:catch}}{{elements:cta}}</div><div class=\"tb-food-seafood__visual\">{{elements:image}}</div></div>",
  "css": ".tb-food-seafood{display:grid;grid-template-columns:.85fr 1.15fr;background:var(--tb-color-background);align-items:stretch}.tb-food-seafood__copy{padding:clamp(40px,7vw,96px);display:flex;flex-direction:column;justify-content:center}.tb-food-seafood__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:950;text-transform:uppercase;letter-spacing:.16em}.tb-food-seafood__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(46px,6vw,76px)}.tb-food-seafood__text{color:var(--tb-color-muted);line-height:1.8}.tb-food-seafood__catch{display:block;margin:20px 0;color:var(--tb-color-secondary);font-weight:900}.tb-food-seafood__cta{align-self:flex-start;padding:12px 18px;background:var(--tb-color-primary);color:var(--tb-color-surface);text-decoration:none;font-weight:900}.tb-food-seafood__image{width:100%;height:100%;min-height:650px;object-fit:cover;display:block}@media(max-width:720px){.tb-food-seafood{grid-template-columns:1fr}.tb-food-seafood__image{min-height:380px}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
