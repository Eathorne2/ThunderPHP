{
  "settings": {
    "defaults": {
      "menu_id": "0",
      "width": "1200"
    },
    "schema": [
      {
        "key": "menu_id",
        "label": "Saved menu",
        "type": "menu",
        "default": "0"
      },
      {
        "key": "width",
        "label": "Content width",
        "type": "select",
        "options": {
          "1040": "Compact",
          "1200": "Standard",
          "1360": "Wide",
          "1480": "Extra wide"
        },
        "default": "1200"
      }
    ]
  },
  "elements": [
    {
      "key": "brand",
      "label": "Brand",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "name": "{{app_name}}",
        "logo": "{{app_logo}}",
        "url": "{{root}}/"
      },
      "schema": [
        {
          "key": "name",
          "label": "Brand name",
          "type": "text",
          "selector": ".tb-h-wide-navigation__brand-name"
        },
        {
          "key": "logo",
          "label": "Logo",
          "type": "image",
          "selector": ".tb-h-wide-navigation__logo"
        },
        {
          "key": "url",
          "label": "Home URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-wide-navigation__brand\" href=\"{{url}}\"><img class=\"tb-h-wide-navigation__logo\" src=\"{{logo}}\" alt=\"\"><span class=\"tb-h-wide-navigation__brand-name\">{{name}}</span></a>",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": false,
        "defaults": {
          "color": "secondary"
        }
      }
    },
    {
      "key": "cta",
      "label": "Call to action",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": true,
        "move": false,
        "clone": false
      },
      "defaults": {
        "text": "Get started",
        "url": "{{root}}/contact"
      },
      "schema": [
        {
          "key": "text",
          "label": "Button text",
          "type": "text",
          "selector": ".tb-h-wide-navigation__cta"
        },
        {
          "key": "url",
          "label": "Button URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-h-wide-navigation__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 1,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "background",
          "background_color": "primary"
        }
      }
    }
  ],
  "menu_sources": [
    {
      "setting": "menu_id",
      "token": "primary",
      "empty": "",
      "container": "<nav class=\"tb-h-wide-navigation__nav\" aria-label=\"{{menu_name}}\">{{items}}</nav>",
      "item": "<a class=\"tb-h-wide-navigation__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}</a>",
      "parent": "<div class=\"tb-h-wide-navigation__parent\"><a class=\"tb-h-wide-navigation__link\" href=\"{{url}}\" target=\"{{target}}\" rel=\"noopener\">{{title}}<span class=\"tb-h-wide-navigation__chevron\">⌄</span></a><div class=\"tb-h-wide-navigation__submenu\">{{children}}</div></div>",
      "empty_preview": "<nav class=\"tb-h-wide-navigation__nav tb-menu-empty\">Select a menu</nav>"
    }
  ],
  "html": "<header class=\"tb-block tb-h-wide-navigation\"><div class=\"tb-h-wide-navigation__inner\" style=\"--tb-h-wide-navigation-width:{{width}}px\"><div class=\"tb-h-wide-navigation__row\">{{elements:brand}}<div class=\"tb-h-wide-navigation__menu-wrap\">{{menu:primary}}</div>{{elements:cta}}</div></div></header>",
  "css": ".tb-h-wide-navigation{position:relative;background:var(--tb-color-surface);color:var(--tb-color-text)}.tb-h-wide-navigation__inner{max-width:var(--tb-h-wide-navigation-width);margin:auto;padding:0 24px}.tb-h-wide-navigation__brand{display:flex;align-items:center;gap:10px;color:var(--tb-color-secondary);text-decoration:none;font-weight:900}.tb-h-wide-navigation__logo{width:38px;height:38px;object-fit:contain}.tb-h-wide-navigation__brand-name{letter-spacing:-.025em}.tb-h-wide-navigation__nav{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.tb-h-wide-navigation__link{display:inline-flex;align-items:center;gap:5px;padding:9px 11px;color:inherit;text-decoration:none;font-weight:750}.tb-h-wide-navigation__link:hover{color:var(--tb-color-primary)}.tb-h-wide-navigation__parent{position:relative}.tb-h-wide-navigation__submenu{position:absolute;z-index:20;top:100%;left:0;min-width:190px;padding:8px;border:1px solid var(--tb-color-border);border-radius:12px;background:var(--tb-color-surface);display:none;box-shadow:0 16px 38px color-mix(in srgb,var(--tb-color-secondary) 14%,transparent)}.tb-h-wide-navigation__submenu .tb-h-wide-navigation__link{display:flex}.tb-h-wide-navigation__parent:hover>.tb-h-wide-navigation__submenu,.tb-h-wide-navigation__parent:focus-within>.tb-h-wide-navigation__submenu{display:grid}.tb-h-wide-navigation__chevron{font-size:10px;opacity:.65}.tb-h-wide-navigation__row{min-height:92px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:42px}.tb-h-wide-navigation__menu-wrap{display:flex;justify-content:center}.tb-h-wide-navigation__nav{gap:15px}.tb-h-wide-navigation__link{padding:10px 7px}.tb-h-wide-navigation__cta{padding:12px 18px;border:2px solid var(--tb-color-primary);border-radius:4px;text-decoration:none;font-weight:900}@media(max-width:820px){.tb-h-wide-navigation__row,.tb-h-wide-navigation__top,.tb-h-wide-navigation__glass,.tb-h-wide-navigation__frame,.tb-h-wide-navigation__pill{flex-wrap:wrap;height:auto;padding-top:14px;padding-bottom:14px}.tb-h-wide-navigation__nav{width:100%;order:5}.tb-h-wide-navigation__submenu{position:static;box-shadow:none}}@media(max-width:560px){.tb-h-wide-navigation__inner{padding-left:16px;padding-right:16px}.tb-h-wide-navigation__row{grid-template-columns:1fr!important}.tb-h-wide-navigation__search{width:100%!important}}",
  "js": "",
  "slug": "header-wide-navigation",
  "name": "Wide Navigation Header",
  "category": "Headers",
  "description": "A broad navigation-first header with generous spacing for larger menus.",
  "keywords": [
    "header",
    "navigation",
    "menu",
    "wide"
  ],
  "contexts": [
    "header"
  ],
  "version": "1.0.0"
}
