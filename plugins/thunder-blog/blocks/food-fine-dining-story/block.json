{
  "slug": "food-fine-dining-story",
  "name": "Fine Dining Story",
  "category": "Food & Restaurant",
  "description": "Elegant restaurant story section with overlapping image and editorial copy",
  "keywords": [
    "food",
    "restaurant",
    "fine dining",
    "story",
    "about"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-story\"><div class=\"tb-food-story__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:quote}}</div><div class=\"tb-food-story__visual\">{{elements:image}}</div></div>",
  "css": ".tb-food-story{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,7vw,100px);align-items:center;padding:clamp(36px,7vw,94px);background:var(--tb-color-background)}.tb-food-story__copy{padding-left:clamp(0px,4vw,54px)}.tb-food-story__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-food-story__title{margin:12px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(46px,6vw,74px);font-weight:500}.tb-food-story__text{color:var(--tb-color-muted);font-size:17px;line-height:1.8}.tb-food-story__quote{display:block;margin-top:24px;padding-left:18px;border-left:3px solid var(--tb-color-primary);color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:21px;font-style:italic}.tb-food-story__visual{position:relative;padding:24px 0 24px 24px}.tb-food-story__visual:before{content:\"\";position:absolute;inset:0 18% 0 0;background:color-mix(in srgb,var(--tb-color-primary) 14%,var(--tb-color-surface))}.tb-food-story__image{position:relative;width:100%;aspect-ratio:4/5;object-fit:cover;display:block}@media(max-width:760px){.tb-food-story{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Our table"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-story__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "A dining room with a point of view"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-food-story__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
