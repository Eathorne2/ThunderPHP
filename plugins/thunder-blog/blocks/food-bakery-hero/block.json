{
  "slug": "food-bakery-hero",
  "name": "Fresh Bakery Hero",
  "category": "Food & Restaurant",
  "description": "Warm bakery hero with oversized typography and bread photography",
  "keywords": [
    "food",
    "restaurant",
    "bakery",
    "bread",
    "pastry"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-bakery-hero\"><div class=\"tb-food-bakery-hero__top\">{{elements:eyebrow}}{{elements:title}}{{elements:cta}}</div><div class=\"tb-food-bakery-hero__image-wrap\">{{elements:image}}<div class=\"tb-food-bakery-hero__note\">{{elements:note}}</div></div></div>",
  "css": ".tb-food-bakery-hero{padding:clamp(28px,5vw,62px);background:var(--tb-color-surface)}.tb-food-bakery-hero__top{display:grid;grid-template-columns:1fr auto;align-items:end;gap:18px;margin-bottom:24px}.tb-food-bakery-hero__eyebrow{grid-column:1/-1;color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.18em}.tb-food-bakery-hero__title{margin:0;max-width:850px;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(52px,8vw,102px);line-height:.9}.tb-food-bakery-hero__cta{padding:12px 18px;border:1px solid var(--tb-color-secondary);color:var(--tb-color-secondary);text-decoration:none;font-weight:850}.tb-food-bakery-hero__image-wrap{position:relative}.tb-food-bakery-hero__image{width:100%;height:min(58vw,600px);object-fit:cover;display:block}.tb-food-bakery-hero__note{position:absolute;right:24px;bottom:24px;max-width:330px;padding:18px;background:var(--tb-color-background);box-shadow:0 14px 40px rgba(0,0,0,.12)}.tb-food-bakery-hero__note-text{margin:0;color:var(--tb-color-muted);line-height:1.65}@media(max-width:650px){.tb-food-bakery-hero__top{grid-template-columns:1fr}.tb-food-bakery-hero__note{position:static;max-width:none}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Baked before sunrise"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-food-bakery-hero__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Fresh bread. Every morning."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-food-bakery-hero__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cta",
      "label": "Menu button",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "See today’s bake",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-food-bakery-hero__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "image",
      "label": "Bakery image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=1400&q=82",
        "alt": "Fresh artisan bread"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-food-bakery-hero__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-food-bakery-hero__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "note",
      "label": "Image note",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Naturally leavened loaves, flaky pastries and small-batch cakes made from scratch."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-food-bakery-hero__note-text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
