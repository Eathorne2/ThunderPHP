      "defaults": {
        "text": "Schedule a consultation",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-med-doctor-consultation-split__cta\" href=\"{{url}}\">{{text}}</a>",
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      },
      "min": 1,
      "max": 1
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
