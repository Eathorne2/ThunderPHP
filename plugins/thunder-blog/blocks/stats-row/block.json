{
  "slug": "stats-row",
  "name": "Statistics Row",
  "category": "Data",
  "description": "A row of three numerical highlights.",
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-block--stats-row\">{{elements:items}}</div>",
  "css": ".tb-block--stats-row{padding:26px;border:1px solid var(--tb-color-border);border-radius:18px;background:var(--tb-color-surface);display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px}.tb-stats-row__item{padding:12px 20px;border-right:1px solid var(--tb-color-border);display:grid;gap:5px;text-align:center}.tb-stats-row__item:last-child{border-right:0}.tb-stats-row__value{color:var(--tb-color-primary);font-size:clamp(30px,5vw,52px);line-height:1}.tb-stats-row__label{color:var(--tb-color-muted);font-size:13px;font-weight:700}@media(max-width:620px){.tb-block--stats-row{grid-template-columns:1fr}.tb-stats-row__item{border-right:0;border-bottom:1px solid var(--tb-color-border)}.tb-stats-row__item:last-child{border-bottom:0}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "items",
      "label": "Statistic",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "value": "48%",
        "label": "Growth this year"
      },
      "schema": [
        {
          "key": "value",
          "label": "Value",
          "type": "text",
          "selector": ".tb-stats-row__value"
        },
        {
          "key": "label",
          "label": "Label",
          "type": "text",
          "selector": ".tb-stats-row__label"
        }
      ],
      "template": "<div class=\"tb-stats-row__item\"><strong class=\"tb-stats-row__value\">{{value}}</strong><span class=\"tb-stats-row__label\">{{label}}</span></div>",
      "min": 1,
      "max": 12,
      "default_items": [
        {
          "value": "48%",
          "label": "Growth this year"
        },
        {
          "value": "12K",
          "label": "Readers reached"
        },
        {
          "value": "96",
          "label": "Stories published"
        }
      ],
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
