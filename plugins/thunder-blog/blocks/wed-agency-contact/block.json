{
  "slug": "wed-agency-contact",
  "name": "Wedding Agency Contact CTA",
  "category": "Wedding",
  "description": "Image-backed closing CTA for wedding planners, venues and creative suppliers",
  "keywords": [
    "wedding",
    "agency",
    "contact",
    "cta"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-agency-cta\"><div class=\"tb-wed-agency-cta__media\">{{elements:image}}</div><div class=\"tb-wed-agency-cta__copy\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:cta}}{{elements:contact}}</div></div>",
  "css": ".tb-wed-agency-cta{display:grid;grid-template-columns:1.15fr .85fr;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-wed-agency-cta__media,.tb-wed-agency-cta__image{min-height:560px}.tb-wed-agency-cta__image{width:100%;height:100%;object-fit:cover}.tb-wed-agency-cta__copy{padding:clamp(36px,7vw,90px);display:flex;flex-direction:column;justify-content:center}.tb-wed-agency-cta__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-wed-agency-cta__title{margin:10px 0;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(42px,6vw,68px);font-weight:400;line-height:1}.tb-wed-agency-cta__text{color:var(--tb-color-muted);line-height:1.75}.tb-wed-agency-cta__cta{align-self:flex-start;margin-top:18px;padding:13px 22px;background:var(--tb-color-primary);color:var(--tb-color-background);text-decoration:none;font-weight:900}.tb-wed-agency-cta__contact{margin-top:20px;color:var(--tb-color-muted);font-size:13px}@media(max-width:760px){.tb-wed-agency-cta{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "image",
      "label": "Image",
      "repeatable": false,
      "controls": {
        "duplicate": false,
        "delete": false,
        "move": false,
        "clone": false
      },
      "defaults": {
        "url": "https://images.unsplash.com/photo-1507504031003-b417219a0fde?auto=format&fit=crop&w=1400&q=82",
        "alt": "Wedding celebration"
      },
      "schema": [
        {
          "key": "url",
          "label": "Image",
          "type": "image",
          "selector": ".tb-wed-agency-cta__image"
        },
        {
          "key": "alt",
          "label": "Alt text",
          "type": "text"
        }
      ],
      "template": "<img class=\"tb-wed-agency-cta__image\" src=\"{{url}}\" alt=\"{{alt}}\">",
      "min": 1,
      "max": 1,
      "appearance": {
        "color": false,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Let’s create something beautiful"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-agency-cta__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Tell us about your wedding"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-agency-cta__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Text",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Share the date, the place and what you want the celebration to feel like. We will take it from there."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-wed-agency-cta__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cta",
      "label": "Contact button",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Start a conversation",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-wed-agency-cta__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "contact",
      "label": "Contact note",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "hello@example.com · +260 000 000 000"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<p class=\"tb-wed-agency-cta__contact\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
