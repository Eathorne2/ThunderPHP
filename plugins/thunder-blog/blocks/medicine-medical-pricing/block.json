{
  "slug": "medicine-medical-pricing",
  "name": "Medical Pricing Cards",
  "category": "Medicine & Science",
  "description": "Transparent healthcare service pricing cards",
  "keywords": [
    "pricing",
    "clinic",
    "healthcare"
  ],
  "version": "1.0.0",
  "html": "<section class=\"tb-block tb-med-medical-pricing\"><header>{{elements:eyebrow}}{{elements:title}}{{elements:text}}</header><div class=\"tb-med-medical-pricing__grid\">{{elements:plans}}</div></section>",
  "css": ".tb-med-medical-pricing{padding:clamp(42px,7vw,88px);background:var(--tb-color-background)}.tb-med-medical-pricing header{text-align:center;max-width:760px;margin:0 auto 34px}.tb-med-medical-pricing__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.14em}.tb-med-medical-pricing__title{font-size:clamp(36px,5vw,60px);margin:10px 0 14px;color:var(--tb-color-secondary)}.tb-med-medical-pricing__text{color:var(--tb-color-muted);line-height:1.7}.tb-med-medical-pricing__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1050px;margin:auto}.tb-med-medical-pricing__plan{padding:30px;background:var(--tb-color-surface);border:1px solid var(--tb-color-border);border-radius:18px}.tb-med-medical-pricing__plan__title{font-size:22px;color:var(--tb-color-secondary);margin:0 0 10px}.tb-med-medical-pricing__plan__text{color:var(--tb-color-muted);line-height:1.65;min-height:52px}.tb-med-medical-pricing__plan__price{display:block;margin-top:24px;font-size:34px;color:var(--tb-color-primary)}@media(max-width:700px){.tb-med-medical-pricing__grid{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
