          "price": "K85"
        },
        {
          "group": "Mains",
          "name": "Herb chicken",
          "detail": "Roast potatoes · garden jus",
          "price": "K195"
        },
        {
          "group": "Dessert",
          "name": "Lemon cheesecake",
          "detail": "Berry compote",
          "price": "K95"
        },
        {
          "group": "Drinks",
          "name": "House lemonade",
          "detail": "Fresh citrus · mint",
          "price": "K45"
        }
      ]
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
