{
  "slug": "wed-rsvp-callout",
  "name": "RSVP Invitation Callout",
  "category": "Wedding",
  "description": "Centered invitation panel with RSVP deadline and action",
  "keywords": [
    "wedding",
    "rsvp",
    "invitation",
    "cta"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-wed-rsvp\"><div class=\"tb-wed-rsvp__ornament\">✦</div>{{elements:eyebrow}}{{elements:title}}{{elements:text}}{{elements:deadline}}{{elements:cta}}</div>",
  "css": ".tb-wed-rsvp{padding:clamp(44px,8vw,96px) 24px;text-align:center;background:var(--tb-color-surface);border:1px solid var(--tb-color-border)}.tb-wed-rsvp__ornament{margin-bottom:18px;color:var(--tb-color-primary);font-size:28px}.tb-wed-rsvp__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.tb-wed-rsvp__title{max-width:760px;margin:12px auto;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(42px,6vw,70px);font-weight:400}.tb-wed-rsvp__text{max-width:620px;margin:0 auto;color:var(--tb-color-muted);font-size:17px;line-height:1.75}.tb-wed-rsvp__deadline{margin:24px 0 0;color:var(--tb-color-text);font-weight:800}.tb-wed-rsvp__cta{display:inline-flex;margin-top:24px;padding:13px 24px;background:var(--tb-color-primary);color:var(--tb-color-background);text-decoration:none;font-weight:900}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "You are invited"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-wed-rsvp__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "title",
      "label": "Title",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Celebrate with us"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<h2 class=\"tb-wed-rsvp__title\">{{text}}</h2>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "text",
      "label": "Message",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "We would love to have you with us. Let us know if you can join the celebration."
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "textarea",
          "selector": ":scope",
          "rows": 3
        }
      ],
      "template": "<p class=\"tb-wed-rsvp__text\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "deadline",
      "label": "RSVP deadline",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Kindly RSVP by 20 September 2026"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<p class=\"tb-wed-rsvp__deadline\">{{text}}</p>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    },
    {
      "key": "cta",
      "label": "RSVP button",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "RSVP now",
        "url": "#"
      },
      "schema": [
        {
          "key": "text",
          "label": "Label",
          "type": "text",
          "selector": ":scope"
        },
        {
          "key": "url",
          "label": "URL",
          "type": "url"
        }
      ],
      "template": "<a class=\"tb-wed-rsvp__cta\" href=\"{{url}}\">{{text}}</a>",
      "min": 0,
      "max": 20,
      "appearance": {
        "color": true,
        "background_color": true,
        "defaults": {
          "color": "",
          "background_color": ""
        }
      }
    }
  ],
  "contexts": [
    "post",
    "page"
  ]
}
