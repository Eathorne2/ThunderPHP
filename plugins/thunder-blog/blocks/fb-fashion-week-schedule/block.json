{
  "slug": "fb-fashion-week-schedule",
  "name": "Fashion Week Schedule",
  "category": "Fashion & Beauty",
  "description": "Elegant event schedule for runway shows, launches and fashion-week programming.",
  "keywords": [
    "fashion",
    "event",
    "schedule",
    "runway"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-fb-schedule\"><div class=\"tb-fb-schedule__head\">{{elements:eyebrow}}{{elements:title}}{{elements:text}}</div><div class=\"tb-fb-schedule__list\">{{elements:events}}</div></div>",
  "css": ".tb-fb-schedule{padding:clamp(30px,6vw,78px);background:var(--tb-color-secondary);color:var(--tb-color-surface)}.tb-fb-schedule__head{max-width:760px;margin-bottom:30px}.tb-fb-schedule__eyebrow{color:var(--tb-color-accent);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.tb-fb-schedule__title{margin:10px 0;color:var(--tb-color-surface);font-family:Georgia,serif;font-size:clamp(40px,6vw,70px);font-weight:500}.tb-fb-schedule__text{color:color-mix(in srgb,var(--tb-color-surface) 70%,transparent);line-height:1.7}.tb-fb-schedule__list{border-top:1px solid color-mix(in srgb,var(--tb-color-surface) 25%,transparent)}.tb-fb-schedule__event{display:grid;grid-template-columns:120px 1fr auto;gap:24px;align-items:center;padding:20px 0;border-bottom:1px solid color-mix(in srgb,var(--tb-color-surface) 25%,transparent)}.tb-fb-schedule__time{color:var(--tb-color-accent);font-family:Georgia,serif;font-size:24px}.tb-fb-schedule__event-title{margin:0;color:var(--tb-color-surface);font-size:19px}.tb-fb-schedule__meta{color:color-mix(in srgb,var(--tb-color-surface) 65%,transparent);font-size:13px}@media(max-width:600px){.tb-fb-schedule__event{grid-template-columns:80px 1fr}.tb-fb-schedule__meta{grid-column:2/3}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
  "elements": [
    {
      "key": "eyebrow",
      "label": "Eyebrow",
      "repeatable": true,
      "controls": {
        "duplicate": true,
        "delete": true,
        "move": true,
        "clone": true
      },
      "defaults": {
        "text": "Fashion week"
      },
      "schema": [
        {
          "key": "text",
          "label": "Text",
          "type": "text",
          "selector": ":scope"
        }
      ],
      "template": "<span class=\"tb-fb-schedule__eyebrow\">{{text}}</span>",
      "min": 0,
      "max": 20,
