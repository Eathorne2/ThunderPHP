{
  "slug": "food-hours-location",
  "name": "Opening Hours & Location",
  "category": "Food & Restaurant",
  "description": "Restaurant contact panel with opening hours, address and directions action",
  "keywords": [
    "food",
    "restaurant",
    "hours",
    "location",
    "contact"
  ],
  "version": "1.0.0",
  "html": "<div class=\"tb-block tb-food-hours\"><div class=\"tb-food-hours__info\">{{elements:eyebrow}}{{elements:title}}{{elements:address}}{{elements:phone}}{{elements:cta}}</div><div class=\"tb-food-hours__hours\">{{elements:items}}</div></div>",
  "css": ".tb-food-hours{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(30px,7vw,90px);padding:clamp(36px,6vw,80px);background:var(--tb-color-surface)}.tb-food-hours__eyebrow{color:var(--tb-color-primary);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.16em}.tb-food-hours__title{margin:10px 0 22px;color:var(--tb-color-secondary);font-family:Georgia,serif;font-size:clamp(42px,6vw,68px)}.tb-food-hours__address,.tb-food-hours__phone{display:block;margin:8px 0;color:var(--tb-color-muted);line-height:1.6}.tb-food-hours__cta{display:inline-flex;margin-top:20px;padding:11px 17px;border:1px solid var(--tb-color-secondary);color:var(--tb-color-secondary);text-decoration:none;font-weight:850}.tb-food-hours__item{display:flex;justify-content:space-between;gap:20px;padding:18px 0;border-bottom:1px solid var(--tb-color-border)}.tb-food-hours__day{color:var(--tb-color-secondary);font-weight:850}.tb-food-hours__time{color:var(--tb-color-muted)}@media(max-width:700px){.tb-food-hours{grid-template-columns:1fr}}",
  "js": "",
  "settings": {
    "defaults": {},
    "schema": []
  },
