{
  "type": "javascript.set_variable",
  "label": "Set JS Variable",
  "category": "JavaScript Flow",
  "kind": "flow",
  "icon": "SET",
  "color": "#7c3aed",
  "description": "Declares a JavaScript variable or assigns a value to an existing variable or property path.",
  "allowed_graphs": [
    "javascript"
  ],
  "defaults": {
    "title": "Set JS Variable",
    "variable_name": "value",
    "assignment_mode": "Declare let"
  },
  "properties": [
    {
      "name": "title",
      "label": "Node title",
      "type": "text"
    },
    {
      "name": "variable_name",
