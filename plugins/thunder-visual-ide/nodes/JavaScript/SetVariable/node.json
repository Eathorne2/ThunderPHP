      {
        "id": "exec_in",
        "label": "Run",
        "type": "js-exec",
        "direction": "in",
        "multiple": false
      },
      {
        "id": "value",
        "label": "Value",
        "type": "js-value",
        "direction": "in",
        "multiple": false
      }
    ],
    "outputs": [
      {
        "id": "exec",
        "label": "Next",
        "type": "js-exec",
        "direction": "out",
        "multiple": false
      },
      {
        "id": "value",
        "label": "Variable value",
        "type": "js-value",
        "direction": "out",
        "multiple": true
      }
    ]
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\JavaScript\\SetVariableCompiler",
    "file": "Compiler.php"
