    },
    {
      "name": "capture",
      "label": "Capture phase",
      "type": "checkbox"
    },
    {
      "name": "once",
      "label": "Run once",
      "type": "checkbox"
    },
    {
      "name": "passive",
      "label": "Passive listener",
      "type": "checkbox"
    }
  ],
  "ports": {
    "inputs": [],
    "outputs": [
      {
        "id": "event",
        "label": "On event",
        "type": "js-exec",
        "direction": "out"
