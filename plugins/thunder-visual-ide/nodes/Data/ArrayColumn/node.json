{
  "type": "data.array_column",
  "label": "Array Column",
  "category": "Data",
  "kind": "expression",
  "icon": "COL",
  "color": "#0e7490",
  "description": "Extracts one property or array key from every row, with dot notation for nested values.",
  "allowed_graphs": [
    "flow"
  ],
  "defaults": {
    "title": "Array Column",
    "column": "value",
    "preserve_missing": true
  },
  "properties": [
    {
      "name": "title",
      "label": "Node title",
      "type": "text"
    },
    {
      "name": "column",
      "label": "Column or property path",
      "type": "text",
      "help": "Examples: month, total, user.name"
    },
    {
      "name": "preserve_missing",
      "label": "Preserve missing values as null",
      "type": "checkbox"
    }
  ],
  "ports": {
    "inputs": [
      {
        "id": "rows",
        "label": "Rows",
        "type": "mixed",
        "direction": "in",
        "multiple": false
      }
    ],
    "outputs": [
      {
        "id": "values",
        "label": "Values",
        "type": "array",
        "direction": "out",
        "multiple": true
      }
    ]
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\Data\\ArrayColumnCompiler",
    "file": "Compiler.php"
  }
}
