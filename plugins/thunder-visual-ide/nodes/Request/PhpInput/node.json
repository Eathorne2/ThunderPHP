{
  "type": "request.php_input",
  "label": "PHP Input",
  "category": "Request",
  "kind": "flow",
  "icon": "RAW",
  "color": "#0369a1",
  "description": "Reads the raw request body from php://input once and exposes both the original text and a decoded JSON value.",
  "allowed_graphs": [
    "flow"
  ],
  "defaults": {
    "title": "PHP Input",
    "json_associative": true,
    "maximum_bytes": 0
  },
  "properties": [
    {
      "name": "title",
      "label": "Node title",
      "type": "text"
    },
    {
      "name": "json_associative",
      "label": "Decode JSON as associative array",
      "type": "checkbox",
      "help": "When enabled, the JSON output contains arrays. When disabled, JSON objects are decoded as stdClass objects."
    },
    {
      "name": "maximum_bytes",
      "label": "Maximum bytes",
      "type": "number",
      "min": 0,
      "help": "Use 0 to read the complete request body. A positive value limits how many bytes are read."
    }
  ],
  "ports": {
    "inputs": [
      {
        "id": "exec_in",
        "label": "Run",
        "type": "exec",
        "direction": "in",
        "multiple": false
      }
    ],
    "outputs": [
      {
        "id": "exec",
        "label": "Next",
        "type": "exec",
        "direction": "out",
        "multiple": false
      },
      {
        "id": "raw",
        "label": "Raw Body",
        "type": "string",
        "direction": "out",
        "multiple": true
      },
      {
        "id": "json",
        "label": "JSON",
        "type": "mixed",
        "direction": "out",
        "multiple": true
      },
      {
        "id": "json_valid",
        "label": "JSON Valid",
        "type": "boolean",
        "direction": "out",
        "multiple": true
      }
    ]
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\Request\\PhpInputCompiler",
    "file": "Compiler.php"
  }
}
