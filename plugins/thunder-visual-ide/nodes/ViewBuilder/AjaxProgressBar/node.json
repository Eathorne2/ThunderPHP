{
  "type": "view.ajax_progress",
  "label": "AJAX Progress Bar",
  "category": "View Builder",
  "kind": "view",
  "icon": "%",
  "color": "#0891b2",
  "description": "Displays upload or download progress and can be targeted from a JavaScript Flow.",
  "allowed_graphs": [
    "view"
  ],
  "defaults": {
    "title": "AJAX Progress",
    "theme_color": "primary",
    "track_color": "border",
    "show_percentage": true,
    "initially_hidden": true,
    "height": "10px",
    "css_class": "",
    "inline_style": "",
    "widths": {
      "mobile": 12,
      "small": 12,
      "medium": 12,
      "large": 12
    }
  },
  "properties": [
    {
      "name": "title",
      "label": "Node title",
      "type": "text"
    },
    {
      "name": "theme_color",
      "label": "Fill theme color",
      "type": "select",
      "options": [
        "primary",
        "accent",
        "success",
        "warning",
        "danger",
        "text"
      ]
    },
    {
      "name": "track_color",
      "label": "Track theme color",
      "type": "select",
      "options": [
        "border",
        "surface-alt",
        "surface",
        "muted"
      ]
    },
    {
      "name": "show_percentage",
      "label": "Show percentage",
      "type": "checkbox"
    },
    {
      "name": "initially_hidden",
      "label": "Initially hidden",
      "type": "checkbox"
    },
    {
      "name": "height",
      "label": "Bar height",
      "type": "text"
    },
    {
      "name": "css_class",
      "label": "CSS classes",
      "type": "text"
    },
    {
      "name": "inline_style",
      "label": "Inline styles",
      "type": "textarea"
    },
    {
      "name": "widths",
      "label": "Responsive width",
      "type": "breakpoints"
    }
  ],
  "ports": {
    "inputs": [
      {
        "id": "parent",
        "label": "Parent",
        "type": "view-child",
        "direction": "in"
      }
    ],
    "outputs": []
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\ViewBuilder\\AjaxProgressBarCompiler",
    "file": "Compiler.php"
  }
}
