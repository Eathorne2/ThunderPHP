{
  "type": "view.component",
  "label": "Component",
  "category": "View Builder",
  "kind": "view",
  "icon": "CMP",
  "color": "#0891b2",
  "description": "Creates a reusable view partial that can be inserted with a component marker.",
  "allowed_graphs": [
    "view"
  ],
  "defaults": {
    "title": "Component",
    "component_name": "component",
    "wrapper_tag": "div",
    "css_class": "",
    "widths": {
      "mobile": 12,
      "small": 12,
      "medium": 12,
      "large": 12
    },
    "inline_style": ""
  },
  "properties": [
    {
      "name": "title",
      "label": "Node title",
      "type": "text"
    },
    {
      "name": "component_name",
      "label": "Component name",
      "type": "text",
      "help": "Use <tvi-component name=\"this-name\" /> in the View source."
    },
    {
      "name": "wrapper_tag",
      "label": "Wrapper tag",
      "type": "select",
      "options": [
        "div",
        "section",
        "article",
        "aside",
        "none"
      ]
    },
    {
      "name": "css_class",
      "label": "CSS classes",
      "type": "text"
    },
    {
      "name": "inline_style",
      "label": "Inline styles",
      "type": "textarea",
      "help": "CSS declarations applied directly to the same element as the custom CSS classes."
    },
    {
      "name": "widths",
      "label": "Responsive width",
      "type": "breakpoints",
      "help": "Choose how many of 12 columns this item occupies at each breakpoint."
    }
  ],
  "ports": {
    "inputs": [
      {
        "id": "parent",
        "label": "Parent",
        "type": "view-child",
        "direction": "in"
      }
    ],
    "outputs": [
      {
        "id": "children",
        "label": "Children",
        "type": "view-child",
        "direction": "out",
        "multiple": true
      }
    ]
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\ViewBuilder\\ComponentCompiler",
    "file": "Compiler.php"
  }
}
