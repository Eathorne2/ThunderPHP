{
  "type": "view.if",
  "label": "If / Else",
  "category": "View Builder",
  "kind": "view",
  "icon": "IF",
  "color": "#0891b2",
  "description": "Conditionally renders one of two child branches.",
  "allowed_graphs": [
    "view"
  ],
  "defaults": {
    "title": "If",
    "path": "user",
    "condition": "truthy",
    "widths": {
      "mobile": 12,
      "small": 12,
      "medium": 12,
      "large": 12
    }
  },
  "properties": [
    {
      "name": "title",
      "label": "Node title",
      "type": "text"
    },
    {
      "name": "path",
      "label": "Variable path",
      "type": "text"
    },
    {
      "name": "condition",
      "label": "Condition",
      "type": "select",
      "options": [
        "truthy",
        "empty",
        "not_empty"
      ]
    },
    {
      "name": "widths",
      "label": "Responsive width",
      "type": "breakpoints",
      "help": "Choose how many of 12 columns this item occupies at each breakpoint."
    }
  ],
  "ports": {
    "inputs": [
      {
        "id": "parent",
        "label": "Parent",
        "type": "view-child",
        "direction": "in"
      }
    ],
    "outputs": [
      {
        "id": "true",
        "label": "True",
        "type": "view-child",
        "direction": "out",
        "multiple": true
      },
      {
        "id": "false",
        "label": "False",
        "type": "view-child",
        "direction": "out",
        "multiple": true
      }
    ]
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\ViewBuilder\\IfCompiler",
    "file": "Compiler.php"
  }
}
