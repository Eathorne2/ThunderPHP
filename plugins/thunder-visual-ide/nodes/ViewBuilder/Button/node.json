{
  "type": "view.button",
  "label": "Button",
  "category": "View Builder",
  "kind": "view",
  "icon": "BTN",
  "color": "#0891b2",
  "description": "Creates a submit, reset, or normal button.",
  "allowed_graphs": [
    "view"
  ],
  "defaults": {
    "title": "Button",
    "text": "Submit",
    "button_type": "submit",
    "style": "primary",
    "name": "",
    "value": "",
    "css_class": "",
    "widths": {
      "mobile": 12,
      "small": 12,
      "medium": 4,
      "large": 3
    },
    "inline_style": ""
  },
  "properties": [
    {
      "name": "title",
      "label": "Node title",
      "type": "text"
    },
    {
      "name": "text",
      "label": "Button text",
      "type": "text"
    },
    {
      "name": "button_type",
      "label": "Type",
      "type": "select",
      "options": [
        "submit",
        "button",
        "reset"
      ]
    },
    {
      "name": "style",
      "label": "Style",
      "type": "select",
      "options": [
        "primary",
        "secondary",
        "custom"
      ]
    },
    {
      "name": "name",
      "label": "Name",
      "type": "text"
    },
    {
      "name": "value",
      "label": "Value",
      "type": "text"
    },
    {
      "name": "css_class",
      "label": "CSS classes",
      "type": "text"
    },
    {
      "name": "inline_style",
      "label": "Inline styles",
      "type": "textarea",
      "help": "CSS declarations applied directly to the same element as the custom CSS classes."
    },
    {
      "name": "widths",
      "label": "Responsive width",
      "type": "breakpoints",
      "help": "Choose how many of 12 columns this item occupies at each breakpoint."
    }
  ],
  "ports": {
    "inputs": [
      {
        "id": "parent",
        "label": "Parent",
        "type": "view-child",
        "direction": "in"
      }
    ],
    "outputs": []
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\ViewBuilder\\ButtonCompiler",
    "file": "Compiler.php"
  }
}
