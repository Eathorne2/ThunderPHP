{
  "type": "view.variable",
  "label": "Variable Output",
  "category": "View Builder",
  "kind": "view",
  "icon": "VAR",
  "color": "#0891b2",
  "description": "Renders an extracted view variable or nested property.",
  "allowed_graphs": [
    "view"
  ],
  "defaults": {
    "title": "Variable",
    "path": "user.name",
    "fallback": "",
    "escape": true,
    "wrapper_tag": "span",
    "css_class": "",
    "widths": {
      "mobile": 12,
      "small": 12,
      "medium": 12,
      "large": 12
    },
    "inline_style": ""
  },
  "properties": [
    {
      "name": "title",
      "label": "Node title",
      "type": "text"
    },
    {
      "name": "path",
      "label": "Variable path",
      "type": "text"
    },
    {
      "name": "fallback",
      "label": "Fallback",
      "type": "text"
    },
    {
      "name": "escape",
      "label": "Escape output",
      "type": "checkbox"
    },
    {
      "name": "wrapper_tag",
      "label": "Wrapper tag",
      "type": "select",
      "options": [
        "span",
        "div",
        "p",
        "strong",
        "h1",
        "h2",
        "h3",
        "none"
      ]
    },
    {
      "name": "css_class",
      "label": "CSS classes",
      "type": "text"
    },
    {
      "name": "inline_style",
      "label": "Inline styles",
      "type": "textarea",
      "help": "CSS declarations applied directly to the same element as the custom CSS classes."
    },
    {
      "name": "widths",
      "label": "Responsive width",
      "type": "breakpoints",
      "help": "Choose how many of 12 columns this item occupies at each breakpoint."
    }
  ],
  "ports": {
    "inputs": [
      {
        "id": "parent",
        "label": "Parent",
        "type": "view-child",
        "direction": "in"
      }
    ],
    "outputs": []
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\ViewBuilder\\VariableCompiler",
    "file": "Compiler.php"
  }
}
