{
  "type": "view.grid",
  "label": "Grid",
  "category": "View Builder",
  "kind": "view",
  "icon": "GRID",
  "color": "#0891b2",
  "description": "Creates a responsive 12-column CSS Grid container.",
  "allowed_graphs": [
    "view"
  ],
  "defaults": {
    "title": "Grid",
    "gap": "1rem",
    "css_class": "",
    "widths": {
      "mobile": 12,
      "small": 12,
      "medium": 12,
      "large": 12
    },
    "inline_style": ""
  },
  "properties": [
    {
      "name": "title",
      "label": "Node title",
      "type": "text"
    },
    {
      "name": "gap",
      "label": "Grid gap",
      "type": "text"
    },
    {
      "name": "css_class",
      "label": "CSS classes",
      "type": "text"
    },
    {
      "name": "inline_style",
      "label": "Inline styles",
      "type": "textarea",
      "help": "CSS declarations applied directly to the same element as the custom CSS classes."
    },
    {
      "name": "widths",
      "label": "Responsive width",
      "type": "breakpoints",
      "help": "Choose how many of 12 columns this item occupies at each breakpoint."
    }
  ],
  "ports": {
    "inputs": [
      {
        "id": "parent",
        "label": "Parent",
        "type": "view-child",
        "direction": "in"
      }
    ],
    "outputs": [
      {
        "id": "children",
        "label": "Children",
        "type": "view-child",
        "direction": "out",
        "multiple": true
      }
    ]
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\ViewBuilder\\GridCompiler",
    "file": "Compiler.php"
  }
}
