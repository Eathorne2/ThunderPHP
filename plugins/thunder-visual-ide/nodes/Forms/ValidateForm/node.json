{
  "type": "forms.validate",
  "label": "Validate Form Schema",
  "category": "Forms",
  "kind": "flow",
  "icon": "RULES",
  "color": "#0d9488",
  "description": "Validates data using rules derived from a visual Form schema.",
  "allowed_graphs": [
    "flow"
  ],
  "defaults": {
    "title": "Validate Form",
    "view_node_id": "",
    "form_name": "",
    "extra_rules_json": "{}",
    "validator_variable": "",
    "errors_variable": ""
  },
  "properties": [
    {
      "name": "title",
      "label": "Node title",
      "type": "text"
    },
    {
      "name": "validator_variable",
      "label": "Validator variable",
      "type": "text",
      "help": "Optional internal validator object variable. Omit the $ sign."
    },
    {
      "name": "errors_variable",
      "label": "Errors variable",
      "type": "text",
      "help": "Optional validation-errors variable. Omit the $ sign."
    },
    {
      "name": "view_node_id",
      "label": "View",
      "type": "view_ref"
    },
    {
      "name": "form_name",
      "label": "Visual form",
      "type": "form_ref"
    },
    {
      "name": "extra_rules_json",
      "label": "Extra or replacement validation rules",
      "type": "validation_rules",
      "help": "These rules are merged over the selected visual form schema."
    }
  ],
  "ports": {
    "inputs": [
      {
        "id": "exec_in",
        "label": "Run",
        "type": "exec",
        "direction": "in"
      },
      {
        "id": "data",
        "label": "Form Data",
        "type": "array",
        "direction": "in"
      }
    ],
    "outputs": [
      {
        "id": "valid",
        "label": "Valid",
        "type": "exec",
        "direction": "out"
      },
      {
        "id": "invalid",
        "label": "Invalid",
        "type": "exec",
        "direction": "out"
      },
      {
        "id": "errors",
        "label": "Errors",
        "type": "array",
        "direction": "out",
        "multiple": true
      }
    ]
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\Forms\\ValidateFormCompiler",
    "file": "Compiler.php"
  }
}
