        "direction": "in",
        "multiple": false
      },
      {
        "id": "object",
        "label": "Object",
        "type": "mixed",
        "direction": "in",
        "multiple": false
      }
    ],
    "outputs": [
      {
        "id": "exec",
        "label": "Next",
        "type": "exec",
        "direction": "out",
        "multiple": false
      },
      {
        "id": "result",
        "label": "Result",
        "type": "mixed",
        "direction": "out",
        "multiple": false
      }
    ]
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\Custom\\ClassMethodCallCompiler",
    "file": "Compiler.php"
  }
}
