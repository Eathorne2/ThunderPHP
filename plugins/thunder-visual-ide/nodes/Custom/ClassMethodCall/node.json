{
  "type": "custom.class_method_call",
  "label": "Class Method Call",
  "category": "Custom",
  "kind": "flow",
  "icon": "C()",
  "color": "#5b21b6",
  "description": "Calls a method from a Class Definition. Typed parameter ports follow the selected signature.",
  "allowed_graphs": [
    "flow"
  ],
  "dynamic_ports": "class_method",
  "defaults": {
    "title": "Class Method",
    "class_node_id": "",
    "method_name": "",
    "result_variable": ""
  },
  "properties": [
    {
      "name": "title",
      "label": "Node title",
      "type": "text"
    },
    {
      "name": "result_variable",
      "label": "Result variable",
      "type": "text",
      "help": "Optional PHP variable name. Omit the $ sign. Leave blank to use the automatic node-specific name."
    },
    {
      "name": "class_node_id",
      "label": "Class",
      "type": "class_ref"
    },
    {
      "name": "method_name",
      "label": "Method",
      "type": "class_method"
    }
  ],
  "ports": {
    "inputs": [
      {
        "id": "exec_in",
        "label": "Run",
