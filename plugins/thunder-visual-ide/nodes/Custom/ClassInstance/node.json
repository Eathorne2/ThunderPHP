    ],
    "outputs": [
      {
        "id": "exec",
        "label": "Next",
        "type": "exec",
        "direction": "out",
        "multiple": false
      },
      {
        "id": "object",
        "label": "Object",
        "type": "mixed",
        "direction": "out",
        "multiple": false
      }
    ]
  },
  "compiler": {
    "class": "ThunderVisualIde\\Nodes\\Custom\\ClassInstanceCompiler",
    "file": "Compiler.php"
