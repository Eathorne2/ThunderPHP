          "data": {
            "title": "Contact Help Tabs",
            "component_name": "contact-help-tabs",
            "html_code": "<section class=\"content-tabs\" data-tabs>\n    <div class=\"content-tabs__list\" role=\"tablist\" aria-label=\"Contact information\">\n        <button class=\"content-tabs__tab is-active\" type=\"button\" role=\"tab\" aria-selected=\"true\" data-tab=\"overview\">Response times</button>\n        <button class=\"content-tabs__tab\" type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"features\">What to include</button>\n        <button class=\"content-tabs__tab\" type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"support\">Other channels</button>\n    </div>\n\n    <div class=\"content-tabs__panel is-active\" role=\"tabpanel\" data-panel=\"overview\">\n        <h3>Response times</h3>\n        <p>Most messages receive a response within one business day.</p>\n    </div>\n    <div class=\"content-tabs__panel\" role=\"tabpanel\" data-panel=\"features\" hidden>\n        <h3>What to include</h3>\n        <p>Include the relevant account, school or order details so the team can help quickly.</p>\n    </div>\n    <div class=\"content-tabs__panel\" role=\"tabpanel\" data-panel=\"support\" hidden>\n        <h3>Other channels</h3>\n        <p>Add phone, WhatsApp or office details here when those channels are available.</p>\n    </div>\n</section>\n",
            "css_code": ".content-tabs {\n    overflow: hidden;\n    border: 1px solid #dbe4ef;\n    border-radius: 1rem;\n    background: #ffffff;\n    box-shadow: 0 14px 38px rgba(15, 23, 42, 0.08);\n}\n\n.content-tabs__list {\n    display: flex;\n    gap: 0.25rem;\n    padding: 0.45rem;\n    background: #f1f5f9;\n}\n\n.content-tabs__tab {\n    flex: 1;\n    padding: 0.75rem 1rem;\n    border: 0;\n    border-radius: 0.7rem;\n    color: #64748b;\n    background: transparent;\n    cursor: pointer;\n    font-weight: 700;\n}\n\n.content-tabs__tab.is-active {\n    color: #ffffff;\n    background: #4f46e5;\n    box-shadow: 0 7px 18px rgba(79, 70, 229, 0.25);\n}\n\n.content-tabs__panel {\n    padding: 1.5rem;\n    animation: tab-panel-in 180ms ease-out;\n}\n\n.content-tabs__panel h3 {\n    margin-top: 0;\n    color: #0f172a;\n}\n\n.content-tabs__panel p {\n    margin-bottom: 0;\n    color: #475569;\n    line-height: 1.65;\n}\n\n@keyframes tab-panel-in {\n    from { opacity: 0; transform: translateY(4px); }\n    to { opacity: 1; transform: translateY(0); }\n}\n",
            "js_code": "const tabs = Array.from(root.querySelectorAll('[data-tab]'));\nconst panels = Array.from(root.querySelectorAll('[data-panel]'));\n\nfunction activate(name) {\n    tabs.forEach(function (tab) {\n        const active = tab.dataset.tab === name;\n        tab.classList.toggle('is-active', active);\n        tab.setAttribute('aria-selected', active ? 'true' : 'false');\n    });\n\n    panels.forEach(function (panel) {\n        const active = panel.dataset.panel === name;\n        panel.classList.toggle('is-active', active);\n        panel.hidden = !active;\n    });\n}\n\ntabs.forEach(function (tab) {\n    tab.addEventListener('click', function () {\n        activate(tab.dataset.tab || '');\n    });\n});\n",
            "widths": {
