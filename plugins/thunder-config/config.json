{
    "name": "Thunder Config",
    "version": "1.0.0",
    "core_requires": "^1.0.0",
    "id": "thunder-config",
    "description": "Admin plugin for editing safe values in the root config.php file.",
    "author": "Eathorne Choongo",
    "website": "thunderphp.com",
    "thumbnail": "thumbnail.jpg",
    "active": true,
    "look": "main",
    "index": 20,
    "permissions": [
        {
            "name": "Manage Configuration",
            "slug": "manage-config",
            "group": "Configuration",
            "description": "Edit safe values in the application config.php file."
        }
    ],
    "routes": {
        "on": ["admin"],
        "off": [],
        "routes": [
            {
                "method": "GET",
                "pattern": "/admin/thunder-config",
                "name": "thunder-config.index"
            },
            {
                "method": "POST",
                "pattern": "/admin/thunder-config",
                "name": "thunder-config.save"
            },
            {
                "method": "POST",
                "pattern": "/admin/thunder-config/upload-logo",
                "name": "thunder-config.upload-logo"
            }
        ]
    },
    "dependencies": {
        "thunder-admin": {
            "name": "Thunder Admin",
            "version": "1.0.0",
            "required": true
        }
    }
}
